{
  "version": 1,
  "backend": "systemd",
  "unit": "charmer-gateway",
  "exec_links": {
    "bundle": ".local/share/charmer/install/current",
    "nix": ".local/share/charmer/nix/current"
  },
  "state_root": ".local/state/charmer",
  "working_directory": ".local/state/charmer/gateway",
  "private_dirs": [
    ".config/charmer",
    ".local/share/charmer",
    ".local/share/charmer/auth",
    ".local/share/charmer/traces",
    ".local/state/charmer",
    ".local/state/charmer/gateway",
    ".local/state/charmer/gateway/logs"
  ],
  "bind_rw": [
    ".local/share/charmer/auth",
    ".local/share/charmer/traces",
    ".local/state/charmer/gateway"
  ],
  "bind_ro": [
    ".config/charmer",
    ".local/share/charmer",
    ".local/state/charmer"
  ],
  "hardening": {
    "home": "tmpfs",
    "tier_b": [
      "ProtectSystem",
      "PrivateTmp",
      "PrivateDevices",
      "NoNewPrivileges",
      "RestrictSUIDSGID",
      "LockPersonality",
      "RestrictRealtime",
      "RestrictNamespaces",
      "SystemCallArchitectures",
      "SystemCallFilter",
      "SystemCallErrorNumber",
      "RestrictAddressFamilies",
      "ProtectKernelTunables",
      "ProtectKernelModules",
      "ProtectKernelLogs",
      "ProtectControlGroups",
      "ProtectHostname"
    ]
  }
}
