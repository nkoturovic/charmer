#!/bin/sh
# charmer subagent status line (Claude Code subagentStatusLine) - stable
# path embedded in compiled scopes. Regenerated by the launcher; do not
# edit. Forwards the launcher's rows only when it exits 0; on any failure
# it prints nothing and exits 0, so the client keeps its own rows.
launcher=/nix/store/fixture/bin/charmer
if [ ! -x "$launcher" ]; then
    launcher=$(command -v charmer 2>/dev/null) || exit 0
fi
out=$("$launcher" statusline subagents 2>/dev/null) || exit 0
if [ -n "$out" ]; then
    printf '%s\n' "$out"
fi
exit 0
