#!/bin/sh
# charmer lifecycle hook shim - stable path embedded in compiled
# scopes. Regenerated by the launcher; do not edit. Prefers the
# resolved launcher command so hooks track the newest install; falls
# back to PATH so a garbage-collected package path cannot strand them.
if [ -x /nix/store/fixture/bin/charmer ]; then
    exec /nix/store/fixture/bin/charmer "$@"
fi
if command -v charmer >/dev/null 2>&1; then
    exec charmer "$@"
fi
echo 'charmer hook shim: no charmer launcher found' >&2
exit 1
