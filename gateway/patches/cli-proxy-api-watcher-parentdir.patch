+// startConfigDirWatcherWithHook is startConfigDirWatcher with a hook that runs
+// inside every reload callback, on the watcher's goroutine.
+func startConfigDirWatcherWithHook(t *testing.T, apiKeys []string, hook func(*configDirWatchFixture, reloadRecord)) *configDirWatchFixture {
+	t.Helper()
+	root := t.TempDir()
+	f := &configDirWatchFixture{
+		t:       t,
+		cfgPath: filepath.Join(root, "cfg", "config.yaml"),
+		authDir: filepath.Join(root, "auth"),
+		reloads: make(chan reloadRecord, 256),
+	}
+	f.logs = installLogCapture(t)
+	for _, dir := range []string{filepath.Dir(f.cfgPath), f.authDir} {
+		if err := os.MkdirAll(dir, 0o700); err != nil {
+			t.Fatalf("mkdir %s: %v", dir, err)
+		}
+	}
+	if err := os.WriteFile(f.cfgPath, f.render(1, apiKeys), 0o600); err != nil {
+		t.Fatalf("seed config: %v", err)
+	}
+	running, err := config.LoadConfig(f.cfgPath)
+	if err != nil {
+		t.Fatalf("load seed config: %v", err)
+	}
+	w, err := NewWatcher(f.cfgPath, f.authDir, func(cfg *config.Config) {
+		record := reloadRecord{}
+		if cfg != nil {
+			record.port = cfg.Port
+			record.apiKeys = append([]string(nil), cfg.APIKeys...)
+		}
+		if hook != nil {
+			hook(f, record)
+		}
+		select {
+		case f.reloads <- record:
+		default:
+		}
+	})
+	if err != nil {
+		t.Fatalf("NewWatcher: %v", err)
+	}
+	f.w = w
+	w.SetConfig(running)
+	ctx, cancel := context.WithCancel(context.Background())
+	t.Cleanup(func() {
+		cancel()
+		_ = w.Stop()
+	})
+	if err = w.Start(ctx); err != nil {
+		t.Fatalf("Start: %v", err)
+	}
+	// Start performs one initial client load, which invokes the callback.
+	f.expectReload(1, apiKeys)
+	return f
+}
