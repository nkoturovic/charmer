+func TestConfigDirWatchIgnoresTempAndSiblingFiles(t *testing.T) {
+	f := startConfigDirWatcher(t, nil)
+	dir := filepath.Dir(f.cfgPath)
+	body := []byte("port: 99\n")
+
+	// An abandoned writer temp file (created, written, never renamed in).
+	tmp, err := os.CreateTemp(dir, ".config.yaml.*.tmp")
+	if err != nil {
+		t.Fatal(err)
+	}
+	if _, err = tmp.Write(body); err != nil {
+		t.Fatal(err)
+	}
+	if err = tmp.Close(); err != nil {
+		t.Fatal(err)
+	}
+	if err = os.Remove(tmp.Name()); err != nil {
+		t.Fatal(err)
+	}
+	// Sibling files: charmer state next to its config, and look-alikes.
+	for _, name := range []string{
+		"api-key", "api-key.lock", "previous-key", "custom.json", "native-contract.json",
+		"config.yaml.bak", "config.yaml~", ".config.yaml.swp", "xconfig.yaml", "config.yml",
+	} {
+		if err = os.WriteFile(filepath.Join(dir, name), body, 0o600); err != nil {
+			t.Fatal(err)
+		}
+	}
+	if err = os.Rename(filepath.Join(dir, "config.yaml.bak"), filepath.Join(dir, "config.yaml.old")); err != nil {
+		t.Fatal(err)
+	}
+	if err = os.Remove(filepath.Join(dir, "config.yml")); err != nil {
+		t.Fatal(err)
+	}
+	// A nested directory (not watched) and a metadata-only change of the config.
+	if err = os.Mkdir(filepath.Join(dir, "compositions"), 0o700); err != nil {
+		t.Fatal(err)
+	}
+	if err = os.WriteFile(filepath.Join(dir, "compositions", "config.yaml"), body, 0o600); err != nil {
+		t.Fatal(err)
+	}
+	if err = os.Chmod(f.cfgPath, 0o640); err != nil {
+		t.Fatal(err)
+	}
+	f.expectNotScheduled("temp, sibling and chmod events")
+	f.expectRunning(1, nil)
+	if got := f.logs.count("config file changed, reloading"); got != 0 {
+		t.Fatalf("a config reload was attempted %d times for temp/sibling events", got)
+	}
+
+	// The watch is still live: a real replace reloads.
+	renameReplace(t, f.cfgPath, f.render(2, nil))
+	f.expectReload(2, nil)
+}
