diff --git a/internal/watcher/config_bytes_reload_linux_test.go b/internal/watcher/config_bytes_reload_linux_test.go
new file mode 100644
index 00000000..5d0f6f6e
--- /dev/null
+++ b/internal/watcher/config_bytes_reload_linux_test.go
@@ -0,0 +1,204 @@
+//go:build linux
+
+package watcher
+
+import (
+	"bytes"
+	"errors"
+	"fmt"
+	"os"
+	"path/filepath"
+	"testing"
+	"time"
+	"unsafe"
+
+	"github.com/router-for-me/CLIProxyAPI/v8/internal/config"
+	"golang.org/x/sys/unix"
+)
+
+// charmer local patch (watcher-parentdir) gate: a hot reload reads the config
+// file exactly once and parses those bytes; nothing re-reads, rewrites, hashes
+// back or re-lays-out the file. The file-system side is observed with inotify
+// on the config file itself, so an open or a write anywhere in the process
+// counts, not just through the watcher's own code.
+
+// fileAccess counts the inotify events one action caused on a file.
+// Read-only closes are observed (closeReads) so that inotify, which merges an
+// event identical to the last queued one, cannot fold two separate read-only
+// opens into one IN_OPEN; they are not writes.
+type fileAccess struct {
+	opens, closeReads, modifies, closeWrites, attribs, moves int
+}
+
+func (a fileAccess) writes() int { return a.modifies + a.closeWrites + a.attribs + a.moves }
+
+// observeFileAccess runs action and returns the inotify events it caused on
+// path. The kernel queues each event before the causing syscall returns, so
+// draining the queue after action sees all of them.
+func observeFileAccess(t *testing.T, path string, action func()) fileAccess {
+	t.Helper()
+	fd, err := unix.InotifyInit1(unix.IN_CLOEXEC | unix.IN_NONBLOCK)
+	if err != nil {
+		t.Fatalf("inotify_init1: %v", err)
+	}
+	defer func() { _ = unix.Close(fd) }()
+	const mask = unix.IN_OPEN | unix.IN_CLOSE_NOWRITE | unix.IN_MODIFY | unix.IN_CLOSE_WRITE | unix.IN_ATTRIB | unix.IN_MOVE_SELF | unix.IN_DELETE_SELF
+	if _, err = unix.InotifyAddWatch(fd, path, mask); err != nil {
+		t.Fatalf("inotify_add_watch %s: %v", path, err)
+	}
+	action()
+	var counts fileAccess
+	buf := make([]byte, 64*1024)
+	for {
+		n, errRead := unix.Read(fd, buf)
+		if errors.Is(errRead, unix.EAGAIN) {
+			return counts
+		}
+		if errRead != nil {
+			t.Fatalf("read inotify events: %v", errRead)
+		}
+		for offset := 0; offset+unix.SizeofInotifyEvent <= n; {
+			event := (*unix.InotifyEvent)(unsafe.Pointer(&buf[offset]))
+			switch {
+			case event.Mask&unix.IN_OPEN != 0:
+				counts.opens++
+			case event.Mask&unix.IN_CLOSE_NOWRITE != 0:
+				counts.closeReads++
+			case event.Mask&unix.IN_MODIFY != 0:
+				counts.modifies++
+			case event.Mask&unix.IN_CLOSE_WRITE != 0:
+				counts.closeWrites++
+			case event.Mask&unix.IN_ATTRIB != 0:
+				counts.attribs++
+			case event.Mask&(unix.IN_MOVE_SELF|unix.IN_DELETE_SELF) != 0:
+				counts.moves++
+			}
+			offset += unix.SizeofInotifyEvent + int(event.Len)
+		}
+	}
+}
+
+// Positive control for observeFileAccess: two separate reads are counted as
+// two opens with two read-only closes and no write.
+func TestObserveFileAccessCountsEverySeparateRead(t *testing.T) {
+	path := filepath.Join(t.TempDir(), "config.yaml")
+	if err := os.WriteFile(path, []byte("port: 8317\n"), 0o600); err != nil {
+		t.Fatal(err)
+	}
+	counts := observeFileAccess(t, path, func() {
+		for i := 0; i < 2; i++ {
+			if _, err := os.ReadFile(path); err != nil {
+				t.Fatal(err)
+			}
+		}
+	})
+	if counts.opens != 2 || counts.closeReads != 2 || counts.writes() != 0 {
+		t.Fatalf("two reads observed as %+v, want 2 opens, 2 read-only closes, no writes", counts)
+	}
+}
+
+// rewriteBaitConfig is a config the upstream loader would rewrite on load: a
+// plaintext management secret (hashed back) and legacy fields that conflict
+// with their v8 counterparts (cleaned out of the file).
+func rewriteBaitConfig(authDir string, port int) []byte {
+	return []byte(fmt.Sprintf("auth-dir: %q\nport: %d\napi-keys:\n  - \"client-key\"\n"+
+		"remote-management:\n  allow-remote: false\n  secret-key: \"plaintext-bait\"\n"+
+		"request-retry: 4\nrouting:\n  retry: {request-retry: 1}\n", authDir, port))
+}
+
+func newBytesReloadWatcher(t *testing.T, mode os.FileMode, port int) (*Watcher, string, *[]int) {
+	t.Helper()
+	root := t.TempDir()
+	authDir := filepath.Join(root, "auth")
+	if err := os.MkdirAll(authDir, 0o700); err != nil {
+		t.Fatal(err)
+	}
+	configPath := filepath.Join(root, "config.yaml")
+	if err := os.WriteFile(configPath, rewriteBaitConfig(authDir, port), mode); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.Chmod(configPath, mode); err != nil {
+		t.Fatal(err)
+	}
+	applied := &[]int{}
+	w := &Watcher{
+		configPath:     configPath,
+		authDir:        authDir,
+		reloadCallback: func(cfg *config.Config) { *applied = append(*applied, cfg.Port) },
+	}
+	return w, authDir, applied
+}
+
+func TestConfigBytesReloadReadsOnceAndNeverWrites(t *testing.T) {
+	w, authDir, applied := newBytesReloadWatcher(t, 0o600, 2)
+	before, err := os.ReadFile(w.configPath)
+	if err != nil {
+		t.Fatal(err)
+	}
+	access := observeFileAccess(t, w.configPath, w.ReloadConfigIfChanged)
+	if access.opens != 1 || access.writes() != 0 {
+		t.Fatalf("first reload: %d opens and %d writes of the config file, want 1 and 0 (%+v)", access.opens, access.writes(), access)
+	}
+	// A changed file: still one read and no write.
+	next := rewriteBaitConfig(authDir, 3)
+	if err = os.WriteFile(w.configPath, next, 0o600); err != nil {
+		t.Fatal(err)
+	}
+	access = observeFileAccess(t, w.configPath, w.ReloadConfigIfChanged)
+	if access.opens != 1 || access.writes() != 0 {
+		t.Fatalf("changed reload: %d opens and %d writes of the config file, want 1 and 0 (%+v)", access.opens, access.writes(), access)
+	}
+	// Unchanged: the change check reads once and applies nothing.
+	access = observeFileAccess(t, w.configPath, w.ReloadConfigIfChanged)
+	if access.opens != 1 || access.writes() != 0 {
+		t.Fatalf("unchanged reload: %d opens and %d writes of the config file, want 1 and 0 (%+v)", access.opens, access.writes(), access)
+	}
+	after, err := os.ReadFile(w.configPath)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !bytes.Equal(after, next) || bytes.Equal(before, next) {
+		t.Fatalf("config file bytes changed by a reload:\n%s", after)
+	}
+	if fmt.Sprint(*applied) != "[2 3]" {
+		t.Fatalf("applied ports = %v, want [2 3]", *applied)
+	}
+	w.clientsMutex.RLock()
+	defer w.clientsMutex.RUnlock()
+	if w.lastConfigHash != config.ComputeSourceHash(next) || w.config == nil || w.config.SourceHash != w.lastConfigHash {
+		t.Fatalf("recorded hash %q / config SourceHash %q, want the hash of the bytes read", w.lastConfigHash, w.config.SourceHash)
+	}
+}
+
+func TestConfigBytesReloadOfReadOnlyFileKeepsBytesAndMtime(t *testing.T) {
+	w, _, applied := newBytesReloadWatcher(t, 0o400, 4)
+	before, err := os.ReadFile(w.configPath)
+	if err != nil {
+		t.Fatal(err)
+	}
+	infoBefore, err := os.Stat(w.configPath)
+	if err != nil {
+		t.Fatal(err)
+	}
+	// A rewrite would move the modification time past this point.
+	time.Sleep(20 * time.Millisecond)
+	access := observeFileAccess(t, w.configPath, w.ReloadConfigIfChanged)
+	if access.opens != 1 || access.writes() != 0 {
+		t.Fatalf("reload of a 0400 config: %d opens and %d writes, want 1 and 0 (%+v)", access.opens, access.writes(), access)
+	}
+	infoAfter, err := os.Stat(w.configPath)
+	if err != nil {
+		t.Fatal(err)
+	}
+	after, err := os.ReadFile(w.configPath)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !bytes.Equal(before, after) || !infoBefore.ModTime().Equal(infoAfter.ModTime()) || infoAfter.Mode().Perm() != 0o400 {
+		t.Fatalf("reload changed the 0400 config: bytes equal %t, mtime %v -> %v, mode %v",
+			bytes.Equal(before, after), infoBefore.ModTime(), infoAfter.ModTime(), infoAfter.Mode().Perm())
+	}
+	if fmt.Sprint(*applied) != "[4]" {
+		t.Fatalf("applied ports = %v, want [4]", *applied)
+	}
+}
