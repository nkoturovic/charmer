+func (f *configDirWatchFixture) render(port int, apiKeys []string) []byte {
+	var b strings.Builder
+	fmt.Fprintf(&b, "auth-dir: %q\nport: %d\n", f.authDir, port)
+	if len(apiKeys) > 0 {
+		b.WriteString("api-keys:\n")
+		for _, key := range apiKeys {
+			fmt.Fprintf(&b, "  - %q\n", key)
+		}
+	}
+	return []byte(b.String())
+}
