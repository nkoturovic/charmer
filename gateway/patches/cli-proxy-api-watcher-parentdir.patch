new file mode 100644
index 00000000..23d0fd7d
--- /dev/null
+++ b/internal/watcher/config_dir_watch_test.go
@@ -0,0 +1,565 @@
+package watcher
+
+import (
+	"context"
+	"fmt"
+	"os"
+	"path/filepath"
+	"strings"
+	"sync"
+	"testing"
+	"time"
+
+	"github.com/router-for-me/CLIProxyAPI/v8/internal/config"
+	log "github.com/sirupsen/logrus"
+)
+
+// These tests drive the real fsnotify watch with an atomic rename-replace:
+// a same-directory ".config.yaml.<rand>.tmp" temp file, fsync, rename over the
+// config, then a directory fsync (the writer pattern of charmer's
+// state.atomic_write).
+
+const (
+	// configWatchEventTimeout bounds every wait for an expected event; it is
+	// reached only when the expectation fails.
+	configWatchEventTimeout = 5 * time.Second
+	// configWatchQuietWindow is how long a negative check keeps listening for
+	// an unexpected reload after the event barrier (one debounce period plus
+	// margin for a reload that was already in flight).
+	configWatchQuietWindow = 2 * configReloadDebounce
+	// Log messages emitted by the reload guards.
+	logEmptyConfig   = "ignoring empty config file"
+	logMissingRead   = "failed to read config file for hash check"
+	logAPIKeyRefusal = "removes every api-key"
+	// Logged when the reloaded bytes do not parse as a config.
+	logReloadParseRefusal = "failed to reload config"
+	// Logged once per applied config reload.
+	logReloadApplied = "config successfully reloaded"
+)
+
+type reloadRecord struct {
+	port    int
+	apiKeys []string
+}
+
+type logCapture struct {
+	mu       sync.Mutex
+	messages []string
+}
+
+func (c *logCapture) Levels() []log.Level { return log.AllLevels }
+
+func (c *logCapture) Fire(entry *log.Entry) error {
+	c.mu.Lock()
+	c.messages = append(c.messages, entry.Message)
+	c.mu.Unlock()
+	return nil
+}
+
+func (c *logCapture) count(substr string) int {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	n := 0
+	for _, message := range c.messages {
+		if strings.Contains(message, substr) {
+			n++
+		}
+	}
+	return n
+}
+
+func installLogCapture(t *testing.T) *logCapture {
+	t.Helper()
+	capture := &logCapture{}
+	logger := log.StandardLogger()
+	savedHooks := make(log.LevelHooks)
+	for level, hooks := range logger.Hooks {
+		savedHooks[level] = append([]log.Hook(nil), hooks...)
+	}
+	savedLevel := logger.GetLevel()
+	logger.SetLevel(log.InfoLevel)
+	logger.AddHook(capture)
+	t.Cleanup(func() {
+		logger.ReplaceHooks(savedHooks)
+		logger.SetLevel(savedLevel)
+	})
+	return capture
+}
+
+type configDirWatchFixture struct {
+	t        *testing.T
+	w        *Watcher
+	cfgPath  string
+	authDir  string
+	reloads  chan reloadRecord
+	logs     *logCapture
+	barriers int
+}
+
+// startConfigDirWatcher starts a real watcher on <tmp>/cfg/config.yaml with an
+// auth dir <tmp>/auth, seeded with port 1 and the given api-keys.
+func startConfigDirWatcher(t *testing.T, apiKeys []string) *configDirWatchFixture {
+	t.Helper()
+	return startConfigDirWatcherWithHook(t, apiKeys, nil)
+}
