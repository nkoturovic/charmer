@@ -0,0 +1,82 @@
+package config
+
+import (
+	"os"
+	"path/filepath"
+	"reflect"
+	"testing"
+)
+
+// charmer local patch (watcher-parentdir) gate: startup and every reload load
+// config bytes through one in-memory pipeline, LoadConfigBytes, which follows
+// ParseConfigBytes and records the bytes' SourceHash.
+
+func TestConfigBytesLoaderMatchesLoadConfigOptional(t *testing.T) {
+	for name, raw := range map[string]string{
+		"empty":   "",
+		"blank":   " \n \n",
+		"minimal": "port: 8317\n",
+		"charmer": "host: 127.0.0.1\nport: 8317\napi-keys:\n  - \"client-key\"\nremote-management:\n  allow-remote: false\n  disable-control-panel: true\n" +
+			"disable-cooling: true\nrequest-retry: 2\nws-auth: true\noauth-excluded-models:\n  antigravity: [\"*\"]\n",
+		"v8 layout": "config-version: 8\nserver: {host: 127.0.0.1, port: 8317}\naccess: {api-keys: [client-key]}\nrouting: {retry: {request-retry: 3}}\n",
+	} {
+		t.Run(name, func(t *testing.T) {
+			path := filepath.Join(t.TempDir(), "config.yaml")
+			if err := os.WriteFile(path, []byte(raw), 0o600); err != nil {
+				t.Fatal(err)
+			}
+			fromFile, err := LoadConfigOptional(path, false)
+			if err != nil {
+				t.Fatalf("LoadConfigOptional: %v", err)
+			}
+			fromBytes, err := LoadConfigBytes([]byte(raw))
+			if err != nil {
+				t.Fatalf("LoadConfigBytes: %v", err)
+			}
+			if fromBytes.SourceHash != ComputeSourceHash([]byte(raw)) {
+				t.Fatalf("SourceHash %q is not the hash of the loaded bytes", fromBytes.SourceHash)
+			}
+			if !reflect.DeepEqual(fromFile, fromBytes) {
+				t.Fatalf("LoadConfigBytes and LoadConfigOptional disagree on %s:\nfile:  %+v\nbytes: %+v", name, fromFile, fromBytes)
+			}
+			if raw != "" {
+				parsed, errParse := ParseConfigBytes([]byte(raw))
+				if errParse != nil {
+					t.Fatalf("ParseConfigBytes: %v", errParse)
+				}
+				parsed.SourceHash = fromBytes.SourceHash
+				if !reflect.DeepEqual(parsed, fromBytes) {
+					t.Fatalf("LoadConfigBytes is not ParseConfigBytes plus SourceHash on %s", name)
+				}
+			}
+			after, err := os.ReadFile(path)
+			if err != nil || string(after) != raw {
+				t.Fatalf("loading rewrote the config file: %v", err)
+			}
+		})
+	}
+}
+
+func TestConfigBytesLoaderOptionalModeKeepsEmptyConfigs(t *testing.T) {
+	dir := t.TempDir()
+	for name, raw := range map[string]string{
+		"blank":   " \n",
+		"invalid": "port: [unclosed\n",
+	} {
+		path := filepath.Join(dir, name+".yaml")
+		if err := os.WriteFile(path, []byte(raw), 0o600); err != nil {
+			t.Fatal(err)
+		}
+		cfg, err := LoadConfigOptional(path, true)
+		if err != nil || cfg == nil || cfg.Port != 0 {
+			t.Fatalf("%s optional load: cfg=%+v err=%v, want the empty config", name, cfg, err)
+		}
+	}
+	cfg, err := LoadConfigOptional(filepath.Join(dir, "missing.yaml"), true)
+	if err != nil || cfg == nil {
+		t.Fatalf("missing optional load: cfg=%+v err=%v", cfg, err)
+	}
+	if _, err = LoadConfigOptional(filepath.Join(dir, "missing.yaml"), false); err == nil {
+		t.Fatal("a missing required config loaded")
+	}
+}
