diff --git a/internal/config/config_bytes_loader_linux_test.go b/internal/config/config_bytes_loader_linux_test.go
new file mode 100644
index 00000000..6de68288
--- /dev/null
+++ b/internal/config/config_bytes_loader_linux_test.go
@@ -0,0 +1,103 @@
+//go:build linux
+
+package config
+
+import (
+	"errors"
+	"os"
+	"path/filepath"
+	"testing"
+	"unsafe"
+
+	"golang.org/x/sys/unix"
+)
+
+// configFileAccess counts the inotify opens and writes one action caused on a
+// file. The kernel queues each event before the causing syscall returns. The
+// mask includes IN_CLOSE_NOWRITE: inotify merges an event identical to the
+// last queued one, so without the close between them two separate read-only
+// opens would arrive as one IN_OPEN. Read-only closes are not writes.
+func configFileAccess(t *testing.T, path string, action func()) (opens, writes int) {
+	t.Helper()
+	fd, err := unix.InotifyInit1(unix.IN_CLOEXEC | unix.IN_NONBLOCK)
+	if err != nil {
+		t.Fatalf("inotify_init1: %v", err)
+	}
+	defer func() { _ = unix.Close(fd) }()
+	const mask = unix.IN_OPEN | unix.IN_CLOSE_NOWRITE | unix.IN_MODIFY | unix.IN_CLOSE_WRITE | unix.IN_ATTRIB | unix.IN_MOVE_SELF | unix.IN_DELETE_SELF
+	if _, err = unix.InotifyAddWatch(fd, path, mask); err != nil {
+		t.Fatalf("inotify_add_watch %s: %v", path, err)
+	}
+	action()
+	buf := make([]byte, 64*1024)
+	for {
+		n, errRead := unix.Read(fd, buf)
+		if errors.Is(errRead, unix.EAGAIN) {
+			return opens, writes
+		}
+		if errRead != nil {
+			t.Fatalf("read inotify events: %v", errRead)
+		}
+		for offset := 0; offset+unix.SizeofInotifyEvent <= n; {
+			event := (*unix.InotifyEvent)(unsafe.Pointer(&buf[offset]))
+			switch {
+			case event.Mask&unix.IN_OPEN != 0:
+				opens++
+			case event.Mask&unix.IN_CLOSE_NOWRITE != 0:
+			default:
+				writes++
+			}
+			offset += unix.SizeofInotifyEvent + int(event.Len)
+		}
+	}
+}
+
+// Positive control for the counter: two separate reads are two opens, never
+// merged into one, and reading writes nothing.
+func TestConfigFileAccessCountsEverySeparateRead(t *testing.T) {
+	path := filepath.Join(t.TempDir(), "config.yaml")
+	if err := os.WriteFile(path, []byte("port: 8317\n"), 0o600); err != nil {
+		t.Fatal(err)
+	}
+	opens, writes := configFileAccess(t, path, func() {
+		for i := 0; i < 2; i++ {
+			if _, err := os.ReadFile(path); err != nil {
+				t.Fatal(err)
+			}
+		}
+	})
+	if opens != 2 || writes != 0 {
+		t.Fatalf("two reads: %d opens and %d writes counted, want 2 and 0", opens, writes)
+	}
+}
+
+// A startup load reads the config file once and never writes it, even for a
+// config the upstream loader rewrites (a plaintext management secret under
+// either spelling, legacy fields that conflict with their v8 counterparts).
+func TestConfigBytesLoaderStartupReadsOnceAndNeverWrites(t *testing.T) {
+	for name, raw := range map[string]string{
+		"legacy secret":   "port: 8317\nremote-management:\n  secret-key: plaintext-bait\nrequest-retry: 4\nrouting:\n  retry: {request-retry: 1}\n",
+		"v8 secret":       "port: 8317\nmanagement:\n  secret-key: plaintext-bait\n",
+		"both spellings":  "port: 8317\nremote-management:\n  secret-key: legacy-bait\nmanagement:\n  secret-key: v8-bait\n",
+		"conflict layout": "port: 8317\napi-keys: [old]\naccess: {api-keys: [new]}\n",
+	} {
+		t.Run(name, func(t *testing.T) {
+			path := filepath.Join(t.TempDir(), "config.yaml")
+			if err := os.WriteFile(path, []byte(raw), 0o600); err != nil {
+				t.Fatal(err)
+			}
+			var errLoad error
+			opens, writes := configFileAccess(t, path, func() { _, errLoad = LoadConfig(path) })
+			if errLoad != nil {
+				t.Fatalf("LoadConfig: %v", errLoad)
+			}
+			if opens != 1 || writes != 0 {
+				t.Fatalf("startup load: %d opens and %d writes of the config file, want 1 and 0", opens, writes)
+			}
+			after, err := os.ReadFile(path)
+			if err != nil || string(after) != raw {
+				t.Fatalf("startup load rewrote the config file: %v", err)
+			}
+		})
+	}
+}
