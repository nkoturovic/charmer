diff --git a/cmd/server/startup_config_snapshot_test.go b/cmd/server/startup_config_snapshot_test.go
new file mode 100644
index 00000000..d50ad1be
--- /dev/null
+++ b/cmd/server/startup_config_snapshot_test.go
@@ -0,0 +1,99 @@
+package main
+
+import (
+	"os"
+	"path/filepath"
+	"testing"
+
+	"github.com/router-for-me/CLIProxyAPI/v8/internal/config"
+)
+
+// charmer local patch (watcher-parentdir): startup reads the config file
+// once. The plugin bootstrap and the runtime config load parse the same
+// snapshot, so the file is opened once and a replacement in between changes
+// neither. The read is counted through the startup read seam.
+
+func countStartupConfigReads(t *testing.T) *int {
+	t.Helper()
+	reads := 0
+	previous := readStartupConfigFile
+	readStartupConfigFile = func(name string) ([]byte, error) {
+		reads++
+		return previous(name)
+	}
+	t.Cleanup(func() { readStartupConfigFile = previous })
+	return &reads
+}
+
+func TestStartupConfigReadOnceForPluginBootstrapAndRuntime(t *testing.T) {
+	path := filepath.Join(t.TempDir(), "config.yaml")
+	first := []byte("port: 8317\napi-keys:\n  - client-key\n")
+	if err := os.WriteFile(path, first, 0o600); err != nil {
+		t.Fatal(err)
+	}
+	reads := countStartupConfigReads(t)
+
+	snapshot := readStartupConfigSnapshot(pluginBootstrapConfigPath([]string{"-config", path, "--local-model"}, ""))
+	if bootstrap := loadPluginBootstrapConfig(snapshot); bootstrap == nil {
+		t.Fatal("plugin bootstrap config is nil")
+	}
+	// A replacement between the bootstrap and the runtime load must reach
+	// neither: both parse the bytes startup read.
+	if err := os.WriteFile(path, []byte("port: 9999\n"), 0o600); err != nil {
+		t.Fatal(err)
+	}
+	cfg, err := snapshot.load(path, false)
+	if err != nil {
+		t.Fatalf("runtime load: %v", err)
+	}
+	if *reads != 1 {
+		t.Fatalf("startup read the config file %d times, want 1", *reads)
+	}
+	if cfg.Port != 8317 || cfg.SourceHash != config.ComputeSourceHash(first) {
+		t.Fatalf("runtime config port %d hash %s, want the snapshot (8317, %s)", cfg.Port, cfg.SourceHash, config.ComputeSourceHash(first))
+	}
+}
+
+// Positive control for the seam: a runtime config at another path is a
+// second, counted read of that file.
+func TestStartupConfigSnapshotOfAnotherPathReadsThatFile(t *testing.T) {
+	dir := t.TempDir()
+	bootstrapPath := filepath.Join(dir, "bootstrap.yaml")
+	runtimePath := filepath.Join(dir, "config.yaml")
+	if err := os.WriteFile(bootstrapPath, []byte("port: 8317\n"), 0o600); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.WriteFile(runtimePath, []byte("port: 8318\n"), 0o600); err != nil {
+		t.Fatal(err)
+	}
+	reads := countStartupConfigReads(t)
+	snapshot := readStartupConfigSnapshot(bootstrapPath)
+	cfg, err := snapshot.load(runtimePath, false)
+	if err != nil {
+		t.Fatalf("runtime load: %v", err)
+	}
+	if *reads != 2 || cfg.Port != 8318 {
+		t.Fatalf("reads %d port %d, want 2 reads and the runtime file's port 8318", *reads, cfg.Port)
+	}
+}
+
+// A missing config keeps upstream's startup semantics: the bootstrap gets an
+// empty plugin config, a required runtime load fails and an optional one is
+// the empty config.
+func TestStartupConfigSnapshotOfMissingFileKeepsOptionalSemantics(t *testing.T) {
+	path := filepath.Join(t.TempDir(), "absent.yaml")
+	reads := countStartupConfigReads(t)
+	snapshot := readStartupConfigSnapshot(path)
+	if bootstrap := loadPluginBootstrapConfig(snapshot); bootstrap == nil {
+		t.Fatal("plugin bootstrap config is nil for a missing file")
+	}
+	if _, err := snapshot.load(path, false); err == nil {
+		t.Fatal("required runtime load of a missing file succeeded")
+	}
+	if cfg, err := snapshot.load(path, true); err != nil || cfg == nil {
+		t.Fatalf("optional runtime load of a missing file: cfg=%v err=%v", cfg, err)
+	}
+	if *reads != 1 {
+		t.Fatalf("startup read the missing config %d times, want 1", *reads)
+	}
+}
