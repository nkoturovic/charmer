+package main
+
+import (
+	"context"
+	"testing"
+
+	"github.com/router-for-me/CLIProxyAPI/v8/internal/localmode"
+)
+
+// charmer local patch (no-antigravity-egress) gate: under --local-model the
+// startup path keeps catalogs embedded and starts no background updater that
+// reaches the network.
+
+type recordedUpdaters struct {
+	managementAsset, antigravity int
+	localCatalogs                []bool
+}
+
+func (r *recordedUpdaters) updaters() backgroundUpdaters {
+	return backgroundUpdaters{
+		managementAsset: func(context.Context, string) { r.managementAsset++ },
+		antigravity:     func(context.Context) { r.antigravity++ },
+		localCatalogs:   func(local bool) { r.localCatalogs = append(r.localCatalogs, local) },
+	}
+}
+
+func withLocalModePolicy(t *testing.T, local bool) {
+	t.Helper()
+	previous := localmode.NoEgress()
+	localmode.Set(local)
+	t.Cleanup(func() { localmode.Set(previous) })
+}
+
+func TestCM053NoAntigravityEgressLocalModel(t *testing.T) {
+	withLocalModePolicy(t, true)
+	var recorded recordedUpdaters
+	startBackgroundUpdaters(true, "/nonexistent/config.yaml", recorded.updaters())
+	if recorded.antigravity != 0 || recorded.managementAsset != 0 {
+		t.Fatalf("local mode started updaters: antigravity=%d management-asset=%d", recorded.antigravity, recorded.managementAsset)
+	}
+	if len(recorded.localCatalogs) != 1 || !recorded.localCatalogs[0] {
+		t.Fatalf("local mode catalog policy = %v, want embedded catalogs", recorded.localCatalogs)
+	}
+}
+
+func TestCM053NoAntigravityEgressRemoteModel(t *testing.T) {
+	withLocalModePolicy(t, false)
+	var recorded recordedUpdaters
+	startBackgroundUpdaters(false, "/nonexistent/config.yaml", recorded.updaters())
+	if recorded.antigravity != 1 || recorded.managementAsset != 1 {
+		t.Fatalf("ordinary startup updaters: antigravity=%d management-asset=%d, want 1 and 1", recorded.antigravity, recorded.managementAsset)
+	}
+	if len(recorded.localCatalogs) != 1 || recorded.localCatalogs[0] {
+		t.Fatalf("ordinary startup catalog policy = %v, want remote-capable catalogs", recorded.localCatalogs)
+	}
+}
