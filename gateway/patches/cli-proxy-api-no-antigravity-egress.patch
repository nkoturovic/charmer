diff --git a/internal/localmode/localmode.go b/internal/localmode/localmode.go
new file mode 100644
index 00000000..28f3c9eb
--- /dev/null
+++ b/internal/localmode/localmode.go
@@ -0,0 +1,25 @@
+// Package localmode holds the process-wide local-mode no-egress policy.
+//
+// charmer local patch (no-antigravity-egress): --local-model sets the policy
+// once at startup, before any background updater starts, and every updater
+// starter reads it. Under it nothing refreshes from the network in the
+// background: the Antigravity version updater, the Grok CLI (npm) version
+// updater and the management asset updater do not start, the management
+// latest-version lookup answers without a request, and the model catalogs stay
+// embedded: an explicit remote catalog source is refused (never read); only an
+// absolute local catalog file may replace an embedded one.
+package localmode
+
+import "sync/atomic"
+
+var noEgress atomic.Bool
+
+// Set records the policy. cmd/server sets it once from --local-model.
+func Set(local bool) {
+	noEgress.Store(local)
+}
+
+// NoEgress reports whether background network refreshes are disabled.
+func NoEgress() bool {
+	return noEgress.Load()
+}
