@@ -0,0 +1,117 @@
+package cliproxy
+
+import (
+	"context"
+	"sort"
+	"sync"
+	"testing"
+	"time"
+
+	"github.com/router-for-me/CLIProxyAPI/v8/internal/config"
+	"github.com/router-for-me/CLIProxyAPI/v8/internal/localmode"
+	"github.com/router-for-me/CLIProxyAPI/v8/internal/registry"
+)
+
+// charmer local patch (no-antigravity-egress) gate: the SDK service path reads
+// the same local-mode no-egress policy. Under it the service does not start the
+// Grok CLI (npm) version updater, and its model catalog updaters read only the
+// embedded catalogs: with a non-nil config, with empty model sources and with
+// explicit remote sources (refused). The catalog readers are injected, so no
+// test reads the network.
+
+type catalogReads struct {
+	mu    sync.Mutex
+	reads map[string]string
+}
+
+func (r *catalogReads) fetch(_ context.Context, catalog, source string) ([]byte, error) {
+	r.mu.Lock()
+	defer r.mu.Unlock()
+	r.reads[catalog] = source
+	return nil, context.Canceled
+}
+
+func (r *catalogReads) wait(t *testing.T, want int) map[string]string {
+	t.Helper()
+	deadline := time.Now().Add(10 * time.Second)
+	for {
+		r.mu.Lock()
+		if len(r.reads) >= want {
+			out := make(map[string]string, len(r.reads))
+			for catalog, source := range r.reads {
+				out[catalog] = source
+			}
+			r.mu.Unlock()
+			return out
+		}
+		r.mu.Unlock()
+		if time.Now().After(deadline) {
+			t.Fatalf("catalog readers ran %d times, want %d", len(r.reads), want)
+		}
+		time.Sleep(time.Millisecond)
+	}
+}
+
+func runServiceCatalogUpdaters(t *testing.T, local bool, sources registry.CatalogSources) (int, map[string]string) {
+	t.Helper()
+	previousPolicy := localmode.NoEgress()
+	previousStarter := startXAIVersionUpdater
+	reads := &catalogReads{reads: map[string]string{}}
+	restoreFetchers := registry.ReplaceCatalogFetchers(reads.fetch)
+	ctx, cancel := context.WithCancel(context.Background())
+	t.Cleanup(func() {
+		cancel()
+		restoreFetchers()
+		localmode.Set(previousPolicy)
+		startXAIVersionUpdater = previousStarter
+	})
+	localmode.Set(local)
+	started := 0
+	startXAIVersionUpdater = func(context.Context, string) { started++ }
+	(&Service{cfg: &config.Config{Models: sources}}).startModelCatalogUpdaters(ctx)
+	return started, reads.wait(t, 3)
+}
+
+func catalogReadSources(reads map[string]string) []string {
+	out := make([]string, 0, len(reads))
+	for catalog, source := range reads {
+		out = append(out, catalog+"="+source)
+	}
+	sort.Strings(out)
+	return out
+}
+
+func TestLocalModeNoEgressSDKLocalModel(t *testing.T) {
+	remote := registry.CatalogSources{
+		Catalog:      "https://catalog.invalid/models.json",
+		CodexCatalog: "https://catalog.invalid/codex.json",
+		DevinCatalog: "http://catalog.invalid/devin.json",
+	}
+	for name, sources := range map[string]registry.CatalogSources{"empty sources": {}, "remote sources": remote} {
+		t.Run(name, func(t *testing.T) {
+			started, reads := runServiceCatalogUpdaters(t, true, sources)
+			if started != 0 {
+				t.Fatalf("local mode started the npm version updater %d times", started)
+			}
+			for catalog, source := range reads {
+				if source != "embed" {
+					t.Fatalf("local mode read %s from %q, want only the embedded catalog: %v", catalog, source, catalogReadSources(reads))
+				}
+			}
+		})
+	}
+}
+
+func TestLocalModeNoEgressSDKRemoteModel(t *testing.T) {
+	started, reads := runServiceCatalogUpdaters(t, false, registry.CatalogSources{})
+	if started != 1 {
+		t.Fatalf("ordinary service start ran the npm version updater %d times, want 1", started)
+	}
+	// Positive control: without the policy an empty source is the official
+	// remote default ("").
+	for catalog, source := range reads {
+		if source != "" {
+			t.Fatalf("ordinary service start read %s from %q, want the remote default: %v", catalog, source, catalogReadSources(reads))
+		}
+	}
+}
