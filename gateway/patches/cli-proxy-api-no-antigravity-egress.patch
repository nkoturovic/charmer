 }
 
+// refuseRemoteCatalogSources (charmer local patch, no-antigravity-egress)
+// drops every explicit remote (http or https) catalog source, so it falls back
+// to the embedded catalog; an absolute local file is kept. Validate admits only
+// those two forms besides the empty default.
+func refuseRemoteCatalogSources(sources CatalogSources) CatalogSources {
+	refuse := func(name, source string) string {
+		if source == "" || filepath.IsAbs(source) {
+			return source
+		}
+		log.Warnf("models.%s is a remote catalog source; refused in local mode (no egress), using the embedded catalog", name)
+		return ""
+	}
+	return CatalogSources{
+		Catalog:      refuse("catalog", sources.Catalog),
+		CodexCatalog: refuse("codex-catalog", sources.CodexCatalog),
+		DevinCatalog: refuse("devin-catalog", sources.DevinCatalog),
+	}
+}
+
+// ReplaceCatalogFetchers (charmer local patch, no-antigravity-egress) replaces
+// the readers of the three catalogs with fetch, which receives the catalog name
+// ("catalog", "codex-catalog", "devin-catalog") and the source it was asked to
+// read ("" is the official remote default, "embed" the embedded catalog). It
+// returns the function that restores the readers. Tests use it to observe which
+// sources a start, a reload or an on-demand refresh reads without reading any.
+func ReplaceCatalogFetchers(fetch func(ctx context.Context, catalog, source string) ([]byte, error)) (restore func()) {
+	updaters := []struct {
+		name    string
+		updater *catalogUpdater
+	}{{"catalog", generalCatalogUpdater}, {"codex-catalog", codexCatalogUpdater}, {"devin-catalog", devinCatalogUpdater}}
+	previous := make([]func(context.Context, string) ([]byte, string, error), len(updaters))
+	for index, entry := range updaters {
+		name := entry.name
+		entry.updater.mu.Lock()
+		previous[index] = entry.updater.fetchWithSource
+		entry.updater.fetchWithSource = func(ctx context.Context, source string) ([]byte, string, error) {
+			data, err := fetch(ctx, name, source)
+			return data, source, err
+		}
+		entry.updater.mu.Unlock()
+	}
+	return func() {
+		for index, entry := range updaters {
+			entry.updater.mu.Lock()
+			entry.updater.fetchWithSource = previous[index]
+			entry.updater.mu.Unlock()
+		}
+	}
+}
+
