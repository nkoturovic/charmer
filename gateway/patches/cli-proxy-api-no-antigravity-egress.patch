+package registry
+
+// charmer local patch (no-antigravity-egress) gate: under the local-mode
+// no-egress policy the catalog readers read only embedded catalogs, also through
+// the legacy StartModelsUpdater, a reload and an on-demand refresh, and an
+// explicit remote source is refused while an absolute local file is kept. The
+// readers are injected, so nothing is read.
+
+import (
+	"context"
+	"strings"
+	"sync"
+	"testing"
+	"time"
+
+	"github.com/router-for-me/CLIProxyAPI/v8/internal/localmode"
+)
+
+type fxCatalogReads struct {
+	mu    sync.Mutex
+	reads []string
+}
+
+func (r *fxCatalogReads) fetch(_ context.Context, catalog, source string) ([]byte, error) {
+	r.mu.Lock()
+	defer r.mu.Unlock()
+	r.reads = append(r.reads, catalog+"="+source)
+	return nil, context.Canceled
+}
+
+func (r *fxCatalogReads) waitFor(t *testing.T, want string) {
+	t.Helper()
+	deadline := time.Now().Add(10 * time.Second)
+	for {
+		r.mu.Lock()
+		for _, read := range r.reads {
+			if read == want {
+				r.mu.Unlock()
+				return
+			}
+		}
+		reads := append([]string(nil), r.reads...)
+		r.mu.Unlock()
+		if time.Now().After(deadline) {
+			t.Fatalf("no catalog read %q; reads: %v", want, reads)
+		}
+		time.Sleep(time.Millisecond)
+	}
+}
+
+func fxWithPolicy(t *testing.T, local bool) (*fxCatalogReads, context.Context) {
+	t.Helper()
+	previous := localmode.NoEgress()
+	reads := &fxCatalogReads{}
+	restore := ReplaceCatalogFetchers(reads.fetch)
+	ctx, cancel := context.WithCancel(context.Background())
+	t.Cleanup(func() {
+		cancel()
+		restore()
+		localmode.Set(previous)
+	})
+	localmode.Set(local)
+	return reads, ctx
+}
+
+func TestCM053LocalModeStartModelsUpdaterReadsEmbedded(t *testing.T) {
+	reads, ctx := fxWithPolicy(t, true)
+	StartModelsUpdater(ctx)
+	reads.waitFor(t, "catalog=embed")
+}
+
+func TestCM053LocalModeRefusesRemoteCatalogSources(t *testing.T) {
+	local := t.TempDir() + "/codex.json"
+	got := refuseRemoteCatalogSources(CatalogSources{
+		Catalog:      "https://catalog.invalid/models.json",
+		CodexCatalog: local,
+		DevinCatalog: "",
+	})
+	if got.Catalog != "" || got.CodexCatalog != local || got.DevinCatalog != "" {
+		t.Fatalf("refuseRemoteCatalogSources = %+v, want the remote source dropped and the local file kept", got)
+	}
+
+	reads, ctx := fxWithPolicy(t, true)
+	StartModelCatalogUpdaters(ctx, CatalogSources{}, false)
+	reads.waitFor(t, "catalog=embed")
+	// A reload that names a remote source keeps reading the embedded catalog;
+	// a local file replaces it.
+	UpdateModelCatalogSources(CatalogSources{Catalog: "https://catalog.invalid/models.json", CodexCatalog: local}, false)
+	reads.waitFor(t, "codex-catalog="+local)
+	reads.mu.Lock()
+	defer reads.mu.Unlock()
+	for _, read := range reads.reads {
+		if read == "catalog=https://catalog.invalid/models.json" {
+			t.Fatalf("local mode read a remote catalog source: %v", reads.reads)
+		}
+	}
+}
+
+func TestCM053LocalModeOnDemandRefreshRefusesRemoteSources(t *testing.T) {
+	reads, ctx := fxWithPolicy(t, true)
+	running, stop := context.WithCancel(ctx)
+	StartModelCatalogUpdaters(running, CatalogSources{}, false)
+	reads.waitFor(t, "catalog=embed")
+	// With the updaters stopped, an on-demand refresh falls back to the sources
+	// it is given; every remote one is refused and the embedded catalogs are
+	// skipped, so nothing is read.
+	stop()
+	remote := CatalogSources{
+		Catalog:      "https://catalog.invalid/models.json",
+		CodexCatalog: "https://catalog.invalid/codex.json",
+		DevinCatalog: "https://catalog.invalid/devin.json",
+	}
+	_, errRefresh := RefreshModelCatalogsWithPolicy(context.Background(), remote, false)
+	reads.mu.Lock()
+	defer reads.mu.Unlock()
+	for _, read := range reads.reads {
+		if strings.Contains(read, "=https://") {
+			t.Fatalf("local mode read a remote catalog source on demand: %v", reads.reads)
+		}
+	}
+	if errRefresh != nil {
+		t.Fatalf("on-demand refresh failed: %v", errRefresh)
+	}
+}
