@@ -0,0 +1,176 @@
+package executor
+
+import (
+	"bytes"
+	"context"
+	"fmt"
+	"io"
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/gin-gonic/gin"
+	"github.com/router-for-me/CLIProxyAPI/v8/internal/config"
+	"github.com/router-for-me/CLIProxyAPI/v8/internal/logging"
+	coreauth "github.com/router-for-me/CLIProxyAPI/v8/sdk/cliproxy/auth"
+	coreexecutor "github.com/router-for-me/CLIProxyAPI/v8/sdk/cliproxy/executor"
+	sdktranslator "github.com/router-for-me/CLIProxyAPI/v8/sdk/translator"
+)
+
+// Observe the real request-log sinks, not a shadow callback or the returned
+// error alone. FileBodySource appends bytes to actual temporary capture files.
+func codexCapturedRequest(t *testing.T, cfg *config.Config, auth *coreauth.Auth, mode string, fileBacked bool) ([]byte, []byte, error) {
+	t.Helper()
+	gin.SetMode(gin.TestMode)
+	ginCtx, _ := gin.CreateTestContext(httptest.NewRecorder())
+	ginCtx.Request = httptest.NewRequest(http.MethodPost, "/v1/responses", nil)
+	var source *logging.FileBodySource
+	if fileBacked {
+		var err error
+		source, err = logging.NewFileBodySourceInDir(t.TempDir(), "response-capture")
+		if err != nil {
+			t.Fatal(err)
+		}
+		t.Cleanup(func() {
+			if err := source.Cleanup(); err != nil {
+				t.Error(err)
+			}
+		})
+		ginCtx.Set(logging.APIResponseSourceContextKey, source)
+	}
+	ctx, cancel := context.WithTimeout(context.WithValue(context.Background(), "gin", ginCtx), 10*time.Second)
+	defer cancel()
+	cfg.RequestLog = true
+	cfg.CommercialMode = false
+	cfg.Codex.StreamBootstrapBuffering = mode == "buffered"
+	exec := NewCodexExecutor(cfg)
+	req := coreexecutor.Request{Model: "gpt-5.5", Payload: []byte(`{"model":"gpt-5.5","input":[{"role":"user","content":"fixture"}]}`)}
+	opts := coreexecutor.Options{SourceFormat: sdktranslator.FormatOpenAIResponse}
+	var payload []byte
+	var failure error
+	if mode == "execute" {
+		response, err := exec.Execute(ctx, auth, req, opts)
+		payload, failure = response.Payload, err
+	} else {
+		opts.Stream = true
+		response, err := exec.ExecuteStream(ctx, auth, req, opts)
+		failure = err
+		if response != nil {
+			for chunk := range response.Chunks {
+				payload = append(payload, chunk.Payload...)
+				if failure == nil && chunk.Err != nil {
+					failure = chunk.Err
+				}
+			}
+		}
+	}
+	var captured []byte
+	if source != nil {
+		var err error
+		captured, err = source.Bytes()
+		if err != nil {
+			t.Fatal(err)
+		}
+	} else {
+		value, ok := ginCtx.Get("API_RESPONSE")
+		if !ok {
+			t.Fatal("request logging produced no response capture")
+		}
+		captured, ok = value.([]byte)
+		if !ok {
+			t.Fatal("unexpected response capture type")
+		}
+	}
+	if len(captured) == 0 {
+		t.Fatal("response capture is empty")
+	}
+	return payload, captured, failure
+}
+
+func TestCodexKeyTerminalFailureCapture(t *testing.T) {
+	events := map[string]string{
+		"failed":   `{"type":"response.failed","response":{"id":"capture","error":{"code":"server_error","message":"failure for ` + codexKeyTestSecret + `"}}}`,
+		"error":    `{"type":"error","error":{"code":"invalid_api_key","type":"authentication_error","message":"bad key ` + codexKeyTestSecret + `"}}`,
+		"overload": `{"type":"error","error":{"code":"server_is_overloaded","type":"service_unavailable_error","message":"overload for ` + codexKeyTestSecret + `"}}`,
+	}
+	for eventName, event := range events {
+		for _, split := range []bool{false, true} {
+			wire := "data: " + event + "\n\n"
+			if split {
+				cut := strings.Index(event, ",") + 1
+				wire = "data: " + event[:cut] + "\ndata: " + event[cut:] + "\n\n"
+			}
+			server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+				_, _ = io.Copy(io.Discard, r.Body)
+				w.Header().Set("Content-Type", "text/event-stream")
+				_, _ = io.WriteString(w, "event: response.created\ndata: {\"type\":\"response.created\",\"response\":{\"id\":\"capture\"}}\n\n"+wire)
+			}))
+			for _, mode := range []string{"execute", "stream", "buffered"} {
+				for _, fileBacked := range []bool{false, true} {
+					for _, plain := range []bool{false, true} {
+						t.Run(fmt.Sprintf("%s/split=%t/%s/file=%t/plain=%t", eventName, split, mode, fileBacked, plain), func(t *testing.T) {
+							cfg := &config.Config{}
+							cfg.Codex.DisableCodexCloaking = plain
+							payload, captured, err := codexCapturedRequest(t, cfg, codexKeyTestAuth(server.URL, true), mode, fileBacked)
+							if err == nil {
+								t.Fatal("terminal failure was not returned")
+							}
+							for _, value := range [][]byte{captured, payload, []byte(err.Error())} {
+								if bytes.Contains(value, []byte(codexKeyTestSecret)) {
+									t.Fatal("credential-bearing terminal event escaped into capture or output")
+								}
+							}
+							if !bytes.Contains(captured, []byte(err.Error())) {
+								t.Fatal("capture does not contain the fixed local failure")
+							}
+						})
+					}
+				}
+			}
+			server.Close()
+		}
+	}
+}
+
+func TestCodexKeySuccessAndAccountCapture(t *testing.T) {
+	completed := "data: " + codexKeyTestCompleted() + "\n\n"
+	failure := "data: {\"type\":\"response.failed\",\"response\":{\"error\":{\"message\":\"" + codexKeyTestSecret + "\"}}}\n\n"
+	for _, success := range []bool{false, true} {
+		wire := failure
+		if success {
+			wire = completed
+		}
+		server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+			_, _ = io.Copy(io.Discard, r.Body)
+			w.Header().Set("Content-Type", "text/event-stream")
+			_, _ = io.WriteString(w, wire)
+		}))
+		for _, apiKey := range []bool{false, true} {
+			if !success && apiKey {
+				continue
+			}
+			for _, mode := range []string{"execute", "stream", "buffered"} {
+				for _, fileBacked := range []bool{false, true} {
+					t.Run(fmt.Sprintf("success=%t/key=%t/%s/file=%t", success, apiKey, mode, fileBacked), func(t *testing.T) {
+						payload, captured, err := codexCapturedRequest(t, &config.Config{}, codexKeyTestAuth(server.URL, apiKey), mode, fileBacked)
+						if success {
+							if err != nil {
+								t.Fatal(err)
+							}
+							if !bytes.Contains(payload, []byte("ok")) || !bytes.Contains(captured, []byte(codexKeyTestCompleted())) {
+								t.Fatal("successful response or its capture changed")
+							}
+						} else {
+							if err == nil || !strings.Contains(err.Error(), codexKeyTestSecret) || !bytes.Contains(captured, []byte(codexKeyTestSecret)) {
+								t.Fatal("account failure/capture positive control changed")
+							}
+						}
+					})
+				}
+			}
+		}
+		server.Close()
+	}
+}
