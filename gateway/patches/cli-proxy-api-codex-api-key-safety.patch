+	cliproxyexecutor "github.com/router-for-me/CLIProxyAPI/v8/sdk/cliproxy/executor"
+	sdktranslator "github.com/router-for-me/CLIProxyAPI/v8/sdk/translator"
+	"github.com/tidwall/gjson"
+)
+
+// A credential-shaped value made of words; the fake upstreams quote it back.
+const codexKeyTestSecret = "codex-key-fixture-value"
+
+// The HTTP paths of the codex executor: Execute, ExecuteStream and compact.
+var codexKeyTestModes = []string{"execute", "stream", "compact"}
+
+func codexKeyTestAuth(baseURL string, apiKey bool) *cliproxyauth.Auth {
+	auth := &cliproxyauth.Auth{ID: "codex-key-test", Provider: "codex", Attributes: map[string]string{"base_url": baseURL}}
+	if apiKey {
+		auth.Attributes["api_key"] = codexKeyTestSecret
+	} else {
+		auth.Metadata = map[string]any{"access_token": codexKeyTestSecret, "account_id": "codex-key-test-account"}
+	}
+	return auth
+}
+
+// codexKeyTestRun sends one request in mode and returns its failure: the
+// returned error, or the first error chunk of a stream.
+func codexKeyTestRun(t *testing.T, cfg *config.Config, auth *cliproxyauth.Auth, mode string, inbound http.Header) error {
+	t.Helper()
+	payload := `{"model":"gpt-5.5","input":[{"role":"user","content":"fixture"}],"prompt_cache_key":"codex-key-test-cache"}`
+	req := cliproxyexecutor.Request{Model: "gpt-5.5", Payload: []byte(payload)}
+	opts := cliproxyexecutor.Options{SourceFormat: sdktranslator.FormatOpenAIResponse, Headers: inbound}
+	ctx, cancel := context.WithTimeout(context.Background(), 10*time.Second)
+	defer cancel()
+	executor := NewCodexExecutor(cfg)
+	switch mode {
+	case "stream":
+		opts.Stream = true
+		result, err := executor.ExecuteStream(ctx, auth, req, opts)
+		if err != nil {
+			return err
+		}
+		var failure error
+		for chunk := range result.Chunks {
+			if chunk.Err != nil && failure == nil {
+				failure = chunk.Err
+			}
+		}
+		return failure
+	case "compact":
+		opts.Alt = "responses/compact"
+	}
+	_, err := executor.Execute(ctx, auth, req, opts)
+	return err
+}
+
+func codexKeyTestStatus(t *testing.T, err error) int {
+	t.Helper()
+	var coded interface{ StatusCode() int }
+	if !errors.As(err, &coded) {
+		t.Fatalf("failure %T carries no status", err)
+	}
+	return coded.StatusCode()
+}
+
+func codexKeyTestCompleted() string {
+	return `{"type":"response.completed","response":{"id":"resp_key","model":"gpt-5.5","status":"completed","output":[{"type":"message","role":"assistant","content":[{"type":"output_text","text":"ok"}]}],"usage":{"input_tokens":1,"output_tokens":1,"total_tokens":2}}}`
+}
+
+// A non-2xx response that quotes the key becomes the fixed text of its kind;
+// the status, the retry delay (the usage-limit reset, or Retry-After for a
+// transient capacity rejection), the credential scope and the transient
+// capacity mark survive.
+func TestCodexKeyStatusFailureIsLocal(t *testing.T) {
+	retry := 300 * time.Second
+	turnRetry := 120 * time.Second
+	cases := []struct {
+		name        string
+		status      int
+		body        string
+		kind        compatsafe.Kind
+		want        int
+		retry       *time.Duration
+		scoped      bool
+		jsonBody    bool
+		retryHeader string
+		transient   bool
+	}{
+		{name: "turn-rate", status: http.StatusTooManyRequests, jsonBody: true, kind: compatsafe.KindRateLimited, want: http.StatusTooManyRequests,
+			retry: &turnRetry, retryHeader: "120", transient: true,
+			body: `{"error":{"type":"rate_limit_error","code":"turn_rate_limit_exceeded","message":"turn limit for ` + codexKeyTestSecret + `"}}`},
+		{name: "credential", status: http.StatusUnauthorized, jsonBody: true, kind: compatsafe.KindAuthentication, want: http.StatusUnauthorized,
+			body: `{"error":{"message":"Incorrect API key provided: ` + codexKeyTestSecret + `","type":"invalid_request_error","code":"invalid_api_key"}}`},
+		{name: "context", status: http.StatusBadRequest, jsonBody: true, kind: compatsafe.KindContextLength, want: http.StatusBadRequest,
+			body: `{"error":{"message":"request for ` + codexKeyTestSecret + ` exceeds the context window","type":"invalid_request_error","code":"context_length_exceeded"}}`},
+		{name: "usage-limit", status: http.StatusTooManyRequests, jsonBody: true, kind: compatsafe.KindRateLimited, want: http.StatusTooManyRequests,
+			retry: &retry, scoped: true,
+			body: `{"error":{"type":"usage_limit_reached","message":"limit for ` + codexKeyTestSecret + `","resets_in_seconds":300}}`},
+		{name: "server", status: http.StatusInternalServerError, kind: compatsafe.KindServerError, want: http.StatusInternalServerError,
+			body: "upstream failed for " + codexKeyTestSecret},
+		{name: "oversized", status: http.StatusBadRequest, kind: compatsafe.KindErrorBodyTooLarge, want: http.StatusBadRequest,
+			body: strings.Repeat("x", 2*compatsafe.MaxErrorBody) + codexKeyTestSecret},
+	}
+	for _, tc := range cases {
+		server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+			_, _ = io.Copy(io.Discard, r.Body)
+			if tc.jsonBody {
+				w.Header().Set("Content-Type", "application/json")
+			}
+			if tc.retryHeader != "" {
+				w.Header().Set("Retry-After", tc.retryHeader)
+			}
+			w.WriteHeader(tc.status)
+			_, _ = io.WriteString(w, tc.body)
+		}))
+		for _, mode := range codexKeyTestModes {
+			t.Run(tc.name+"/"+mode, func(t *testing.T) {
+				err := codexKeyTestRun(t, &config.Config{}, codexKeyTestAuth(server.URL, true), mode, nil)
+				if err == nil {
+					t.Fatal("no failure")
+				}
+				if err.Error() != tc.kind.Body() {
+					t.Fatalf("failure text = %q, want the fixed text of %s", err.Error(), tc.kind)
+				}
+				if got := codexKeyTestStatus(t, err); got != tc.want {
+					t.Fatalf("status = %d, want %d", got, tc.want)
+				}
+				var failure statusErr
+				if !errors.As(err, &failure) {
+					t.Fatalf("failure %T is not a classified status", err)
+				}
+				if (failure.RetryAfter() == nil) != (tc.retry == nil) || (tc.retry != nil && *failure.RetryAfter() != *tc.retry) {
+					t.Fatalf("retry delay = %v, want %v", failure.RetryAfter(), tc.retry)
+				}
+				if failure.IsCredentialScoped() != tc.scoped {
+					t.Fatalf("credential scope = %t, want %t", failure.IsCredentialScoped(), tc.scoped)
+				}
+				if failure.IsTransientRateLimit() != tc.transient {
+					t.Fatalf("transient capacity = %t, want %t", failure.IsTransientRateLimit(), tc.transient)
+				}
+			})
+		}
+		// A ChatGPT account keeps the upstream text (and reads the whole body).
+		t.Run(tc.name+"/account", func(t *testing.T) {
+			err := codexKeyTestRun(t, &config.Config{}, codexKeyTestAuth(server.URL, false), "execute", nil)
+			if err == nil || !strings.Contains(err.Error(), codexKeyTestSecret) {
+				t.Fatalf("account failure changed: %v", err)
+			}
+		})
+		server.Close()
+	}
+}
+
+// A terminal stream event that quotes the key becomes the fixed text of its
+// kind, in the non-stream body, the stream and the buffered stream bootstrap
+// (including the overload rejection a bootstrap fails over with).
+func TestCodexKeyTerminalFailureIsLocal(t *testing.T) {
+	cases := []struct {
+		name  string
+		event string
+		kind  compatsafe.Kind
+		want  int
+	}{
+		{name: "failed", kind: compatsafe.KindServerError, want: http.StatusBadGateway,
+			event: `{"type":"response.failed","response":{"id":"resp_key","status":"failed","error":{"code":"server_error","message":"request with ` + codexKeyTestSecret + ` failed"}}}`},
+		{name: "context", kind: compatsafe.KindContextLength, want: http.StatusBadRequest,
+			event: `{"type":"error","error":{"type":"invalid_request_error","code":"context_length_exceeded","message":"input of ` + codexKeyTestSecret + ` exceeds the context window"}}`},
+		{name: "credential", kind: compatsafe.KindAuthentication, want: http.StatusUnauthorized,
+			event: `{"type":"response.failed","response":{"error":{"type":"authentication_error","code":"invalid_api_key","message":"bad key ` + codexKeyTestSecret + `"}}}`},
+		{name: "overload", kind: compatsafe.KindServerError, want: http.StatusBadGateway,
+			event: `{"type":"error","error":{"type":"service_unavailable_error","code":"server_is_overloaded","message":"overloaded for ` + codexKeyTestSecret + `"}}`},
+	}
+	for _, tc := range cases {
+		server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+			_, _ = io.Copy(io.Discard, r.Body)
+			w.Header().Set("Content-Type", "text/event-stream")
+			_, _ = fmt.Fprintf(w, "event: response.created\ndata: {\"type\":\"response.created\",\"response\":{\"id\":\"resp_key\"}}\n\n")
+			_, _ = fmt.Fprintf(w, "data: %s\n\n", tc.event)
+		}))
+		for _, mode := range []string{"execute", "stream", "buffered"} {
+			t.Run(tc.name+"/"+mode, func(t *testing.T) {
+				cfg := &config.Config{}
+				run, want := mode, tc.want
+				if mode == "buffered" {
+					cfg.Codex.StreamBootstrapBuffering = true
+					run = "stream"
+					if tc.name == "overload" {
+						want = http.StatusServiceUnavailable // the bootstrap fails over with 503
+					}
+				}
+				err := codexKeyTestRun(t, cfg, codexKeyTestAuth(server.URL, true), run, nil)
+				if err == nil {
+					t.Fatal("no failure")
+				}
+				if err.Error() != tc.kind.Body() {
+					t.Fatalf("failure text = %q, want the fixed text of %s", err.Error(), tc.kind)
+				}
+				if got := codexKeyTestStatus(t, err); got != want {
+					t.Fatalf("status = %d, want %d", got, want)
+				}
+			})
+		}
+		t.Run(tc.name+"/account", func(t *testing.T) {
+			cfg := &config.Config{}
+			cfg.Codex.StreamBootstrapBuffering = true
+			err := codexKeyTestRun(t, cfg, codexKeyTestAuth(server.URL, false), "stream", nil)
+			if err == nil || !strings.Contains(err.Error(), codexKeyTestSecret) {
+				t.Fatalf("account failure changed: %v", err)
+			}
+		})
+		server.Close()
+	}
+}
+
+// A transport failure keeps only its trusted identity: the request URL (here
+// carrying a marker in its path) never reaches the failure text.
+func TestCodexKeyTransportErrorIsLocal(t *testing.T) {
+	const marker = "transport-marker-path"
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		hijacker, ok := w.(http.Hijacker)
+		if !ok {
+			t.Error("no hijacker")
+			return
+		}
+		conn, _, err := hijacker.Hijack()
+		if err == nil {
+			_ = conn.Close()
+		}
+	}))
+	defer server.Close()
+	base := server.URL + "/" + marker
+	for _, mode := range codexKeyTestModes {
+		t.Run(mode, func(t *testing.T) {
+			err := codexKeyTestRun(t, &config.Config{}, codexKeyTestAuth(base, true), mode, nil)
+			if err == nil {
+				t.Fatal("no failure")
+			}
+			if strings.Contains(err.Error(), marker) {
+				t.Fatalf("transport failure kept the request URL: %q", err.Error())
+			}
+			var transport compatsafe.TransportError
+			if !errors.As(err, &transport) && !errors.Is(err, io.EOF) && !errors.Is(err, io.ErrUnexpectedEOF) {
+				t.Fatalf("failure %T is not a trusted transport identity", err)
+			}
+		})
+	}
+	t.Run("account", func(t *testing.T) {
+		err := codexKeyTestRun(t, &config.Config{}, codexKeyTestAuth(base, false), "execute", nil)
+		if err == nil || !strings.Contains(err.Error(), marker) {
+			t.Fatalf("account failure changed: %v", err)
+		}
+	})
+}
+
+// A response the shared decoder cannot open (a gzip label on a plain body) is a
+// helper failure on the request path: for an API key it keeps only the trusted
+// transport identity, while an account keeps the decoder's own text.
+func TestCodexKeyDecoderFailureIsLocal(t *testing.T) {
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		_, _ = io.Copy(io.Discard, r.Body)
+		w.Header().Set("Content-Type", "text/event-stream")
+		w.Header().Set("Content-Encoding", "gzip")
+		_, _ = io.WriteString(w, "not a gzip stream for "+codexKeyTestSecret)
+	}))
+	defer server.Close()
+	for _, mode := range codexKeyTestModes {
+		t.Run(mode, func(t *testing.T) {
+			err := codexKeyTestRun(t, &config.Config{}, codexKeyTestAuth(server.URL, true), mode, nil)
+			if err == nil {
+				t.Fatal("no failure")
+			}
+			if strings.Contains(err.Error(), "decode upstream response") || strings.Contains(err.Error(), codexKeyTestSecret) {
+				t.Fatalf("decoder failure kept its text: %q", err.Error())
+			}
+			var transport compatsafe.TransportError
+			if !errors.As(err, &transport) {
+				t.Fatalf("failure %T (%q) is not a trusted transport identity", err, err.Error())
+			}
+		})
+	}
+	t.Run("account", func(t *testing.T) {
+		err := codexKeyTestRun(t, &config.Config{}, codexKeyTestAuth(server.URL, false), "execute", nil)
+		if err == nil || !strings.Contains(err.Error(), "decode upstream response") {
+			t.Fatalf("account failure changed: %v", err)
+		}
+	})
+}
+
+// A compressed non-2xx body is decoded before the bounded read: the key it
+// quotes never reaches the failure text, which is the fixed envelope of its kind.
+func TestCodexKeyCompressedFailureBodyIsLocal(t *testing.T) {
+	body := `{"error":{"message":"Incorrect API key provided: ` + codexKeyTestSecret + `","type":"invalid_request_error","code":"invalid_api_key"}}`
+	var compressed bytes.Buffer
+	writer := gzip.NewWriter(&compressed)
+	_, _ = writer.Write([]byte(body))
+	_ = writer.Close()
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		_, _ = io.Copy(io.Discard, r.Body)
+		w.Header().Set("Content-Type", "application/json")
+		w.Header().Set("Content-Encoding", "gzip")
+		w.WriteHeader(http.StatusUnauthorized)
+		_, _ = w.Write(compressed.Bytes())
+	}))
+	defer server.Close()
+	for _, mode := range codexKeyTestModes {
+		t.Run(mode, func(t *testing.T) {
+			err := codexKeyTestRun(t, &config.Config{}, codexKeyTestAuth(server.URL, true), mode, nil)
+			if err == nil {
+				t.Fatal("no failure")
+			}
+			if got := codexKeyTestStatus(t, err); got != http.StatusUnauthorized {
+				t.Fatalf("status = %d, want 401", got)
+			}
+			if err.Error() != compatsafe.KindAuthentication.Body() {
+				t.Fatalf("failure text = %q, want the fixed authentication envelope", err.Error())
+			}
+		})
+	}
+}
+
+type codexKeyTestReader struct {
+	remaining int
+	read      int
+	fail      bool
+}
+
+func (r *codexKeyTestReader) Read(p []byte) (int, error) {
+	if r.fail {
+		return 0, errors.New("read failed for " + codexKeyTestSecret)
+	}
+	if r.remaining == 0 {
+		return 0, io.EOF
+	}
+	n := min(len(p), r.remaining)
+	for i := range p[:n] {
+		p[i] = 'x'
+	}
+	r.remaining -= n
+	r.read += n
+	return n, nil
+}
+
+// A failure body is read through the bound: never more than one byte past
+// compatsafe.MaxErrorBody, and an unreadable body has its own fixed kind.
+func TestCodexKeyErrorBodyReadIsBounded(t *testing.T) {
+	for _, tc := range []struct {
+		name   string
+		status int
+		reader *codexKeyTestReader
+		kind   compatsafe.Kind
+	}{
+		{name: "oversized", status: http.StatusBadRequest, reader: &codexKeyTestReader{remaining: 4 << 20}, kind: compatsafe.KindErrorBodyTooLarge},
+		{name: "oversized-rate-limit", status: http.StatusTooManyRequests, reader: &codexKeyTestReader{remaining: 4 << 20}, kind: compatsafe.KindRateLimited},
+		{name: "unreadable", status: http.StatusBadGateway, reader: &codexKeyTestReader{fail: true}, kind: compatsafe.KindErrorBodyUnreadable},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			resp := &http.Response{StatusCode: tc.status, Header: http.Header{}, Body: io.NopCloser(tc.reader)}
+			failure, examined := codexKeyHTTPFailure(context.Background(), &config.Config{}, resp, false)
+			if tc.reader.read > compatsafe.MaxErrorBody+1 {
+				t.Fatalf("read %d bytes, bound is %d", tc.reader.read, compatsafe.MaxErrorBody+1)
+			}
+			if examined != nil {
+				t.Fatal("an unbounded or unreadable body was handed on")
+			}
+			if failure.Error() != tc.kind.Body() || failure.StatusCode() != tc.status {
+				t.Fatalf("failure = %d %q, want %d %s", failure.StatusCode(), failure.Error(), tc.status, tc.kind)
+			}
+		})
+	}
+}
+
+// codexKeyTestHeaders returns the final upstream request headers and body of
+// one successful request in mode.
+func codexKeyTestHeaders(t *testing.T, cfg *config.Config, auth *cliproxyauth.Auth, mode string, inbound http.Header) (http.Header, []byte) {
+	t.Helper()
+	type capture struct {
+		header http.Header
+		body   []byte
+	}
+	captured := make(chan capture, 1)
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		body, _ := io.ReadAll(r.Body)
+		captured <- capture{r.Header.Clone(), body}
+		if mode == "compact" {
+			w.Header().Set("Content-Type", "application/json")
+			_, _ = io.WriteString(w, `{"id":"resp_key","object":"response.compaction","output":[]}`)
+			return
+		}
+		w.Header().Set("Content-Type", "text/event-stream")
+		_, _ = fmt.Fprintf(w, "data: %s\n\n", codexKeyTestCompleted())
+	}))
+	defer server.Close()
+	auth.Attributes["base_url"] = server.URL
+	if err := codexKeyTestRun(t, cfg, auth, mode, inbound); err != nil {
+		t.Fatalf("%s request: %v", mode, err)
+	}
+	select {
+	case got := <-captured:
+		return got.header, got.body
+	default:
+		t.Fatal("no upstream request")
+		return nil, nil
+	}
+}
+
+// An API key with codex cloaking disabled is a plain API client: no default
+// codex Version and no session header, whatever set it; the prompt cache key
+// stays in the body and a client's own Version passes through. Cloaked API
+// keys and ChatGPT accounts keep the codex client identity.
+func TestCodexPlainKeyIdentity(t *testing.T) {
+	uncloaked := &config.Config{}
+	uncloaked.Codex.DisableCodexCloaking = true
+	sessionFromClient := http.Header{"Session-Id": {"client-session"}}
+	for _, mode := range codexKeyTestModes {
+		t.Run(mode+"/plain", func(t *testing.T) {
+			for name, auth := range map[string]*cliproxyauth.Auth{
+				"config":    codexKeyTestAuth("", true),
+				"attribute": codexKeyTestAuth("", true),
+			} {
+				cfg := uncloaked
+				if name == "attribute" {
+					cfg = &config.Config{}
+					auth.Attributes[cliproxyauth.AttributeCodexDisableCloaking] = "true"
+				}
+				header, body := codexKeyTestHeaders(t, cfg, auth, mode, sessionFromClient)
+				for _, key := range []string{"Version", "Session-Id", "Session_id", "Originator", "Chatgpt-Account-Id"} {
+					if _, present := header[http.CanonicalHeaderKey(key)]; present || header.Get(key) != "" {
+						t.Fatalf("%s: plain key sent %s", name, key)
+					}
+				}
+				if got := gjson.GetBytes(body, "prompt_cache_key").String(); got != "codex-key-test-cache" {
+					t.Fatalf("%s: prompt cache key = %q", name, got)
+				}
+			}
+			header, _ := codexKeyTestHeaders(t, uncloaked, codexKeyTestAuth("", true), mode, http.Header{"Version": {"0.200.0"}})
+			if got := header.Get("Version"); got != "0.200.0" {
+				t.Fatalf("client Version = %q, want it passed through", got)
+			}
+		})
+		t.Run(mode+"/codex-identity", func(t *testing.T) {
+			for name, tc := range map[string]struct {
+				cfg  *config.Config
+				auth *cliproxyauth.Auth
+			}{
+				"cloaked-key":       {&config.Config{}, codexKeyTestAuth("", true)},
+				"account":           {&config.Config{}, codexKeyTestAuth("", false)},
+				"uncloaked-account": {uncloaked, codexKeyTestAuth("", false)},
+			} {
+				header, _ := codexKeyTestHeaders(t, tc.cfg, tc.auth, mode, nil)
+				if got := header.Get("Version"); got != codexClientVersion {
+					t.Fatalf("%s: Version = %q, want %q", name, got, codexClientVersion)
+				}
+				if got := header.Get("Session-Id"); got != "codex-key-test-cache" {
+					t.Fatalf("%s: Session-Id = %q", name, got)
+				}
+			}
+		})
+	}
+	// The websocket header builder applies the same Version default.
+	plain := codexKeyTestAuth("", true)
+	if got := applyCodexWebsocketHeaders(context.Background(), nil, plain, codexKeyTestSecret, uncloaked, false).Get("Version"); got != "" {
+		t.Fatalf("websocket plain key Version = %q", got)
+	}
+	account := codexKeyTestAuth("", false)
+	if got := applyCodexWebsocketHeaders(context.Background(), nil, account, codexKeyTestSecret, uncloaked, false).Get("Version"); got != codexClientVersion {
+		t.Fatalf("websocket account Version = %q", got)
+	}
+}
