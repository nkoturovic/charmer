+++ b/sdk/cliproxy/auth/log_identity.go
@@ -0,0 +1,18 @@
+package auth
+
+import "strings"
+
+// LogIndex returns the credential index a log line may show: the stable
+// index of an account or credential file, or "nil" for an API key, whose
+// index, like its ID, is a hash over the key. Neither an account's e-mail
+// address nor its credential file name (which usually carries the address)
+// belongs in a log line.
+func (a *Auth) LogIndex() string {
+	if a == nil || a.AuthKind() == AuthKindAPIKey {
+		return "nil"
+	}
+	if index := strings.TrimSpace(a.Index); index != "" {
+		return index
+	}
+	return "nil"
+}
