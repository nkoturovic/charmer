@@ -0,0 +1,238 @@
+package auth
+
+import (
+	"bytes"
+	"context"
+	"errors"
+	"net/http"
+	"strings"
+	"sync"
+	"testing"
+	"time"
+
+	"github.com/router-for-me/CLIProxyAPI/v8/internal/registry"
+	"github.com/router-for-me/CLIProxyAPI/v8/internal/util"
+	cliproxyexecutor "github.com/router-for-me/CLIProxyAPI/v8/sdk/cliproxy/executor"
+	log "github.com/sirupsen/logrus"
+)
+
+const (
+	logIdentityEmail = "fixture.user@example.invalid"
+	logIdentityFile  = "codex-fixture.user@example.invalid-plus.json"
+	logIdentityKey   = "sk-fixture-key-0123456789abcdef"
+)
+
+// logIdentityAccount is a credential-file account; its index is derived from
+// its file, as at registration.
+func logIdentityAccount() *Auth {
+	return &Auth{ID: logIdentityFile, Provider: "codex", FileName: "/auths/" + logIdentityFile, Status: StatusActive,
+		Attributes: map[string]string{"path": "/auths/" + logIdentityFile},
+		Metadata:   map[string]any{"type": "codex", "email": logIdentityEmail, "access_token": "fixture-access-token"}}
+}
+
+// logIdentityKeyAuth is a configured API key; like its ID, its index is a hash
+// over the key.
+func logIdentityKeyAuth() *Auth {
+	return &Auth{ID: "codex:apikey:fixture-key-id", Provider: "codex", Status: StatusActive,
+		Attributes: map[string]string{"api_key": logIdentityKey, "base_url": "https://codex.example.invalid/v1", "source": "config:codex[fixture]"}}
+}
+
+// captureLogs records every log line at every level, as the gateway's log
+// file would with debug enabled.
+func captureLogs(t *testing.T) *bytes.Buffer {
+	t.Helper()
+	var out bytes.Buffer
+	logger := log.StandardLogger()
+	previousOut, previousLevel, previousFormatter := logger.Out, logger.GetLevel(), logger.Formatter
+	logger.SetOutput(&out)
+	logger.SetLevel(log.DebugLevel)
+	logger.SetFormatter(&log.TextFormatter{DisableTimestamp: true, DisableColors: true})
+	t.Cleanup(func() {
+		logger.SetOutput(previousOut)
+		logger.SetLevel(previousLevel)
+		logger.SetFormatter(previousFormatter)
+	})
+	return &out
+}
+
+// assertNoCredentialIdentity fails when logs name an account's e-mail address
+// or credential file, or carry any part of a key or a key-derived identifier.
+func assertNoCredentialIdentity(t *testing.T, logs string) {
+	t.Helper()
+	keyIndex := logIdentityKeyAuth().EnsureIndex()
+	for _, leak := range []string{logIdentityEmail, "fixture.user", logIdentityKey, util.HideAPIKey(logIdentityKey),
+		"codex:apikey:fixture-key-id", keyIndex, "fixture-access-token"} {
+		if strings.Contains(logs, leak) {
+			t.Fatalf("logs carry %q:\n%s", leak, logs)
+		}
+	}
+}
+
+// Each selection logs one info line that keeps its provider and model and
+// names no credential, for an account and for an API key.
+func TestSessionAffinityLinesNameNoCredential(t *testing.T) {
+	logs := captureLogs(t)
+	selector := NewSessionAffinitySelector(&FillFirstSelector{})
+	defer selector.Stop()
+	payload := []byte(`{"metadata":{"user_id":"user_xxx_account__session_ac980658-63bd-4fb3-97ba-8da64cb1e344"}}`)
+	opts := cliproxyexecutor.Options{OriginalRequest: payload}
+	picks := 0
+	for _, auths := range [][]*Auth{{logIdentityAccount()}, {logIdentityKeyAuth()}} {
+		for i := 0; i < 2; i++ {
+			if _, err := selector.Pick(context.Background(), "codex", "gpt-5.5", opts, auths); err != nil {
+				t.Fatalf("Pick: %v", err)
+			}
+			picks++
+		}
+	}
+	var routing []string
+	for _, line := range strings.Split(strings.TrimSpace(logs.String()), "\n") {
+		if strings.Contains(line, "session-affinity:") && strings.HasPrefix(line, "level=info") {
+			routing = append(routing, line)
+		}
+	}
+	if len(routing) != picks {
+		t.Fatalf("routing info lines = %d, want one per selection (%d):\n%s", len(routing), picks, logs)
+	}
+	for _, line := range routing {
+		if !strings.Contains(line, "provider=codex model=gpt-5.5") || strings.Contains(line, "auth=") {
+			t.Fatalf("routing line = %s", line)
+		}
+	}
+	assertNoCredentialIdentity(t, logs.String())
+}
+
+// A guardian review that inherits its parent thread's credential logs its
+// routing line without naming that credential.
+func TestGuardianRoutingLineNamesNoCredential(t *testing.T) {
+	logs := captureLogs(t)
+	enabled := true
+	selector := NewSessionAffinitySelectorWithConfig(SessionAffinityConfig{
+		Fallback: &FillFirstSelector{}, TTL: time.Minute, SubagentAffinity: &enabled,
+	})
+	defer selector.Stop()
+	account, other := logIdentityAccount(), &Auth{ID: "fixture-other", Provider: "codex", Status: StatusActive}
+	parent := cliproxyexecutor.Options{Headers: http.Header{"Session_id": []string{"main-thread"}}, Metadata: map[string]any{}}
+	if picked, err := selector.Pick(context.Background(), "codex", "gpt-5.5", parent, []*Auth{account}); err != nil || picked.ID != account.ID {
+		t.Fatalf("parent Pick = %v, %v", picked, err)
+	}
+	review := cliproxyexecutor.Options{Headers: http.Header{
+		"Session_id": []string{"review-thread"}, "X-Codex-Parent-Thread-Id": []string{"main-thread"},
+		"X-Openai-Subagent": []string{"guardian"},
+	}, Metadata: map[string]any{}}
+	if picked, err := selector.Pick(context.Background(), "codex", "codex-auto-review", review, []*Auth{other, account}); err != nil || picked.ID != account.ID {
+		t.Fatalf("guardian Pick = %v, %v", picked, err)
+	}
+	var guardian []string
+	for _, line := range strings.Split(strings.TrimSpace(logs.String()), "\n") {
+		if strings.Contains(line, "session-affinity: guardian inherited parent binding") {
+			guardian = append(guardian, line)
+		}
+	}
+	if len(guardian) != 1 || !strings.HasPrefix(guardian[0], "level=info") ||
+		!strings.Contains(guardian[0], "provider=codex model=codex-auto-review") || strings.Contains(guardian[0], "auth=") {
+		t.Fatalf("guardian routing lines = %q\n%s", guardian, logs)
+	}
+	assertNoCredentialIdentity(t, logs.String())
+}
+
+type logIdentityStore struct {
+	mu    sync.Mutex
+	saves int
+}
+
+func (s *logIdentityStore) List(context.Context) ([]*Auth, error) { return nil, nil }
+
+func (s *logIdentityStore) Save(_ context.Context, auth *Auth) (string, error) {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	s.saves++
+	return auth.ID, nil
+}
+
+func (s *logIdentityStore) Delete(context.Context, string) error { return nil }
+
+// Control: a configured key is never persisted, so no credential receipt
+// carries its key-derived index while it serves requests.
+func TestConfigKeyWritesNoCredentialReceipt(t *testing.T) {
+	logs := captureLogs(t)
+	store := &logIdentityStore{}
+	manager := NewManager(store, nil, nil)
+	manager.RegisterExecutor(&mockCustomErrorExecutor{identifier: "codex"})
+	key := logIdentityKeyAuth()
+	registry.GetGlobalRegistry().RegisterClient(key.ID, "codex", []*registry.ModelInfo{{ID: "gpt-5.5"}})
+	t.Cleanup(func() { registry.GetGlobalRegistry().UnregisterClient(key.ID) })
+	if _, err := manager.Register(context.Background(), key); err != nil {
+		t.Fatalf("Register: %v", err)
+	}
+	if strings.Contains(logs.String(), "credential_save_v1") {
+		t.Fatalf("registering a configured key wrote a receipt:\n%s", logs)
+	}
+	// Registration's own diagnostics are outside the request path checked below.
+	logs.Reset()
+	for i := 0; i < 3; i++ {
+		if _, err := manager.Execute(context.Background(), []string{"codex"}, cliproxyexecutor.Request{Model: "gpt-5.5"}, cliproxyexecutor.Options{}); err != nil {
+			t.Fatalf("Execute: %v", err)
+		}
+	}
+	store.mu.Lock()
+	saves := store.saves
+	store.mu.Unlock()
+	if saves != 0 || strings.Contains(logs.String(), "credential_save_v1") {
+		t.Fatalf("configured key persisted %d time(s):\n%s", saves, logs)
+	}
+	assertNoCredentialIdentity(t, logs.String())
+}
+
+// The selected credential and execution failures name an account by provider
+// and credential index and an API key by fixed redaction, at debug and warning
+// level alike.
+func TestCredentialIdentityNamesNoAccountOrKey(t *testing.T) {
+	account, key := logIdentityAccount(), logIdentityKeyAuth()
+	account.EnsureIndex()
+	key.EnsureIndex()
+	other := &Auth{ID: "fixture-other.user@example.invalid.json", FileName: "/auths/fixture-other.user@example.invalid.json", Provider: "vertex"}
+	other.EnsureIndex()
+	cases := []struct {
+		auth *Auth
+		want string
+	}{
+		{account, "provider=codex auth_index=" + account.Index},
+		{key, "api_key=[redacted]"},
+		{other, "auth_index=" + other.Index},
+	}
+	for _, tc := range cases {
+		if got := formatAuthIdentity(tc.auth, tc.auth.Provider); got != tc.want {
+			t.Fatalf("formatAuthIdentity(%s) = %q, want %q", tc.auth.Provider, got, tc.want)
+		}
+	}
+	if account.Index == "" || account.Index == key.Index {
+		t.Fatalf("fixture indexes = %q, %q", account.Index, key.Index)
+	}
+
+	logs := captureLogs(t)
+	entry := log.NewEntry(log.StandardLogger())
+	failure := statusErrorLogTestError{message: "upstream unavailable", statusCode: http.StatusServiceUnavailable}
+	for _, auth := range []*Auth{account, key, other} {
+		debugLogAuthSelection(entry, auth, auth.Provider, "gpt-5.5")
+		warnLogUpstreamFailure(context.Background(), entry, auth.Provider, "gpt-5.5", auth, time.Second, failure)
+		warnLogUpstreamFailure(context.Background(), entry, auth.Provider, "gpt-5.5", auth, time.Second, errors.New("transport closed"))
+		warnLogHomeCredentialFailure(context.Background(), "refresh", auth.Provider, auth, failure)
+	}
+	text := logs.String()
+	for _, want := range []string{
+		"Use OAuth provider=codex auth_index=" + account.Index + " for model gpt-5.5",
+		"Use API key [redacted] for model gpt-5.5",
+		"upstream execution failed: provider=codex model=gpt-5.5 auth=provider=codex auth_index=" + account.Index,
+		"upstream execution failed: provider=codex model=gpt-5.5 auth=api_key=[redacted]",
+		"upstream execution failed: provider=vertex model=gpt-5.5 auth=auth_index=" + other.Index,
+	} {
+		if !strings.Contains(text, want) {
+			t.Fatalf("logs lack %q:\n%s", want, text)
+		}
+	}
+	assertNoCredentialIdentity(t, text)
+	if strings.Contains(text, "fixture-other") {
+		t.Fatalf("logs carry a credential file name:\n%s", text)
+	}
+}
