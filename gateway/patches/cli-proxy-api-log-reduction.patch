+	"github.com/router-for-me/CLIProxyAPI/v8/internal/util"
+	cliproxyauth "github.com/router-for-me/CLIProxyAPI/v8/sdk/cliproxy/auth"
+	cliproxyexecutor "github.com/router-for-me/CLIProxyAPI/v8/sdk/cliproxy/executor"
+	sdktranslator "github.com/router-for-me/CLIProxyAPI/v8/sdk/translator"
+	log "github.com/sirupsen/logrus"
+)
+
+const (
+	logReductionEmail = "fixture.user@example.invalid"
+	logReductionFile  = "codex-fixture.user@example.invalid-plus.json"
+	logReductionKey   = "sk-fixture-key-0123456789abcdef"
+)
+
+// captureExecutorLogs records every log line at level and above.
+func captureExecutorLogs(t *testing.T, level log.Level) *bytes.Buffer {
+	t.Helper()
+	var out bytes.Buffer
+	logger := log.StandardLogger()
+	previousOut, previousLevel, previousFormatter := logger.Out, logger.GetLevel(), logger.Formatter
+	logger.SetOutput(&out)
+	logger.SetLevel(level)
+	logger.SetFormatter(&log.TextFormatter{DisableTimestamp: true, DisableColors: true})
+	t.Cleanup(func() {
+		logger.SetOutput(previousOut)
+		logger.SetLevel(previousLevel)
+		logger.SetFormatter(previousFormatter)
+	})
+	return &out
+}
+
+func assertNoAccountOrKeyInLogs(t *testing.T, logs string, keyAuth *cliproxyauth.Auth) {
+	t.Helper()
+	keyIndex := keyAuth.Clone().EnsureIndex()
+	for _, leak := range []string{logReductionEmail, "fixture.user", logReductionKey, util.HideAPIKey(logReductionKey), keyAuth.ID, keyIndex} {
+		if strings.Contains(logs, leak) {
+			t.Fatalf("logs carry %q:\n%s", leak, logs)
+		}
+	}
+}
+
+// Every attempt that an upstream answers with another model logs its own
+// substitution warning with both models quoted; it names an account by its
+// credential index and withholds an API key's, which is a hash over the key.
+// Both indexes are derived from the credentials, as at registration.
+func TestSubstitutionWarningPerAttemptWithholdsKeyIndex(t *testing.T) {
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		_, _ = io.Copy(io.Discard, r.Body)
+		w.Header().Set("Content-Type", "text/event-stream")
+		_, _ = io.WriteString(w, `data: {"type":"response.completed","response":{"id":"resp_sub","object":"response","created_at":1700000000,"status":"completed","model":"gpt-5.4-mini","output":[{"type":"message","id":"msg_sub","role":"assistant","status":"completed","content":[{"type":"output_text","text":"ok","annotations":[]}]}],"usage":{"input_tokens":1,"output_tokens":1,"total_tokens":2}}}`+"\n\n")
+	}))
+	defer server.Close()
+	keyAuth := func() *cliproxyauth.Auth {
+		return &cliproxyauth.Auth{ID: "codex:apikey:fixture-key-id", Provider: "codex",
+			Attributes: map[string]string{"api_key": logReductionKey, "base_url": server.URL, "source": "config:codex[fixture]"}}
+	}
+	accountAuth := func() *cliproxyauth.Auth {
+		return &cliproxyauth.Auth{ID: logReductionFile, Provider: "codex", FileName: "/auths/" + logReductionFile,
+			Attributes: map[string]string{"base_url": server.URL, "path": "/auths/" + logReductionFile},
+			Metadata:   map[string]any{"type": "codex", "email": logReductionEmail, "access_token": "fixture-access-token", "account_id": "fixture-account"}}
+	}
+	accountIndex := accountAuth().EnsureIndex()
+	if accountIndex == "" || accountIndex == keyAuth().EnsureIndex() {
+		t.Fatalf("derived indexes: account %q, key %q", accountIndex, keyAuth().EnsureIndex())
+	}
+	const attempts = 3
+	for _, tc := range []struct {
+		name  string
+		auth  func() *cliproxyauth.Auth
+		index string
+	}{{"key", keyAuth, "nil"}, {"account", accountAuth, accountIndex}} {
+		t.Run(tc.name, func(t *testing.T) {
+			logs := captureExecutorLogs(t, log.DebugLevel)
+			executor := NewCodexExecutor(&config.Config{})
+			for attempt := 0; attempt < attempts; attempt++ {
+				for _, stream := range []bool{false, true} {
+					ctx, cancel := context.WithTimeout(context.Background(), 10*time.Second)
+					req := cliproxyexecutor.Request{Model: "gpt-5.5", Payload: []byte(`{"model":"gpt-5.5","max_tokens":1024,"messages":[{"role":"user","content":"fixture"}]}`)}
+					opts := cliproxyexecutor.Options{SourceFormat: sdktranslator.FormatClaude, Stream: stream}
+					if stream {
+						result, err := executor.ExecuteStream(ctx, tc.auth(), req, opts)
+						if err != nil {
+							t.Fatalf("ExecuteStream: %v", err)
+						}
+						for chunk := range result.Chunks {
+							if chunk.Err != nil {
+								t.Fatalf("stream chunk: %v", chunk.Err)
+							}
+						}
+					} else if _, err := executor.Execute(ctx, tc.auth(), req, opts); err != nil {
+						t.Fatalf("Execute: %v", err)
+					}
+					cancel()
+				}
+			}
+			want := fmt.Sprintf(`codex executor: upstream served model \"gpt-5.4-mini\" for requested model \"gpt-5.5\" (auth_index=%s)`, tc.index)
+			if got := strings.Count(logs.String(), "level=warning msg=\""+want+"\""); got != 2*attempts {
+				t.Fatalf("substitution warnings = %d, want %d (%s):\n%s", got, 2*attempts, want, logs)
+			}
+			assertNoAccountOrKeyInLogs(t, logs.String(), keyAuth())
+		})
+	}
+}
+
+// The websocket request, response and connection lines are per-request
+// diagnostics: nothing at info level, and at debug level no auth ID.
+func TestWebsocketDiagnosticsLogAtDebugWithoutAuthID(t *testing.T) {
+	const url = "wss://upstream.example.invalid/v1/responses"
+	payload := []byte(`{"type":"response.create","input":[],"response":{"id":"resp_ws","previous_response_id":"resp_prev"}}`)
+	emit := func() {
+		logCodexWebsocketConnected("session-1", logReductionFile, url)
+		logCodexWebsocketConnectedWithReused(nil, "session-1", logReductionFile, url, true)
+		logCodexWebsocketDisconnected("session-1", logReductionFile, url, "closed", nil)
+		logCodexWebsocketDisconnectedWithLastEvent(nil, "session-1", logReductionFile, url, "closed", "response.completed", errors.New("eof"))
+		logXAIWebsocketRequest("session-1", logReductionFile, url, nil)
+		logXAIWebsocketRequest("session-1", logReductionFile, url, payload)
+		logXAIWebsocketWarmupCompleted("session-1", logReductionFile, url, payload)
+		logXAIWebsocketTerminalResponse("session-1", logReductionFile, url, "response.completed", payload)
+		logXAIWebsocketConnected("session-1", logReductionFile, url)
+		logXAIWebsocketDisconnected("session-1", logReductionFile, url, "closed", errors.New("eof"))
+	}
+	info := captureExecutorLogs(t, log.InfoLevel)
+	emit()
+	if info.Len() != 0 {
+		t.Fatalf("websocket diagnostics at info level:\n%s", info)
+	}
+	debug := captureExecutorLogs(t, log.DebugLevel)
+	emit()
+	if lines := strings.Count(debug.String(), "level=debug"); lines != 10 {
+		t.Fatalf("debug lines = %d, want 10:\n%s", lines, debug)
+	}
+	if strings.Contains(debug.String(), "fixture.user") || strings.Contains(debug.String(), "auth=") {
+		t.Fatalf("websocket diagnostics name the credential:\n%s", debug)
+	}
+}
