@@ -0,0 +1,281 @@
+package executor
+
+import (
+	"context"
+	"fmt"
+	"io"
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/gorilla/websocket"
+	"github.com/router-for-me/CLIProxyAPI/v8/internal/config"
+	"github.com/router-for-me/CLIProxyAPI/v8/internal/registry"
+	"github.com/router-for-me/CLIProxyAPI/v8/internal/runtime/executor/helps"
+	cliproxyauth "github.com/router-for-me/CLIProxyAPI/v8/sdk/cliproxy/auth"
+	cliproxyexecutor "github.com/router-for-me/CLIProxyAPI/v8/sdk/cliproxy/executor"
+	sdktranslator "github.com/router-for-me/CLIProxyAPI/v8/sdk/translator"
+)
+
+// Assert the captured final request, after auth/config/cloaking AND the late
+// models.json overrides. Constants/helper assertions alone miss that boundary.
+const fxUA = "codex-tui/0.159.1 (Mac OS 26.5.2; arm64) iTerm.app/3.6.11 (codex-tui; 0.159.1)"
+
+var fxModes = []string{"http", "stream", "compact", "websocket", "websocket-stream"}
+
+type fxIdentityCase struct {
+	inbound                   http.Header
+	attrs                     map[string]string
+	configuredUA              string
+	uncloaked, apiKey, native bool
+}
+
+func fxCapture(t *testing.T, mode, wire string, tc fxIdentityCase) http.Header {
+	t.Helper()
+	captured := make(chan http.Header, 1)
+	completed := fmt.Sprintf(`{"type":"response.completed","response":{"id":"resp_cm055","model":%q,"status":"completed","output":[{"type":"message","role":"assistant","content":[{"type":"output_text","text":"ok"}]}],"usage":{"input_tokens":1,"output_tokens":1,"total_tokens":2}}}`, wire)
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		captured <- r.Header.Clone()
+		if strings.HasPrefix(mode, "websocket") {
+			upgrader := websocket.Upgrader{CheckOrigin: func(*http.Request) bool { return true }}
+			conn, err := upgrader.Upgrade(w, r, nil)
+			if err != nil {
+				t.Errorf("upgrade: %v", err)
+				return
+			}
+			defer conn.Close()
+			_ = conn.SetReadDeadline(time.Now().Add(5 * time.Second))
+			if _, _, err = conn.ReadMessage(); err != nil {
+				t.Errorf("read: %v", err)
+				return
+			}
+			if err = conn.WriteMessage(websocket.TextMessage, []byte(completed)); err != nil {
+				t.Errorf("write: %v", err)
+			}
+			return
+		}
+		_, _ = io.Copy(io.Discard, r.Body)
+		if mode == "compact" {
+			if r.URL.Path != "/responses/compact" {
+				t.Errorf("compact path = %q", r.URL.Path)
+			}
+			w.Header().Set("Content-Type", "application/json")
+			_, _ = io.WriteString(w, `{"id":"resp_cm055","object":"response.compaction","output":[]}`)
+		} else {
+			if r.URL.Path != "/responses" {
+				t.Errorf("responses path = %q", r.URL.Path)
+			}
+			w.Header().Set("Content-Type", "text/event-stream")
+			_, _ = fmt.Fprintf(w, "data: %s\n\n", completed)
+		}
+	}))
+	defer server.Close()
+	cfg := &config.Config{SDKConfig: config.SDKConfig{DisableImageGeneration: config.DisableImageGenerationAll}}
+	cfg.Codex.DisableCodexCloaking = tc.uncloaked
+	cfg.CodexHeaderDefaults.UserAgent = tc.configuredUA
+	auth := &cliproxyauth.Auth{ID: "cm055", Provider: "codex", Attributes: map[string]string{"base_url": server.URL}, Metadata: map[string]any{"access_token": "fixture-only"}}
+	if tc.apiKey {
+		auth.Attributes["api_key"] = "fixture-only"
+	}
+	for k, v := range tc.attrs {
+		auth.Attributes[k] = v
+	}
+	headers := tc.inbound.Clone()
+	if headers == nil {
+		headers = http.Header{}
+	}
+	payload := fmt.Sprintf(`{"model":%q,"input":[{"role":"user","content":"fixture"}]}`, wire)
+	if tc.native {
+		headers.Set("X-Openai-Internal-Codex-Responses-Lite", "true")
+	}
+	req := cliproxyexecutor.Request{Model: wire, Payload: []byte(payload)}
+	opts := cliproxyexecutor.Options{SourceFormat: sdktranslator.FormatOpenAIResponse, Headers: headers}
+	if helps.IsNativeCodexRequest(req.Payload, opts) != tc.native {
+		t.Fatal("fixture native classification mismatch")
+	}
+	if mode == "compact" {
+		opts.Alt = "responses/compact"
+	}
+	ctx, cancel := context.WithTimeout(context.Background(), 8*time.Second)
+	defer cancel()
+	var err error
+	if strings.HasPrefix(mode, "websocket") {
+		e := NewCodexWebsocketsExecutor(cfg)
+		if mode == "websocket-stream" {
+			var res *cliproxyexecutor.StreamResult
+			res, err = e.ExecuteStream(ctx, auth, req, opts)
+			if err == nil {
+				for chunk := range res.Chunks {
+					if chunk.Err != nil {
+						t.Fatalf("stream: %v", chunk.Err)
+					}
+				}
+			}
+		} else {
+			_, err = e.Execute(ctx, auth, req, opts)
+		}
+	} else {
+		e := NewCodexExecutor(cfg)
+		if mode == "stream" {
+			var res *cliproxyexecutor.StreamResult
+			res, err = e.ExecuteStream(ctx, auth, req, opts)
+			if err == nil {
+				for chunk := range res.Chunks {
+					if chunk.Err != nil {
+						t.Fatalf("stream: %v", chunk.Err)
+					}
+				}
+			}
+		} else {
+			_, err = e.Execute(ctx, auth, req, opts)
+		}
+	}
+	if err != nil {
+		t.Fatalf("%s request: %v", mode, err)
+	}
+	select {
+	case h := <-captured:
+		return h
+	default:
+		t.Fatal("no upstream request")
+		return nil
+	}
+}
+
+// fxHint is the routing hint 8.0.33 derives for a ChatGPT-backend request of
+// wire; an API-key request carries none.
+func fxHint(wire string, apiKey bool) string {
+	if apiKey {
+		return ""
+	}
+	return "model=" + wire
+}
+
+func fxCheck(t *testing.T, h http.Header, ua, originator, version, hint string) {
+	t.Helper()
+	for k, want := range map[string]string{"User-Agent": ua, "Originator": originator, "Version": version, "X-Codex-Routing-Hint": hint} {
+		if got := h.Get(k); got != want {
+			t.Errorf("final %s = %q, want %q", k, got, want)
+		}
+	}
+}
+
+func fxWires(t *testing.T) []string {
+	t.Helper()
+	overlay := "cm055-overlay"
+	r := registry.GetGlobalRegistry()
+	r.RegisterClient("cm055-overlay-client", "codex", []*registry.ModelInfo{{ID: overlay, Object: "model", Type: "codex"}})
+	t.Cleanup(func() { r.UnregisterClient("cm055-overlay-client") })
+	for _, m := range registry.GetCodexProModels() {
+		if len(registry.ModelOverrideHeaders(m.ID)) == 0 {
+			return []string{m.ID, overlay}
+		}
+	}
+	t.Fatal("no unoverridden static Codex model")
+	return nil
+}
+
+func fxFinalHeaders(t *testing.T, modes []string) {
+	for _, wire := range fxWires(t) {
+		for _, mode := range modes {
+			for _, version := range []string{"", "  ", "0.154.0", "0.200.0"} {
+				for _, apiKey := range []bool{false, true} {
+					for _, native := range []bool{false, true} {
+						t.Run(fmt.Sprintf("%s/%s/version=%q/key=%t/native=%t", wire, mode, version, apiKey, native), func(t *testing.T) {
+							want := strings.TrimSpace(version)
+							if want == "" {
+								want = "0.159.1"
+							}
+							h := fxCapture(t, mode, wire, fxIdentityCase{inbound: http.Header{"Version": {version}}, apiKey: apiKey, native: native})
+							fxCheck(t, h, fxUA, "codex-tui", want, fxHint(wire, apiKey))
+						})
+					}
+				}
+			}
+		}
+	}
+}
+func TestCM055CodexIdentityHTTPFinalHeaders(t *testing.T)      { fxFinalHeaders(t, fxModes[:3]) }
+func TestCM055CodexIdentityWebsocketFinalHeaders(t *testing.T) { fxFinalHeaders(t, fxModes[3:]) }
+
+func TestCM055CodexIdentityVersionDefault(t *testing.T) {
+	for _, target := range []string{"", "  ", "0.150.0"} {
+		for _, source := range []string{"", "  ", "0.200.0"} {
+			for _, ws := range []bool{false, true} {
+				h := http.Header{"Version": {target}}
+				in := http.Header{"Version": {source}}
+				if ws {
+					h = applyCodexWebsocketHeaders(context.Background(), h, nil, "", &config.Config{}, false, in)
+				} else {
+					applyCodexHeadersFromSources(&http.Request{Header: h}, nil, "", false, &config.Config{}, in)
+				}
+				want := strings.TrimSpace(source)
+				if want == "" {
+					want = strings.TrimSpace(target)
+				}
+				if want == "" {
+					want = "0.159.1"
+				}
+				if got := h.Get("Version"); got != want {
+					t.Errorf("target=%q source=%q ws=%t: %q != %q", target, source, ws, got, want)
+				}
+			}
+		}
+	}
+}
+
+func TestCM055CodexIdentityCloakingPrecedence(t *testing.T) {
+	for _, mode := range fxModes {
+		for _, uncloaked := range []bool{false, true} {
+			for _, apiKey := range []bool{false, true} {
+				for _, custom := range []bool{false, true} {
+					t.Run(fmt.Sprintf("%s/uncloaked=%t/key=%t/custom=%t", mode, uncloaked, apiKey, custom), func(t *testing.T) {
+						tc := fxIdentityCase{uncloaked: uncloaked, apiKey: apiKey, native: true, configuredUA: "configured/1", inbound: http.Header{"User-Agent": {"incoming/1"}, "Originator": {"incoming-client"}, "Version": {"0.200.0"}}}
+						ua, origin, version := fxUA, "codex-tui", "0.200.0"
+						if uncloaked {
+							ua, origin = "configured/1", "incoming-client"
+							if apiKey {
+								ua = "incoming/1"
+							}
+						}
+						if custom {
+							tc.attrs = map[string]string{"header:User-Agent": "custom/1", "header:Originator": "custom-client", "header:Version": "0.180.0"}
+							version = "0.180.0"
+							if uncloaked {
+								ua, origin = "custom/1", "custom-client"
+							}
+						}
+						fxCheck(t, fxCapture(t, mode, "cm055-custom-wire", tc), ua, origin, version, fxHint("cm055-custom-wire", apiKey))
+					})
+				}
+			}
+		}
+	}
+}
+
+func TestCM055CodexIdentityRoutingHintFinal(t *testing.T) {
+	for _, mode := range fxModes {
+		for _, apiKey := range []bool{false, true} {
+			t.Run(fmt.Sprintf("%s/key=%t", mode, apiKey), func(t *testing.T) {
+				tc := fxIdentityCase{apiKey: apiKey, native: true, inbound: http.Header{"X-Codex-Routing-Hint": {"model=client-original"}}}
+				fxCheck(t, fxCapture(t, mode, "routing-hint-wire", tc), fxUA, "codex-tui", "0.159.1", fxHint("routing-hint-wire", apiKey))
+			})
+		}
+	}
+}
+
+func TestCM055CodexIdentityStaticOverrideException(t *testing.T) {
+	// The only admitted exception, never a static-registry rewrite.
+	const wire = "gpt-5.6-luna"
+	const oldUA = "codex-tui/0.154.0 (Mac OS 26.5.2; arm64) iTerm.app/3.6.11 (codex-tui; 0.154.0)"
+	for _, mode := range fxModes {
+		for _, uncloaked := range []bool{false, true} {
+			t.Run(fmt.Sprintf("%s/uncloaked=%t", mode, uncloaked), func(t *testing.T) {
+				tc := fxIdentityCase{uncloaked: uncloaked, attrs: map[string]string{"header:User-Agent": "custom/1", "header:Originator": "custom-client"}}
+				fxCheck(t, fxCapture(t, mode, wire, tc), oldUA, "codex-tui", "0.159.1", fxHint(wire, false))
+			})
+		}
+	}
+}
