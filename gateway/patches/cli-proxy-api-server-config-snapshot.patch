+// cm053SDKConfig is a genuinely changed, freshly allocated SDK config per round.
+func cm053SDKConfig(round int) *sdkconfig.SDKConfig {
+	cfg := &sdkconfig.SDKConfig{
+		PassthroughHeaders:         round%2 == 0,
+		RequestLog:                 round%3 == 0,
+		NonStreamKeepAliveInterval: round % 2,
+	}
+	cfg.Streaming.KeepAliveSeconds = 5 + round%4
+	cfg.Streaming.BootstrapRetries = round % 2
+	cfg.ClaudeCode.DisableCloakingModelList = round%2 == 1
+	return cfg
+}
