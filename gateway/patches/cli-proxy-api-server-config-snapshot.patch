diff --git a/sdk/api/handlers/handlers_config_snapshot.go b/sdk/api/handlers/handlers_config_snapshot.go
new file mode 100644
index 00000000..3d1d819c
--- /dev/null
+++ b/sdk/api/handlers/handlers_config_snapshot.go
@@ -0,0 +1,47 @@
+package handlers
+
+// charmer local patch (server-config-snapshot): the SDK
+// handler configuration is one published snapshot. UpdateClients replaces the
+// pointer under runtimeMu and CurrentConfig reads it; a request reads one
+// snapshot from its first reader to its end (RequestConfig), so a reload in the
+// middle of a request never mixes two configurations in one request.
+
+import (
+	"github.com/gin-gonic/gin"
+	"github.com/router-for-me/CLIProxyAPI/v8/sdk/config"
+	"golang.org/x/net/context"
+)
+
+// sdkConfigSnapshotKey pins the SDK config snapshot a request uses in its gin
+// context.
+const sdkConfigSnapshotKey = "cliproxy.cm053.sdkConfigSnapshot"
+
+// RequestConfig returns the one SDK configuration snapshot a request uses: the
+// first reader of the request (GetContextWithCancel, or an earlier handler
+// read) pins the snapshot current at that moment in the gin context, and every
+// later reader of the same request gets that snapshot, even across a reload.
+// Without a gin context it returns the current snapshot.
+func (h *BaseAPIHandler) RequestConfig(c *gin.Context) *config.SDKConfig {
+	if c != nil {
+		if value, ok := c.Get(sdkConfigSnapshotKey); ok {
+			if cfg, okCfg := value.(*config.SDKConfig); okCfg {
+				return cfg
+			}
+		}
+	}
+	cfg := h.CurrentConfig()
+	if c != nil {
+		c.Set(sdkConfigSnapshotKey, cfg)
+	}
+	return cfg
+}
+
+// requestConfigFromContext resolves the request's snapshot through the gin
+// context GetContextWithCancel stores in ctx.
+func (h *BaseAPIHandler) requestConfigFromContext(ctx context.Context) *config.SDKConfig {
+	var c *gin.Context
+	if ctx != nil {
+		c, _ = ctx.Value("gin").(*gin.Context)
+	}
+	return h.RequestConfig(c)
+}
