+package claude
+
+import (
+	"errors"
+
+	"github.com/router-for-me/CLIProxyAPI/v8/internal/interfaces"
+)
+
+// promptTooLongMessage is the Messages API's wording for a request whose
+// prompt exceeds the model's context window. Claude clients compact their
+// conversation and retry when a request is refused with it.
+const promptTooLongMessage = "prompt is too long"
+
+// isPromptTooLong reports whether an executor positively identified the
+// failure as a context-window overflow of the request (it marks such a
+// failure with PromptTooLong; see the Codex executor). Unmarked failures and
+// direct responses keep their own status and body.
+func isPromptTooLong(msg *interfaces.ErrorMessage) bool {
+	if msg == nil || msg.Error == nil || msg.DirectResponse {
+		return false
+	}
+	var marked interface{ PromptTooLong() bool }
+	return errors.As(msg.Error, &marked) && marked.PromptTooLong()
+}
+
+// promptTooLongError is the native error body of a marked failure: HTTP 400
+// before the response headers, the stream's error event after them.
+func promptTooLongError() claudeErrorResponse {
+	return claudeErrorResponse{Type: "error", Error: claudeErrorDetail{Type: "invalid_request_error", Message: promptTooLongMessage}}
+}
