+// An account request carries no output cap from the client, whatever the
+// client format, the codex cloaking setting or the execution mode: the
+// translations forward the client's limit, and the account backend is sent
+// none. A configured payload rule still sets the final body.
+func TestCodexAccountOutputCapIsNotForwarded(t *testing.T) {
+	withCap := `{"model":"gpt-5.5","max_tokens":32000,` + codexOutputCapMessage + `}`
+	cases := []struct{ name, from, payload string }{
+		{"messages", "claude", withCap},
+		{"messages one", "claude", `{"model":"gpt-5.5","max_tokens":1,` + codexOutputCapMessage + `}`},
+		{"responses", "openai-response", `{"model":"gpt-5.5","max_output_tokens":2048,` + codexOutputCapInput + `}`},
+		{"responses legacy field", "openai-response", `{"model":"gpt-5.5","max_completion_tokens":2048,` + codexOutputCapInput + `}`},
+		{"chat", "openai", `{"model":"gpt-5.5","max_completion_tokens":2048,` + codexOutputCapMessage + `}`},
+		{"chat max_tokens", "openai", `{"model":"gpt-5.5","max_tokens":2048,` + codexOutputCapMessage + `}`},
+		{"gemini", "gemini", `{"model":"gpt-5.5","contents":[{"role":"user","parts":[{"text":"fixture"}]}],"generationConfig":{"maxOutputTokens":2048}}`},
+		{"interactions", "interactions", `{"model":"gpt-5.5","input":"fixture","max_output_tokens":2048}`},
+	}
+	for _, tc := range cases {
+		for _, plain := range []bool{false, true} {
+			for _, stream := range []bool{false, true} {
+				t.Run(fmt.Sprintf("%s/plain=%t/stream=%t", tc.name, plain, stream), func(t *testing.T) {
+					cfg := &config.Config{}
+					cfg.Codex.DisableCodexCloaking = plain
+					hit := codexOutputCapTurn(t, cfg, codexOutputCapAccountAuth, tc.from, tc.payload, stream)
+					if hit.header.Get("Chatgpt-Account-Id") != codexOutputCapAccount {
+						t.Fatalf("request did not take the account route: %v", hit.header)
+					}
+					codexOutputCapWant(t, hit.body, "")
+				})
+			}
+		}
+	}
+	for _, stream := range []bool{false, true} {
+		t.Run(fmt.Sprintf("override/stream=%t", stream), func(t *testing.T) {
+			hit := codexOutputCapTurn(t, codexOutputCapPayloadConfig("override", 64000), codexOutputCapAccountAuth, "claude", withCap, stream)
+			codexOutputCapWant(t, hit.body, "64000")
+		})
+		t.Run(fmt.Sprintf("default/stream=%t", stream), func(t *testing.T) {
+			hit := codexOutputCapTurn(t, codexOutputCapPayloadConfig("default", 4096), codexOutputCapAccountAuth, "claude", withCap, stream)
+			codexOutputCapWant(t, hit.body, "4096")
+		})
+	}
+}
