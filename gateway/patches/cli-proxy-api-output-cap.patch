+// An absent client value, or one that is not a positive plain integer, gets
+// no cap from the gateway: the Responses request carries exactly what the
+// translation produced (its own forwarding of the client's field, if any),
+// an invalid value is left to the upstream, and the request is still sent.
+func TestCodexKeyOutputCapAbsentOrInvalid(t *testing.T) {
+	cases := []struct{ name, from, field, value, want string }{
+		{"messages absent", "claude", "", "", ""},
+		{"messages zero", "claude", "max_tokens", "0", "0"},
+		{"messages negative", "claude", "max_tokens", "-1", "-1"},
+		{"messages fraction", "claude", "max_tokens", "1024.5", "1024"},
+		{"messages exponent", "claude", "max_tokens", "1e4", "10000"},
+		{"messages overflow", "claude", "max_tokens", "92233720368547758070", "-10"},
+		{"messages string", "claude", "max_tokens", `"32000"`, ""},
+		{"messages null", "claude", "max_tokens", "null", ""},
+		{"messages bool", "claude", "max_tokens", "true", ""},
+		{"messages object", "claude", "max_tokens", `{"value":32000}`, ""},
+		{"responses absent", "openai-response", "", "", ""},
+		{"responses string", "openai-response", "max_output_tokens", `"2048"`, `"2048"`},
+		{"responses zero", "openai-response", "max_output_tokens", "0", "0"},
+		{"responses null", "openai-response", "max_output_tokens", "null", "null"},
+	}
+	for _, tc := range cases {
+		for _, stream := range []bool{false, true} {
+			t.Run(fmt.Sprintf("%s/stream=%t", tc.name, stream), func(t *testing.T) {
+				content := codexOutputCapMessage
+				if tc.from == "openai-response" {
+					content = codexOutputCapInput
+				}
+				payload := `{"model":"gpt-5.5",` + content + `}`
+				if tc.field != "" {
+					payload = `{"model":"gpt-5.5","` + tc.field + `":` + tc.value + `,` + content + `}`
+				}
+				hit := codexOutputCapTurn(t, &config.Config{}, codexOutputCapKeyAuth, tc.from, payload, stream)
+				codexOutputCapWant(t, hit.body, tc.want)
+			})
+		}
+	}
+}
