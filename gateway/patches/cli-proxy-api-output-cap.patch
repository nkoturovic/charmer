+// Configured payload rules run first and may lower the client's cap, never
+// remove it or take it below the Responses minimum (16); with no client cap
+// the gateway adds no limit of its own.
+func TestCodexKeyOutputCapAfterPayloadRules(t *testing.T) {
+	withCap := `{"model":"gpt-5.5","max_tokens":32000,` + codexOutputCapMessage + `}`
+	withSmallCap := `{"model":"gpt-5.5","max_tokens":8,` + codexOutputCapMessage + `}`
+	withoutCap := `{"model":"gpt-5.5",` + codexOutputCapMessage + `}`
+	cases := []struct {
+		name, kind string
+		value      any
+		payload    string
+		want       string
+	}{
+		{"larger override is capped", "override", 64000, withCap, "32000"},
+		{"larger override is capped to a small cap, raised to the minimum", "override", 64000, withSmallCap, "16"},
+		{"smaller override is kept", "override", 1000, withCap, "1000"},
+		{"small override is raised to the minimum", "override", 8, withCap, "16"},
+		{"override fifteen is raised to the minimum", "override", 15, withCap, "16"},
+		{"override sixteen is kept", "override", 16, withCap, "16"},
+		{"override seventeen is kept", "override", 17, withCap, "17"},
+		{"equal override is kept", "override", 32000, withCap, "32000"},
+		{"invalid override is left to the upstream", "override", 0, withCap, "0"},
+		{"larger default is capped", "default", 64000, withCap, "32000"},
+		// The translation forwards the client's cap, so a default (which only
+		// fills an absent field) never displaces it.
+		{"smaller default leaves the client's cap", "default", 4096, withCap, "32000"},
+		{"filter cannot remove the cap", "filter", nil, withCap, "32000"},
+		{"no client cap keeps the configured default", "default", 4096, withoutCap, "4096"},
+		{"no client cap keeps the configured override", "override", 64000, withoutCap, "64000"},
+	}
+	for _, tc := range cases {
+		for _, stream := range []bool{false, true} {
+			t.Run(fmt.Sprintf("%s/stream=%t", tc.name, stream), func(t *testing.T) {
+				hit := codexOutputCapTurn(t, codexOutputCapPayloadConfig(tc.kind, tc.value), codexOutputCapKeyAuth, "claude", tc.payload, stream)
+				codexOutputCapWant(t, hit.body, tc.want)
+			})
+		}
+	}
+}
