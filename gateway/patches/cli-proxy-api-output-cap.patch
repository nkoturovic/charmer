+// The websocket executor keeps the account route's body free of the client's
+// cap too; on an API key it still carries the translation's forwarding.
+func TestCodexAccountOutputCapIsNotForwardedOverWebsockets(t *testing.T) {
+	withCap := `{"model":"gpt-5.5","max_tokens":32000,` + codexOutputCapMessage + `}`
+	for _, stream := range []bool{false, true} {
