+// Negative controls: a Sign in with ChatGPT credential, compact and image
+// requests get nothing from the gateway's cap. The SIWC body carries the
+// translation's own forwarding of the client's max_tokens (32000), and a
+// payload override there is not bounded by it.
+func TestCodexKeyOutputCapLeavesOtherRoutes(t *testing.T) {
+	withCap := `{"model":"gpt-5.5","max_tokens":32000,` + codexOutputCapMessage + `}`
+	for _, stream := range []bool{false, true} {
+		t.Run(fmt.Sprintf("siwc/stream=%t", stream), func(t *testing.T) {
+			hit := codexOutputCapTurn(t, &config.Config{}, codexOutputCapSIWCAuth, "claude", withCap, stream)
+			if hit.header.Get("Authorization") != "Bearer codex-output-cap-fixture-siwc" {
+				t.Fatalf("request did not take the SIWC route: %v", hit.header)
+			}
+			codexOutputCapWant(t, hit.body, "32000")
+		})
+		t.Run(fmt.Sprintf("siwc override/stream=%t", stream), func(t *testing.T) {
+			hit := codexOutputCapTurn(t, codexOutputCapPayloadConfig("override", 64000), codexOutputCapSIWCAuth, "claude", withCap, stream)
+			codexOutputCapWant(t, hit.body, "64000")
+		})
+		t.Run(fmt.Sprintf("image/stream=%t", stream), func(t *testing.T) {
+			req := cliproxyexecutor.Request{Model: "gpt-image-2", Payload: []byte(`{"model":"gpt-image-2","prompt":"fixture","max_output_tokens":1000}`)}
+			opts := cliproxyexecutor.Options{SourceFormat: sdktranslator.FromString(codexOpenAIImageSourceFormat), Stream: stream,
+				Metadata: map[string]any{cliproxyexecutor.RequestPathMetadataKey: codexImagesGenerationsPath}}
+			hits := codexOutputCapRequest(t, codexOutputCapPayloadConfig("override", 64000), codexOutputCapKeyAuth, req, opts)
+			if len(hits) != 1 || hits[0].path != "/images/generations" {
+				t.Fatalf("image upstream requests = %d (%v), want one /images/generations", len(hits), hits)
+			}
+			if got := ojson.GetBytes(hits[0].body, "max_output_tokens").Raw; got != "64000" {
+				t.Fatalf("image max_output_tokens = %q, want 64000; body=%s", got, hits[0].body)
+			}
+		})
+	}
+	t.Run("compact", func(t *testing.T) {
+		req := cliproxyexecutor.Request{Model: "gpt-5.5", Payload: []byte(`{"model":"gpt-5.5","max_output_tokens":1000,` + codexOutputCapInput + `}`)}
+		opts := cliproxyexecutor.Options{SourceFormat: sdktranslator.FormatOpenAIResponse, Alt: "responses/compact"}
+		hits := codexOutputCapRequest(t, codexOutputCapPayloadConfig("override", 64000), codexOutputCapKeyAuth, req, opts)
+		if len(hits) != 1 || hits[0].path != "/responses/compact" {
+			t.Fatalf("compact upstream requests = %d, want one /responses/compact", len(hits))
+		}
+		if got := ojson.GetBytes(hits[0].body, "max_output_tokens").Raw; got != "64000" {
+			t.Fatalf("compact max_output_tokens = %q, want 64000; body=%s", got, hits[0].body)
+		}
+	})
+}
