diff --git a/internal/runtime/executor/codex_key_output_cap.go b/internal/runtime/executor/codex_key_output_cap.go
new file mode 100644
index 00000000..7b05d888
--- /dev/null
+++ b/internal/runtime/executor/codex_key_output_cap.go
@@ -0,0 +1,104 @@
+package executor
+
+import (
+	"context"
+	"strconv"
+
+	"github.com/MoeForge/moego/ojson"
+	"github.com/router-for-me/CLIProxyAPI/v8/internal/runtime/executor/helps"
+	cliproxyauth "github.com/router-for-me/CLIProxyAPI/v8/sdk/cliproxy/auth"
+	sdktranslator "github.com/router-for-me/CLIProxyAPI/v8/sdk/translator"
+)
+
+// withCodexKeyOutputCap keeps the client's own output cap in the final body
+// of an ordinary Codex API-key request (Execute and ExecuteStream).
+//
+// The Claude Messages and OpenAI Responses translations to Codex forward the
+// client's limit (max_tokens, max_output_tokens), but the configured payload
+// rules run after the translation and can raise or delete it, which would
+// leave an API-key request bounded only by the model's own maximum. The cap
+// is applied as the last step of payload finalization, after those rules, so
+// a rule can lower it but never remove it: the final max_output_tokens is the
+// client's cap unless the body already holds a smaller valid limit. A limit
+// below the upstream minimum (a client cap, or a smaller limit in the body)
+// is raised to codexMinOutputTokens, so a small cap such as Claude Code's
+// model check (max_tokens 1) stays bounded instead of being refused; every
+// other valid cap is sent as supplied. A client value that is absent or not
+// a positive plain integer adds nothing, and an invalid limit already in the
+// body is left to the upstream. An account request carries no client cap
+// (dropCodexAccountOutputCapDoc), a Sign in with ChatGPT credential keeps
+// the translation's result unchanged, and compact and image requests never
+// pass through here.
+func withCodexKeyOutputCap(ctx context.Context, auth *cliproxyauth.Auth, from sdktranslator.Format, payload []byte) context.Context {
+	if !codexAuthUsesAPIKey(auth) || codexUseSIWC(auth) {
+		return ctx
+	}
+	var field string
+	switch {
+	case sourceFormatEqual(from, sdktranslator.FormatClaude):
+		field = "max_tokens"
+	case sourceFormatEqual(from, sdktranslator.FormatOpenAIResponse):
+		field = "max_output_tokens"
+	default:
+		return ctx
+	}
+	limit, ok := codexOutputLimit(ojson.GetBytes(payload, field))
+	if !ok {
+		return ctx
+	}
+	rules := ctx
+	return helps.WithPayloadFinalizer(ctx, func(body []byte) []byte {
+		return capCodexOutputTokens(helps.FinalizePayload(rules, body), limit)
+	})
+}
+
+// codexOutputLimit reads a valid output limit: a positive plain JSON integer,
+// the Messages rule for max_tokens. No upstream minimum is applied here.
+func codexOutputLimit(value ojson.Result) (int64, bool) {
+	if value.Type != ojson.Number {
+		return 0, false
+	}
+	limit, err := strconv.ParseInt(value.Raw, 10, 64)
+	if err != nil || limit < 1 {
+		return 0, false
+	}
+	return limit, true
+}
+
+// capCodexOutputTokens bounds the body's max_output_tokens by limit, never
+// below the upstream minimum.
+func capCodexOutputTokens(body []byte, limit int64) []byte {
+	if current := ojson.GetBytes(body, "max_output_tokens"); current.Exists() && current.Type != ojson.Null {
+		explicit, valid := codexOutputLimit(current)
+		if !valid {
+			return body
+		}
+		limit = min(limit, explicit)
+	}
+	capped, err := ojson.SetBytes(body, "max_output_tokens", max(limit, codexMinOutputTokens))
+	if err != nil {
+		return body
+	}
+	return capped
+}
+
+// dropCodexAccountOutputCap keeps the client's output cap off a ChatGPT
+// account request: a credential that is neither an API key nor Sign in with
+// ChatGPT, on the HTTP and the websocket executor alike. The translations
+// forward the client's limit (max_tokens, max_completion_tokens,
+// max_output_tokens, maxOutputTokens) as max_output_tokens on every route;
+// the account backend is sent none, as before that forwarding. It removes the
+// limit from the request body and from the original translation the payload
+// rules consult, right after the translation, so configured payload rules
+// still decide the final body as they did then. It returns the original
+// translation to use.
+func dropCodexAccountOutputCap(doc *ojson.Doc, original []byte, auth *cliproxyauth.Auth) []byte {
+	if doc == nil || codexAuthUsesAPIKey(auth) || codexUseSIWC(auth) {
+		return original
+	}
+	_ = doc.Delete("max_output_tokens")
+	if dropped, err := ojson.DeleteBytes(original, "max_output_tokens"); err == nil {
+		return dropped
+	}
+	return original
+}
