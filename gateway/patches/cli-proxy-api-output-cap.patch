+		})
+		t.Run(fmt.Sprintf("key/stream=%t", stream), func(t *testing.T) {
+			codexOutputCapWant(t, codexOutputCapWebsocketFrame(t, codexOutputCapKeyAuth, withCap, stream), "32000")
+		})
+	}
+}
