+// codexOutputCapWebsocketFrame sends one request through the websocket
+// executor to a fake upstream and returns the first frame it received.
+func codexOutputCapWebsocketFrame(t *testing.T, makeAuth func(string) *cliproxyauth.Auth, payload string, stream bool) []byte {
+	t.Helper()
+	upgrader := websocket.Upgrader{CheckOrigin: func(*http.Request) bool { return true }}
+	frames := make(chan []byte, 1)
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		conn, err := upgrader.Upgrade(w, r, nil)
+		if err != nil {
+			t.Errorf("upgrade websocket: %v", err)
+			return
+		}
+		defer func() { _ = conn.Close() }()
+		_, frame, err := conn.ReadMessage()
+		if err != nil {
+			t.Errorf("read upstream frame: %v", err)
+			return
+		}
+		frames <- frame
+		_ = conn.WriteMessage(websocket.TextMessage, []byte(codexOutputCapCompleted))
+	}))
+	defer server.Close()
+	ctx, cancel := context.WithTimeout(context.Background(), 10*time.Second)
+	defer cancel()
+	executor := NewCodexWebsocketsExecutor(&config.Config{})
+	req := cliproxyexecutor.Request{Model: "gpt-5.5", Payload: []byte(payload)}
+	opts := cliproxyexecutor.Options{SourceFormat: sdktranslator.FormatClaude, Stream: stream}
+	if stream {
+		result, err := executor.ExecuteStream(ctx, makeAuth(server.URL), req, opts)
+		if err != nil {
+			t.Fatalf("ExecuteStream: %v", err)
+		}
+		for chunk := range result.Chunks {
+			if chunk.Err != nil {
+				t.Fatalf("stream chunk: %v", chunk.Err)
+			}
+		}
+	} else if _, err := executor.Execute(ctx, makeAuth(server.URL), req, opts); err != nil {
+		t.Fatalf("Execute: %v", err)
+	}
+	select {
+	case frame := <-frames:
+		return frame
+	case <-ctx.Done():
+		t.Fatal("no upstream frame")
+		return nil
+	}
+}
