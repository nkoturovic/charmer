new file mode 100644
index 00000000..29f94d8c
--- /dev/null
+++ b/internal/runtime/executor/codex_key_output_cap_test.go
@@ -0,0 +1,433 @@
+package executor
+
+import (
+	"context"
+	"fmt"
+	"io"
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"sync"
+	"testing"
+	"time"
+
+	"github.com/MoeForge/moego/ojson"
+	"github.com/gorilla/websocket"
+	"github.com/router-for-me/CLIProxyAPI/v8/internal/config"
+	cliproxyauth "github.com/router-for-me/CLIProxyAPI/v8/sdk/cliproxy/auth"
+	cliproxyexecutor "github.com/router-for-me/CLIProxyAPI/v8/sdk/cliproxy/executor"
+	sdktranslator "github.com/router-for-me/CLIProxyAPI/v8/sdk/translator"
+)
+
+const (
+	codexOutputCapKey     = "codex-output-cap-fixture-key"
+	codexOutputCapAccount = "codex-output-cap-fixture-account"
+	codexOutputCapMessage = `"messages":[{"role":"user","content":"fixture"}]`
+	codexOutputCapInput   = `"input":[{"role":"user","content":"fixture"}]`
+)
+
+const codexOutputCapCompleted = `{"type":"response.completed","response":{"id":"resp_cap","object":"response","created_at":1700000000,"status":"completed","model":"gpt-5.5","output":[{"type":"message","id":"msg_cap","role":"assistant","status":"completed","content":[{"type":"output_text","text":"ok","annotations":[]}]}],"usage":{"input_tokens":1,"output_tokens":1,"total_tokens":2}}}`
+
+type codexOutputCapHit struct {
+	path   string
+	header http.Header
+	body   []byte
+}
+
+func codexOutputCapKeyAuth(baseURL string) *cliproxyauth.Auth {
+	return &cliproxyauth.Auth{ID: "codex-output-cap-key", Provider: "codex",
+		Attributes: map[string]string{"base_url": baseURL, "api_key": codexOutputCapKey}}
+}
+
+func codexOutputCapAccountAuth(baseURL string) *cliproxyauth.Auth {
+	return &cliproxyauth.Auth{ID: "codex-output-cap-account", Provider: "codex",
+		Attributes: map[string]string{"base_url": baseURL},
+		Metadata:   map[string]any{"access_token": "codex-output-cap-fixture-token", "account_id": codexOutputCapAccount}}
+}
+
+// codexOutputCapSIWCAuth is a Sign in with ChatGPT credential that also
+// carries an api_key attribute, so the API-key predicate alone accepts it.
+func codexOutputCapSIWCAuth(baseURL string) *cliproxyauth.Auth {
+	return &cliproxyauth.Auth{ID: "codex-output-cap-siwc", Provider: "codex",
+		Attributes: map[string]string{"base_url": baseURL, "api_key": codexOutputCapKey, "use_siwc": "true"},
+		Metadata:   map[string]any{"siwc": map[string]any{"access_token": "codex-output-cap-fixture-siwc"}}}
+}
+
+// codexBudgetSIWCAuth is a Sign in with ChatGPT credential without an api_key
+// attribute: the upstream budget tests run on it, because it keeps the
+// translations' forwarded budget, which an account request no longer carries.
+func codexBudgetSIWCAuth(baseURL string) *cliproxyauth.Auth {
+	return &cliproxyauth.Auth{Provider: "codex", Attributes: map[string]string{"base_url": baseURL},
+		Metadata: map[string]any{"type": "codex", "use_siwc": true, "siwc": map[string]any{"access_token": "siwc-budget-token"}}}
+}
+
+// codexOutputCapRequest sends one request through the real executor to a fake
+// upstream and returns every upstream request it received.
+func codexOutputCapRequest(t *testing.T, cfg *config.Config, makeAuth func(string) *cliproxyauth.Auth, req cliproxyexecutor.Request, opts cliproxyexecutor.Options) []codexOutputCapHit {
+	t.Helper()
+	var mu sync.Mutex
+	var hits []codexOutputCapHit
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		body, _ := io.ReadAll(r.Body)
+		mu.Lock()
+		hits = append(hits, codexOutputCapHit{path: r.URL.Path, header: r.Header.Clone(), body: body})
+		mu.Unlock()
+		switch {
+		case strings.HasSuffix(r.URL.Path, "/responses/compact"):
+			w.Header().Set("Content-Type", "application/json")
+			_, _ = io.WriteString(w, `{"id":"resp_cap","object":"response.compaction","usage":{"input_tokens":1,"output_tokens":1,"total_tokens":2}}`)
+		case strings.HasSuffix(r.URL.Path, "/images/generations") && ojson.GetBytes(body, "stream").Bool():
+			w.Header().Set("Content-Type", "text/event-stream")
+			_, _ = io.WriteString(w, "event: image_generation.completed\ndata: {\"type\":\"image_generation.completed\",\"b64_json\":\"AA==\"}\n\n")
+		case strings.HasSuffix(r.URL.Path, "/images/generations"):
+			w.Header().Set("Content-Type", "application/json")
+			_, _ = io.WriteString(w, `{"created":1700000000,"data":[{"b64_json":"AA=="}]}`)
+		default:
+			w.Header().Set("Content-Type", "text/event-stream")
+			_, _ = io.WriteString(w, "data: "+codexOutputCapCompleted+"\n\n")
+		}
+	}))
+	defer server.Close()
+	ctx, cancel := context.WithTimeout(context.Background(), 10*time.Second)
+	defer cancel()
+	executor := NewCodexExecutor(cfg)
+	auth := makeAuth(server.URL)
+	if opts.Stream {
+		result, err := executor.ExecuteStream(ctx, auth, req, opts)
+		if err != nil {
+			t.Fatalf("ExecuteStream: %v", err)
+		}
+		for chunk := range result.Chunks {
+			if chunk.Err != nil {
+				t.Fatalf("stream chunk: %v", chunk.Err)
+			}
+		}
+	} else if _, err := executor.Execute(ctx, auth, req, opts); err != nil {
+		t.Fatalf("Execute: %v", err)
+	}
+	mu.Lock()
+	defer mu.Unlock()
+	return hits
+}
+
+// codexOutputCapTurn sends one ordinary request and returns its single
+// upstream request.
+func codexOutputCapTurn(t *testing.T, cfg *config.Config, makeAuth func(string) *cliproxyauth.Auth, from, payload string, stream bool) codexOutputCapHit {
+	t.Helper()
+	req := cliproxyexecutor.Request{Model: "gpt-5.5", Payload: []byte(payload)}
+	opts := cliproxyexecutor.Options{SourceFormat: sdktranslator.FromString(from), Stream: stream}
+	hits := codexOutputCapRequest(t, cfg, makeAuth, req, opts)
+	if len(hits) != 1 {
+		t.Fatalf("upstream requests = %d, want 1", len(hits))
+	}
+	if hits[0].path != "/responses" {
+		t.Fatalf("upstream path = %q, want /responses", hits[0].path)
+	}
+	return hits[0]
+}
+
+// codexOutputCapWant checks the final upstream limit: want is the raw JSON
+// value of max_output_tokens, or "" when the body must carry none. No other
+// output-limit spelling ever reaches the Responses request.
+func codexOutputCapWant(t *testing.T, body []byte, want string) {
+	t.Helper()
+	got := ojson.GetBytes(body, "max_output_tokens")
+	if want == "" && got.Exists() {
+		t.Fatalf("max_output_tokens = %s, want none; body=%s", got.Raw, body)
+	}
+	if want != "" && got.Raw != want {
+		t.Fatalf("max_output_tokens = %q, want %s; body=%s", got.Raw, want, body)
+	}
+	for _, other := range []string{"max_tokens", "max_completion_tokens"} {
+		if ojson.GetBytes(body, other).Exists() {
+			t.Fatalf("%s reached the Responses request: %s", other, body)
+		}
+	}
+}
+
+func codexOutputCapPayloadConfig(kind string, value any) *config.Config {
+	cfg := &config.Config{}
+	models := []config.PayloadModelRule{{Name: "*"}}
+	switch kind {
+	case "override":
+		cfg.Payload.Override = []config.PayloadRule{{Models: models, Params: map[string]any{"max_output_tokens": value}}}
+	case "default":
+		cfg.Payload.Default = []config.PayloadRule{{Models: models, Params: map[string]any{"max_output_tokens": value}}}
+	case "filter":
+		cfg.Payload.Filter = []config.PayloadFilterRule{{Models: models, Params: []string{"max_output_tokens"}}}
+	}
+	return cfg
+}
+
+// An API key forwards the client's valid Messages max_tokens, or a native
+// Responses max_output_tokens, as the final max_output_tokens of both
+// execution modes, whatever the codex cloaking setting. A cap below the
+// Responses minimum (16) is sent as 16, never dropped; 16 and above as
+// supplied.
+func TestCodexKeyOutputCapForwardsClientCap(t *testing.T) {
+	cases := []struct {
+		name, from, payload, want string
+	}{
+		{"messages", "claude", `{"model":"gpt-5.5","max_tokens":32000,` + codexOutputCapMessage + `}`, "32000"},
+		{"messages one", "claude", `{"model":"gpt-5.5","max_tokens":1,` + codexOutputCapMessage + `}`, "16"},
+		{"messages fifteen", "claude", `{"model":"gpt-5.5","max_tokens":15,` + codexOutputCapMessage + `}`, "16"},
+		{"messages sixteen", "claude", `{"model":"gpt-5.5","max_tokens":16,` + codexOutputCapMessage + `}`, "16"},
+		{"messages seventeen", "claude", `{"model":"gpt-5.5","max_tokens":17,` + codexOutputCapMessage + `}`, "17"},
+		{"messages with tools", "claude", `{"model":"gpt-5.5","max_tokens":32000,` + codexOutputCapMessage +
+			`,"tools":[{"name":"cm_lookup","description":"Look a value up.","input_schema":{"type":"object","properties":{"k":{"type":"string"}}}}]}`, "32000"},
+		{"messages thinking disabled", "claude", `{"model":"gpt-5.5","max_tokens":32000,"thinking":{"type":"disabled"},` + codexOutputCapMessage + `}`, "32000"},
+		{"messages thinking budget zero", "claude", `{"model":"gpt-5.5","max_tokens":32000,"thinking":{"type":"enabled","budget_tokens":0},` + codexOutputCapMessage + `}`, "32000"},
+		{"messages thinking budget", "claude", `{"model":"gpt-5.5","max_tokens":32000,"thinking":{"type":"enabled","budget_tokens":4096},` + codexOutputCapMessage + `}`, "32000"},
+		{"responses", "openai-response", `{"model":"gpt-5.5","max_output_tokens":2048,` + codexOutputCapInput + `}`, "2048"},
+		{"responses one", "openai-response", `{"model":"gpt-5.5","max_output_tokens":1,` + codexOutputCapInput + `}`, "16"},
+		{"responses sixteen", "openai-response", `{"model":"gpt-5.5","max_output_tokens":16,` + codexOutputCapInput + `}`, "16"},
+		{"responses seventeen", "openai-response", `{"model":"gpt-5.5","max_output_tokens":17,` + codexOutputCapInput + `}`, "17"},
+	}
+	for _, tc := range cases {
+		for _, plain := range []bool{false, true} {
+			for _, stream := range []bool{false, true} {
+				t.Run(fmt.Sprintf("%s/plain=%t/stream=%t", tc.name, plain, stream), func(t *testing.T) {
