+// Trailing slash on a registered path: gin alone answers 301/307 before any
+// middleware (RedirectTrailingSlash). The server's handler refuses these
+// spellings before gin routes them, the allowlisted path plus "/" included
+// (the allowlist is exact).
+var managementTrailingSlashTargets = []struct{ method, target string }{
+	{http.MethodGet, "/v0/management/config.yaml/"},
+	{http.MethodGet, "/v0/management/auth-files/download/"},
+	{http.MethodPost, "/v0/management/api-call/"},
+	{http.MethodGet, "/v0/management/auth-files/"},
+	{http.MethodGet, "/v8/management/credentials/"},
+	{http.MethodPost, "/v8/management/requests/api-call/"},
+	{http.MethodGet, "/v8/management/server/latest-version/"},
+	{http.MethodPost, "/v1/realtime/calls/"},
+	{http.MethodGet, "/codex/callback/"},
+}
