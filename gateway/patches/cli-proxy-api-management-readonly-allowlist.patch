diff --git a/internal/api/server_management_allowlist.go b/internal/api/server_management_allowlist.go
new file mode 100644
index 00000000..334ac126
--- /dev/null
+++ b/internal/api/server_management_allowlist.go
@@ -0,0 +1,260 @@
+package api
+
+import (
+	"net"
+	"net/http"
+	"path"
+	"strings"
+
+	"github.com/gin-gonic/gin"
+)
+
+// charmer local patch (management-readonly-allowlist).
+//
+// The Management API is reduced to an exact read-only allowlist, and the
+// gateway's other administrative and unused surfaces are refused. The guard
+// is an engine-level middleware installed before any route exists, so it runs
+// ahead of every handler in scope: the /v0/management and /v8/management
+// groups (and their management-key middleware), the engine-level OAuth
+// callback routes of both namespaces, the NoRoute plugin dispatcher (plugin
+// management routes, plugin logins, plugin resources), the control panel, and
+// CORS. A request in scope is refused with a bare 404 before any key check,
+// so it never reaches the failed-attempt counter, when any of these holds:
+//   - it is not an exact allowlisted request (GET, canonical path);
+//   - it carries browser request metadata (Origin or Sec-Fetch-*), so a
+//     Fetch-Metadata-capable browser page cannot drive the 5-strike ban on
+//     the allowlisted routes;
+//   - its Host is not a loopback literal, so the Host check covers DNS
+//     rebinding.
+//
+// The allowlist is GET /v0/management/auth-files, GET
+// /v0/management/auth-files/models and GET
+// /v0/management/model-definitions/<channel>. Every /v8/management route is
+// refused, including its read-only twins of the allowlisted handlers.
+//
+// Outside the management namespaces the same refusal applies, with no
+// exception, to the API surfaces the gateway does not serve: model detail
+// lookups (/v1/models/<id>), speech (/v1/audio/speech, /v1/tts), realtime
+// and live sessions, videos, images, alpha search and interactions, and the
+// provider login redirect pages (/callback and the per-provider
+// /<provider>/callback). charmer serves only messages, count_tokens,
+// responses, chat completions and the model list; its logins use the
+// login command's own loopback listener, never these pages.
+//
+// Older browsers without Fetch Metadata remain an accepted residual: their
+// cross-site simple GETs to 127.0.0.1 still reach the key check on the
+// allowlisted routes, and the ban they can drive only blocks quota reads for
+// 30 minutes.
+//
+// The refusal has an empty body and no X-CPA-* headers, like upstream's
+// "management unavailable" 404, but also no Access-Control-* headers: CORS
+// runs after the guard. That is intentional: no cross-origin read or
+// preflight succeeds on a refused path.
+//
+// gin answers some requests before any middleware runs: a registered path
+// plus "/" gets a trailing-slash redirect (RedirectTrailingSlash). The guard
+// therefore also wraps the engine as the server's HTTP handler
+// (managementGuardHandler), so a refused spelling is answered with the same
+// bare 404 before gin routes it, and never reveals which refused paths are
+// registered. The middleware stays for every path into the engine that does
+// not pass through the server's handler.
+
+// managementAllowlistScopePrefixes are the management namespaces. A request
+// whose path spells one of them (with no segment boundary) is in scope and
+// may only be served when it is allowlisted.
+var managementAllowlistScopePrefixes = []string{
+	"/v0/management",
+	"/v8/management",
+}
+
+// refusedSurfacePrefixes are refused outright, with no allowlist: plugin
+// resources and the control panel, which belong to the management surface,
+// and the API routes the gateway does not serve.
+var refusedSurfacePrefixes = []string{
+	"/v0/resource/plugins",
+	"/management.html",
+	"/v1/models/",
+	"/v1/audio/speech",
+	"/v1/tts",
+	"/v1/realtime",
+	"/v1/live",
+	"/v1/videos",
+	"/openai/v1/videos",
+	"/v1/images",
+	"/v1/alpha/search",
+	"/backend-api/codex/alpha/search",
+	"/v1beta/interactions",
+	"/callback",
+	"/anthropic/callback",
+	"/codex/callback",
+	"/antigravity/callback",
+	"/devin/callback",
+}
+
+// managementRESPOutputDisabled closes the RESP (Redis protocol) usage/error
+// surface that shares the HTTP port, authenticates with the management key
+// and pops the usage queue. It is outside the read-only allowlist.
+const managementRESPOutputDisabled = true
+
+var managementAllowlistExactGET = map[string]struct{}{
+	"/v0/management/auth-files":        {},
+	"/v0/management/auth-files/models": {},
+}
+
+const managementAllowlistChannelPrefix = "/v0/management/model-definitions/"
+
+var managementBrowserRequestHeaders = []string{
+	"Origin",
+	"Sec-Fetch-Site",
+	"Sec-Fetch-Mode",
+	"Sec-Fetch-Dest",
+}
+
+// managementGuardHandler is the server's HTTP handler: it refuses a request
+// in the guard's scope before gin routes it. A refusal goes through a
+// route-less engine that carries only the access logger and recovery, so it
+// is logged like any other 404 and gin has no registered path to redirect to.
+func managementGuardHandler(next http.Handler, refusalMiddleware ...gin.HandlerFunc) http.Handler {
+	refusal := gin.New()
+	refusal.Use(refusalMiddleware...)
+	refusal.NoRoute(func(c *gin.Context) {
+		c.AbortWithStatus(http.StatusNotFound)
+	})
+	return http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		if r == nil || r.URL == nil || managementGuardRefuses(r) {
+			refusal.ServeHTTP(w, r)
+			return
+		}
+		next.ServeHTTP(w, r)
+	})
+}
+
+func managementReadOnlyAllowlistMiddleware() gin.HandlerFunc {
+	return func(c *gin.Context) {
+		r := c.Request
+		if r == nil || r.URL == nil {
+			c.AbortWithStatus(http.StatusNotFound)
+			return
+		}
+		if managementGuardRefuses(r) {
+			c.AbortWithStatus(http.StatusNotFound)
+			return
+		}
+		c.Next()
+	}
+}
+
+// managementGuardRefuses is the guard's whole decision for one request.
+func managementGuardRefuses(r *http.Request) bool {
+	if isRefusedSurfaceRequest(r) {
+		return true
+	}
+	if !isManagementScopedRequest(r) {
+		return false
+	}
+	return isBrowserOriginatedRequest(r) || !isLoopbackHostHeader(r.Host) || !isAllowlistedManagementRequest(r)
+}
+
+// guardPathCandidates are the spellings of the request path the guard
+// matches: the decoded and the raw path, each case-folded as sent and after
+// path.Clean. Gin (raw or decoded path, extra slashes removed or not, in any
+// engine configuration) and the NoRoute dispatcher route on one of these.
+func guardPathCandidates(r *http.Request) []string {
+	var out []string
+	for _, candidate := range []string{r.URL.Path, r.URL.RawPath} {
+		if candidate == "" {
+			continue
+		}
+		lower := strings.ToLower(candidate)
+		out = append(out, lower, path.Clean("/"+lower))
+	}
+	return out
+}
+
+// isManagementScopedRequest is deliberately broad: any spelling that could
+// route to a management handler is in scope. There is no segment boundary on
+// purpose.
+func isManagementScopedRequest(r *http.Request) bool {
+	return guardPathHasPrefix(r, managementAllowlistScopePrefixes)
+}
+
+// isRefusedSurfaceRequest reports whether any spelling of the path reaches a
+// surface that is refused for every request.
+func isRefusedSurfaceRequest(r *http.Request) bool {
+	return guardPathHasPrefix(r, refusedSurfacePrefixes)
+}
+
+func guardPathHasPrefix(r *http.Request, prefixes []string) bool {
+	for _, candidate := range guardPathCandidates(r) {
+		for _, prefix := range prefixes {
+			if strings.HasPrefix(candidate, prefix) {
+				return true
+			}
+		}
+	}
+	return false
+}
+
+// isBrowserOriginatedRequest reports whether the request carries any header a
+// browser attaches to cross-site or fetch-metadata requests. The charmer
+// client sends none of them.
+func isBrowserOriginatedRequest(r *http.Request) bool {
+	for _, name := range managementBrowserRequestHeaders {
+		if len(r.Header.Values(name)) > 0 {
+			return true
+		}
+	}
+	return false
+}
+
+// isLoopbackHostHeader accepts only loopback literals (any port): 127.0.0.1,
+// [::1] and localhost. A DNS-rebinding page carries its own host name.
+func isLoopbackHostHeader(hostport string) bool {
+	host := hostport
+	if h, _, err := net.SplitHostPort(hostport); err == nil {
+		host = h
+	} else if strings.HasPrefix(host, "[") && strings.HasSuffix(host, "]") {
+		host = host[1 : len(host)-1]
+	}
+	switch strings.ToLower(host) {
+	case "127.0.0.1", "::1", "localhost":
+		return true
+	}
+	return false
+}
+
+// isAllowlistedManagementRequest is deliberately strict: GET only, canonical
+// (no percent-encoding) path, exact match. Allowed paths are fixed points of
+// gin's path cleaning and unescaping, so an allowed request routes to exactly
+// one allowlisted handler.
+func isAllowlistedManagementRequest(r *http.Request) bool {
+	if r.Method != http.MethodGet || r.URL.RawPath != "" {
+		return false
+	}
+	p := r.URL.Path
+	if _, ok := managementAllowlistExactGET[p]; ok {
+		return true
+	}
+	if channel, ok := strings.CutPrefix(p, managementAllowlistChannelPrefix); ok {
+		return isManagementAllowlistChannel(channel)
+	}
+	return false
+}
+
+// isManagementAllowlistChannel matches ^[a-z0-9][a-z0-9._-]{0,63}$, which
+// excludes "", ".", ".." and "/".
+func isManagementAllowlistChannel(channel string) bool {
+	if len(channel) == 0 || len(channel) > 64 {
+		return false
+	}
+	for i := 0; i < len(channel); i++ {
+		ch := channel[i]
+		switch {
+		case ch >= 'a' && ch <= 'z', ch >= '0' && ch <= '9':
+		case i > 0 && (ch == '.' || ch == '-' || ch == '_'):
+		default:
+			return false
+		}
+	}
+	return true
+}
diff --git a/internal/api/server_management_allowlist_test.go b/internal/api/server_management_allowlist_test.go
new file mode 100644
index 00000000..cce8d4e2
--- /dev/null
+++ b/internal/api/server_management_allowlist_test.go
@@ -0,0 +1,1020 @@
+package api
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"go/ast"
+	"go/parser"
+	"go/token"
+	"io/fs"
+	"net"
+	"net/http"
+	"net/http/httptest"
+	"os"
+	"path/filepath"
+	"sort"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/gin-gonic/gin"
+	managementHandlers "github.com/router-for-me/CLIProxyAPI/v8/internal/api/handlers/management"
+	proxyconfig "github.com/router-for-me/CLIProxyAPI/v8/internal/config"
+	"github.com/router-for-me/CLIProxyAPI/v8/internal/pluginhost"
+	sdkconfig "github.com/router-for-me/CLIProxyAPI/v8/sdk/config"
+)
+
+// charmer local patch (management-readonly-allowlist) gate.
+// Network-free: requests go through server.engine.ServeHTTP (no listener);
+// the RESP check uses a 127.0.0.1:0 listener only; the source tripwire reads
+// the module's own files.
+
+const (
+	allowlistTestKey    = "allowlist-test-management-key"
+	allowlistTestAPIKey = "test-key"
+	allowlistTestHost   = "127.0.0.1:8317"
+)
+
+var allowlistedManagementRoutes = map[string]string{
+	"GET /v0/management/auth-files":                 "/v0/management/auth-files",
+	"GET /v0/management/auth-files/models":          "/v0/management/auth-files/models?name=none",
+	"GET /v0/management/model-definitions/:channel": "/v0/management/model-definitions/claude",
+}
+
+// The read-only v8 twins of the allowlisted handlers. They are refused: the
+// client reads only the v0 routes.
+var refusedV8ReadTwins = []string{
+	"/v8/management/credentials",
+	"/v8/management/credentials/models?name=none",
+	"/v8/management/routing/model-definitions/claude",
+}
+
+// newAllowlistTestServer builds every gate server production-shaped: the
+// plugin host is wired exactly as sdk/cliproxy/builder.go Build does
+// (pluginhost.New, ApplyConfig, RegisterFrontendAuthProviders, then
+// WithPluginHost). Production always has a plugin host, and without one the
+// NoRoute dispatcher 404s before the management key middleware
+// (pluginManagementNoRoute), so NoRoute probes on newTestServer are vacuous.
+func newAllowlistTestServer(t *testing.T) *Server {
+	t.Helper()
+	t.Setenv("MANAGEMENT_PASSWORD", allowlistTestKey)
+	cfg := &proxyconfig.Config{
+		SDKConfig: sdkconfig.SDKConfig{
+			APIKeys: []string{allowlistTestAPIKey},
+		},
+	}
+	host := pluginhost.New()
+	host.ApplyConfig(context.Background(), cfg)
+	host.RegisterFrontendAuthProviders()
+	s := newTestServerWithConfig(t, cfg, WithPluginHost(host))
+	if s.pluginHost != host || s.mgmt == nil {
+		t.Fatal("gate server is not production-shaped: plugin host or management handler missing")
+	}
+	return s
+}
+
+// allowlistRequest builds a request shaped like the charmer client: a
+// loopback peer, a loopback Host literal, no browser headers.
+func allowlistRequest(method, target, key, remoteAddr string) *http.Request {
+	req := httptest.NewRequest(method, target, nil)
+	if remoteAddr == "" {
+		remoteAddr = "127.0.0.1:40000"
+	}
+	req.RemoteAddr = remoteAddr
+	req.Host = allowlistTestHost
+	if key != "" {
+		req.Header.Set("Authorization", "Bearer "+key)
+	}
+	return req
+}
+
+// serveAllowlist serves through the server's HTTP handler, the guard's
+// pre-routing wrapper included, as a listener does.
+func serveAllowlist(s *Server, req *http.Request) *httptest.ResponseRecorder {
+	rr := httptest.NewRecorder()
+	s.Handler().ServeHTTP(rr, req)
+	return rr
+}
+
+// serveEngine serves through the gin engine alone, without the server's
+// pre-routing wrapper.
+func serveEngine(s *Server, req *http.Request) *httptest.ResponseRecorder {
+	rr := httptest.NewRecorder()
+	s.engine.ServeHTTP(rr, req)
+	return rr
+}
+
+// concreteRoutePath substitutes gin parameters with a sample segment.
+func concreteRoutePath(routePath string) string {
+	segments := strings.Split(routePath, "/")
+	for i, seg := range segments {
+		if strings.HasPrefix(seg, ":") || strings.HasPrefix(seg, "*") {
+			segments[i] = "sample"
+		}
+	}
+	return strings.Join(segments, "/")
+}
+
+func isManagementRoutePath(routePath string) bool {
+	for _, prefix := range managementAllowlistScopePrefixes {
+		if routePath == prefix || strings.HasPrefix(routePath, prefix+"/") {
+			return true
+		}
+	}
+	return false
+}
+
+// managementRoutes are the registered routes of both management namespaces,
+// engine-level OAuth callbacks included.
+func managementRoutes(t *testing.T, s *Server) map[string]string {
+	t.Helper()
+	out := make(map[string]string)
+	for _, route := range s.engine.Routes() {
+		if isManagementRoutePath(route.Path) {
+			out[route.Method+" "+route.Path] = concreteRoutePath(route.Path)
+		}
+	}
+	return out
+}
