+// Upstream serves the engine-level OAuth callbacks of both namespaces without
+// the key middleware and writes a callback file for a pending session. With a
+// session pending, both methods on both callbacks are refused and nothing is
+// written; the same request on an unguarded engine writes the file.
+func TestManagementAllowlist_OAuthCallbackWithPendingSessionWritesNothing(t *testing.T) {
+	s := newAllowlistTestServer(t)
+	state := "allowlist-pending-oauth-state"
+	managementHandlers.RegisterOAuthSession(state, "anthropic")
+	defer managementHandlers.CompleteOAuthSession(state)
+	callbackPath := filepath.Join(s.cfg.AuthDir, ".oauth-anthropic-"+state+".oauth")
+	callbacks := []string{"/v0/management/oauth-callback", "/v8/management/oauth/callback"}
+
+	// Positive control: unguarded, the handler writes the callback file.
+	bare := gin.New()
+	bare.GET(callbacks[0], s.mgmt.GetOAuthCallback)
+	rr := httptest.NewRecorder()
+	bare.ServeHTTP(rr, allowlistRequest(http.MethodGet, callbacks[0]+"?state="+state+"&code=test-code", "", ""))
+	if rr.Code != http.StatusOK {
+		t.Fatalf("positive control: unguarded callback status = %d body=%q, want 200", rr.Code, rr.Body.String())
+	}
+	if _, err := os.Stat(callbackPath); err != nil {
+		t.Fatalf("positive control: unguarded callback wrote no file: %v", err)
+	}
+	if err := os.Remove(callbackPath); err != nil {
+		t.Fatalf("remove positive-control callback file: %v", err)
+	}
+
+	for _, callback := range callbacks {
+		for _, method := range []string{http.MethodGet, http.MethodPost} {
+			for _, key := range []string{"", allowlistTestKey} {
+				target := callback + "?state=" + state + "&code=test-code&provider=anthropic"
+				assertRefused(t, serveAllowlist(s, allowlistRequest(method, target, key, "")), method+" "+callback+" (pending session)")
+			}
+		}
+	}
+	if _, err := os.Stat(callbackPath); !errors.Is(err, os.ErrNotExist) {
+		t.Fatalf("callback file %s: stat err = %v, want not exist", callbackPath, err)
+	}
+}
