+	{http.MethodGet, "/v0/management//config.yaml"},
+	{http.MethodGet, "/v0/management//auth-files"},
+	{http.MethodGet, "/v0/management%2Fconfig.yaml"},
+	{http.MethodGet, "/v0/management%2fauth-files%2fdownload"},
+	{http.MethodGet, "/v0/management/auth-files%2Fdownload?name=x"},
+	{http.MethodGet, "/v0/%6danagement/config.yaml"},
+	{http.MethodGet, "/v0/management/auth%2Dfiles"},
