+// Every route the engine registers is in the committed reviewed table, with
+// its disposition, and the guard enforces that disposition: allowlisted
+// routes serve with the key, refused routes are a bare 404 with the key,
+// every other route is outside the guard's scope.
+func TestManagementAllowlist_RouteTableMatchesReview(t *testing.T) {
+	s := newAllowlistTestServer(t)
+	registered := make(map[string]string)
+	for _, route := range s.engine.Routes() {
+		registered[route.Method+" "+route.Path] = concreteRoutePath(route.Path)
+	}
+	var diffs []string
+	for key := range registered {
+		if _, ok := reviewedRouteTable[key]; !ok {
+			diffs = append(diffs, "registered but not reviewed: "+key)
+		}
+	}
+	for key := range reviewedRouteTable {
+		if _, ok := registered[key]; !ok {
+			diffs = append(diffs, "reviewed but no longer registered: "+key)
+		}
+	}
+	sort.Strings(diffs)
+	if len(diffs) > 0 {
+		t.Fatalf("the engine's routes differ from the reviewed route table; review each against the default-deny guard, then update reviewedRouteTable:\n  %s", strings.Join(diffs, "\n  "))
+	}
+	counts := map[reviewedRouteDisposition]int{}
+	v8Refused := 0
+	for key, concrete := range registered {
+		method := strings.SplitN(key, " ", 2)[0]
+		disposition := reviewedRouteTable[key]
+		counts[disposition]++
+		switch disposition {
+		case routeAllow:
+			target, ok := allowlistedManagementRoutes[key]
+			if !ok {
+				t.Fatalf("%s is reviewed as allowed but is not in the allowlist", key)
+			}
+			if rr := serveAllowlist(s, allowlistRequest(method, target, allowlistTestKey, "")); rr.Code != http.StatusOK {
+				t.Fatalf("%s: allowlisted status = %d, want 200 body=%q", key, rr.Code, rr.Body.String())
+			}
+		case routeRefuse:
+			assertRefused(t, serveAllowlist(s, allowlistRequest(method, concrete, allowlistTestKey, "")), key+" (management key)")
+			assertRefused(t, serveAllowlist(s, allowlistRequest(method, concrete, allowlistTestAPIKey, "")), key+" (API key)")
+			if strings.HasPrefix(key, method+" /v8/management") {
+				v8Refused++
+			}
+		case routeOpen:
+			if managementGuardRefuses(allowlistRequest(method, concrete, "", "")) {
+				t.Fatalf("%s is reviewed as open but the guard refuses it", key)
+			}
+			if isManagementRoutePath(strings.SplitN(key, " ", 2)[1]) {
+				t.Fatalf("%s is a management route reviewed as open", key)
+			}
+		}
+	}
+	if counts[routeAllow] != len(allowlistedManagementRoutes) {
+		t.Fatalf("%d routes reviewed as allowed, want exactly the %d allowlisted", counts[routeAllow], len(allowlistedManagementRoutes))
+	}
+	if v8Refused < 41 || counts[routeRefuse] < 180 {
+		t.Fatalf("refused %d routes (%d under /v8/management); enumeration broken?", counts[routeRefuse], v8Refused)
+	}
+	t.Logf("reviewed %d routes: %d allowed, %d refused (%d under /v8/management), %d open",
+		len(registered), counts[routeAllow], counts[routeRefuse], v8Refused, counts[routeOpen])
+}
