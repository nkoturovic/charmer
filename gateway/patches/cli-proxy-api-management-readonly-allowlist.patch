+// The spelling matrix: every way gin (decoded or raw path, extra slashes,
+// case, dot segments) or the NoRoute dispatcher could route a request to a
+// handler in scope, for both management namespaces, the plugin resources, the
+// control panel and the refused API surfaces.
+var managementBypassTargets = []struct{ method, target string }{
+	{http.MethodGet, "/v0/management"},
+	{http.MethodGet, "/v0/management/"},
+	{http.MethodGet, "//v0/management/config.yaml"},
