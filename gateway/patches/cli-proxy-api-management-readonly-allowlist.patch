+// Every source-level consumer of the management key in the module, by file
+// and count (selector references, so a method value or a renamed receiver
+// counts too). Audited consumers:
+//   - handlers/management/handler.go: Middleware() calls
+//     AuthenticateManagementKey;
+//   - redis_queue_protocol.go: the RESP surface, closed before any command is
+//     read (managementRESPOutputDisabled);
+//   - server_management.go: the /v0/management group and the NoRoute
+//     dispatcher, both behind the engine-level guard;
+//   - server_management_v8.go: the /v8/management group, refused entirely by
+//     the engine-level guard.
+//
+// A new consumer (an upstream bump) fails here until it is audited against
+// the allowlist.
+var auditedManagementKeyConsumers = map[string]int{
+	"AuthenticateManagementKey internal/api/handlers/management/handler.go": 1,
+	"AuthenticateManagementKey internal/api/redis_queue_protocol.go":        3,
+	"Middleware internal/api/server_management.go":                          2,
+	"Middleware internal/api/server_management_v8.go":                       1,
+}
+
+var managementKeyConsumerNames = map[string]struct{}{
+	"AuthenticateManagementKey": {},
+	"Middleware":                {},
+}
+
+const managementKeyHandlerFile = "internal/api/handlers/management/handler.go"
+
+func allowlistModuleRoot(t *testing.T) string {
+	t.Helper()
+	dir, err := os.Getwd()
+	if err != nil {
+		t.Fatalf("getwd: %v", err)
+	}
+	for {
+		data, errRead := os.ReadFile(filepath.Join(dir, "go.mod"))
+		if errRead == nil {
+			module := ""
+			for _, line := range strings.Split(string(data), "\n") {
+				if rest, ok := strings.CutPrefix(strings.TrimSpace(line), "module "); ok {
+					module = strings.TrimSpace(rest)
+					break
+				}
+			}
+			if module != "github.com/router-for-me/CLIProxyAPI/v8" {
+				t.Fatalf("%s/go.mod declares module %q, want github.com/router-for-me/CLIProxyAPI/v8", dir, module)
+			}
+			return dir
+		}
+		parent := filepath.Dir(dir)
+		if parent == dir {
+			t.Fatal("go.mod not found above the test directory")
+		}
+		dir = parent
+	}
+}
