+func TestManagementAllowlist_BypassVariantsRefused(t *testing.T) {
+	s := newAllowlistTestServer(t)
+	for _, tc := range managementBypassTargets {
+		for _, key := range []string{allowlistTestKey, allowlistTestAPIKey} {
+			assertRefused(t, serveAllowlist(s, allowlistRequest(tc.method, tc.target, key, "")), tc.method+" "+tc.target)
+		}
+	}
+	for _, tc := range managementTrailingSlashTargets {
+		label := tc.method + " " + tc.target
+		// Control: the engine alone redirects these, so the refusal below is
+		// the pre-routing guard's, not gin's.
+		if rr := serveEngine(s, allowlistRequest(tc.method, tc.target, allowlistTestKey, "")); rr.Code != http.StatusMovedPermanently && rr.Code != http.StatusTemporaryRedirect {
+			t.Fatalf("%s: engine status = %d, want gin's trailing-slash redirect (control)", label, rr.Code)
+		}
+		for _, key := range []string{allowlistTestKey, allowlistTestAPIKey, "wrong", ""} {
+			rr := serveAllowlist(s, allowlistRequest(tc.method, tc.target, key, ""))
+			assertRefused(t, rr, label)
+			if location := rr.Header().Get("Location"); location != "" {
+				t.Fatalf("%s: Location %q revealed a registered path", label, location)
+			}
+		}
+		preflight := allowlistRequest(http.MethodOptions, tc.target, "", "")
+		preflight.Header.Set("Access-Control-Request-Method", tc.method)
+		assertRefused(t, serveAllowlist(s, preflight), "OPTIONS "+tc.target)
+	}
+	for i := 0; i < 2; i++ {
+		for _, tc := range managementTrailingSlashTargets {
+			serveAllowlist(s, allowlistRequest(tc.method, tc.target, "wrong", ""))
+		}
+	}
+	assertNotBanned(t, s, "bad keys on trailing-slash spellings")
+}
