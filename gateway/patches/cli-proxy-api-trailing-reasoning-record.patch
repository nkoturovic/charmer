+// SSE framing: an extra empty separator is no event and waits with the run;
+// a field value loses only the one space after its colon, so an event name with
+// a trailing space is another event; a carriage return, a line of spaces or a
+// frame without its event line pass the reply unchanged.
+func TestClaudeTrailingRecordStreamFraming(t *testing.T) {
+	stop := func(field string) []byte { return []byte(field + "\ndata: {\"type\":\"message_stop\"}\n\n") }
+	trDriveCases(t, []trCase{
+		{"extra-blank-separator-in-the-queue", newTRStream().text("answer").record("a", true).raw([]byte("\n")).
+			end("end_turn"), 1},
+		{"extra-blank-separator-before-the-record", newTRStream().text("answer").raw([]byte("\n")).record("a", true).
+			end("end_turn"), 1},
+		{"event-name-without-a-space", newTRStream().text("answer").record("a", true).delta("end_turn").
+			raw(stop("event:message_stop")), 1},
+		{"event-name-with-a-trailing-space", newTRStream().text("answer").record("a", false).delta("end_turn").
+			raw(stop("event: message_stop ")), 0},
+		{"event-name-after-two-spaces", newTRStream().text("answer").record("a", false).delta("end_turn").
+			raw(stop("event:  message_stop")), 0},
+		{"carriage-return-in-a-frame", newTRStream().text("answer").record("a", false).
+			raw([]byte("event: ping\r\ndata: {\"type\":\"ping\"}\n\n")).end("end_turn"), 0},
+		{"a-line-of-spaces-ends-a-frame", newTRStream().text("answer").record("a", false).
+			raw([]byte("event: ping\ndata: {\"type\":\"ping\"}\n \n")).end("end_turn"), 0},
+		{"frame-without-an-event-line", newTRStream().text("answer").record("a", false).
+			raw([]byte("data: {\"type\":\"ping\"}\n\n")).end("end_turn"), 0},
+	})
