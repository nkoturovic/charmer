+	const oauthToken = "sk-ant-oat01-gwtest-fixture-token"
+	const account = "00000000-0000-4000-8000-00000000a11c"
+	oauth := func(attributes map[string]string) *cliproxyauth.Auth {
+		return &cliproxyauth.Auth{ID: "gwtest-trailing-oauth", Provider: "claude", Attributes: attributes,
+			Metadata: map[string]any{"type": "claude", "access_token": oauthToken, "email": "gwtest@example.invalid",
+				"account_uuid": account}}
+	}
+	return []trEntry{
+		{"third-party-api-key", func(server string) *cliproxyauth.Auth {
+			return &cliproxyauth.Auth{Attributes: map[string]string{"api_key": "dummy-gwtest-key", "base_url": server}}
+		}, false, true},
+		{"first-party-oauth", func(string) *cliproxyauth.Auth { return oauth(nil) }, true, false},
+		{"oauth-at-a-custom-origin", func(server string) *cliproxyauth.Auth {
+			return oauth(map[string]string{"base_url": server})
+		}, false, false},
+		{"api-key-at-anthropics-origin", func(string) *cliproxyauth.Auth {
+			return &cliproxyauth.Auth{Attributes: map[string]string{"api_key": "dummy-gwtest-key", "base_url": "https://api.anthropic.com"}}
+		}, true, false},
+		{"setup-token-as-api-key-at-a-custom-origin", func(server string) *cliproxyauth.Auth {
+			return &cliproxyauth.Auth{Attributes: map[string]string{"api_key": oauthToken, "base_url": server},
+				Metadata: map[string]any{"account_uuid": account}}
