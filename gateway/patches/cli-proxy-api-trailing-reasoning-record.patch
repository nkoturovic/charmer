@@ -0,0 +1,667 @@
+package executor
+
+import (
+	"bytes"
+	"context"
+	"encoding/json"
+	"fmt"
+	"net/http"
+	"net/http/httptest"
+	"net/url"
+	"strings"
+	"sync"
+	"testing"
+	"time"
+
+	"github.com/router-for-me/CLIProxyAPI/v8/internal/config"
+	cliproxyauth "github.com/router-for-me/CLIProxyAPI/v8/sdk/cliproxy/auth"
+	cliproxyexecutor "github.com/router-for-me/CLIProxyAPI/v8/sdk/cliproxy/executor"
+	sdktranslator "github.com/router-for-me/CLIProxyAPI/v8/sdk/translator"
+	log "github.com/sirupsen/logrus"
+)
+
+const trModel = "gwtest-trailing-model"
+
+func trEvent(kind string, data map[string]any) []byte {
+	raw, err := json.Marshal(data)
+	if err != nil {
+		panic(err)
+	}
+	return []byte("event: " + kind + "\ndata: " + string(raw) + "\n\n")
+}
+
+// trStream builds a streamed reply frame by frame, the way a Messages upstream
+// sends it, and records which frames belong to a trailing run the filter is to
+// leave out.
+type trStream struct {
+	frames  [][]byte
+	removed map[int]bool
+	index   int
+}
+
+func newTRStream() *trStream {
+	s := &trStream{removed: map[int]bool{}}
+	return s.raw(trEvent("message_start", map[string]any{"type": "message_start", "message": map[string]any{
+		"id": "msg_gwtest_trailing", "type": "message", "role": "assistant", "model": trModel, "content": []any{},
+		"stop_reason": nil, "stop_sequence": nil, "usage": map[string]any{"input_tokens": 7, "output_tokens": 1}}}))
+}
+
+func (s *trStream) raw(frame []byte) *trStream {
+	s.frames = append(s.frames, frame)
+	return s
+}
+
+func (s *trStream) block(start map[string]any, delta map[string]any, run bool) *trStream {
+	index := s.index
+	s.index++
+	if run {
+		s.removed[len(s.frames)] = true
+	}
+	s.raw(trEvent("content_block_start", map[string]any{"type": "content_block_start", "index": index, "content_block": start}))
+	if delta != nil {
+		s.raw(trEvent("content_block_delta", map[string]any{"type": "content_block_delta", "index": index, "delta": delta}))
+	}
+	if run {
+		s.removed[len(s.frames)] = true
+	}
+	return s.raw(trEvent("content_block_stop", map[string]any{"type": "content_block_stop", "index": index}))
+}
+
+func (s *trStream) thinking() *trStream {
+	return s.block(map[string]any{"type": "thinking", "thinking": "", "signature": ""},
+		map[string]any{"type": "thinking_delta", "thinking": "gwtest fixture reasoning"}, false)
+}
+
+func (s *trStream) text(text string) *trStream {
+	return s.block(map[string]any{"type": "text", "text": ""}, map[string]any{"type": "text_delta", "text": text}, false)
+}
+
+func (s *trStream) record(name string, run bool) *trStream {
+	return s.block(map[string]any{"type": "redacted_thinking", "data": claudeTrailingRecordPrefix + "gwtest-record-" + name}, nil, run)
+}
+
+func (s *trStream) redacted(data string) *trStream {
+	return s.block(map[string]any{"type": "redacted_thinking", "data": data}, nil, false)
+}
+
+func (s *trStream) toolUse() *trStream {
