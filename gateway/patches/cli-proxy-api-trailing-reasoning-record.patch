+// Only a third-party API-key entry has the run left out. First-party OAuth, an
+// OAuth credential at a custom origin, an API key at Anthropic's origin and a
+// setup token given as an API key get the very bytes that qualify on it,
+// unchanged, streamed and as one body.
+func TestClaudeTrailingRecordEntries(t *testing.T) {
+	logs := trCaptureLog(t)
+	stream := newTRStream().thinking().text("answer").record("a", true).end("end_turn")
+	body := []byte(`{"id":"msg_gwtest_trailing","type":"message","role":"assistant","model":"` + trModel +
+		`","content":[{"type":"thinking","thinking":"gwtest fixture reasoning","signature":""},{"type":"text","text":"answer"},` +
+		`{"type":"redacted_thinking","data":"` + claudeTrailingRecordPrefix + `gwtest-record-a"}],"stop_reason":"end_turn",` +
+		`"stop_sequence":null,"usage":{"input_tokens":7,"output_tokens":9}}`)
+	kept := omitClaudeTrailingRecord(context.Background(), true, body)
+	logs.take()
+	for _, entry := range trEntries() {
+		t.Run(entry.name+"/stream", func(t *testing.T) {
+			server := trServer(t, "text/event-stream", stream.bytes())
+			got, errs := trExecuteStream(t, trContext(t, entry, server), entry.auth(server.URL))
+			want, records := stream.bytes(), 0
+			if entry.removes {
+				want, records = stream.kept(), 1
+			}
+			if len(errs) != 0 || !bytes.Equal(got, want) {
+				t.Fatalf("errors %v, client stream:\n%s\nwant:\n%s", errs, got, want)
+			}
+			if lines := logs.take(); fmt.Sprint(lines) != fmt.Sprint(trWantLog(records)) {
+				t.Fatalf("log lines %q, want %q", lines, trWantLog(records))
+			}
+		})
+		t.Run(entry.name+"/unary", func(t *testing.T) {
+			server := trServer(t, "application/json", body)
+			resp, err := NewClaudeExecutor(&config.Config{}).Execute(trContext(t, entry, server), entry.auth(server.URL),
+				cliproxyexecutor.Request{Model: trModel, Payload: []byte(`{"model":"` + trModel +
+					`","max_tokens":16,"messages":[{"role":"user","content":"gwtest"}]}`)},
+				cliproxyexecutor.Options{SourceFormat: sdktranslator.FormatClaude, ResponseFormat: sdktranslator.FormatClaude})
+			want, records := body, 0
+			if entry.removes {
+				want, records = kept, 1
+			}
+			if err != nil || !bytes.Equal(resp.Payload, want) {
+				t.Fatalf("error %v, client body:\n%s\nwant:\n%s", err, resp.Payload, want)
+			}
+			if lines := logs.take(); fmt.Sprint(lines) != fmt.Sprint(trWantLog(records)) {
+				t.Fatalf("log lines %q, want %q", lines, trWantLog(records))
+			}
+		})
+	}
+}
+
+// A stream that ends early or errors while frames wait, with the client still
+// connected: every frame arrives once, unchanged and in order, before exactly
+// one error, the one the executor reports for that ending today. No end of the
+// message is invented.
+func TestClaudeTrailingRecordFailurePaths(t *testing.T) {
+	entry := trEntries()[0]
+	for _, tc := range trailingRecordFailures() {
+		t.Run(tc.name, func(t *testing.T) {
+			server := trServer(t, "text/event-stream", tc.stream.bytes())
+			got, errs := trExecuteStream(t, trContext(t, entry, server), entry.auth(server.URL))
+			if !bytes.Equal(got, tc.stream.bytes()) {
+				t.Fatalf("client stream:\n%s\nwant:\n%s", got, tc.stream.bytes())
+			}
+			if len(errs) != 1 {
+				t.Fatalf("errors %v, want exactly one", errs)
+			}
+			if strings.HasPrefix(tc.name, "end-") && !strings.Contains(errs[0].Error(), "message_stop") {
+				t.Fatalf("error %q, want the stream's truncation error", errs[0])
+			}
+			if bytes.Contains(got, []byte("message_stop")) {
+				t.Fatal("the client got a message_stop the upstream never sent")
+			}
+		})
+	}
+}
+
+// A client that goes away while the run waits gets nothing more: the response
+// goroutine drops the pending frames, sends nothing and ends.
+func TestClaudeTrailingRecordClientGoneWhileQueued(t *testing.T) {
+	stream := newTRStream().text("answer").record("a", true)
+	upstreamDone := make(chan struct{})
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		defer close(upstreamDone)
+		w.Header().Set("Content-Type", "text/event-stream")
+		_, _ = w.Write(stream.bytes())
+		w.(http.Flusher).Flush()
+		select {
+		case <-r.Context().Done():
+		case <-time.After(10 * time.Second):
+		}
+	}))
+	defer server.Close()
+	ctx, cancel := context.WithCancel(context.Background())
+	defer cancel()
+	result, err := NewClaudeExecutor(&config.Config{}).ExecuteStream(ctx, trEntries()[0].auth(server.URL), cliproxyexecutor.Request{
+		Model:   trModel,
+		Payload: []byte(`{"model":"` + trModel + `","max_tokens":16,"messages":[{"role":"user","content":"gwtest"}],"stream":true}`),
+	}, cliproxyexecutor.Options{SourceFormat: sdktranslator.FormatClaude, ResponseFormat: sdktranslator.FormatClaude})
+	if err != nil {
+		t.Fatalf("ExecuteStream: %v", err)
+	}
+	textStop := stream.frames[len(stream.frames)-3]
+	var received bytes.Buffer
+	for chunk := range result.Chunks {
+		received.Write(chunk.Payload)
+		if bytes.HasSuffix(received.Bytes(), textStop) {
+			break
+		}
+	}
+	// The record's frames are already read upstream; give the goroutine the
+	// time to queue them, then go away.
+	time.Sleep(50 * time.Millisecond)
+	cancel()
+	deadline := time.After(5 * time.Second)
+	for {
+		select {
+		case chunk, open := <-result.Chunks:
+			if !open {
+				if bytes.Contains(received.Bytes(), []byte("redacted_thinking")) {
+					t.Fatalf("a client that went away was sent the pending frames:\n%s", received.Bytes())
+				}
+				select {
+				case <-upstreamDone:
+				case <-time.After(5 * time.Second):
+					t.Fatal("the upstream request was not ended")
+				}
+				return
+			}
+			received.Write(chunk.Payload)
+		case <-deadline:
+			t.Fatal("the response goroutine did not end after the client went away")
+		}
+	}
+}
