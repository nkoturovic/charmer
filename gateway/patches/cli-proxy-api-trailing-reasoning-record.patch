+// kept is the stream the client is to get: every frame but the run's.
+func (s *trStream) kept() []byte {
+	var out [][]byte
+	for i, frame := range s.frames {
+		if !s.removed[i] {
+			out = append(out, frame)
+		}
+	}
+	return bytes.Join(out, nil)
+}
