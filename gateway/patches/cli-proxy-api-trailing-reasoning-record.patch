+const trModel = "gwtest-trailing-model"
+
+func trEvent(kind string, data map[string]any) []byte {
+	raw, err := json.Marshal(data)
+	if err != nil {
+		panic(err)
+	}
+	return []byte("event: " + kind + "\ndata: " + string(raw) + "\n\n")
+}
+
+// trStream builds a streamed reply frame by frame, the way a Messages upstream
+// sends it, and records which frames belong to a trailing run the filter is to
+// leave out.
+type trStream struct {
+	frames  [][]byte
+	removed map[int]bool
+	index   int
+}
+
+func newTRStream() *trStream {
+	s := &trStream{removed: map[int]bool{}}
+	return s.raw(trEvent("message_start", map[string]any{"type": "message_start", "message": map[string]any{
+		"id": "msg_gwtest_trailing", "type": "message", "role": "assistant", "model": trModel, "content": []any{},
+		"stop_reason": nil, "stop_sequence": nil, "usage": map[string]any{"input_tokens": 7, "output_tokens": 1}}}))
+}
+
+func (s *trStream) raw(frame []byte) *trStream {
+	s.frames = append(s.frames, frame)
+	return s
+}
+
+func (s *trStream) block(start map[string]any, delta map[string]any, run bool) *trStream {
+	index := s.index
+	s.index++
+	if run {
+		s.removed[len(s.frames)] = true
+	}
+	s.raw(trEvent("content_block_start", map[string]any{"type": "content_block_start", "index": index, "content_block": start}))
+	if delta != nil {
+		s.raw(trEvent("content_block_delta", map[string]any{"type": "content_block_delta", "index": index, "delta": delta}))
+	}
+	if run {
+		s.removed[len(s.frames)] = true
+	}
+	return s.raw(trEvent("content_block_stop", map[string]any{"type": "content_block_stop", "index": index}))
+}
+
+func (s *trStream) thinking() *trStream {
+	return s.block(map[string]any{"type": "thinking", "thinking": "", "signature": ""},
+		map[string]any{"type": "thinking_delta", "thinking": "gwtest fixture reasoning"}, false)
+}
+
+func (s *trStream) text(text string) *trStream {
+	return s.block(map[string]any{"type": "text", "text": ""}, map[string]any{"type": "text_delta", "text": text}, false)
+}
+
+func (s *trStream) record(name string, run bool) *trStream {
+	return s.block(map[string]any{"type": "redacted_thinking", "data": claudeTrailingRecordPrefix + "gwtest-record-" + name}, nil, run)
+}
+
+func (s *trStream) redacted(data string) *trStream {
+	return s.block(map[string]any{"type": "redacted_thinking", "data": data}, nil, false)
+}
+
+func (s *trStream) toolUse() *trStream {
+	return s.block(map[string]any{"type": "tool_use", "id": "toolu_gwtest_trailing", "name": "gwtest_tool", "input": map[string]any{}},
+		map[string]any{"type": "input_json_delta", "partial_json": `{"k":"v"}`}, false)
+}
+
+func (s *trStream) serverTool() *trStream {
+	s.block(map[string]any{"type": "server_tool_use", "id": "srvtoolu_gwtest", "name": "web_search",
+		"input": map[string]any{"query": "gwtest"}}, nil, false)
+	return s.block(map[string]any{"type": "web_search_tool_result", "tool_use_id": "srvtoolu_gwtest", "content": []any{}}, nil, false)
+}
+
+func (s *trStream) ping() *trStream { return s.raw(trEvent("ping", map[string]any{"type": "ping"})) }
+
+func (s *trStream) comment() *trStream { return s.raw([]byte(": gwtest keep-alive\n\n")) }
+
+func (s *trStream) unknown() *trStream {
+	return s.raw(trEvent("gwtest_unknown", map[string]any{"type": "gwtest_unknown"}))
+}
+
+func (s *trStream) delta(stop any) *trStream {
+	delta := map[string]any{"stop_sequence": nil}
+	if stop != nil {
+		delta["stop_reason"] = stop
+	}
+	return s.raw(trEvent("message_delta", map[string]any{"type": "message_delta", "delta": delta,
+		"usage": map[string]any{"output_tokens": 9}}))
+}
+
+func (s *trStream) stop() *trStream {
+	return s.raw(trEvent("message_stop", map[string]any{"type": "message_stop"}))
+}
+
+func (s *trStream) errorEvent() *trStream {
+	return s.raw(trEvent("error", map[string]any{"type": "error", "error": map[string]any{
+		"type": "overloaded_error", "message": "gwtest fixture overload"}}))
+}
+
+func (s *trStream) end(stop any) *trStream { return s.delta(stop).stop() }
+
+// startRaw adds a content_block_start frame whose data is written as given
+// (%d stands for the block's index, the next one) and the block's stop.
+func (s *trStream) startRaw(data string, run bool) *trStream {
+	index := s.index
+	s.index++
+	if run {
+		s.removed[len(s.frames)] = true
+	}
+	s.raw([]byte("event: content_block_start\ndata: " + fmt.Sprintf(data, index) + "\n\n"))
+	if run {
+		s.removed[len(s.frames)] = true
+	}
+	return s.raw(trEvent("content_block_stop", map[string]any{"type": "content_block_stop", "index": index}))
+}
+
+// deltaRaw adds a message_delta frame whose data is written as given.
+func (s *trStream) deltaRaw(data string) *trStream {
+	return s.raw([]byte("event: message_delta\ndata: " + data + "\n\n"))
+}
+
+// textWithDeltaAt adds a text block whose delta names the index at.
+func (s *trStream) textWithDeltaAt(at int) *trStream {
+	index := s.index
+	s.index++
+	s.raw(trEvent("content_block_start", map[string]any{"type": "content_block_start", "index": index,
+		"content_block": map[string]any{"type": "text", "text": ""}}))
+	s.raw(trEvent("content_block_delta", map[string]any{"type": "content_block_delta", "index": at,
+		"delta": map[string]any{"type": "text_delta", "text": "answer"}}))
+	return s.raw(trEvent("content_block_stop", map[string]any{"type": "content_block_stop", "index": index}))
+}
+
+// skip leaves one block index out.
+func (s *trStream) skip() *trStream {
+	s.index++
+	return s
+}
+
+// restart begins a second message in the same stream.
+func (s *trStream) restart() *trStream {
+	s.index = 0
+	return s.raw(newTRStream().frames[0])
+}
+
+func (s *trStream) bytes() []byte { return bytes.Join(s.frames, nil) }
+
+// kept is the stream the client is to get: every frame but the run's.
+func (s *trStream) kept() []byte {
+	var out [][]byte
+	for i, frame := range s.frames {
+		if !s.removed[i] {
+			out = append(out, frame)
+		}
+	}
+	return bytes.Join(out, nil)
+}
