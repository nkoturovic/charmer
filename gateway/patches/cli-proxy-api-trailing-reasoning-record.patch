+// trailingRecordOrigin answers every request the executor sends, whatever
+// origin it names, from a local server.
+type trailingRecordOrigin struct{ target *url.URL }
+
+func (o trailingRecordOrigin) RoundTrip(req *http.Request) (*http.Response, error) {
+	clone := req.Clone(req.Context())
+	clone.URL.Scheme, clone.URL.Host, clone.Host = o.target.Scheme, o.target.Host, o.target.Host
+	return http.DefaultTransport.RoundTrip(clone)
+}
