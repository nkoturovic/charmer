+// The one-body form: the run's elements and the separators before them are
+// cut, and every other byte is the body as it came.
+func TestClaudeTrailingRecordBody(t *testing.T) {
+	record := func(name string) string {
+		return `{"type":"redacted_thinking","data":"` + claudeTrailingRecordPrefix + `gwtest-record-` + name + `"}`
+	}
+	thinking := `{"type":"thinking","thinking":"gwtest fixture reasoning","signature":""}`
+	text := `{"type":"text","text":"answer"}`
+	body := func(stop string, blocks ...string) string {
+		return `{"id":"msg_gwtest_trailing","type":"message","role":"assistant","model":"` + trModel +
+			`","content":[` + strings.Join(blocks, ",") + `],"stop_reason":` + stop +
+			`,"stop_sequence":null,"usage":{"input_tokens":7,"output_tokens":9}}`
+	}
+	cases := []struct{ name, in, want string }{
+		{"one-record", body(`"end_turn"`, thinking, text, record("a")), body(`"end_turn"`, thinking, text)},
+		{"two-records", body(`"end_turn"`, thinking, text, record("a"), record("b")), body(`"end_turn"`, thinking, text)},
+		{"spacing-is-kept", "{\n  \"content\": [\n    " + text + " ,\n    " + record("a") + "\n  ],\n  \"stop_reason\": \"end_turn\"\n}\n",
+			"{\n  \"content\": [\n    " + text + "\n  ],\n  \"stop_reason\": \"end_turn\"\n}\n"},
+		{"no-record", body(`"end_turn"`, thinking, text), ""},
+		{"record-before-the-text", body(`"end_turn"`, thinking, record("a"), text), ""},
+		{"trailing-redacted-without-the-prefix", body(`"end_turn"`, text, `{"type":"redacted_thinking","data":"gwtest-provider-reasoning"}`), ""},
+		{"mixed-run", body(`"end_turn"`, text, record("a"), `{"type":"redacted_thinking","data":"gwtest-provider-reasoning"}`), ""},
+		{"record-only", body(`"end_turn"`, record("a")), ""},
+		{"thinking-then-record", body(`"end_turn"`, text, thinking, record("a")), ""},
+		{"tool-use-before", body(`"end_turn"`, `{"type":"tool_use","id":"toolu_gwtest","name":"gwtest_tool","input":{}}`, text, record("a")), ""},
+		{"server-tool", body(`"end_turn"`, `{"type":"server_tool_use","id":"srvtoolu_gwtest","name":"web_search","input":{}}`,
+			`{"type":"web_search_tool_result","tool_use_id":"srvtoolu_gwtest","content":[]}`, text, record("a")), ""},
+		{"stop-tool-use", body(`"tool_use"`, text, record("a")), ""},
+		{"stop-pause-turn", body(`"pause_turn"`, text, record("a")), ""},
+		{"stop-max-tokens", body(`"max_tokens"`, text, record("a")), ""},
+		{"stop-null", body(`null`, text, record("a")), ""},
+		{"stop-unknown", body(`"gwtest_unknown_reason"`, text, record("a")), ""},
+		{"stop-absent", `{"content":[` + text + `,` + record("a") + `]}`, ""},
+		{"content-twice", `{"content":[` + text + `,` + record("a") + `],"content":[` + text + `,` + record("a") + `],"stop_reason":"end_turn"}`, ""},
+		{"unknown-block", body(`"end_turn"`, `{"type":"gwtest_unknown"}`, text, record("a")), ""},
+		{"trailing-bytes", body(`"end_turn"`, text, record("a")) + `{}`, ""},
+		{"not-json", "event: message_start\ndata: {}\n\n", ""},
+	}
+	logs := trCaptureLog(t)
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			want, records := tc.want, 0
+			if want == "" {
+				want = tc.in
+			} else {
+				records = strings.Count(tc.in, claudeTrailingRecordPrefix)
+			}
+			if got := string(omitClaudeTrailingRecord(context.Background(), true, []byte(tc.in))); got != want {
+				t.Fatalf("body:\n%s\nwant:\n%s", got, want)
+			}
+			if got := logs.take(); fmt.Sprint(got) != fmt.Sprint(trWantLog(records)) {
+				t.Fatalf("log lines %q, want %q", got, trWantLog(records))
+			}
+			if got := string(omitClaudeTrailingRecord(context.Background(), false, []byte(tc.in))); got != tc.in {
+				t.Fatalf("an entry that does not qualify changed the body:\n%s", got)
+			}
+		})
+	}
+}
