+type trLog struct {
+	mu    sync.Mutex
+	lines []string
+}
+
+func (*trLog) Levels() []log.Level { return log.AllLevels }
+func (h *trLog) Fire(entry *log.Entry) error {
+	if strings.Contains(entry.Message, "openrouter reasoning record removed") {
+		h.mu.Lock()
+		h.lines = append(h.lines, entry.Level.String()+" "+entry.Message)
+		h.mu.Unlock()
+	}
+	return nil
+}
+
+func (h *trLog) take() []string {
+	h.mu.Lock()
+	defer h.mu.Unlock()
+	lines := h.lines
+	h.lines = nil
+	return lines
+}
+
+func trCaptureLog(t *testing.T) *trLog {
+	t.Helper()
+	hook := &trLog{}
+	logger := log.StandardLogger()
+	saved := make(log.LevelHooks)
+	for level, hooks := range logger.Hooks {
+		saved[level] = append([]log.Hook(nil), hooks...)
+	}
+	logger.AddHook(hook)
+	t.Cleanup(func() { logger.ReplaceHooks(saved) })
+	return hook
+}
+
+func trWantLog(records int) []string {
+	if records == 0 {
+		return nil
+	}
+	return []string{fmt.Sprintf("info openrouter reasoning record removed: records=%d", records)}
+}
+
+// drive pushes every frame through a filter, then ends the stream, and
+// returns what the client gets.
+func drive(s *claudeTrailingRecordStream, frames [][]byte) []byte {
+	var out [][]byte
+	for _, frame := range frames {
+		out = append(out, s.Push(frame)...)
+	}
+	out = append(out, s.End()...)
+	return bytes.Join(out, nil)
+}
+
+// A qualifying reply loses its run's frames and nothing else; every other
+// shape, and every stream that ends early, reaches the client unchanged.
+func TestClaudeTrailingRecordStreamShapes(t *testing.T) {
+	logs := trCaptureLog(t)
+	for _, tc := range append(trShapes(), trailingRecordFailures()...) {
+		t.Run(tc.name, func(t *testing.T) {
+			want := tc.stream.bytes()
+			if tc.records > 0 {
+				want = tc.stream.kept()
+			}
+			if got := drive(newClaudeTrailingRecordStream(context.Background(), true), tc.stream.frames); !bytes.Equal(got, want) {
+				t.Fatalf("client stream:\n%s\nwant:\n%s", got, want)
+			}
+			if got := logs.take(); fmt.Sprint(got) != fmt.Sprint(trWantLog(tc.records)) {
+				t.Fatalf("log lines %q, want %q", got, trWantLog(tc.records))
+			}
+		})
+	}
+}
+
+// Every frame up to the run's start goes out when it arrives: the answer text
+// is never held, and only the run's own frames and what follows them wait.
+func TestClaudeTrailingRecordStreamSendsTheTextAtOnce(t *testing.T) {
+	stream := newTRStream().thinking().text("answer").record("a", true).end("end_turn")
+	filter := newClaudeTrailingRecordStream(context.Background(), true)
+	first := len(stream.frames)
+	for i := range stream.frames {
+		if stream.removed[i] {
+			first = i
+			break
+		}
+	}
+	for i, frame := range stream.frames[:first] {
+		if got := filter.Push(frame); len(got) != 1 || !bytes.Equal(got[0], frame) {
+			t.Fatalf("frame %d: sent %q at arrival, want the frame itself", i, got)
+		}
+	}
+	for i, frame := range stream.frames[first : len(stream.frames)-1] {
+		if got := filter.Push(frame); got != nil {
+			t.Fatalf("frame %d after the text: sent %q, want it to wait for the message's end", first+i, got)
+		}
+	}
+}
+
+// With small test limits: a stream that keeps sending records past the byte
+// limit, and a frame that arrives after the time limit, each send every pending
+// frame once, in order; the rest passes as it arrives. A stream that goes
+// silent with frames pending gets them, in order, at its end.
+func TestClaudeTrailingRecordStreamLimits(t *testing.T) {
+	t.Run("bytes", func(t *testing.T) {
+		stream := newTRStream().text("answer")
+		for i := 0; i < 50; i++ {
+			stream.record(fmt.Sprint(i), false)
+		}
+		stream.end("end_turn")
+		filter := newClaudeTrailingRecordStream(context.Background(), true)
+		filter.maxBytes = 3 * len(stream.frames[4])
+		var out [][]byte
+		released := -1
+		for i, frame := range stream.frames {
+			sent := filter.Push(frame)
+			if released >= 0 && (len(sent) != 1 || !bytes.Equal(sent[0], frame)) {
+				t.Fatalf("frame %d after the release: sent %q, want the frame itself", i, sent)
+			}
+			if released < 0 && len(sent) > 1 {
+				released = i
+			}
+			out = append(out, sent...)
+		}
+		out = append(out, filter.End()...)
+		if released < 0 || released >= 10 {
+			t.Fatalf("released at frame %d, want within the byte limit", released)
+		}
+		if got := bytes.Join(out, nil); !bytes.Equal(got, stream.bytes()) {
+			t.Fatalf("client stream:\n%s\nwant:\n%s", got, stream.bytes())
+		}
+	})
+	t.Run("time", func(t *testing.T) {
+		stream := newTRStream().text("answer").record("a", false).ping().end("end_turn")
+		filter := newClaudeTrailingRecordStream(context.Background(), true)
+		clock := time.Unix(1_800_000_000, 0)
+		filter.now = func() time.Time { return clock }
+		filter.maxWait = 50 * time.Millisecond
+		var out [][]byte
+		for i, frame := range stream.frames {
+			if i == len(stream.frames)-3 { // the ping after the record
+				clock = clock.Add(filter.maxWait + time.Millisecond)
+				sent := filter.Push(frame)
+				if len(sent) != 3 {
+					t.Fatalf("late ping released %d frames, want the record's two and itself", len(sent))
+				}
+				out = append(out, sent...)
+				continue
+			}
+			out = append(out, filter.Push(frame)...)
+		}
+		out = append(out, filter.End()...)
+		if got := bytes.Join(out, nil); !bytes.Equal(got, stream.bytes()) {
+			t.Fatalf("client stream:\n%s\nwant:\n%s", got, stream.bytes())
+		}
+	})
+	t.Run("silent-then-end", func(t *testing.T) {
+		stream := newTRStream().text("answer").record("a", false)
+		filter := newClaudeTrailingRecordStream(context.Background(), true)
+		var out [][]byte
+		for _, frame := range stream.frames {
+			out = append(out, filter.Push(frame)...)
+		}
+		pending := filter.End()
+		if len(pending) != 2 {
+			t.Fatalf("end of stream released %d frames, want the record's two", len(pending))
+		}
+		if again := filter.End(); again != nil {
+			t.Fatalf("a second end released %q, want nothing", again)
+		}
+		if got := bytes.Join(append(out, pending...), nil); !bytes.Equal(got, stream.bytes()) {
+			t.Fatalf("client stream:\n%s\nwant:\n%s", got, stream.bytes())
+		}
+	})
+}
