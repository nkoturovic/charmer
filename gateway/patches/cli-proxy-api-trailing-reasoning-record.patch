+func trServer(t *testing.T, contentType string, body []byte) *httptest.Server {
+	t.Helper()
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, _ *http.Request) {
+		w.Header().Set("Content-Type", contentType)
+		_, _ = w.Write(body)
+	}))
+	t.Cleanup(server.Close)
+	return server
+}
+
+func trContext(t *testing.T, entry trEntry, server *httptest.Server) context.Context {
+	t.Helper()
+	ctx, cancel := context.WithTimeout(context.Background(), 20*time.Second)
+	t.Cleanup(cancel)
+	if entry.official {
+		target, _ := url.Parse(server.URL)
+		ctx = context.WithValue(ctx, "cliproxy.roundtripper", http.RoundTripper(trailingRecordOrigin{target}))
+	}
+	return ctx
+}
+
+func trExecuteStream(t *testing.T, ctx context.Context, auth *cliproxyauth.Auth) ([]byte, []error) {
+	t.Helper()
+	result, err := NewClaudeExecutor(&config.Config{}).ExecuteStream(ctx, auth, cliproxyexecutor.Request{
+		Model:   trModel,
+		Payload: []byte(`{"model":"` + trModel + `","max_tokens":16,"messages":[{"role":"user","content":"gwtest"}],"stream":true}`),
+	}, cliproxyexecutor.Options{SourceFormat: sdktranslator.FormatClaude, ResponseFormat: sdktranslator.FormatClaude})
+	if err != nil {
+		t.Fatalf("ExecuteStream: %v", err)
+	}
+	var out bytes.Buffer
+	var errs []error
+	for chunk := range result.Chunks {
+		if chunk.Err != nil {
+			errs = append(errs, chunk.Err)
+			continue
+		}
+		out.Write(chunk.Payload)
+	}
+	return out.Bytes(), errs
+}
