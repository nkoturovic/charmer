+		{"delta-for-another-block", newTRStream().textWithDeltaAt(5).record("a", false).end("end_turn"), 0},
+		{"delta-for-a-closed-block", newTRStream().text("answer").raw(closedDelta).record("a", false).end("end_turn"), 0},
+		{"text-index-out-of-sequence", newTRStream().skip().text("answer").record("a", false).end("end_turn"), 0},
+		{"record-index-out-of-sequence", newTRStream().text("answer").skip().record("a", false).end("end_turn"), 0},
+		{"second-record-index-out-of-sequence", newTRStream().text("answer").record("a", false).skip().
+			record("b", false).end("end_turn"), 0},
+		{"block-before-the-message-start", noStart.text("answer").record("a", false).end("end_turn"), 0},
+	})
+}
+
+// A Responses compaction summarizes through Execute with a Responses source
+// and a Claude response format, streamed and not: neither is a native Claude
+// Messages request, so a record in the summary reply is never left out.
+func TestClaudeTrailingRecordCompaction(t *testing.T) {
+	logs := trCaptureLog(t)
+	reply := []byte(`{"id":"msg_gwtest_trailing","type":"message","role":"assistant","model":"` + trModel +
+		`","content":[{"type":"text","text":"Sealed summary of the build."},{"type":"redacted_thinking","data":"` +
+		claudeTrailingRecordPrefix + `gwtest-record-a"}],"stop_reason":"end_turn","stop_sequence":null,` +
+		`"usage":{"input_tokens":7,"output_tokens":9}}`)
+	for _, stream := range []bool{false, true} {
+		t.Run("stream="+strconv.FormatBool(stream), func(t *testing.T) {
+			var hits atomic.Int32
+			server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, _ *http.Request) {
+				hits.Add(1)
+				w.Header().Set("Content-Type", "application/json")
+				_, _ = w.Write(reply)
+			}))
+			defer server.Close()
+			payload := []byte(`{"model":"` + trModel + `","stream":` + strconv.FormatBool(stream) + `,"input":[` +
+				`{"type":"message","role":"user","content":[{"type":"input_text","text":"Check the build next."}]},` +
+				`{"type":"message","role":"assistant","content":[{"type":"output_text","text":"OK, I will check the build."}]},` +
+				`{"type":"compaction_trigger"}]}`)
+			ctx, cancel := context.WithTimeout(context.Background(), 20*time.Second)
+			defer cancel()
+			executor := NewClaudeExecutor(&config.Config{})
+			req := cliproxyexecutor.Request{Model: trModel, Payload: payload}
+			opts := cliproxyexecutor.Options{SourceFormat: sdktranslator.FormatOpenAIResponse,
+				ResponseFormat: sdktranslator.FormatOpenAIResponse, Stream: stream, OriginalRequest: payload}
+			auth := trEntries()[0].auth(server.URL)
+			if stream {
+				result, err := executor.ExecuteStream(ctx, auth, req, opts)
+				if err != nil {
+					t.Fatalf("ExecuteStream: %v", err)
+				}
+				for chunk := range result.Chunks {
+					if chunk.Err != nil {
+						t.Fatalf("chunk error: %v", chunk.Err)
+					}
+				}
+			} else if _, err := executor.Execute(ctx, auth, req, opts); err != nil {
+				t.Fatalf("Execute: %v", err)
+			}
+			if got := hits.Load(); got != 1 {
+				t.Fatalf("summary requests %d, want 1", got)
+			}
+			if lines := logs.take(); len(lines) != 0 {
+				t.Fatalf("a compaction summary had a record left out: %q", lines)
+			}
+		})
+	}
+}
