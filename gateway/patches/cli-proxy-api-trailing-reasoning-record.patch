+		{"stop-pause-turn", body(`"pause_turn"`, text, record("a")), ""},
+		{"stop-max-tokens", body(`"max_tokens"`, text, record("a")), ""},
+		{"stop-null", body(`null`, text, record("a")), ""},
+		{"stop-unknown", body(`"gwtest_unknown_reason"`, text, record("a")), ""},
+		{"stop-absent", `{"content":[` + text + `,` + record("a") + `]}`, ""},
+		{"content-twice", `{"content":[` + text + `,` + record("a") + `],"content":[` + text + `,` + record("a") + `],"stop_reason":"end_turn"}`, ""},
+		{"unknown-block", body(`"end_turn"`, `{"type":"gwtest_unknown"}`, text, record("a")), ""},
+		{"trailing-bytes", body(`"end_turn"`, text, record("a")) + `{}`, ""},
+		{"not-json", "event: message_start\ndata: {}\n\n", ""},
+	}
+	logs := trCaptureLog(t)
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			want, records := tc.want, 0
+			if want == "" {
+				want = tc.in
+			} else {
+				records = strings.Count(tc.in, claudeTrailingRecordPrefix)
+			}
+			if got := string(omitClaudeTrailingRecord(context.Background(), true, []byte(tc.in))); got != want {
+				t.Fatalf("body:\n%s\nwant:\n%s", got, want)
+			}
+			if got := logs.take(); fmt.Sprint(got) != fmt.Sprint(trWantLog(records)) {
+				t.Fatalf("log lines %q, want %q", got, trWantLog(records))
+			}
+			if got := string(omitClaudeTrailingRecord(context.Background(), false, []byte(tc.in))); got != tc.in {
+				t.Fatalf("an entry that does not qualify changed the body:\n%s", got)
+			}
+		})
+	}
+}
