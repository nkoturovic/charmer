+// The entry test reads the credential's kind, the executor's OAuth-token
+// decision and the request's origin, nothing else.
+func TestClaudeTrailingRecordEntryPredicate(t *testing.T) {
+	key := func(attributes map[string]string) *cliproxyauth.Auth {
+		return &cliproxyauth.Auth{Attributes: attributes}
+	}
+	cases := []struct {
+		name  string
+		auth  *cliproxyauth.Auth
+		url   string
+		oauth bool
+		want  bool
+	}{
+		{"api-key-custom-origin", key(map[string]string{"api_key": "dummy-gwtest-key"}), "https://openrouter.example/api/v1/messages?beta=true", false, true},
+		{"api-key-loopback", key(map[string]string{"api_key": "dummy-gwtest-key"}), "http://127.0.0.1:8080/v1/messages?beta=true", false, true},
+		{"api-key-anthropic", key(map[string]string{"api_key": "dummy-gwtest-key"}), "https://api.anthropic.com/v1/messages?beta=true", false, false},
+		{"api-key-anthropic-port-443", key(map[string]string{"api_key": "dummy-gwtest-key"}), "https://api.anthropic.com:443/v1/messages", false, false},
+		{"api-key-anthropic-over-http", key(map[string]string{"api_key": "dummy-gwtest-key"}), "http://api.anthropic.com/v1/messages", false, true},
+		{"setup-token-as-api-key", key(map[string]string{"api_key": "sk-ant-oat01-gwtest-fixture"}), "https://openrouter.example/api/v1/messages", true, false},
+		{"oauth-kind-attribute", key(map[string]string{"api_key": "dummy-gwtest-key", "auth_kind": "oauth"}), "https://openrouter.example/api/v1/messages", false, false},
+		{"oauth-metadata", &cliproxyauth.Auth{Metadata: map[string]any{"access_token": "gwtest-access"}}, "https://openrouter.example/api/v1/messages", false, false},
+		{"no-credential", &cliproxyauth.Auth{}, "https://openrouter.example/api/v1/messages", false, false},
+		{"nil-auth", nil, "https://openrouter.example/api/v1/messages", false, false},
+		{"no-host", key(map[string]string{"api_key": "dummy-gwtest-key"}), "/v1/messages", false, false},
+	}
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			if got := claudeTrailingRecordEntry(tc.auth, tc.url, claudeFingerprintPolicy{AuthIsOAuthToken: tc.oauth}); got != tc.want {
+				t.Fatalf("claudeTrailingRecordEntry = %t, want %t", got, tc.want)
+			}
+		})
+	}
+}
