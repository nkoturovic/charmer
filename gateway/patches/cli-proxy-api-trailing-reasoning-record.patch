+// A client that goes away while the run waits gets nothing more: the response
+// goroutine drops the pending frames, sends nothing and ends.
+func TestClaudeTrailingRecordClientGoneWhileQueued(t *testing.T) {
+	stream := newTRStream().text("answer").record("a", true)
+	upstreamDone := make(chan struct{})
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		defer close(upstreamDone)
+		w.Header().Set("Content-Type", "text/event-stream")
+		_, _ = w.Write(stream.bytes())
+		w.(http.Flusher).Flush()
+		select {
+		case <-r.Context().Done():
+		case <-time.After(10 * time.Second):
+		}
+	}))
+	defer server.Close()
+	ctx, cancel := context.WithCancel(context.Background())
+	defer cancel()
+	result, err := NewClaudeExecutor(&config.Config{}).ExecuteStream(ctx, trEntries()[0].auth(server.URL), cliproxyexecutor.Request{
+		Model:   trModel,
+		Payload: []byte(`{"model":"` + trModel + `","max_tokens":16,"messages":[{"role":"user","content":"gwtest"}],"stream":true}`),
+	}, cliproxyexecutor.Options{SourceFormat: sdktranslator.FormatClaude, ResponseFormat: sdktranslator.FormatClaude})
+	if err != nil {
+		t.Fatalf("ExecuteStream: %v", err)
+	}
+	textStop := stream.frames[len(stream.frames)-3]
+	var received bytes.Buffer
+	for chunk := range result.Chunks {
+		received.Write(chunk.Payload)
+		if bytes.HasSuffix(received.Bytes(), textStop) {
+			break
+		}
+	}
+	// The record's frames are already read upstream; give the goroutine the
+	// time to queue them, then go away.
+	time.Sleep(50 * time.Millisecond)
+	cancel()
+	deadline := time.After(5 * time.Second)
+	for {
+		select {
+		case chunk, open := <-result.Chunks:
+			if !open {
+				if bytes.Contains(received.Bytes(), []byte("redacted_thinking")) {
+					t.Fatalf("a client that went away was sent the pending frames:\n%s", received.Bytes())
+				}
+				select {
+				case <-upstreamDone:
+				case <-time.After(5 * time.Second):
+					t.Fatal("the upstream request was not ended")
+				}
+				return
+			}
+			received.Write(chunk.Payload)
+		case <-deadline:
+			t.Fatal("the response goroutine did not end after the client went away")
+		}
+	}
+}
