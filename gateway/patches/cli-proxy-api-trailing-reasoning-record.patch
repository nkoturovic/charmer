diff --git a/internal/runtime/executor/claude_trailing_reasoning_record.go b/internal/runtime/executor/claude_trailing_reasoning_record.go
new file mode 100644
index 00000000..b4f45866
--- /dev/null
+++ b/internal/runtime/executor/claude_trailing_reasoning_record.go
@@ -0,0 +1,558 @@
+package executor
+
+import (
+	"bytes"
+	"context"
+	"encoding/json"
+	"errors"
+	"io"
+	"net/url"
+	"strings"
+	"time"
+
+	"github.com/router-for-me/CLIProxyAPI/v8/internal/runtime/executor/helps"
+	cliproxyauth "github.com/router-for-me/CLIProxyAPI/v8/sdk/cliproxy/auth"
+	cliproxyexecutor "github.com/router-for-me/CLIProxyAPI/v8/sdk/cliproxy/executor"
+)
+
+// OpenRouter's Messages endpoint can end a reply with its own reasoning record:
+// a redacted_thinking block whose data starts with this prefix, after the answer
+// text. Claude Code takes a one-shot result from the reply's last block, so such
+// a reply gives an empty result although the model answered. On a third-party
+// API-key entry, for a native Claude Messages request (Claude source and Claude
+// response format), the run of such records is left out of a reply when it
+// directly follows a text block, every other block of the reply is thinking,
+// redacted_thinking or text, and the reply ends with stop_reason end_turn.
+// Every member the decision reads is read by its exact name; a reply in which
+// one of them appears twice or in another case is passed unchanged. Nothing sent
+// is altered, reordered or renumbered, the text is never held, and no state
+// outlives one response. The client never receives a record left out, so it is
+// not part of that conversation from then on.
+const claudeTrailingRecordPrefix = "openrouter.reasoning:"
+
+// The limits of a stream's pending frames. Only frames that can still belong to
+// a trailing record wait: from the record's start to the end of the message
+// (the record, its stop, pings, comment and empty frames and the
+// message_delta). Past either limit the pending frames are sent in their
+// original order and the rest of the response passes unchanged.
+//
+// 8 MiB is about a million reasoning tokens at the size records were measured
+// at (1,477 bytes for 146 tokens, 2,905 for 343), and a single event may already
+// hold 50 MiB. The record and the end of the message arrive together, and 10 s
+// is far below the 300 s the client waits on a silent stream.
+//
+// The time limit is checked when the next frame arrives (a ping or a comment
+// frame counts) and at the end of the stream: no timer runs, so the executor
+// keeps one goroutine per response. An upstream that goes silent after a record
+// gives the client the silence it gives it today: the client waits until its own
+// idle limit or until the stream ends, and at the end of the stream the pending
+// frames are sent before the existing error.
+const (
+	claudeTrailingRecordMaxPendingBytes = 8 << 20
+	claudeTrailingRecordMaxPendingTime  = 10 * time.Second
+)
+
+// claudeTrailingRecordLine is the one Info line per removal, the same for a
+// stream and for one body: the number of records left out, never their content.
+// Its text is fixed; checks of a live gateway's log match on it.
+const claudeTrailingRecordLine = "openrouter reasoning record removed: records=%d"
+
+// claudeTrailingRecordEntry reports whether a request runs on a third-party
+// API-key entry: a credential classified as an API key, that is not an OAuth or
+// setup token given as one, sent to an origin that is not Anthropic's own. OAuth
+// and setup-token entries never qualify, at any origin.
+func claudeTrailingRecordEntry(auth *cliproxyauth.Auth, requestURL string, fp claudeFingerprintPolicy) bool {
+	if auth == nil || auth.AuthKind() != cliproxyauth.AuthKindAPIKey || fp.AuthIsOAuthToken {
+		return false
+	}
+	parsed, err := url.Parse(strings.TrimSpace(requestURL))
+	if err != nil || parsed.Host == "" {
+		return false
+	}
+	return !helps.IsAnthropicUpstreamURL(parsed)
+}
+
+func claudeTrailingRecordAllowedBlock(kind string) bool {
+	return kind == "text" || kind == "thinking" || kind == "redacted_thinking"
+}
+
+// claudeTrailingRecordFields returns the members of one JSON object that the
+// decision reads, by their exact names. ok is false unless raw is exactly one
+// JSON object in which none of names appears twice or in another case: a
+// decoder that matches names regardless of case (Go's encoding/json among
+// them) or keeps another of a duplicate's values could read such an object as
+// another block than the one seen here, so the reply is then passed unchanged.
+func claudeTrailingRecordFields(raw []byte, names ...string) (map[string]json.RawMessage, bool) {
+	dec := json.NewDecoder(bytes.NewReader(raw))
+	if token, err := dec.Token(); err != nil || token != json.Delim('{') {
+		return nil, false
+	}
+	fields := make(map[string]json.RawMessage, len(names))
+	for dec.More() {
+		token, err := dec.Token()
+		if err != nil {
+			return nil, false
+		}
+		key, isKey := token.(string)
+		var value json.RawMessage
+		if !isKey || dec.Decode(&value) != nil {
+			return nil, false
+		}
+		for _, name := range names {
+			if !strings.EqualFold(key, name) {
+				continue
+			}
+			if _, seen := fields[name]; seen || key != name {
+				return nil, false
+			}
+			fields[name] = value
+		}
+	}
+	if token, err := dec.Token(); err != nil || token != json.Delim('}') {
+		return nil, false
+	}
+	if _, err := dec.Token(); !errors.Is(err, io.EOF) {
+		return nil, false
+	}
+	return fields, true
+}
+
+// claudeTrailingRecordString is a member's value when it is a JSON string.
+func claudeTrailingRecordString(raw json.RawMessage) (string, bool) {
+	var value string
+	if len(raw) == 0 || raw[0] != '"' || json.Unmarshal(raw, &value) != nil {
+		return "", false
+	}
+	return value, true
+}
+
+// claudeTrailingRecordIndex is a block index: a JSON integer, never negative.
+func claudeTrailingRecordIndex(raw json.RawMessage) (int64, bool) {
+	var value int64
+	if len(raw) == 0 || raw[0] < '0' || raw[0] > '9' || json.Unmarshal(raw, &value) != nil {
+		return 0, false
+	}
+	return value, true
+}
+
+// claudeTrailingRecordBlock reads one content block: its type, and whether it
+// is one of OpenRouter's records. ok is false for a block the decision cannot
+// read unambiguously.
+func claudeTrailingRecordBlock(raw json.RawMessage) (kind string, record, ok bool) {
+	fields, ok := claudeTrailingRecordFields(raw, "type", "data")
+	if !ok {
+		return "", false, false
+	}
+	if kind, ok = claudeTrailingRecordString(fields["type"]); !ok {
+		return "", false, false
+	}
+	data, isString := claudeTrailingRecordString(fields["data"])
+	return kind, kind == "redacted_thinking" && isString && strings.HasPrefix(data, claudeTrailingRecordPrefix), true
+}
+
+// omitClaudeTrailingRecord returns a non-streaming Messages body without its
+// trailing record run when entry qualifies and the body does; otherwise body
+// itself. Only the run's elements and the separators before them are cut, from
+// the end of the text element they follow to the end of the last record: every
+// other byte is the body as it came.
+func omitClaudeTrailingRecord(ctx context.Context, entry bool, body []byte) []byte {
+	if !entry {
+		return body
+	}
+	cut, end, records, ok := claudeTrailingRecordSpan(body)
+	if !ok {
+		return body
+	}
+	helps.LogWithRequestID(ctx).Infof(claudeTrailingRecordLine, records)
+	out := make([]byte, 0, len(body)-(end-cut))
+	out = append(out, body[:cut]...)
+	return append(out, body[end:]...)
+}
+
+// claudeTrailingRecordSpan finds the byte span [cut, end) of a body's trailing
+// record run. ok is false unless the body is one JSON object with exactly one
+// content array and one stop_reason, neither of them (nor type) also present
+// in another case, the stop reason is end_turn, every element is a text,
+// thinking or redacted_thinking block read by its exact keys, and the content
+// ends in one or more records directly after a text block.
+func claudeTrailingRecordSpan(body []byte) (cut, end, records int, ok bool) {
+	type element struct {
+		start, end int
+		kind       string
+		record     bool
+	}
+	dec := json.NewDecoder(bytes.NewReader(body))
+	if token, err := dec.Token(); err != nil || token != json.Delim('{') {
+		return 0, 0, 0, false
+	}
+	var elements []element
+	var stop json.RawMessage
+	seen := map[string]bool{}
+	for dec.More() {
+		token, err := dec.Token()
+		if err != nil {
+			return 0, 0, 0, false
+		}
+		key, _ := token.(string)
+		for _, name := range []string{"type", "content", "stop_reason"} {
+			if strings.EqualFold(key, name) {
+				if key != name || seen[name] {
+					return 0, 0, 0, false
+				}
+				seen[name] = true
+			}
+		}
+		switch key {
+		case "content":
+			if token, err = dec.Token(); err != nil || token != json.Delim('[') {
+				return 0, 0, 0, false
+			}
+			for dec.More() {
+				var raw json.RawMessage
+				if err = dec.Decode(&raw); err != nil {
+					return 0, 0, 0, false
+				}
+				kind, record, readable := claudeTrailingRecordBlock(raw)
+				if !readable || !claudeTrailingRecordAllowedBlock(kind) {
+					return 0, 0, 0, false
+				}
+				offset := int(dec.InputOffset())
+				elements = append(elements, element{start: offset - len(raw), end: offset, kind: kind, record: record})
+			}
+			if token, err = dec.Token(); err != nil || token != json.Delim(']') {
+				return 0, 0, 0, false
+			}
+		case "stop_reason":
+			if err = dec.Decode(&stop); err != nil {
+				return 0, 0, 0, false
+			}
+		default:
+			var skipped json.RawMessage
+			if err = dec.Decode(&skipped); err != nil {
+				return 0, 0, 0, false
+			}
+		}
+	}
+	if token, err := dec.Token(); err != nil || token != json.Delim('}') {
+		return 0, 0, 0, false
+	}
+	if _, err := dec.Token(); !errors.Is(err, io.EOF) {
+		return 0, 0, 0, false
+	}
+	if reason, isString := claudeTrailingRecordString(stop); !seen["content"] || !isString || reason != "end_turn" {
+		return 0, 0, 0, false
+	}
+	last := len(elements)
+	for last > 0 && elements[last-1].record {
+		last--
+	}
+	records = len(elements) - last
+	if records == 0 || last == 0 || elements[last-1].kind != "text" {
+		return 0, 0, 0, false
+	}
+	return elements[last-1].end, elements[len(elements)-1].end, records, true
+}
+
+// claudeStreamFrame is what the stream filter reads from one complete SSE event.
+type claudeStreamFrame struct {
+	// kind is the event type; "comment" for a comment-only frame, "blank" for a
+	// frame of empty lines only (an extra separator), "unknown" otherwise.
+	kind         string
+	index        int64
+	blockType    string
+	record       bool
+	stopReason   *string
+	contentEmpty bool
+}
+
+// claudeStreamFieldValue is an SSE field's value: what follows the colon,
+// without the one space that may follow it. Nothing else is trimmed.
+func claudeStreamFieldValue(line []byte, field string) []byte {
+	return bytes.TrimPrefix(line[len(field)+1:], []byte(" "))
+}
+
+func parseClaudeStreamFrame(frame []byte) claudeStreamFrame {
+	unknown := claudeStreamFrame{kind: "unknown"}
+	// A carriage return ends a line for an event-stream client wherever it
+	// stands; the executor splits lines at line feeds only, so a client could
+	// read a frame that holds one as other events than the ones read here.
+	if bytes.IndexByte(frame, '\r') >= 0 {
+		return unknown
+	}
+	var name []byte
+	named := false
+	var data [][]byte
+	comments := 0
+	for _, line := range bytes.Split(frame, []byte("\n")) {
+		switch {
+		case len(line) == 0:
+		case line[0] == ':':
+			comments++
+		case bytes.HasPrefix(line, []byte("event:")):
+			if named {
+				return unknown
+			}
+			name, named = claudeStreamFieldValue(line, "event"), true
+		case bytes.HasPrefix(line, []byte("data:")):
+			data = append(data, claudeStreamFieldValue(line, "data"))
+		default:
+			// Another field, or a line of spaces: the executor ends a frame at a
+			// line of spaces, an event-stream client does not.
+			return unknown
+		}
+	}
+	if len(data) == 0 {
+		switch {
+		case named:
+			return unknown
+		case comments > 0:
+			return claudeStreamFrame{kind: "comment"}
+		default:
+			return claudeStreamFrame{kind: "blank"}
+		}
+	}
+	fields, ok := claudeTrailingRecordFields(bytes.Join(data, []byte("\n")), "type", "index", "content_block", "delta", "message")
+	if !ok {
+		return unknown
+	}
+	kind, ok := claudeTrailingRecordString(fields["type"])
+	if !ok || !named || kind != string(name) {
+		return unknown
+	}
+	parsed := claudeStreamFrame{kind: kind}
+	switch kind {
+	case "message_start":
+		message, readable := claudeTrailingRecordFields(fields["message"], "content")
+		if !readable {
+			return unknown
+		}
+		var content []json.RawMessage
+		parsed.contentEmpty = len(message["content"]) > 0 && message["content"][0] == '[' &&
+			json.Unmarshal(message["content"], &content) == nil && len(content) == 0
+	case "content_block_start":
+		index, readable := claudeTrailingRecordIndex(fields["index"])
+		if !readable {
+			return unknown
+		}
+		blockType, record, readable := claudeTrailingRecordBlock(fields["content_block"])
+		if !readable {
+			return unknown
+		}
+		parsed.index, parsed.blockType, parsed.record = index, blockType, record
+	case "content_block_delta", "content_block_stop":
+		index, readable := claudeTrailingRecordIndex(fields["index"])
+		if !readable {
+			return unknown
+		}
+		parsed.index = index
+	case "message_delta":
+		delta, readable := claudeTrailingRecordFields(fields["delta"], "stop_reason")
+		if !readable {
+			return unknown
+		}
+		if reason, isString := claudeTrailingRecordString(delta["stop_reason"]); isString {
+			parsed.stopReason = &reason
+		}
+	case "message_stop", "ping", "error":
+	default:
+		return unknown
+	}
+	return parsed
+}
+
+type claudeTrailingRecordState int
+
+const (
+	claudeTrailingRecordWatching claudeTrailingRecordState = iota
+	claudeTrailingRecordQueued
+	claudeTrailingRecordPassing
+)
+
+type claudeQueuedFrame struct {
+	data   []byte
+	record bool
+}
+
+// claudeTrailingRecordStream decides, frame by frame, what a streamed reply's
+// client is sent. It runs in the executor's response goroutine; nothing else
+// touches it. It reads one message: a second message_start, a block out of
+// sequence or a delta for a block that is not open passes the rest unchanged,
+// so nothing seen before a message can authorize a removal in it.
+type claudeTrailingRecordStream struct {
+	ctx      context.Context
+	maxBytes int
+	maxWait  time.Duration
+	now      func() time.Time
+
+	state       claudeTrailingRecordState
+	started     bool   // the message_start passed
+	next        int64  // the index the next content block is to have
+	open        string // the type of the block open now, "" when none is
+	openIndex   int64
+	lastStopped string // the type of the block stopped last
+	delta       bool   // a message_delta passed while watching
+
+	queue      []claudeQueuedFrame
+	pending    int
+	queuedAt   time.Time
+	runOpen    bool
+	runIndex   int64
+	records    int
+	deltaQueue bool
+}
+
+// newClaudeTrailingRecordStream is nil unless the entry qualifies: the
+// executor then sends every frame as it always did.
+func newClaudeTrailingRecordStream(ctx context.Context, entry bool) *claudeTrailingRecordStream {
+	if !entry {
+		return nil
+	}
+	return &claudeTrailingRecordStream{ctx: ctx, maxBytes: claudeTrailingRecordMaxPendingBytes,
+		maxWait: claudeTrailingRecordMaxPendingTime, now: time.Now}
+}
+
+// Push takes the next complete event and returns the frames to send now, in
+// order: the frame itself, nothing while it waits, or the frames that waited.
+func (s *claudeTrailingRecordStream) Push(frame []byte) [][]byte {
+	if s == nil || s.state == claudeTrailingRecordPassing {
+		return [][]byte{frame}
+	}
+	event := parseClaudeStreamFrame(frame)
+	if s.state == claudeTrailingRecordQueued {
+		return s.queued(frame, event)
+	}
+	switch event.kind {
+	case "message_start":
+		if s.started || !event.contentEmpty {
+			s.state = claudeTrailingRecordPassing
+		}
+		s.started = true
+	case "content_block_start":
+		switch {
+		case !s.started || event.index != s.next || !claudeTrailingRecordAllowedBlock(event.blockType):
+			s.state = claudeTrailingRecordPassing
+		case event.record && s.open == "" && s.lastStopped == "text" && !s.delta:
+			s.state, s.queuedAt = claudeTrailingRecordQueued, s.now()
+			return s.queued(frame, event)
+		case s.open != "":
+			s.state = claudeTrailingRecordPassing
+		default:
+			s.open, s.openIndex = event.blockType, event.index
+			s.next++
+		}
+	case "content_block_delta":
+		if s.open == "" || event.index != s.openIndex {
+			s.state = claudeTrailingRecordPassing
+		}
+	case "content_block_stop":
+		if s.open == "" || event.index != s.openIndex {
+			s.state = claudeTrailingRecordPassing
+		} else {
+			s.lastStopped, s.open = s.open, ""
+		}
+	case "message_delta":
+		s.delta = true
+	case "ping", "comment", "blank":
+	default: // message_stop, error, an event type the filter does not know
+		s.state = claudeTrailingRecordPassing
+	}
+	return [][]byte{frame}
+}
+
+// queued handles a frame while a run waits: it extends the run, waits with it,
+// ends it (the record is left out) or releases everything in arrival order.
+func (s *claudeTrailingRecordStream) queued(frame []byte, event claudeStreamFrame) [][]byte {
+	if s.now().Sub(s.queuedAt) > s.maxWait || s.pending+len(frame) > s.maxBytes {
+		return s.release(frame)
+	}
+	record := false
+	switch event.kind {
+	case "content_block_start":
+		if !event.record || s.runOpen || s.deltaQueue || event.index != s.next {
+			return s.release(frame)
+		}
+		record, s.runOpen, s.runIndex = true, true, event.index
+		s.next++
+		s.records++
+	case "content_block_stop":
+		if !s.runOpen || event.index != s.runIndex {
+			return s.release(frame)
+		}
+		record, s.runOpen = true, false
+	case "ping", "comment", "blank":
+	case "message_delta":
+		if s.runOpen || s.deltaQueue || event.stopReason == nil || *event.stopReason != "end_turn" {
+			return s.release(frame)
+		}
+		s.deltaQueue = true
+	case "message_stop":
+		if s.runOpen || !s.deltaQueue {
+			return s.release(frame)
+		}
+		frames := make([][]byte, 0, len(s.queue)+1)
+		for _, queued := range s.queue {
+			if !queued.record {
+				frames = append(frames, queued.data)
+			}
+		}
+		helps.LogWithRequestID(s.ctx).Infof(claudeTrailingRecordLine, s.records)
+		s.queue, s.pending, s.state = nil, 0, claudeTrailingRecordPassing
+		return append(frames, frame)
+	default: // a delta inside the run, an error, an event type the filter does not know
+		return s.release(frame)
+	}
+	s.queue = append(s.queue, claudeQueuedFrame{data: frame, record: record})
+	s.pending += len(frame)
+	return nil
+}
+
+// release returns every waiting frame in arrival order, then frame (when not
+// nil), and lets the rest of the response pass unchanged.
+func (s *claudeTrailingRecordStream) release(frame []byte) [][]byte {
+	frames := make([][]byte, 0, len(s.queue)+1)
+	for _, queued := range s.queue {
+		frames = append(frames, queued.data)
+	}
+	if frame != nil {
+		frames = append(frames, frame)
+	}
+	s.queue, s.pending, s.state = nil, 0, claudeTrailingRecordPassing
+	return frames
+}
+
+// Failed takes a frame after the executor's own observation of the stream
+// found it failed (an error event, a refusal in the message_delta): the frames
+// that waited go first, in arrival order, then frame, and the rest of the
+// response passes unchanged. A failed stream never has a record left out.
+func (s *claudeTrailingRecordStream) Failed(frame []byte) [][]byte {
+	if s == nil {
+		return [][]byte{frame}
+	}
+	return s.release(frame)
+}
+
+// End returns the frames still waiting when the stream ends before its
+// message_stop (an early end, a scanner or restore error): they are sent, in
+// order, before the executor reports the error it reports today.
+func (s *claudeTrailingRecordStream) End() [][]byte {
+	if s == nil || s.state != claudeTrailingRecordQueued {
+		return nil
+	}
+	return s.release(nil)
+}
+
+// sendClaudeStreamFrames sends frames in order and reports false once the
+// client has gone away: nothing more is sent then, and no send blocks.
+func sendClaudeStreamFrames(ctx context.Context, out chan<- cliproxyexecutor.StreamChunk, frames [][]byte) bool {
+	for _, frame := range frames {
+		if ctx.Err() != nil {
+			return false
+		}
+		select {
+		case out <- cliproxyexecutor.StreamChunk{Payload: frame}:
+		case <-ctx.Done():
+			return false
+		}
+	}
+	return true
+}
