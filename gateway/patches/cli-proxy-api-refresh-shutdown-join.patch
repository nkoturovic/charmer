+package auth
+
+import (
+	"context"
+	"errors"
+	"net/http"
+	"sync"
+	"sync/atomic"
+	"testing"
+	"time"
+)
+
+func TestRefreshShutdownFencesRequestAdmission(t *testing.T) {
+	var calls atomic.Int32
+	m := shutdownRefreshManager(t, &shutdownRefreshStore{}, func(_ context.Context, a *Auth) (*Auth, error) {
+		calls.Add(1)
+		return shutdownRefreshReplacement(a), nil
+	})
+	// Positive control: the executor is usable before shutdown.
+	if _, err := m.ForceRefreshAuth(context.Background(), "shutdown-fixture"); err != nil {
+		t.Fatal(err)
+	}
+	if calls.Load() != 1 {
+		t.Fatal("refresh positive control did not run")
+	}
+	if err := m.StopAutoRefreshAndWait(context.Background()); err != nil {
+		t.Fatal(err)
+	}
+	for name, call := range map[string]func() error{
+		"request": func() error {
+			_, err := m.refreshAuthForRequest(context.Background(), "shutdown-fixture", "")
+			return err
+		},
+		"forced": func() error { _, err := m.ForceRefreshAuth(context.Background(), "shutdown-fixture"); return err },
+		"epoch": func() error {
+			_, err := m.refreshAuthForRequestAtEpoch(context.Background(), "shutdown-fixture", "", 0)
+			return err
+		},
+	} {
+		t.Run(name, func(t *testing.T) {
+			if err := call(); !errors.Is(err, context.Canceled) {
+				t.Fatalf("refresh admitted after shutdown: %v", err)
+			}
+		})
+	}
+	m.mu.RLock()
+	a := m.auths["shutdown-fixture"].Clone()
+	m.mu.RUnlock()
+	if _, retried := m.tryRefreshAfterUnauthorized(context.Background(), a, &Error{HTTPStatus: http.StatusUnauthorized}, false); retried {
+		t.Error("401 recovery admitted after shutdown")
+	}
+	m.StartAutoRefresh(context.Background(), time.Hour)
+	m.mu.RLock()
+	loop := m.refreshLoop
+	m.mu.RUnlock()
+	if loop != nil {
+		t.Error("background loop admitted after shutdown")
+	}
+	if calls.Load() != 1 {
+		t.Fatalf("executor calls after shutdown = %d, want the positive control only", calls.Load())
+	}
+}
+
+func TestRefreshShutdownRequestAdmissionRace(t *testing.T) {
+	entered, cancelled := make(chan struct{}), make(chan struct{})
+	hold, release := shutdownRefreshRelease(t)
+	var calls atomic.Int32
+	store := &shutdownRefreshStore{}
+	m := shutdownRefreshManager(t, store, func(ctx context.Context, a *Auth) (*Auth, error) {
+		if calls.Add(1) != 1 {
+			t.Error("a queued refresh reached the provider after shutdown")
+			return nil, context.Canceled
+		}
+		close(entered)
+		<-ctx.Done()
+		close(cancelled)
+		<-hold
+		return shutdownRefreshReplacement(a), nil
+	})
+	ctx, cancel := context.WithCancel(context.Background())
+	var requests sync.WaitGroup
+	t.Cleanup(func() { cancel(); release(); requests.Wait() })
+	requests.Add(1)
+	go func() { defer requests.Done(); _, _ = m.ForceRefreshAuth(ctx, "shutdown-fixture") }()
+	shutdownRefreshSignal(t, entered)
+	const competing = 16
+	start := make(chan struct{})
+	for i := 0; i < competing; i++ {
+		requests.Add(1)
+		go func() {
+			defer requests.Done()
+			<-start
+			_, _ = m.ForceRefreshAuth(ctx, "shutdown-fixture")
+		}()
+	}
+	close(start)
+	done := shutdownRefreshJoin(m)
+	select {
+	case <-cancelled:
+	case err := <-done:
+		t.Fatalf("join returned while an inline refresh was active: %v", err)
+	case <-time.After(5 * time.Second):
+		t.Fatal("shutdown did not cancel the admitted inline refresh")
+	}
+	// Contending starts share the same admission fence as request refreshes.
+	for i := 0; i < competing; i++ {
+		requests.Add(1)
+		go func() { defer requests.Done(); m.StartAutoRefresh(ctx, time.Hour) }()
+	}
+	shutdownRefreshBlocked(t, done)
+	release()
+	shutdownRefreshJoined(t, done, store)
+	requests.Wait()
+	if calls.Load() != 1 {
+		t.Fatalf("provider refreshes = %d, want 1", calls.Load())
+	}
+	m.mu.RLock()
+	loop := m.refreshLoop
+	m.mu.RUnlock()
+	if loop != nil {
+		t.Fatal("concurrent start escaped the shutdown fence")
+	}
+}
+
+func TestRefreshShutdownBackgroundStopKeepsRequest(t *testing.T) {
+	entered := make(chan struct{})
+	hold, release := shutdownRefreshRelease(t)
+	var wasCancelled atomic.Bool
+	m := shutdownRefreshManager(t, &shutdownRefreshStore{}, func(ctx context.Context, a *Auth) (*Auth, error) {
+		close(entered)
+		<-hold
+		wasCancelled.Store(ctx.Err() != nil)
+		return shutdownRefreshReplacement(a), nil
+	})
+	done := make(chan error, 1)
+	go func() { _, err := m.ForceRefreshAuth(context.Background(), "shutdown-fixture"); done <- err }()
+	shutdownRefreshSignal(t, entered)
+	m.StopAutoRefresh() // scheduler-only cancellation is not service shutdown
+	release()
+	select {
+	case err := <-done:
+		if err != nil {
+			t.Fatal(err)
+		}
+	case <-time.After(5 * time.Second):
+		t.Fatal("request refresh did not finish after scheduler stop")
+	}
+	if wasCancelled.Load() {
+		t.Fatal("scheduler-only stop cancelled an independent request refresh")
+	}
+}
