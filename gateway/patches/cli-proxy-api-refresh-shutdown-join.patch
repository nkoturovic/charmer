+				joinCtx, cancelJoin := context.WithTimeout(context.Background(), 5*time.Second)
+				defer cancelJoin()
+				go func() { next <- m.StopAutoRefreshAndWait(joinCtx) }()
+				joined = next
+			} else {
+				select {
+				case <-exec.cancelled:
+				case err := <-stopped:
+					t.Fatalf("shutdown returned before admitted inline refresh: %v", err)
+				case <-time.After(5 * time.Second):
+					t.Fatal("inline refresh was not cancelled by shutdown")
+				}
+			}
+			serviceShutdownBlocked(t, joined)
+			releaseExecutor()
+			serviceShutdownSignal(t, store.entered)
+			serviceShutdownBlocked(t, joined)
+			releaseStore()
+			select {
+			case message := <-hook.messages:
+				if !strings.Contains(message, "result=persisted ") {
+					t.Fatal("missing durable-save receipt")
+				}
+			case <-time.After(5 * time.Second):
+				t.Fatal("inline refresh did not report its durable save")
+			}
+			serviceShutdownBlocked(t, joined)
+			releaseReceipt()
+			select {
+			case err := <-joined:
+				if err != nil {
+					t.Fatal(err)
+				}
+			case <-time.After(5 * time.Second):
+				t.Fatal("join did not complete after the receipt")
+			}
+			serviceShutdownSignal(t, requestFinished)
+			if requestErr != nil {
+				t.Fatalf("refreshed request: %v", requestErr)
+			}
+			raw, err := os.ReadFile(path)
+			if err != nil {
+				t.Fatal(err)
+			}
+			var saved map[string]any
+			if err := json.Unmarshal(raw, &saved); err != nil {
+				t.Fatal(err)
+			}
+			if saved["access_token"] != "replacement-access" || saved["refresh_token"] != "replacement-refresh" {
+				t.Fatal("shutdown completed without the rotated tokens on disk")
+			}
+		})
+	}
+}
