+			store := &requestShutdownStore{FileTokenStore: filestore.NewFileTokenStore(), entered: make(chan struct{}), release: storeHold}
+			root := t.TempDir()
+			store.SetBaseDir(root)
+			path := filepath.Join(root, "inline.json")
+			if err := os.WriteFile(path, []byte(`{"type":"shutdown-fixture","refresh_token":"old-refresh","access_token":"old-access"}`), 0600); err != nil {
+				t.Fatal(err)
+			}
