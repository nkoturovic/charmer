+package cliproxy
+
+import (
+	"context"
+	"errors"
+	"strings"
+	"sync"
+	"testing"
+	"time"
+
+	"github.com/router-for-me/CLIProxyAPI/v8/internal/watcher"
+	coreauth "github.com/router-for-me/CLIProxyAPI/v8/sdk/cliproxy/auth"
+	"github.com/router-for-me/CLIProxyAPI/v8/sdk/config"
+	log "github.com/sirupsen/logrus"
+)
+
+type serviceShutdownExecutor struct {
+	coreauth.ProviderExecutor
+	entered   chan struct{}
+	cancelled chan struct{}
+	release   <-chan struct{}
+}
+
+func (*serviceShutdownExecutor) Identifier() string { return "shutdown-fixture" }
+func (e *serviceShutdownExecutor) Refresh(ctx context.Context, a *coreauth.Auth) (*coreauth.Auth, error) {
+	close(e.entered)
+	<-ctx.Done()
+	close(e.cancelled)
+	<-e.release // model a cancellation-shielded successful provider attempt
+	a = a.Clone()
+	a.Metadata["refresh_token"] = "replacement-refresh"
+	return a, nil
+}
+
+type serviceShutdownStore struct {
+	coreauth.Store
+	entered chan struct{}
+	release <-chan struct{}
+	saved   string // read only after the refresh join
+}
+
+func (s *serviceShutdownStore) SaveWithReport(_ context.Context, a *coreauth.Auth, opts coreauth.SaveOptions) (coreauth.SaveReport, error) {
+	close(s.entered)
+	<-s.release
+	if !opts.Sync {
+		return coreauth.SaveReport{}, errors.New("refresh did not request sync")
+	}
+	s.saved, _ = a.Metadata["refresh_token"].(string)
+	return coreauth.SaveReport{Outcome: coreauth.SaveOutcomePersisted, Stage: coreauth.SaveStageNone, Category: coreauth.SaveCategoryNone, CredentialsChanged: true}, nil
+}
+
+func serviceShutdownSignal(t *testing.T, ch <-chan struct{}) {
+	t.Helper()
+	select {
+	case <-ch:
+	case <-time.After(5 * time.Second):
+		t.Fatal("timed out waiting for shutdown fixture")
+	}
+}
+
+func serviceShutdownBlocked(t *testing.T, done <-chan error) {
+	t.Helper()
+	select {
+	case err := <-done:
+		t.Fatalf("shutdown returned before cleanup completed: %v", err)
+	case <-time.After(20 * time.Millisecond):
+	}
+}
+
+func serviceShutdownRelease() (chan struct{}, func()) {
+	ch := make(chan struct{})
+	var once sync.Once
+	return ch, func() { once.Do(func() { close(ch) }) }
+}
+
+type serviceShutdownLog struct {
+	messages chan string
+}
+
+func (*serviceShutdownLog) Levels() []log.Level { return []log.Level{log.WarnLevel} }
+func (h *serviceShutdownLog) Fire(e *log.Entry) error {
+	if strings.Contains(e.Message, "credential refresh workers still running") {
+		h.messages <- e.Message
+	}
+	return nil
+}
+
+func TestServiceShutdownJoinsRefresh(t *testing.T) {
+	for _, deadline := range []bool{false, true} {
+		name := "completion"
+		if deadline {
+			name = "deadline"
+		}
+		t.Run(name, func(t *testing.T) {
+			executorHold, releaseExecutor := serviceShutdownRelease()
+			storeHold, releaseStore := serviceShutdownRelease()
+			exec := &serviceShutdownExecutor{entered: make(chan struct{}), cancelled: make(chan struct{}), release: executorHold}
+			store := &serviceShutdownStore{entered: make(chan struct{}), release: storeHold}
+			m := coreauth.NewManager(store, nil, nil)
+			m.RegisterExecutor(exec)
+			_, err := m.Register(coreauth.WithSkipPersist(context.Background()), &coreauth.Auth{
+				ID: "shutdown-fixture", Provider: "shutdown-fixture",
+				Metadata: map[string]any{"refresh_token": "old-refresh", "refresh_interval_seconds": 3600},
+			})
+			if err != nil {
+				t.Fatal(err)
+			}
+			t.Cleanup(func() {
+				releaseExecutor()
+				releaseStore()
+				ctx, cancel := context.WithTimeout(context.Background(), 5*time.Second)
+				defer cancel()
+				if err := m.StopAutoRefreshAndWait(ctx); err != nil {
+					t.Errorf("cleanup: %v", err)
+				}
+			})
+			m.StartAutoRefresh(context.Background(), time.Hour)
+			serviceShutdownSignal(t, exec.entered)
+			s := &Service{coreManager: m}
+			budget := 5 * time.Second
+			if deadline {
+				budget = 20 * time.Millisecond
+				// A later cleanup error must not replace the refresh deadline error.
+				s.watcher = &WatcherWrapper{stop: func() error { return errors.New("synthetic watcher failure") }}
+			}
+			logger := log.StandardLogger()
+			hook := &serviceShutdownLog{messages: make(chan string, 1)}
+			oldHooks := logger.ReplaceHooks(make(log.LevelHooks))
+			logger.AddHook(hook)
+			t.Cleanup(func() { logger.ReplaceHooks(oldHooks) })
+			ctx, cancel := context.WithTimeout(context.Background(), budget)
+			defer cancel()
+			done := make(chan error, 1)
+			go func() { done <- s.Shutdown(ctx) }()
+			serviceShutdownSignal(t, exec.cancelled)
+			if deadline {
+				select {
+				case err := <-done:
+					if !errors.Is(err, context.DeadlineExceeded) {
+						t.Fatalf("shutdown error = %v, want refresh deadline", err)
+					}
+				case <-time.After(5 * time.Second):
+					t.Fatal("shutdown ignored its deadline")
+				}
+				select {
+				case message := <-hook.messages:
+					if message != "credential refresh workers still running at shutdown deadline; persistence unverified" {
+						t.Fatalf("unexpected deadline diagnostic: %q", message)
+					}
+				default:
+					t.Fatal("missing credential-free deadline diagnostic")
+				}
+				releaseExecutor()
+				releaseStore()
+				joinCtx, joinCancel := context.WithTimeout(context.Background(), 5*time.Second)
+				defer joinCancel()
+				if err := m.StopAutoRefreshAndWait(joinCtx); err != nil {
+					t.Fatal(err)
+				}
+			} else {
+				serviceShutdownBlocked(t, done)
+				releaseExecutor()
+				serviceShutdownSignal(t, store.entered)
+				serviceShutdownBlocked(t, done)
+				releaseStore()
+				select {
+				case err := <-done:
+					if err != nil {
+						t.Fatal(err)
+					}
+				case <-time.After(5 * time.Second):
+					t.Fatal("shutdown did not finish after save")
+				}
+			}
+			if store.saved != "replacement-refresh" {
+				t.Fatalf("saved refresh token = %q, want replacement-refresh", store.saved)
+			}
+		})
+	}
+}
