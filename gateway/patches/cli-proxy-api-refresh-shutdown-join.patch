+	log "github.com/sirupsen/logrus"
+)
+
+// The fake provider rejects its stale access token. Its inline 401 refresh
+// can finish rotating tokens after cancellation, as a shielded HTTP call can.
+type requestShutdownExecutor struct{ serviceShutdownExecutor }
+
+func (e *requestShutdownExecutor) Execute(_ context.Context, a *coreauth.Auth, _ coreexecutor.Request, _ coreexecutor.Options) (coreexecutor.Response, error) {
+	if a.Metadata["access_token"] != "replacement-access" {
+		return coreexecutor.Response{}, &coreauth.Error{HTTPStatus: http.StatusUnauthorized, Message: "fixture stale access token"}
+	}
+	return coreexecutor.Response{Payload: []byte("fixture refreshed response")}, nil
+}
+
+func (e *requestShutdownExecutor) Refresh(ctx context.Context, a *coreauth.Auth) (*coreauth.Auth, error) {
+	updated, err := e.serviceShutdownExecutor.Refresh(ctx, a)
+	if updated != nil {
+		updated.Metadata["access_token"] = "replacement-access"
+	}
+	return updated, err
+}
+
+type requestShutdownStore struct {
+	*filestore.FileTokenStore
+	entered chan struct{}
+	release <-chan struct{}
+}
+
+func (s *requestShutdownStore) SaveWithReport(ctx context.Context, a *coreauth.Auth, opts coreauth.SaveOptions) (coreauth.SaveReport, error) {
+	// MarkResult may also persist ordinary request state after the retry.
+	// The barrier is the token-changing, durable refresh save only.
+	if opts.Sync {
+		close(s.entered)
+		<-s.release
+	}
+	return s.FileTokenStore.SaveWithReport(ctx, a, opts)
+}
+
+type requestShutdownReceipt struct {
+	messages chan string
+	release  <-chan struct{}
+}
+
+func (*requestShutdownReceipt) Levels() []log.Level { return []log.Level{log.InfoLevel} }
+func (h *requestShutdownReceipt) Fire(e *log.Entry) error {
+	if strings.HasPrefix(e.Message, "credential_save_v1 operation=refresh result=persisted ") {
+		h.messages <- e.Message
+		<-h.release
+	}
+	return nil
+}
+
+func TestServiceShutdownJoinsRequestRefresh(t *testing.T) {
