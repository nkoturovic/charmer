+type shutdownEmptyTokens struct{}
+
+func (shutdownEmptyTokens) Load(context.Context, *config.Config) (*TokenClientResult, error) {
+	return &TokenClientResult{}, nil
+}
+
+type shutdownEmptyAPIKeys struct{}
+
+func (shutdownEmptyAPIKeys) Load(context.Context, *config.Config) (*APIKeyClientResult, error) {
+	return &APIKeyClientResult{}, nil
+}
+
+// This deliberately runs once, outside the short gateway lane and repeated race
+// gate: the old context expired after 30 seconds of uptime, not after cancellation.
+func TestRunShutdownContextStartsAtExit(t *testing.T) {
+	t.Setenv("MANAGEMENT_PASSWORD", "")
+	t.Setenv("WRITABLE_PATH", t.TempDir())
+	t.Setenv("writable_path", "")
+	s := &Service{
+		cfg:           &config.Config{Host: "127.0.0.1", Port: 0, AuthDir: t.TempDir()},
+		coreManager:   coreauth.NewManager(nil, nil, nil),
+		tokenProvider: shutdownEmptyTokens{}, apiKeyProvider: shutdownEmptyAPIKeys{},
+		authUpdates: make(chan watcher.AuthUpdate),
+	}
+	started, stopping := make(chan struct{}), make(chan struct{})
+	barrier := make(chan struct{})
+	close(barrier)
+	s.watcherFactory = func(string, string, func(*config.Config)) (*WatcherWrapper, error) {
+		return &WatcherWrapper{
+			start: func(context.Context) error {
+				// The real consumer receives this update, then waits at authUpdateMu.
+				s.authUpdates <- watcher.AuthUpdate{Action: watcher.AuthUpdateActionDelete, ID: "consumer-fixture"}
+				close(started)
+				return nil
+			},
+			stop:                func() error { close(stopping); return nil },
+			dispatchAuthBarrier: func() <-chan struct{} { return barrier },
+		}, nil
+	}
+	s.authUpdateMu.Lock()
+	var once sync.Once
+	unblock := func() { once.Do(s.authUpdateMu.Unlock) }
+	ctx, cancel := context.WithCancel(context.Background())
+	done := make(chan error, 1)
+	finished := make(chan struct{})
+	go func() {
+		done <- s.Run(ctx)
+		close(finished)
+	}()
+	t.Cleanup(func() {
+		cancel()
+		unblock()
+		serviceShutdownSignal(t, finished)
+	})
+	serviceShutdownSignal(t, started)
+	select {
+	case err := <-done:
+		t.Fatalf("Run exited before cancellation: %v", err)
+	case <-time.After(31 * time.Second):
+	}
+	cancel()
+	serviceShutdownSignal(t, stopping)
+	// No refresh work exists in this test; only the consumer join can hold Run.
+	serviceShutdownBlocked(t, done)
+	unblock()
+	select {
+	case err := <-done:
+		if !errors.Is(err, context.Canceled) {
+			t.Fatalf("Run error = %v, want context cancelled", err)
+		}
+	case <-time.After(5 * time.Second):
+		t.Fatal("Run did not finish after consumer release")
+	}
+	select {
+	case <-s.authQueueDone:
+	default:
+		t.Fatal("Run returned before the real auth-update consumer finished")
+	}
+}
