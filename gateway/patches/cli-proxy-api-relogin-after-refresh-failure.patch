+package auth
+
+import (
+	"context"
+	"errors"
+	"net/http"
+	"os"
+	"path/filepath"
+	"testing"
+	"time"
+
+	internalconfig "github.com/router-for-me/CLIProxyAPI/v8/internal/config"
+	"github.com/router-for-me/CLIProxyAPI/v8/internal/registry"
+	cliproxyexecutor "github.com/router-for-me/CLIProxyAPI/v8/sdk/cliproxy/executor"
+)
+
+// reloginSnapshot writes a Claude auth file and returns it as the watcher
+// reads it (a file snapshot of that file).
+func reloginSnapshot(t *testing.T, path, token string, expiry time.Time) *Auth {
+	t.Helper()
+	expired := expiry.Format(time.RFC3339)
+	data := []byte(`{"type":"claude","access_token":"` + token + `-at","refresh_token":"` + token + `-rt","expired":"` + expired + `"}`)
+	if err := os.WriteFile(path, data, 0o600); err != nil {
+		t.Fatal(err)
+	}
+	a := &Auth{ID: filepath.Base(path), Provider: "claude", FileName: filepath.Base(path), Status: StatusActive,
+		Attributes: map[string]string{"path": path, "source": path},
+		Metadata:   map[string]any{"type": "claude", "access_token": token + "-at", "refresh_token": token + "-rt", "expired": expired}}
+	a.BindFileSnapshot(path, data)
+	return a
+}
+
+// Controls for the 8.0.39 runtime-state preservation the fix keeps: a rewrite
+// with unchanged tokens keeps the failed refresh's state, and new tokens keep
+// a live credential quota cooldown.
+func TestReloginKeepsUnchangedTokensAndLiveQuota(t *testing.T) {
+	ctx := WithSkipPersist(context.Background())
+	invalidGrant := errors.New(`token refresh failed with status 400: {"error": "invalid_grant"}`)
+	t.Run("unchanged tokens", func(t *testing.T) {
+		path := filepath.Join(t.TempDir(), "claude-a.json")
+		m := NewManager(nil, nil, nil)
+		m.SetConfigSnapshot(&internalconfig.Config{DisableCooling: true})
+		m.RegisterExecutor(&unauthorizedRefreshExecutor{id: "claude", refreshErr: invalidGrant})
+		expiry := time.Now().Add(-time.Hour)
+		if _, err := m.Register(ctx, reloginSnapshot(t, path, "old", expiry)); err != nil {
+			t.Fatal(err)
+		}
+		m.refreshAuth(ctx, "claude-a.json")
+		if _, err := m.Update(ctx, reloginSnapshot(t, path, "old", expiry)); err != nil {
+			t.Fatal(err)
+		}
+		after, _ := m.GetByID("claude-a.json")
+		if after.Status != StatusError || after.RefreshFailures == 0 {
+			t.Fatalf("rewrite with unchanged tokens dropped the failed refresh: status=%s refresh_failures=%d", after.Status, after.RefreshFailures)
+		}
+	})
+	t.Run("live credential quota", func(t *testing.T) {
+		path := filepath.Join(t.TempDir(), "claude-a.json")
+		m := NewManager(nil, nil, nil)
+		m.RegisterExecutor(&unauthorizedRefreshExecutor{id: "claude"})
+		if _, err := m.Register(ctx, reloginSnapshot(t, path, "old", time.Now().Add(8*time.Hour))); err != nil {
+			t.Fatal(err)
+		}
+		recover := time.Now().Add(time.Hour)
+		m.mu.Lock()
+		current := m.auths["claude-a.json"]
+		current.Status, current.Unavailable = StatusError, true
+		current.LastError = &Error{HTTPStatus: http.StatusTooManyRequests, Message: "credential quota exhausted"}
+		current.Quota = QuotaState{Exceeded: true, Reason: "credential_quota", NextRecoverAt: recover}
+		m.mu.Unlock()
+		if _, err := m.Update(ctx, reloginSnapshot(t, path, "new", time.Now().Add(8*time.Hour))); err != nil {
+			t.Fatal(err)
+		}
+		after, _ := m.GetByID("claude-a.json")
+		if !after.Unavailable || !after.Quota.NextRecoverAt.Equal(recover) {
+			t.Fatalf("sign-in released a live credential quota cooldown: unavailable=%v recover=%v", after.Unavailable, after.Quota.NextRecoverAt)
+		}
+	})
+}
+
+// Signing an account in again after its refresh failed (a dead refresh token,
+// or a token endpoint outage) puts it back into rotation, with cooling
+// disabled as the rendered configuration sets it (upstream issue 6948, a
+// regression of 8.0.39). A live retry or quota deadline still survives the
+// sign-in, whichever way the refresh failed.
+func TestReloginAfterRefreshFailureRestoresAccount(t *testing.T) {
+	outage := errors.New("token refresh failed with status 503: upstream connect error")
+	invalidGrant := errors.New(`token refresh failed with status 400: {"error": "invalid_grant", "error_description": "Refresh token not found or invalid"}`)
+	for _, tc := range []struct {
+		name       string
+		refreshErr error
+		cooling    bool
+		failure    int // a request failure before the refresh: its live deadline must survive
+	}{
+		{"invalid grant", invalidGrant, false, 0},
+		{"token endpoint 503", outage, false, 0},
+		{"active 429 cooldown", outage, true, http.StatusTooManyRequests},
+		{"invalid grant with a live retry deadline", invalidGrant, true, http.StatusServiceUnavailable},
+		{"invalid grant with a live 429 quota", invalidGrant, true, http.StatusTooManyRequests},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			ctx := WithSkipPersist(context.Background())
+			path := filepath.Join(t.TempDir(), "claude-a.json")
+			m := NewManager(nil, nil, nil)
+			m.SetConfigSnapshot(&internalconfig.Config{DisableCooling: !tc.cooling})
+			m.RegisterExecutor(&unauthorizedRefreshExecutor{id: "claude", refreshErr: tc.refreshErr})
+			if _, err := m.Register(ctx, reloginSnapshot(t, path, "old", time.Now().Add(-time.Hour))); err != nil {
+				t.Fatal(err)
+			}
+			if tc.failure != 0 {
+				retryAfter := time.Hour
+				m.MarkResult(ctx, Result{AuthID: "claude-a.json", Provider: "claude", RetryAfter: &retryAfter,
+					Error: &Error{HTTPStatus: tc.failure, Message: "request failed"}})
+			}
+			m.refreshAuth(ctx, "claude-a.json") // expired token, refresh fails
+			failed, _ := m.GetByID("claude-a.json")
+			if !failed.Unavailable {
+				t.Fatalf("precondition: refresh failure left the account available: %+v", failed)
+			}
+			if _, err := m.Update(ctx, reloginSnapshot(t, path, "new", time.Now().Add(8*time.Hour))); err != nil {
+				t.Fatal(err)
+			}
+			after, _ := m.GetByID("claude-a.json")
+			if tc.failure != 0 {
+				if !after.Unavailable || !after.NextRetryAfter.After(time.Now()) {
+					t.Fatalf("sign-in released a live retry deadline: unavailable=%v next_retry=%v", after.Unavailable, after.NextRetryAfter)
+				}
+				if tc.failure == http.StatusTooManyRequests && !after.Quota.NextRecoverAt.After(time.Now()) {
+					t.Fatalf("sign-in released a live quota deadline: recover=%v", after.Quota.NextRecoverAt)
+				}
+				return
+			}
+			// It serves at once, without waiting for a later refresh.
+			registry.GetGlobalRegistry().RegisterClient("claude-a.json", "claude", []*registry.ModelInfo{{ID: "fixture-model"}})
+			t.Cleanup(func() { registry.GetGlobalRegistry().UnregisterClient("claude-a.json") })
+			resp, errExecute := m.Execute(ctx, []string{"claude"}, cliproxyexecutor.Request{Model: "fixture-model"}, cliproxyexecutor.Options{})
+			serves := errExecute == nil && string(resp.Payload) == "claude-a.json:new-at"
+			if !serves || after.Unavailable || after.Status != StatusActive || after.LastError != nil || after.RefreshFailures != 0 {
+				t.Fatalf("signed-in account still out of rotation: serves=%v (err=%v) status=%s msg=%q unavailable=%v refresh_failures=%d",
+					serves, errExecute, after.Status, after.StatusMessage, after.Unavailable, after.RefreshFailures)
+			}
+		})
+	}
+}
