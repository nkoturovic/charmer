new file mode 100644
index 00000000..2b4a45e0
--- /dev/null
+++ b/internal/credfile/credfile_unix.go
@@ -0,0 +1,25 @@
+//go:build unix
+
+package credfile
+
+import (
+	"os"
+	"syscall"
+)
+
+// tempFlags creates a new private file: never an existing entry, never through a
+// symlink, never inherited by a child process.
+const tempFlags = os.O_WRONLY | os.O_CREATE | os.O_EXCL | syscall.O_NOFOLLOW | syscall.O_CLOEXEC
+
+func syncDir(dir string) error {
+	handle, err := os.Open(dir)
+	if err != nil {
+		return err
+	}
+	errSync := handle.Sync()
+	errClose := handle.Close()
+	if errSync != nil {
+		return errSync
+	}
+	return errClose
+}
