+func TestCM053CredentialSaveGenerationOrdering(t *testing.T) {
+	logs := fxCaptureLogs(t)
+	store := newCM053Store()
+	m := fxManager(t, store)
+	fxRegister(t, m, fxNewAuth("claude-a.json", "sk-old"))
+	fxRegister(t, m, fxNewAuth("claude-b.json", "sk-other"))
+	logs.events(t)
+
+	// A refresh's verified save is paused after staging (its file sync). The manager
+	// lock is free meanwhile: selection reads and another credential's result persist
+	// do not wait. The same credential's next save (a quota reset) is serialized
+	// behind the refresh (its mutation gate) and publishes the newer generation after
+	// it. (A request result would be stale here: it ran with the older credential.)
+	stagedCh, resume := make(chan struct{}), make(chan struct{})
+	store.set(func(s *fxStore) {
+		s.staged = func() {
+			close(stagedCh)
+			<-resume
+		}
+	})
+	refreshed := make(chan struct{})
+	go func() {
+		defer close(refreshed)
+		if _, err := fxRefreshErr(context.Background(), m, "claude-a.json", "sk-new"); err != nil {
+			t.Errorf("refresh: %v", err)
+		}
+	}()
+	<-stagedCh
+	otherDone := make(chan struct{})
+	go func() {
+		defer close(otherDone)
+		fxSelectionLockProbe(m)
+		fxResult(m, "claude-b.json")
+	}()
+	select {
+	case <-otherDone:
+	case <-time.After(5 * time.Second):
+		close(resume)
+		<-refreshed
+		t.Fatal("selection or another credential's result persist waited for a paused verified save")
+	}
+	sameDone := make(chan struct{})
+	go func() {
+		defer close(sameDone)
+		if _, _, err := m.ResetQuota(context.Background(), "claude-a.json"); err != nil {
+			t.Errorf("reset: %v", err)
+		}
+	}()
+	select {
+	case <-sameDone:
+		t.Error("the same credential's next save ran during its paused verified save")
+	case <-time.After(50 * time.Millisecond):
+	}
+	close(resume)
+	<-refreshed
+	<-sameDone
+
+	store.mu.Lock()
+	commits := append([]uint64(nil), store.commits["claude-a.json"]...)
+	saved := store.saved["claude-a.json"].Clone()
+	store.mu.Unlock()
+	current, _ := m.GetByID("claude-a.json")
+	if len(commits) != 2 || commits[0] >= commits[1] || commits[1] != current.Generation || authAccessToken(saved) != "sk-new" {
+		t.Fatalf("commits=%v saved=%q current gen=%d, want the refresh then the newer reset generation", commits, authAccessToken(saved), current.Generation)
+	}
+	events := logs.events(t)
+	if got := fxSummary(events); got != "result/unverified/no_sync refresh/persisted/none reset/unverified/no_sync" {
+		t.Fatalf("events = %s", got)
+	}
+
+	// A stalled directory sync (after the publish) holds no manager lock either.
+	syncedCh, resumeSync := make(chan struct{}), make(chan struct{})
+	store.set(func(s *fxStore) {
+		s.staged = nil
+		s.synced = func() {
+			close(syncedCh)
+			<-resumeSync
+		}
+	})
+	refreshed = make(chan struct{})
+	go func() {
+		defer close(refreshed)
+		if _, err := fxRefreshErr(context.Background(), m, "claude-a.json", "sk-newer"); err != nil {
+			t.Errorf("refresh: %v", err)
+		}
+	}()
+	<-syncedCh
+	otherDone = make(chan struct{})
+	go func() {
+		defer close(otherDone)
+		fxResult(m, "claude-b.json")
+		fxSelectionLockProbe(m)
+	}()
+	select {
+	case <-otherDone:
+	case <-time.After(5 * time.Second):
+		close(resumeSync)
+		<-refreshed
+		t.Fatal("a persist of another credential waited for a stalled directory sync")
+	}
+	close(resumeSync)
+	<-refreshed
+	store.set(func(s *fxStore) { s.synced = nil })
+
+	// A verified save that fails before its commit point after a newer generation was
+	// published meanwhile was superseded: stale, not the latest failure. (The newer
+	// save is a direct persist: the manager's own saves of this credential wait for
+	// the refresh.)
+	logs.events(t)
+	store.set(func(s *fxStore) {
+		s.failStaged = syscall.EIO
+		s.staged = func() {
+			newer, _ := m.GetByID("claude-a.json")
+			newer.Generation += 10
+			if err := m.persist(context.Background(), newer, persistOpResult, persistNoSync); err != nil {
+				t.Errorf("persist: %v", err)
+			}
+		}
+	})
+	fxRefresh(t, context.Background(), m, "claude-a.json", "sk-superseded")
+	store.set(func(s *fxStore) { s.failStaged, s.staged = nil, nil })
+	if got := fxSummary(logs.events(t)); got != "result/unverified/no_sync refresh/skipped/stale_generation" {
+		t.Fatalf("superseded failure events = %s", got)
+	}
+	// Without a newer publish the same failure is reported.
+	bump, _ := m.GetByID("claude-a.json")
+	bump.Generation += 20
+	if err := m.persist(context.Background(), bump, persistOpResult, persistNoSync); err != nil {
+		t.Fatal(err)
+	}
+	m.mu.Lock()
+	m.auths["claude-a.json"].Generation = bump.Generation
+	m.mu.Unlock()
+	logs.events(t)
+	store.set(func(s *fxStore) { s.failStaged = syscall.EIO })
+	fxRefresh(t, context.Background(), m, "claude-a.json", "sk-lost")
+	store.set(func(s *fxStore) { s.failStaged = nil })
+	if got := logs.events(t); len(got) != 1 || got[0].result != "failed" || got[0].stage != "sync" || got[0].errno != int(syscall.EIO) {
+		t.Fatalf("pre-commit failure events = %s", fxSummary(got))
+	}
+
+	// Concurrent verified and lock-held persists of one auth, generations interleaved:
+	// publishes stay in generation order and the newest generation is what ends up
+	// stored. (Driven through persist itself: driving UpdateRefreshedAuth concurrently
+	// with MarkResult trips the upstream publication race in updateInternal, which is
+	// separate work, not this patch.)
+	logs.events(t)
+	template, _ := m.GetByID("claude-a.json")
+	template.Generation += 100
+	var next atomic.Uint64
+	next.Store(template.Generation + 1)
+	var maxGen atomic.Uint64
+	var wg sync.WaitGroup
+	for worker := 0; worker < 8; worker++ {
+		wg.Add(1)
+		go func(worker int) {
+			defer wg.Done()
+			for i := 0; i < 25; i++ {
+				snapshot := template.Clone()
+				snapshot.Generation = next.Add(1)
+				snapshot.Metadata["access_token"] = fmt.Sprintf("sk-gen-%d", snapshot.Generation)
+				for {
+					seen := maxGen.Load()
+					if snapshot.Generation <= seen || maxGen.CompareAndSwap(seen, snapshot.Generation) {
+						break
+					}
+				}
+				op, durability := persistOpRefresh, persistDurable
+				if (worker+i)%2 == 1 {
+					op, durability = persistOpResult, persistNoSync
+				}
+				if err := m.persist(context.Background(), snapshot, op, durability); err != nil {
+					t.Errorf("persist: %v", err)
+				}
+			}
+		}(worker)
+	}
+	wg.Wait()
+	store.mu.Lock()
+	commits = append([]uint64(nil), store.commits["claude-a.json"]...)
+	saved = store.saved["claude-a.json"].Clone()
+	store.mu.Unlock()
+	for len(commits) > 0 && commits[0] <= template.Generation {
+		commits = commits[1:]
+	}
+	for i := 1; i < len(commits); i++ {
+		if commits[i] <= commits[i-1] {
+			t.Fatalf("publish order regressed: %v", commits)
+		}
+	}
+	if saved.Generation != maxGen.Load() || authAccessToken(saved) != fmt.Sprintf("sk-gen-%d", maxGen.Load()) {
+		t.Fatalf("stored gen=%d token=%q, want the newest generation %d", saved.Generation, authAccessToken(saved), maxGen.Load())
+	}
+	for _, e := range logs.events(t) {
+		if e.result == "failed" || (e.result == "skipped" && e.category != "stale_generation") {
+			t.Fatalf("unexpected event %+v", e)
+		}
+	}
+}
