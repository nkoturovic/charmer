+		events := logs.events(t)
+		wantResult := "unverified"
+		if wantSync {
+			wantResult = "persisted"
+		}
+		if len(events) != 1 || events[0].operation != operation || events[0].result != wantResult {
+			t.Fatalf("%s: events = %s, want %s/%s", name, fxSummary(events), operation, wantResult)
+		}
+	}
+	syncsBefore := func() int { store.mu.Lock(); defer store.mu.Unlock(); return store.syncs }
+
+	// The refresh/prepare/update persist (m.mu released, before publication) is verified.
+	fxRefresh(t, context.Background(), m, "claude-a.json", "sk-r")
+	expect("refresh", "refresh", true)
+	base, _ := m.GetByID("claude-a.json")
+	prepared := base.Clone()
+	prepared.Metadata["access_token"] = "sk-p"
+	if _, err := m.UpdatePreparedAuth(context.Background(), base, prepared); err != nil {
+		t.Fatal(err)
+	}
+	expect("prepare", "prepare", true)
+	updated, _ := m.GetByID("claude-a.json")
+	updated.Metadata["access_token"] = "sk-u"
+	if _, err := m.Update(context.Background(), updated); err != nil {
+		t.Fatal(err)
+	}
+	expect("update", "update", true)
+	// Register keeps the upstream write cost: no barrier.
+	if _, err := m.Register(context.Background(), fxNewAuth("claude-b.json", "sk-b")); err != nil {
+		t.Fatal(err)
+	}
+	expect("register", "register", false)
+
+	// The per-request and bookkeeping saves never sync.
+	before := syncsBefore()
+	fxResult(m, "claude-a.json")
+	expect("result", "result", false)
+	neutral, _ := m.GetByID("claude-a.json")
+	m.recordAvailabilityNeutralResult(context.Background(), Result{AuthID: "claude-a.json", Provider: "claude", Model: "m", CredentialVersion: neutral.CredentialVersion, RegistrationEpoch: neutral.RegistrationEpoch})
+	expect("neutral result", "result", false)
+	if _, _, err := m.ResetQuota(context.Background(), "claude-a.json"); err != nil {
+		t.Fatal(err)
+	}
+	expect("reset", "reset", false)
+
+	m.mu.Lock()
+	m.auths["claude-a.json"].ModelStates = map[string]*ModelState{
+		"cm053-gone-model": {Status: StatusError, Unavailable: true, StatusMessage: "gone"},
+	}
+	m.mu.Unlock()
+	reg := registry.GetGlobalRegistry()
+	reg.RegisterClient("claude-a.json", "claude", []*registry.ModelInfo{{ID: "cm053-kept-model"}})
+	t.Cleanup(func() { reg.UnregisterClient("claude-a.json") })
+	m.ReconcileRegistryModelStates(context.Background(), "claude-a.json")
+	expect("reconcile", "reconcile", false)
+
+	if after := syncsBefore(); after != before {
+		t.Fatalf("per-request and bookkeeping persists synced %d times", after-before)
+	}
+
+	// A Meta mint is saved before it is installed, like every refresh: verified.
+	meta := fxNewAuth("meta-a.json", "sk-meta")
+	meta.Provider = "meta"
+	meta.Metadata["type"] = "meta"
+	fxRegister(t, m, meta)
+	store.takeCalls()
+	logs.events(t)
+	fxRefresh(t, context.Background(), m, "meta-a.json", "sk-meta-2")
+	expect("meta mint", "refresh", true)
+}
