+func TestCM053CredentialSaveEventVolumeRules(t *testing.T) {
+	logs := fxCaptureLogs(t)
+	ops := []persistOperation{persistOpRefresh, persistOpPrepare, persistOpUpdate, persistOpResult, persistOpReconcile, persistOpRegister, persistOpReset}
+	outcomes := []SaveOutcome{SaveOutcomePersisted, SaveOutcomeFailed, SaveOutcomeUnverified, SaveOutcomeUnchanged, SaveOutcomeSkipped}
+	auth := fxNewAuth("claude-a.json", "sk-a")
+	auth.EnsureIndex()
+	for _, op := range ops {
+		for _, outcome := range outcomes {
+			emitCredentialSave(op, auth, SaveReport{Outcome: outcome})
+			got := logs.events(t)
+			want := outcome == SaveOutcomePersisted || outcome == SaveOutcomeFailed || outcome == SaveOutcomeUnverified || op == persistOpRefresh
+			if (len(got) == 1) != want || len(got) > 1 {
+				t.Fatalf("%s/%s: %d events, want emitted=%t", op, outcome, len(got), want)
+			}
+			if want && (got[0].operation != string(op) || got[0].result != string(outcome) || got[0].stage != "none" || got[0].category != "none") {
+				t.Fatalf("%s/%s: event %+v", op, outcome, got[0])
+			}
+		}
+	}
+
+	// A store without the report interface is never "persisted".
+	m := fxManager(t, &legacyCM053Store{})
+	fxRegister(t, m, fxNewAuth("claude-a.json", "sk-a"))
+	logs.events(t)
+	fxRefresh(t, context.Background(), m, "claude-a.json", "sk-b")
+	if got := logs.events(t); len(got) != 1 || got[0].result != "unverified" || got[0].category != "store" {
+		t.Fatalf("legacy store events = %s", fxSummary(got))
+	}
+	m = fxManager(t, &legacyCM053Store{err: fmt.Errorf("disk: %w", syscall.ENOSPC)})
+	fxRegister(t, m, fxNewAuth("claude-a.json", "sk-a"))
+	logs.events(t)
+	fxRefresh(t, context.Background(), m, "claude-a.json", "sk-b")
+	if got := logs.events(t); len(got) != 1 || got[0].result != "failed" || got[0].stage != "store" || got[0].errno != int(syscall.ENOSPC) {
+		t.Fatalf("legacy store failure events = %+v", got)
+	}
+}
+
+// A verified save completes (directory sync) with no manager lock held. A save admitted
+// after it that completes first with a write or a failure makes the delayed completion
+// older than the newest outcome: it must not be the latest receipt, and it must not
+// clear the newer failure. An unchanged save in between supersedes nothing.
+func TestCM053CredentialSaveSupersededCompletionIsNoReceipt(t *testing.T) {
+	logs := fxCaptureLogs(t)
+	store := newCM053Store()
+	m := fxManager(t, store)
+	fxRegister(t, m, fxNewAuth("claude-a.json", "sk-a"))
+	logs.events(t)
+	result := func() {
+		fxResult(m, "claude-a.json")
+	}
+	// newerSave saves a newer generation of the credential directly: during a
+	// refresh's sync the manager's own saves of it wait for the refresh.
+	newerSave := func() {
+		newer, _ := m.GetByID("claude-a.json")
+		newer.Generation += 10
+		_ = m.persist(context.Background(), newer, persistOpResult, persistNoSync)
+		m.mu.Lock()
+		if current := m.auths["claude-a.json"]; current != nil && current.Generation < newer.Generation {
+			current.Generation = newer.Generation
+		}
+		m.mu.Unlock()
+	}
+	// refreshWhileSyncing runs a refresh and, once, runs during its directory sync.
+	refreshWhileSyncing := func(access string, during func()) {
+		t.Helper()
+		var once sync.Once
+		store.set(func(s *fxStore) {
+			s.synced = func() { once.Do(during) }
+		})
+		fxRefresh(t, context.Background(), m, "claude-a.json", access)
+		store.set(func(s *fxStore) { s.synced = nil })
+	}
+
+	// A newer lock-held save fails while the refresh syncs: the refresh completes after
+	// it and is reported superseded, and the failure state stays set.
+	refreshWhileSyncing("sk-r1", func() {
+		store.set(func(s *fxStore) { s.failErr, s.failStage = syscall.ENOSPC, SaveStageWrite })
+		newerSave()
+		store.set(func(s *fxStore) { s.failErr = nil })
+	})
+	if got := fxSummary(logs.events(t)); got != "result/failed/errno refresh/unverified/superseded" {
+		t.Fatalf("events = %s, want result/failed/errno refresh/unverified/superseded", got)
+	}
+	store.set(func(s *fxStore) { s.failErr, s.failStage = syscall.ENOSPC, SaveStageWrite })
+	result()
+	store.set(func(s *fxStore) { s.failErr = nil })
+	if got := logs.events(t); len(got) != 0 {
+		t.Fatalf("a superseded completion cleared the failure state: %s", fxSummary(got))
+	}
+
+	// A newer lock-held write while the refresh syncs: superseded, never persisted.
+	refreshWhileSyncing("sk-r2", newerSave)
+	if got := fxSummary(logs.events(t)); got != "result/unverified/no_sync refresh/unverified/superseded" {
+		t.Fatalf("events = %s, want result/unverified/no_sync refresh/unverified/superseded", got)
+	}
+
+	// An unchanged save while the refresh syncs supersedes nothing: the receipt stands.
+	refreshWhileSyncing("sk-r3", func() {
+		store.set(func(s *fxStore) { s.unchanged = true })
+		newerSave()
+		store.set(func(s *fxStore) { s.unchanged = false })
+	})
+	if got := fxSummary(logs.events(t)); got != "refresh/persisted/none" {
+		t.Fatalf("events = %s, want refresh/persisted/none", got)
+	}
+
+	// Two verified saves: the newer one completes first; the older one is superseded.
+	base, _ := m.GetByID("claude-a.json")
+	older := base.Clone()
+	older.Generation++
+	older.Metadata["access_token"] = "sk-older"
+	newer := older.Clone()
+	newer.Generation++
+	newer.Metadata["access_token"] = "sk-newer"
+	olderSyncing, releaseOlder := make(chan struct{}), make(chan struct{})
+	var calls atomic.Int32
+	store.set(func(s *fxStore) {
+		s.synced = func() {
+			if calls.Add(1) == 1 {
+				close(olderSyncing)
+				<-releaseOlder
+			}
+		}
+	})
+	olderDone := make(chan error, 1)
+	go func() { olderDone <- m.persist(context.Background(), older, persistOpRefresh, persistDurable) }()
+	<-olderSyncing
+	if err := m.persist(context.Background(), newer, persistOpRefresh, persistDurable); err != nil {
+		t.Fatal(err)
+	}
+	close(releaseOlder)
+	if err := <-olderDone; err != nil {
+		t.Fatal(err)
+	}
+	store.set(func(s *fxStore) { s.synced = nil })
+	events := logs.events(t)
+	if fxSummary(events) != "refresh/persisted/none refresh/unverified/superseded" ||
+		events[0].generation != int64(newer.Generation) || events[1].generation != int64(older.Generation) {
+		t.Fatalf("events = %s (%+v), want the newer generation persisted and the older superseded", fxSummary(events), events)
+	}
+}
diff --git a/sdk/cliproxy/auth/credential_save_line_test.go b/sdk/cliproxy/auth/credential_save_line_test.go
new file mode 100644
index 00000000..851165f7
--- /dev/null
+++ b/sdk/cliproxy/auth/credential_save_line_test.go
@@ -0,0 +1,144 @@
+package auth
+
+import (
+	"bytes"
+	"context"
+	"os"
+	"regexp"
+	"testing"
+
+	internallogging "github.com/router-for-me/CLIProxyAPI/v8/internal/logging"
+	log "github.com/sirupsen/logrus"
+)
+
+// charmer local patch (credential-save-report): the gateway's own log formatter, with
+// the caller reported as the gateway configures it, writes each credential_save_v1
+// event as one line that ends at "epoch=<n>\n". The formatter appends logger fields
+// after the message, so the event must be a bare entry: any field would break the
+// reader's whole-line match. The two patterns are the reader's (charmer's
+// gateway_events SAVE_LINE_PATTERN and its strict v1 event grammar); a change on
+// either side fails here or in the reader's own tests.
+
+var (
+	fxReaderSaveLine = regexp.MustCompile(`^\[[0-9]{4}-[0-9]{2}-[0-9]{2} [0-9]{2}:[0-9]{2}:[0-9]{2}\] \[[^]]*\] \[[^]]*\] \[credential_save\.go:[0-9]+\] credential_save_v`)
+	fxReaderEvent    = regexp.MustCompile(`^credential_save_v1 operation=(refresh|prepare|update|result|reconcile|register|reset) ` +
+		`result=(persisted|failed|unchanged|skipped|unverified) ` +
+		`provider=([a-z0-9][a-z0-9._-]{0,63}) auth_index=([0-9a-f]{16}|invalid) ` +
+		`credentials_changed=(true|false) ` +
+		`stage=(none|validate|path|mkdir|read|marshal|open|write|sync|close|rename|dirsync|delegated|store) ` +
+		`errno=([0-9]{1,10}) ` +
+		`category=(none|errno|short_write|error|no_store|config_api_key|runtime_only|plugin_virtual|` +
+		`no_metadata|stale_generation|skip_persist|disabled_absent|commit_declined|no_sync|` +
+		`delegated|store|dirsync_unsupported|superseded) ` +
+		`bytes=([0-9]{1,20}) size=([0-9]{1,20}) generation=([0-9]{1,20}) epoch=([0-9]{1,20})$`)
+	fxReaderEnvelope = regexp.MustCompile(`^\[[0-9]{4}-[0-9]{2}-[0-9]{2} [0-9]{2}:[0-9]{2}:[0-9]{2}\] \[[^\]\r\n]*\] \[[^\]\r\n]*\] \[credential_save\.go:[0-9]+\] (.*)$`)
+)
+
+// D217 normalizes only the already-validated envelope; event-body bytes stay exact.
+var fxLiteralEventBodies = []string{
+	"credential_save_v1 operation=refresh result=persisted provider=claude auth_index=0123456789abcdef credentials_changed=true stage=none errno=0 category=none bytes=120 size=120 generation=3 epoch=7\n",
+	"credential_save_v1 operation=result result=failed provider=claude auth_index=0123456789abcdef credentials_changed=false stage=write errno=0 category=error bytes=0 size=120 generation=3 epoch=7\n",
+}
+
+func fxLiteralEventMatches(raw []byte, want string) bool {
+	if !bytes.HasSuffix(raw, []byte("\n")) {
+		return false
+	}
+	parts := fxReaderEnvelope.FindSubmatch(raw[:len(raw)-1])
+	return parts != nil && bytes.Equal(append(bytes.Clone(parts[1]), byte('\n')), []byte(want))
+}
+
+func TestCM053CredentialSaveLiteralEventControl(t *testing.T) {
+	for _, body := range fxLiteralEventBodies {
+		line := []byte("[2026-10-19 00:00:00] [] [info ] [credential_save.go:123] " + body)
+		if !fxLiteralEventMatches(line, body) {
+			t.Fatal("literal event positive control failed")
+		}
+		for _, changed := range [][]byte{bytes.Replace(line, []byte("epoch=7"), []byte("epoch=8"), 1),
+			append(bytes.Clone(line), byte('\n'))} {
+			if fxLiteralEventMatches(changed, body) {
+				t.Fatal("changed event golden byte accepted")
+			}
+		}
+	}
+}
+
+func TestCM053CredentialSaveLineEndsAtEpoch(t *testing.T) {
+	logger := log.StandardLogger()
+	var out bytes.Buffer
+	savedOut, savedFormatter, savedLevel, savedCaller := logger.Out, logger.Formatter, logger.GetLevel(), logger.ReportCaller
+	logger.SetOutput(&out)
+	logger.SetFormatter(&internallogging.LogFormatter{})
+	logger.SetLevel(log.InfoLevel)
+	logger.SetReportCaller(true)
+	t.Cleanup(func() {
+		logger.SetOutput(savedOut)
+		logger.SetFormatter(savedFormatter)
+		logger.SetLevel(savedLevel)
+		logger.SetReportCaller(savedCaller)
+	})
+
+	auth := fxNewAuth("claude-a.json", "sk-a")
+	auth.Index = "0123456789abcdef" // fixed synthetic identity, not a computed golden
+	auth.EnsureIndex()
+	auth.Generation, auth.RegistrationEpoch = 3, 7
+	emitCredentialSave(persistOpRefresh, auth, SaveReport{Outcome: SaveOutcomePersisted, Stage: SaveStageNone, Category: SaveCategoryNone, Bytes: 120, Size: 120, CredentialsChanged: true})
+	emitCredentialSave(persistOpResult, auth, FailedSaveReport(SaveStageWrite, os.ErrPermission, 0, 120))
+
+	lines := bytes.SplitAfter(out.Bytes(), []byte("\n"))
+	if len(lines) != 3 || len(lines[2]) != 0 {
+		t.Fatalf("output = %q, want exactly two newline-terminated lines", out.String())
+	}
+	for index, raw := range lines[:2] {
+		if !fxLiteralEventMatches(raw, fxLiteralEventBodies[index]) {
+			t.Fatalf("literal credential event body changed: %q", raw)
+		}
+		line := string(raw)
+		if !bytes.HasSuffix(raw, []byte(" generation=3 epoch=7\n")) {
+			t.Fatalf("line %q does not end at epoch=7 and its newline", line)
+		}
+		body := line[:len(line)-1]
+		if !fxReaderSaveLine.MatchString(body) {
+			t.Fatalf("the reader's save-line pattern does not match %q", body)
+		}
+		envelope := fxReaderEnvelope.FindStringSubmatch(body)
+		if envelope == nil || !fxReaderEvent.MatchString(envelope[1]) {
+			t.Fatalf("the reader's strict event grammar does not match %q", body)
+		}
+	}
+	if !bytes.Contains(lines[0], []byte("] [info ] [credential_save.go:")) || !bytes.Contains(lines[1], []byte("] [warn ] [credential_save.go:")) {
+		t.Fatalf("levels or caller off: %q", out.String())
+	}
+	if path := os.Getenv("CM053_SAVE_LINE_OUT"); path != "" {
+		if err := os.WriteFile(path, out.Bytes(), 0o600); err != nil {
+			t.Fatal(err)
+		}
+	}
+}
+
+// A refresh whose snapshot a newer credential overtook is discarded (the stored
+// credential stays). It is reported, so a refresh never ends without an event.
+func TestCM053CredentialSaveDiscardedRefreshIsSuperseded(t *testing.T) {
+	logs := fxCaptureLogs(t)
+	store := newCM053Store()
+	m := fxManager(t, store)
+	fxRegister(t, m, fxNewAuth("claude-a.json", "sk-a"))
+	base, _ := m.GetByID("claude-a.json")
+	newer := base.Clone()
+	newer.Metadata["access_token"] = "sk-login"
+	if _, err := m.Update(context.Background(), newer); err != nil {
+		t.Fatal(err)
+	}
+	logs.events(t)
+	refreshed := base.Clone()
+	refreshed.Metadata["access_token"] = "sk-refreshed-from-old"
+	if _, err := m.UpdateRefreshedAuth(context.Background(), base, refreshed); err != nil {
+		t.Fatal(err)
+	}
+	if got := fxSummary(logs.events(t)); got != "refresh/skipped/superseded" {
+		t.Fatalf("events = %s, want refresh/skipped/superseded", got)
+	}
+	if current, _ := m.GetByID("claude-a.json"); authAccessToken(current) != "sk-login" {
+		t.Fatalf("stored credential = %q, want the newer login", authAccessToken(current))
+	}
+}
