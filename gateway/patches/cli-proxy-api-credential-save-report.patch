+	if authAccessToken(saved) != "sk-new" {
+		t.Fatalf("UpdateRefreshedAuth returned %q", authAccessToken(saved))
+	}
+	current, ok := m.GetByID("claude-a.json")
+	if !ok || authAccessToken(current) != "sk-new" || current.Disabled || current.Unavailable || current.Status != StatusActive {
+		t.Fatalf("runtime credential after a failed save: ok=%t %+v", ok, current)
+	}
+	if calls := store.takeCalls(); len(calls) != 1 || !calls[0] {
+		t.Fatalf("store calls = %v, want exactly one verified attempt (no retry)", calls)
+	}
+	got := logs.events(t)
+	if len(got) != 1 || got[0].operation != "refresh" || got[0].result != "failed" || got[0].stage != "write" ||
+		got[0].errno != int(syscall.ENOSPC) || got[0].category != "errno" || !got[0].changed || got[0].level != log.WarnLevel {
+		t.Fatalf("events = %+v, want one Warn refresh/failed/write errno=28 credentials_changed=true", got)
+	}
+
+	// The next request's result persist rewrites the file: evidence of repair
+	// (unverified with credentials_changed=true), never a restart or eviction.
+	store.set(func(s *fxStore) { s.failErr = nil })
+	fxResult(m, "claude-a.json")
+	got = logs.events(t)
+	if len(got) != 1 || got[0].operation != "result" || got[0].result != "unverified" || !got[0].changed || got[0].level != log.InfoLevel {
+		t.Fatalf("repair events = %+v, want result/unverified credentials_changed=true", got)
+	}
+	if _, ok = m.GetByID("claude-a.json"); !ok {
+		t.Fatal("auth evicted after a persistence failure")
+	}
+}
