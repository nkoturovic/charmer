diff --git a/internal/credfile/credfile.go b/internal/credfile/credfile.go
new file mode 100644
index 00000000..86e8f2bb
--- /dev/null
+++ b/internal/credfile/credfile.go
@@ -0,0 +1,68 @@
+// Package credfile replaces credential files without ever writing them in place.
+//
+// charmer local patch (credential-save-report). WriteFile writes a same-directory
+// temporary file named ".<base>.cm-save-<16 hex>" (never ending in ".json", so no
+// auth-dir watcher or startup scan loads it), checks the byte count, syncs and closes
+// it, renames it over the destination and syncs the directory. The destination is
+// never opened for writing, so a failed or interrupted write cannot truncate or
+// partially overwrite the previous credential, and a reader of the auth directory
+// sees either the old file or the complete new one.
+package credfile
+
+import (
+	"crypto/rand"
+	"encoding/hex"
+	"fmt"
+	"io"
+	"os"
+	"path/filepath"
+)
+
+// TempMarker is part of every temporary file name; see the package comment.
+const TempMarker = ".cm-save-"
+
+// WriteFile replaces path with data (mode 0600). A directory sync failure after the
+// rename is returned: the replacement is then visible but not known to be durable.
+func WriteFile(path string, data []byte) error {
+	dir := filepath.Dir(path)
+	if errMkdir := os.MkdirAll(dir, 0o700); errMkdir != nil {
+		return fmt.Errorf("credential file: create directory: %w", errMkdir)
+	}
+	var suffix [8]byte
+	if _, errRand := rand.Read(suffix[:]); errRand != nil {
+		return fmt.Errorf("credential file: temp name: %w", errRand)
+	}
+	tmp := filepath.Join(dir, "."+filepath.Base(path)+TempMarker+hex.EncodeToString(suffix[:]))
+	file, errOpen := os.OpenFile(tmp, tempFlags, 0o600)
+	if errOpen != nil {
+		return fmt.Errorf("credential file: create temp: %w", errOpen)
+	}
+	renamed := false
+	defer func() {
+		if !renamed {
+			_ = os.Remove(tmp)
+		}
+	}()
+	n, errWrite := file.Write(data)
+	if errWrite == nil && n != len(data) {
+		errWrite = io.ErrShortWrite
+	}
+	if errWrite == nil {
+		errWrite = file.Sync()
+	}
+	errClose := file.Close()
+	if errWrite != nil {
+		return fmt.Errorf("credential file: write temp: %w", errWrite)
+	}
+	if errClose != nil {
+		return fmt.Errorf("credential file: close temp: %w", errClose)
+	}
+	if errRename := os.Rename(tmp, path); errRename != nil {
+		return fmt.Errorf("credential file: replace: %w", errRename)
+	}
+	renamed = true
+	if errSync := syncDir(dir); errSync != nil {
+		return fmt.Errorf("credential file: directory sync after replace: %w", errSync)
+	}
+	return nil
+}
