+type fxStorage struct {
+	meta map[string]any
+	err  error
+}
+
+func (s *fxStorage) SetMetadata(meta map[string]any) { s.meta = meta }
+
+func (s *fxStorage) SaveTokenToFile(path string) error {
+	if s.err != nil {
+		return fmt.Errorf("token storage write %s: %w", path, s.err)
+	}
+	raw, err := json.Marshal(s.meta)
+	if err != nil {
+		return err
+	}
+	return os.WriteFile(path, raw, 0o600)
+}
