+package auth
+
+// Test-only exports for the external (package auth_test) watcher gates, which must
+// import internal/watcher and therefore cannot live in this package.
+
+// NewFileTokenStoreWithSaveFaultForTest returns a store whose metadata saves fail at stage
+// ("open", "write", "short_write", "sync", "close", "rename", or "" for none) with err.
+// pause runs while the temporary file exists: at the injected failure, and before
+// every rename.
+func NewFileTokenStoreWithSaveFaultForTest(stage string, err error, pause func()) *FileTokenStore {
+	faults := &fxFaults{stage: stage, err: err, pause: pause}
+	store := NewFileTokenStore()
+	store.fileOps = faults.ops()
+	return store
+}
+
+// SaveTempPathForTest is the temporary name a save of dest uses with suffix.
+func SaveTempPathForTest(dest, suffix string) string {
+	return saveTempPath(dest, suffix)
+}
+
+// NewFileTokenStoreWithDirSyncHookForTest returns a store that runs hook before every
+// directory sync (after a verified save's rename, with no lock held), and a function
+// returning the file and directory sync counts.
+func NewFileTokenStoreWithDirSyncHookForTest(hook func()) (*FileTokenStore, func() (int, int)) {
+	faults := &fxFaults{beforeDirSync: hook}
+	store := NewFileTokenStore()
+	store.fileOps = faults.ops()
+	return store, faults.syncCounts
+}
