+// An unchanged credential needs no temporary file, write or sync: a verified save of it
+// is unchanged even where a temporary file cannot be created.
+func TestCM053CredentialSaveUnchangedNeedsNoWrite(t *testing.T) {
+	t.Run("unwritable directory", func(t *testing.T) {
+		dir := t.TempDir()
+		prior := fxSeed(t, dir, "claude-a.json")
+		var meta map[string]any
+		if err := json.Unmarshal(prior, &meta); err != nil {
+			t.Fatal(err)
+		}
+		store, faults := fxStore(dir)
+		if err := os.Chmod(dir, 0o500); err != nil {
+			t.Fatal(err)
+		}
+		t.Cleanup(func() { _ = os.Chmod(dir, 0o700) })
+		if probe, err := os.OpenFile(filepath.Join(dir, "probe"), os.O_WRONLY|os.O_CREATE|os.O_EXCL, 0o600); err == nil {
+			_ = probe.Close()
+			t.Skip("directory permissions are not enforced (running as root?)")
+		}
+		for _, sync := range []bool{false, true} {
+			auth := fxAuth(dir, "claude-a.json", fxOldAccess, fxOldRefresh)
+			auth.Metadata = meta
+			report, err := store.SaveWithReport(context.Background(), auth, cliproxyauth.SaveOptions{Sync: sync})
+			if err != nil || report.Outcome != cliproxyauth.SaveOutcomeUnchanged || report.CredentialsChanged || report.Errno != 0 {
+				t.Fatalf("sync=%t: report=%+v err=%v, want unchanged", sync, report, err)
+			}
+		}
+		fxAssertBytes(t, filepath.Join(dir, "claude-a.json"), prior)
+		faults.mu.Lock()
+		temps := len(faults.temps)
+		faults.mu.Unlock()
+		if files, dirs := faults.syncCounts(); temps != 0 || files != 0 || dirs != 0 {
+			t.Fatalf("temps=%d file syncs=%d dir syncs=%d, want no file work", temps, files, dirs)
+		}
+	})
+	t.Run("temp creation fails", func(t *testing.T) {
+		dir := t.TempDir()
+		prior := fxSeed(t, dir, "claude-a.json")
+		store, faults := fxStore(dir)
+		faults.stage, faults.err = "open", syscall.EACCES
+		auth := fxAuth(dir, "claude-a.json", fxOldAccess, fxOldRefresh)
+		report, err := store.SaveWithReport(context.Background(), auth, cliproxyauth.SaveOptions{Sync: true})
+		if err != nil || report.Outcome != cliproxyauth.SaveOutcomeUnchanged {
+			t.Fatalf("report=%+v err=%v, want unchanged", report, err)
+		}
+		fxAssertBytes(t, filepath.Join(dir, "claude-a.json"), prior)
+		faults.mu.Lock()
+		events := strings.Join(faults.events, ",")
+		faults.mu.Unlock()
+		if events != "" {
+			t.Fatalf("file operations = %s, want none", events)
+		}
+		// A changed credential still reaches the failing open: the check skips only no-ops.
+		auth.Metadata["access_token"] = fxNewAccess
+		report, err = store.SaveWithReport(context.Background(), auth, cliproxyauth.SaveOptions{Sync: true})
+		if err == nil || report.Outcome != cliproxyauth.SaveOutcomeFailed || report.Stage != cliproxyauth.SaveStageOpen || report.Errno != int(syscall.EACCES) {
+			t.Fatalf("changed: report=%+v err=%v, want failed/open/EACCES", report, err)
+		}
+	})
+}
