+	for _, w := range writers {
+		t.Run(w.name, func(t *testing.T) {
+			dir := t.TempDir()
+			path := filepath.Join(dir, "credential-synthetic.json")
+			previous := fxCodexMetadata("at-old")
+			fxWriteJSON(t, path, previous)
+			old, err := os.ReadFile(path)
+			if err != nil {
+				t.Fatal(err)
+			}
+			handle, err := os.Open(path)
+			if err != nil {
+				t.Fatal(err)
+			}
+			defer func() { _ = handle.Close() }()
+			oldInfo, err := handle.Stat()
+			if err != nil {
+				t.Fatal(err)
+			}
+
+			w.write(t, dir, path)
+
+			kept := make([]byte, len(old)+64)
+			n, _ := handle.ReadAt(kept, 0)
+			if string(kept[:n]) != string(old) {
+				t.Fatalf("the previous credential file was written in place: %q, want %q", kept[:n], old)
+			}
+			newInfo, err := os.Stat(path)
+			if err != nil {
+				t.Fatal(err)
+			}
+			if os.SameFile(oldInfo, newInfo) {
+				t.Fatal("the destination is the previous inode: written in place")
+			}
+			if newInfo.Mode().Perm() != 0o600 {
+				t.Fatalf("destination mode = %v, want 0600", newInfo.Mode().Perm())
+			}
+			fxReadJSON(t, path)
+			fxNoTempLeft(t, dir)
+		})
+	}
+}
diff --git a/sdk/auth/filestore_save.go b/sdk/auth/filestore_save.go
new file mode 100644
index 00000000..9a0753d4
--- /dev/null
+++ b/sdk/auth/filestore_save.go
@@ -0,0 +1,525 @@
+package auth
+
+import (
+	"context"
+	"crypto/rand"
+	"encoding/hex"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"io"
+	"os"
+	"path/filepath"
+	"strings"
+
+	cliproxyauth "github.com/router-for-me/CLIProxyAPI/v8/sdk/cliproxy/auth"
+)
+
+// A metadata save never rewrites the destination in place. It writes a same-directory
+// temporary file, checks the byte count, closes it and renames it over the destination,
+// so a failed write can never truncate the previous valid credential. With
+// SaveOptions.Sync it also syncs the file before the rename and the directory after it,
+// and reports persisted only when the destination is still the file it synced: no newer
+// write through this store and the same inode.
+//
+// The temporary name is ".<base>.cm-save-<16 hex>". It never ends in ".json" in any
+// letter case, so neither the auth-dir watcher (case-sensitive ".json" events) nor the
+// startup scans (case-insensitive ".json") ever load it as a credential.
+const saveTempMarker = ".cm-save-"
+
+// saveFile is the file surface a save uses; saveFileOps is its fault-injection seam.
+type saveFile interface {
+	Write([]byte) (int, error)
+	Sync() error
+	Close() error
+}
+
+type saveFileOps struct {
+	openTemp   func(name string) (saveFile, error)
+	rename     func(oldPath, newPath string) error
+	remove     func(name string) error
+	syncDir    func(dir string) error
+	tempSuffix func() (string, error)
+}
+
+var defaultSaveFileOps = &saveFileOps{
+	openTemp: func(name string) (saveFile, error) {
+		file, err := os.OpenFile(name, saveTempFlags, 0o600)
+		if err != nil {
+			return nil, err
+		}
+		return file, nil
+	},
+	rename:     os.Rename,
+	remove:     os.Remove,
+	syncDir:    syncDirectory,
+	tempSuffix: randomSaveSuffix,
+}
+
+// publishLocked records a write to path and returns its sequence number. The caller holds s.mu.
+func (s *FileTokenStore) publishLocked(path string) uint64 {
+	if s.published == nil {
+		s.published = make(map[string]uint64)
+	}
+	s.publishSeq++
+	s.published[path] = s.publishSeq
+	return s.publishSeq
+}
+
+// stillPublished reports whether path is still the file a verified save published as
+// seq: no later write through this store, and the destination is the staged inode (an
+// outside replacement or removal fails the second check).
+func (s *FileTokenStore) stillPublished(path string, seq uint64, staged os.FileInfo) bool {
+	if staged == nil {
+		return false
+	}
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	if s.published[path] != seq {
+		return false
+	}
+	current, err := os.Lstat(path)
+	return err == nil && os.SameFile(staged, current)
+}
+
+func unchangedSave(size int) cliproxyauth.SaveReport {
+	return cliproxyauth.SaveReport{Outcome: cliproxyauth.SaveOutcomeUnchanged, Stage: cliproxyauth.SaveStageNone, Category: cliproxyauth.SaveCategoryNone, Size: size}
+}
+
+func (s *FileTokenStore) saveOps() *saveFileOps {
+	if s.fileOps != nil {
+		return s.fileOps
+	}
+	return defaultSaveFileOps
+}
+
+func randomSaveSuffix() (string, error) {
+	var buf [8]byte
+	if _, err := rand.Read(buf[:]); err != nil {
+		return "", err
+	}
+	return hex.EncodeToString(buf[:]), nil
+}
+
+func saveTempPath(dest, suffix string) string {
+	return filepath.Join(filepath.Dir(dest), "."+filepath.Base(dest)+saveTempMarker+suffix)
+}
+
+// stageSave writes raw to a new temporary file next to dest and closes it. It removes the
+// temporary file on every failure and returns its path on success.
+func stageSave(ops *saveFileOps, dest string, raw []byte, sync bool) (string, cliproxyauth.SaveReport, error) {
+	size := len(raw)
+	suffix, err := ops.tempSuffix()
+	if err != nil {
+		return "", cliproxyauth.FailedSaveReport(cliproxyauth.SaveStageOpen, err, 0, size), fmt.Errorf("auth filestore: temp name failed: %w", err)
+	}
+	tmp := saveTempPath(dest, suffix)
+	file, err := ops.openTemp(tmp)
+	if err != nil {
+		// O_EXCL: nothing was created, and an existing entry is not ours to remove.
+		return "", cliproxyauth.FailedSaveReport(cliproxyauth.SaveStageOpen, err, 0, size), fmt.Errorf("auth filestore: open temp failed: %w", err)
+	}
+	n, err := file.Write(raw)
+	if err == nil && n != size {
+		err = io.ErrShortWrite
+	}
+	stage := cliproxyauth.SaveStageWrite
+	if err == nil && sync {
+		stage = cliproxyauth.SaveStageSync
+		err = file.Sync()
+	}
+	if err != nil {
+		_ = file.Close()
+		_ = ops.remove(tmp)
+		return "", cliproxyauth.FailedSaveReport(stage, err, n, size), fmt.Errorf("auth filestore: %s temp failed: %w", stage, err)
+	}
+	if err = file.Close(); err != nil {
+		_ = ops.remove(tmp)
+		return "", cliproxyauth.FailedSaveReport(cliproxyauth.SaveStageClose, err, n, size), fmt.Errorf("auth filestore: close temp failed: %w", err)
+	}
+	return tmp, cliproxyauth.SaveReport{Bytes: n, Size: size}, nil
+}
+
+// credentialsChangedOnDisk reports whether after carries different credentials than the
+// destination content before (nil when the destination did not exist).
+func credentialsChangedOnDisk(before, after []byte) bool {
+	var beforeMeta, afterMeta map[string]any
+	if len(before) > 0 {
+		if err := json.Unmarshal(before, &beforeMeta); err != nil {
+			beforeMeta = nil
+		}
+	}
+	if err := json.Unmarshal(after, &afterMeta); err != nil {
+		afterMeta = nil
+	}
+	return cliproxyauth.CredentialsChanged(&cliproxyauth.Auth{Metadata: beforeMeta}, &cliproxyauth.Auth{Metadata: afterMeta})
+}
+
+// SaveWithReport persists auth like Save and reports a typed, metadata-only outcome
+// (cliproxyauth.ReportingStore). Only opts.Sync on the metadata branch can report
+// persisted; the delegated TokenStorage branch reports unverified.
+func (s *FileTokenStore) SaveWithReport(ctx context.Context, auth *cliproxyauth.Auth, opts cliproxyauth.SaveOptions) (cliproxyauth.SaveReport, error) {
+	report, _, err := s.save(ctx, auth, opts)
+	return report, err
+}
+
+func (s *FileTokenStore) save(ctx context.Context, auth *cliproxyauth.Auth, opts cliproxyauth.SaveOptions) (cliproxyauth.SaveReport, string, error) {
+	if auth == nil {
+		err := fmt.Errorf("auth filestore: auth is nil")
+		return cliproxyauth.FailedSaveReport(cliproxyauth.SaveStageValidate, err, 0, 0), "", err
+	}
+	cliproxyauth.NormalizeCredentialMetadata(auth.Metadata)
+	if errWeight := cliproxyauth.ValidateAuthWeight(auth); errWeight != nil {
+		return cliproxyauth.FailedSaveReport(cliproxyauth.SaveStageValidate, errWeight, 0, 0), "", fmt.Errorf("auth filestore: %w", errWeight)
+	}
+
+	path, err := s.resolveAuthPath(auth)
+	if err != nil {
+		return cliproxyauth.FailedSaveReport(cliproxyauth.SaveStagePath, err, 0, 0), "", err
+	}
+	if path == "" {
+		err = fmt.Errorf("auth filestore: missing file path attribute for %s", auth.ID)
+		return cliproxyauth.FailedSaveReport(cliproxyauth.SaveStagePath, err, 0, 0), "", err
+	}
+
+	// Runtime updates must not recreate a disabled credential whose source file
+	// was deliberately removed. Login and migration callers explicitly mark the
+	// save when creating a missing disabled credential is intentional.
+	if auth.Disabled && !cliproxyauth.HasAuthCreationIntent(ctx) {
+		if _, statErr := os.Stat(path); os.IsNotExist(statErr) {
+			return cliproxyauth.SaveReport{Outcome: cliproxyauth.SaveOutcomeSkipped, Stage: cliproxyauth.SaveStageNone, Category: cliproxyauth.SaveCategoryDisabledAbsent}, "", nil
+		}
+	}
+
+	var report cliproxyauth.SaveReport
+	if cliproxyauth.IsCodexAuthRecord(auth) && (auth.CodexRefreshPatch != nil || auth.Storage != nil || auth.Metadata != nil) {
+		report, err = s.saveCodex(ctx, auth, path, opts)
+	} else if opts.Sync && auth.Storage == nil && auth.Metadata != nil {
+		report, err = s.saveMetadataVerified(auth, path, opts)
+	} else {
+		report, err = s.saveLocked(auth, path, opts)
+	}
+	if err != nil || report.Outcome == cliproxyauth.SaveOutcomeSkipped {
+		return report, "", err
+	}
+
+	if auth.Attributes == nil {
+		auth.Attributes = make(map[string]string)
+	}
+	auth.Attributes[cliproxyauth.AttributePath] = path
+	auth.Attributes[cliproxyauth.AttributeSource] = path
+	auth.Attributes[cliproxyauth.AttributeSourceBackend] = cliproxyauth.AuthSourceFile
+
+	if strings.TrimSpace(auth.FileName) == "" {
+		auth.FileName = auth.ID
+	}
+	return report, path, nil
+}
+
+func commitDeclined() cliproxyauth.SaveReport {
+	return cliproxyauth.SaveReport{Outcome: cliproxyauth.SaveOutcomeSkipped, Stage: cliproxyauth.SaveStageNone, Category: cliproxyauth.SaveCategoryCommitDeclined}
+}
+
+// saveLocked is the save without a durability barrier: the delegated TokenStorage writer,
+// or a metadata write through temp file and rename, both under s.mu.
+func (s *FileTokenStore) saveLocked(auth *cliproxyauth.Auth, path string, opts cliproxyauth.SaveOptions) (cliproxyauth.SaveReport, error) {
+	if opts.Commit != nil {
+		release, ok := opts.Commit()
+		if !ok {
+			return commitDeclined(), nil
+		}
+		if release != nil {
+			defer release()
+		}
+	}
+
+	s.mu.Lock()
+	defer s.mu.Unlock()
+
+	if err := os.MkdirAll(filepath.Dir(path), 0o700); err != nil {
+		return cliproxyauth.FailedSaveReport(cliproxyauth.SaveStageMkdir, err, 0, 0), fmt.Errorf("auth filestore: create dir failed: %w", err)
+	}
+
+	// metadataSetter is a private interface for TokenStorage implementations that support metadata injection.
+	type metadataSetter interface {
+		SetMetadata(map[string]any)
+	}
+
+	switch {
+	case auth.Storage != nil:
+		// The delegated writer's completion guarantees are unknown: never persisted.
+		before, _ := os.ReadFile(path)
+		if auth.Metadata == nil {
+			auth.Metadata = make(map[string]any)
+		}
+		auth.Metadata["disabled"] = auth.Disabled
+		if setter, ok := auth.Storage.(metadataSetter); ok {
+			setter.SetMetadata(auth.Metadata)
+		}
+		// The delegated writer may have replaced the destination even when it fails.
+		s.publishLocked(path)
+		if err := auth.Storage.SaveTokenToFile(path); err != nil {
+			return cliproxyauth.FailedSaveReport(cliproxyauth.SaveStageDelegated, err, 0, 0), err
+		}
+		after, _ := os.ReadFile(path)
+		return cliproxyauth.SaveReport{
+			Outcome:            cliproxyauth.SaveOutcomeUnverified,
+			Stage:              cliproxyauth.SaveStageNone,
+			Category:           cliproxyauth.SaveCategoryDelegated,
+			Bytes:              len(after),
+			Size:               len(after),
+			CredentialsChanged: credentialsChangedOnDisk(before, after),
+		}, nil
+	case auth.Metadata != nil:
+		auth.Metadata["disabled"] = auth.Disabled
+		raw, errMarshal := json.Marshal(auth.Metadata)
+		if errMarshal != nil {
+			return cliproxyauth.FailedSaveReport(cliproxyauth.SaveStageMarshal, errMarshal, 0, 0), fmt.Errorf("auth filestore: marshal metadata failed: %w", errMarshal)
+		}
+		return s.replaceUnsyncedLocked(path, raw)
+	default:
+		err := fmt.Errorf("auth filestore: nothing to persist for %s", auth.ID)
+		return cliproxyauth.FailedSaveReport(cliproxyauth.SaveStageStore, err, 0, 0), err
+	}
+}
+
+// replaceUnsyncedLocked replaces path with raw through a temporary file and a rename,
+// without a durability barrier (unverified, no_sync). The caller holds s.mu.
+func (s *FileTokenStore) replaceUnsyncedLocked(path string, raw []byte) (cliproxyauth.SaveReport, error) {
+	existing, errRead := os.ReadFile(path)
+	if errRead == nil && jsonEqual(existing, raw) {
+		return unchangedSave(len(raw)), nil
+	}
+	if errRead != nil && !os.IsNotExist(errRead) {
+		return cliproxyauth.FailedSaveReport(cliproxyauth.SaveStageRead, errRead, 0, len(raw)), fmt.Errorf("auth filestore: read existing failed: %w", errRead)
+	}
+	changed := credentialsChangedOnDisk(existing, raw)
+	ops := s.saveOps()
+	tmp, report, err := stageSave(ops, path, raw, false)
+	if err != nil {
+		report.CredentialsChanged = changed
+		return report, err
+	}
+	if err = ops.rename(tmp, path); err != nil {
+		_ = ops.remove(tmp)
+		report = cliproxyauth.FailedSaveReport(cliproxyauth.SaveStageRename, err, report.Bytes, report.Size)
+		report.CredentialsChanged = changed
+		return report, fmt.Errorf("auth filestore: rename failed: %w", err)
+	}
+	s.publishLocked(path)
+	report.Outcome = cliproxyauth.SaveOutcomeUnverified
+	report.Stage = cliproxyauth.SaveStageNone
+	report.Category = cliproxyauth.SaveCategoryNoSync
+	report.CredentialsChanged = changed
+	return report, nil
+}
+
+// compareDestination reads the destination under opts.Commit and s.mu and reports whether
+// it already holds raw (unchanged, done) or cannot be read (failed, done).
+func (s *FileTokenStore) compareDestination(path string, raw []byte, commit func() (func(), bool)) (cliproxyauth.SaveReport, bool, error) {
+	if commit != nil {
+		release, ok := commit()
+		if !ok {
+			return commitDeclined(), true, nil
+		}
+		if release != nil {
+			defer release()
+		}
+	}
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	existing, errRead := os.ReadFile(path)
+	if errRead == nil && jsonEqual(existing, raw) {
+		return unchangedSave(len(raw)), true, nil
+	}
+	if errRead != nil && !os.IsNotExist(errRead) {
+		return cliproxyauth.FailedSaveReport(cliproxyauth.SaveStageRead, errRead, 0, len(raw)), true, fmt.Errorf("auth filestore: read existing failed: %w", errRead)
+	}
+	return cliproxyauth.SaveReport{}, false, nil
+}
+
+// saveMetadataVerified is the metadata save with the durability barrier. An unchanged
+// destination is detected first, under opts.Commit and s.mu, and costs no write or sync.
+// Otherwise the payload is staged and synced with neither held; the destination compare
+// and the rename run under them; the directory sync runs after both are released, and
+// the result is persisted only if the destination is still the synced file.
+func (s *FileTokenStore) saveMetadataVerified(auth *cliproxyauth.Auth, path string, opts cliproxyauth.SaveOptions) (cliproxyauth.SaveReport, error) {
+	auth.Metadata["disabled"] = auth.Disabled
+	raw, errMarshal := json.Marshal(auth.Metadata)
+	if errMarshal != nil {
+		return cliproxyauth.FailedSaveReport(cliproxyauth.SaveStageMarshal, errMarshal, 0, 0), fmt.Errorf("auth filestore: marshal metadata failed: %w", errMarshal)
+	}
+	return s.replaceVerified(path, raw, opts)
+}
+
+// replaceVerified replaces path with raw under the durability barrier; see
+// saveMetadataVerified.
+func (s *FileTokenStore) replaceVerified(path string, raw []byte, opts cliproxyauth.SaveOptions) (cliproxyauth.SaveReport, error) {
+	if report, done, err := s.compareDestination(path, raw, opts.Commit); done {
+		return report, err
+	}
+	dir := filepath.Dir(path)
+	if err := os.MkdirAll(dir, 0o700); err != nil {
+		return cliproxyauth.FailedSaveReport(cliproxyauth.SaveStageMkdir, err, 0, len(raw)), fmt.Errorf("auth filestore: create dir failed: %w", err)
+	}
+	ops := s.saveOps()
+	tmp, staged, err := stageSave(ops, path, raw, true)
+	if err != nil {
+		// Unlocked, informational read: did the lost write carry new credentials?
+		existing, _ := os.ReadFile(path)
+		staged.CredentialsChanged = credentialsChangedOnDisk(existing, raw)
+		return staged, err
+	}
+	renamed := false
+	defer func() {
+		if !renamed {
+			_ = ops.remove(tmp)
+		}
+	}()
+
+	var release func()
+	if opts.Commit != nil {
+		var ok bool
+		if release, ok = opts.Commit(); !ok {
+			return commitDeclined(), nil
+		}
+	}
+	var seq uint64
+	var stagedInfo os.FileInfo
+	report, err := func() (cliproxyauth.SaveReport, error) {
+		s.mu.Lock()
+		defer s.mu.Unlock()
+		// The destination may have changed since the first compare.
+		existing, errRead := os.ReadFile(path)
+		if errRead == nil && jsonEqual(existing, raw) {
+			return unchangedSave(len(raw)), nil
+		}
+		if errRead != nil && !os.IsNotExist(errRead) {
+			return cliproxyauth.FailedSaveReport(cliproxyauth.SaveStageRead, errRead, 0, len(raw)), fmt.Errorf("auth filestore: read existing failed: %w", errRead)
+		}
+		changed := credentialsChangedOnDisk(existing, raw)
+		// The synced inode; nil (never persisted) if it cannot be identified.
+		if info, errStat := os.Lstat(tmp); errStat == nil {
+			stagedInfo = info
+		}
+		if errRename := ops.rename(tmp, path); errRename != nil {
+			report := cliproxyauth.FailedSaveReport(cliproxyauth.SaveStageRename, errRename, staged.Bytes, staged.Size)
+			report.CredentialsChanged = changed
+			return report, fmt.Errorf("auth filestore: rename failed: %w", errRename)
+		}
+		renamed = true
+		seq = s.publishLocked(path)
+		return cliproxyauth.SaveReport{Bytes: staged.Bytes, Size: staged.Size, CredentialsChanged: changed}, nil
+	}()
+	if release != nil {
+		release()
+	}
+	if err != nil || report.Outcome == cliproxyauth.SaveOutcomeUnchanged {
+		return report, err
+	}
+
+	// The replacement is committed from here on: a failure is not "nothing changed".
+	if errSync := ops.syncDir(dir); errSync != nil {
+		if errors.Is(errSync, errDirSyncUnsupported) {
+			report.Outcome = cliproxyauth.SaveOutcomeUnverified
+			report.Stage = cliproxyauth.SaveStageNone
+			report.Category = cliproxyauth.SaveCategoryDirSyncUnsupported
+			return report, nil
+		}
+		failed := cliproxyauth.FailedSaveReport(cliproxyauth.SaveStageDirSync, errSync, report.Bytes, report.Size)
+		failed.CredentialsChanged = report.CredentialsChanged
+		return failed, fmt.Errorf("auth filestore: directory sync failed after rename: %w", errSync)
+	}
+	report.Stage = cliproxyauth.SaveStageNone
+	// Neither lock was held over the directory sync, so another write may have replaced
+	// the destination meanwhile; the directory sync then made that file's (unsynced)
+	// entry durable, not ours.
+	if !s.stillPublished(path, seq, stagedInfo) {
+		report.Outcome = cliproxyauth.SaveOutcomeUnverified
+		report.Category = cliproxyauth.SaveCategorySuperseded
+		return report, nil
+	}
+	report.Outcome = cliproxyauth.SaveOutcomePersisted
+	report.Category = cliproxyauth.SaveCategoryNone
+	return report, nil
+}
+
+// saveCodex saves a Codex credential record through the upstream Codex branches
+// (refresh patch, token storage, metadata), which merge with the file on disk under the
+// record's inter-process lock (<path>.lock). The refresh-patch and metadata branches
+// write their final object through this store: a temporary file and a rename, with the
+// durability barrier when opts.Sync is set, so they report like any metadata save. The
+// token-storage branch is the delegated writer and reports unverified. s.mu is taken
+// only inside the record lock (never around it), as every other writer of the file does.
+func (s *FileTokenStore) saveCodex(ctx context.Context, auth *cliproxyauth.Auth, path string, opts cliproxyauth.SaveOptions) (cliproxyauth.SaveReport, error) {
+	if err := os.MkdirAll(filepath.Dir(path), 0o700); err != nil {
+		return cliproxyauth.FailedSaveReport(cliproxyauth.SaveStageMkdir, err, 0, 0), fmt.Errorf("auth filestore: create dir failed: %w", err)
+	}
+	delegated := auth.CodexRefreshPatch == nil && auth.Storage != nil
+	var before []byte
+	if delegated {
+		before, _ = os.ReadFile(path)
+	}
+	var report cliproxyauth.SaveReport
+	wrote := false
+	write := func(dest string, data map[string]any) error {
+		wrote = true
+		raw, errMarshal := json.Marshal(data)
+		if errMarshal != nil {
+			report = cliproxyauth.FailedSaveReport(cliproxyauth.SaveStageMarshal, errMarshal, 0, 0)
+			return fmt.Errorf("auth filestore: marshal metadata failed: %w", errMarshal)
+		}
+		var errWrite error
+		if opts.Sync {
+			report, errWrite = s.replaceVerified(dest, raw, opts)
+			return errWrite
+		}
+		if opts.Commit != nil {
+			release, ok := opts.Commit()
+			if !ok {
+				report = commitDeclined()
+				return nil
+			}
+			if release != nil {
+				defer release()
+			}
+		}
+		s.mu.Lock()
+		defer s.mu.Unlock()
+		report, errWrite = s.replaceUnsyncedLocked(dest, raw)
+		return errWrite
+	}
+	if delegated {
+		// The delegated writer may have replaced the destination even when it fails.
+		s.mu.Lock()
+		s.publishLocked(path)
+		s.mu.Unlock()
+	}
+	handled, err := cliproxyauth.PersistCodexAuthFileWith(ctx, path, auth, write)
+	if !handled {
+		return s.saveLocked(auth, path, opts)
+	}
+	if delegated {
+		if err != nil {
+			return cliproxyauth.FailedSaveReport(cliproxyauth.SaveStageDelegated, err, 0, 0), err
+		}
+		after, _ := os.ReadFile(path)
+		return cliproxyauth.SaveReport{
+			Outcome:            cliproxyauth.SaveOutcomeUnverified,
+			Stage:              cliproxyauth.SaveStageNone,
+			Category:           cliproxyauth.SaveCategoryDelegated,
+			Bytes:              len(after),
+			Size:               len(after),
+			CredentialsChanged: credentialsChangedOnDisk(before, after),
+		}, nil
+	}
+	if !wrote {
+		if err != nil {
