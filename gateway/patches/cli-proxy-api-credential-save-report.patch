+func TestCM053CredentialSaveTempNameNeverJSON(t *testing.T) {
+	dir := t.TempDir()
+	fxSeed(t, dir, "claude-a.json")
+	store, faults := fxStore(dir)
+	for i := 0; i < 3; i++ {
+		auth := fxAuth(dir, "claude-a.json", fmt.Sprintf("%s-%d", fxNewAccess, i), fxNewRefresh)
+		if _, err := store.SaveWithReport(context.Background(), auth, cliproxyauth.SaveOptions{Sync: i%2 == 0}); err != nil {
+			t.Fatal(err)
+		}
+	}
+	pattern := regexp.MustCompile(`^\.claude-a\.json\.cm-save-[0-9a-f]{16}$`)
+	faults.mu.Lock()
+	temps := append([]string(nil), faults.temps...)
+	faults.mu.Unlock()
+	if len(temps) != 3 {
+		t.Fatalf("temps = %q, want 3", temps)
+	}
+	for _, temp := range temps {
+		base := filepath.Base(temp)
+		if filepath.Dir(temp) != dir || !pattern.MatchString(base) || strings.HasSuffix(strings.ToLower(base), ".json") {
+			t.Fatalf("temp %q: want %s in the destination directory, never *.json", temp, pattern)
+		}
+	}
+	for i := 0; i < 1000; i++ {
+		suffix, err := randomSaveSuffix()
+		if err != nil || !regexp.MustCompile(`^[0-9a-f]{16}$`).MatchString(suffix) {
+			t.Fatalf("suffix %q err %v", suffix, err)
+		}
+	}
+
+	// O_EXCL|O_NOFOLLOW: a pre-planted entry at the temp name (here a symlink to a
+	// victim file) fails the open; nothing is written through it or removed.
+	victim := filepath.Join(t.TempDir(), "victim")
+	if err := os.WriteFile(victim, []byte("victim"), 0o600); err != nil {
+		t.Fatal(err)
+	}
+	faults.suffix = "0123456789abcdef"
+	planted := saveTempPath(filepath.Join(dir, "claude-a.json"), faults.suffix)
+	if err := os.Symlink(victim, planted); err != nil {
+		t.Fatal(err)
+	}
+	before, _ := os.ReadFile(filepath.Join(dir, "claude-a.json"))
+	report, err := store.SaveWithReport(context.Background(), fxAuth(dir, "claude-a.json", "sk-other", fxNewRefresh), cliproxyauth.SaveOptions{Sync: true})
+	if err == nil || report.Stage != cliproxyauth.SaveStageOpen || report.Errno != int(syscall.EEXIST) {
+		t.Fatalf("planted temp: report=%+v err=%v, want failed/open/EEXIST", report, err)
+	}
+	if got, _ := os.ReadFile(victim); string(got) != "victim" {
+		t.Fatalf("victim written through the temp name: %q", got)
+	}
+	if _, errL := os.Lstat(planted); errL != nil {
+		t.Fatalf("an entry the save did not create was removed: %v", errL)
+	}
+	fxAssertBytes(t, filepath.Join(dir, "claude-a.json"), before)
+}
