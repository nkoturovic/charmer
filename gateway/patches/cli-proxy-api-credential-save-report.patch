+// SaveWithReport keeps the wrapper's hooks on the Manager's save path (charmer
+// local patch, credential-save-report): the inherited
+// FileTokenStore.SaveWithReport would bypass them.
+func (s *afterSaveStore) SaveWithReport(ctx context.Context, auth *coreauth.Auth, opts coreauth.SaveOptions) (coreauth.SaveReport, error) {
+	if errFail := s.failNext; errFail != nil {
+		s.failNext = nil
+		return coreauth.FailedSaveReport(coreauth.SaveStageStore, errFail, 0, 0), errFail
+	}
+	report, errSave := s.FileTokenStore.SaveWithReport(ctx, auth, opts)
+	if hook := s.afterSave; hook != nil {
+		s.afterSave = nil
+		hook()
+	}
+	return report, errSave
+}
