+// charmer: a persist failure surfaces as the metadata-only credential_save_v1 event
+// at warn level. No log entry names the auth ID (a file name that can carry an
+// e-mail address) or the error text of the store.
+func assertCredentialSaveFailed(t *testing.T, hook *logtest.Hook, operation, authID, errText string) {
+	t.Helper()
+	prefix := "credential_save_v1 operation=" + operation + " result=failed "
+	var matched *log.Entry
+	for _, entry := range hook.AllEntries() {
+		text := entry.Message
+		for key, value := range entry.Data {
+			text += " " + key + "=" + fmt.Sprint(value)
+		}
+		if strings.Contains(text, authID) || strings.Contains(text, errText) {
+			t.Fatalf("log entry names the auth or the store error: %q", text)
+		}
+		if entry.Level == log.WarnLevel && strings.HasPrefix(entry.Message, prefix) {
+			matched = entry
+		}
+	}
+	if matched == nil {
+		t.Fatalf("expected a warn %q event, got logs: %#v", prefix, hook.AllEntries())
+	}
+	if len(matched.Data) != 0 {
+		t.Fatalf("credential_save_v1 event carries logger fields: %v", matched.Data)
+	}
+	if !strings.Contains(matched.Message, " stage=store errno=0 category=error ") {
+		t.Fatalf("event = %q, want stage=store errno=0 category=error", matched.Message)
+	}
+}
