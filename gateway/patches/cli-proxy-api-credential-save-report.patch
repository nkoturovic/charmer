+
+// These gates run a real fsnotify Watcher on an auth directory while the file store
+// saves a credential, and a real initial scan next to a leftover save temp file. The
+// temp name must never look like a credential to either.
+
+const fxWatchTimeout = 5 * time.Second
+
+type fxWatchFixture struct {
+	t        *testing.T
+	authDir  string
+	queue    chan watcher.AuthUpdate
+	w        *watcher.Watcher
+	barriers int
+}
+
+func fxWriteCredential(t *testing.T, path, access string) {
+	t.Helper()
+	raw, err := json.Marshal(map[string]any{
+		"type":          "claude",
+		"email":         "synthetic-user@example.invalid",
+		"access_token":  access,
+		"refresh_token": "sk-ant-ort01-SYNTHETIC-REFRESH",
+		"disabled":      false,
+	})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err = os.WriteFile(path, raw, 0o600); err != nil {
+		t.Fatal(err)
+	}
+}
+
+func fxStartWatcher(t *testing.T, authDir string) (*fxWatchFixture, []watcher.AuthUpdate) {
+	t.Helper()
+	root := filepath.Dir(authDir)
+	cfgPath := filepath.Join(root, "cfg", "config.yaml")
+	if err := os.MkdirAll(filepath.Dir(cfgPath), 0o700); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.WriteFile(cfgPath, []byte(fmt.Sprintf("auth-dir: %q\nport: 1\n", authDir)), 0o600); err != nil {
+		t.Fatal(err)
+	}
+	cfg, err := config.LoadConfig(cfgPath)
+	if err != nil {
+		t.Fatalf("load config: %v", err)
+	}
+	w, err := watcher.NewWatcher(cfgPath, authDir, func(*config.Config) {})
+	if err != nil {
+		t.Fatalf("NewWatcher: %v", err)
+	}
+	f := &fxWatchFixture{t: t, authDir: authDir, queue: make(chan watcher.AuthUpdate, 1024), w: w}
+	w.SetConfig(cfg)
+	w.SetAuthUpdateQueue(f.queue)
+	ctx, cancel := context.WithCancel(context.Background())
+	t.Cleanup(func() {
+		cancel()
+		_ = w.Stop()
+	})
+	if err = w.Start(ctx); err != nil {
+		t.Fatalf("Start: %v", err)
+	}
+	return f, f.drainToMarker()
+}
+
+// drainToMarker collects every update dispatched before a DispatchAuthBarrier marker.
+func (f *fxWatchFixture) drainToMarker() []watcher.AuthUpdate {
+	f.t.Helper()
+	done := f.w.DispatchAuthBarrier()
+	if done == nil {
+		f.t.Fatal("DispatchAuthBarrier returned nil")
+	}
+	var got []watcher.AuthUpdate
+	deadline := time.After(fxWatchTimeout)
+	for {
+		select {
+		case update := <-f.queue:
+			if update.IsBarrier() {
+				update.ReleaseBarrier()
+				return got
+			}
+			got = append(got, update)
+		case <-deadline:
+			f.t.Fatalf("no dispatch marker within %s", fxWatchTimeout)
+		}
+	}
+}
+
+// settle writes a sibling barrier credential and returns every update up to and
+// excluding its add. The watcher handles inotify events in order, so every event of
+// the saves before it has been handled and dispatched by then.
+func (f *fxWatchFixture) settle() []watcher.AuthUpdate {
+	f.t.Helper()
+	f.barriers++
+	id := fmt.Sprintf("cm053-barrier-%d.json", f.barriers)
+	fxWriteCredential(f.t, filepath.Join(f.authDir, id), fmt.Sprintf("sk-barrier-%d", f.barriers))
+	var got []watcher.AuthUpdate
+	deadline := time.After(fxWatchTimeout)
+	for {
+		select {
+		case update := <-f.queue:
+			if update.IsBarrier() {
+				update.ReleaseBarrier()
+				continue
+			}
+			if update.ID == id {
+				return append(got, f.drainToMarker()...)
+			}
+			got = append(got, update)
+		case <-deadline:
+			f.t.Fatalf("barrier %s not dispatched within %s", id, fxWatchTimeout)
+		}
+	}
+}
+
+func fxDescribeUpdates(updates []watcher.AuthUpdate) string {
+	parts := make([]string, 0, len(updates))
+	for _, u := range updates {
+		parts = append(parts, fmt.Sprintf("%s:%s", u.Action, u.ID))
+	}
+	return strings.Join(parts, " ")
+}
+
+func fxAssertNoTempFiles(t *testing.T, dir string) {
+	t.Helper()
+	entries, err := os.ReadDir(dir)
+	if err != nil {
+		t.Fatal(err)
+	}
+	for _, entry := range entries {
+		if strings.Contains(entry.Name(), ".cm-save-") {
+			t.Fatalf("temporary save file left behind: %s", entry.Name())
+		}
+	}
+}
+
+func fxSaveAuth(authDir, access string) *cliproxyauth.Auth {
+	path := filepath.Join(authDir, "claude-a.json")
+	return &cliproxyauth.Auth{
+		ID:         "claude-a.json",
+		Provider:   "claude",
+		FileName:   "claude-a.json",
+		Attributes: map[string]string{"path": path},
+		Metadata: map[string]any{
+			"type":          "claude",
+			"email":         "synthetic-user@example.invalid",
+			"access_token":  access,
+			"refresh_token": "sk-ant-ort01-SYNTHETIC-REFRESH",
+		},
+	}
+}
+
+func TestCM053CredentialSaveWatcherSeesOnlyDestination(t *testing.T) {
+	authDir := filepath.Join(t.TempDir(), "auth")
+	if err := os.MkdirAll(authDir, 0o700); err != nil {
+		t.Fatal(err)
+	}
+	dest := filepath.Join(authDir, "claude-a.json")
+	fxWriteCredential(t, dest, "sk-ant-oat01-SYNTHETIC-OLD")
+	f, initial := fxStartWatcher(t, authDir)
+	if len(initial) != 1 || initial[0].ID != "claude-a.json" || initial[0].Action != watcher.AuthUpdateActionAdd {
+		t.Fatalf("initial updates = %s, want add:claude-a.json", fxDescribeUpdates(initial))
+	}
+
+	// pausedSettle settles the watcher while a save's temporary file exists (partial
+	// content at a write failure, complete content at a sync, close or rename point):
+	// the watcher must have seen nothing.
+	pausedSettle := func(context string) func() {
+		return func() {
+			tempSeen := false
+			entries, _ := os.ReadDir(authDir)
+			for _, entry := range entries {
+				tempSeen = tempSeen || strings.Contains(entry.Name(), ".cm-save-")
+			}
+			if !tempSeen {
+				t.Errorf("%s: no temporary file exists at the pause point", context)
+			}
+			if got := f.settle(); len(got) != 0 {
+				t.Errorf("%s: watcher updates while the temp file exists: %s", context, fxDescribeUpdates(got))
+			}
+		}
+	}
+
+	// Every forced pre-rename failure: the watcher sees nothing at all.
+	for i, stage := range []string{"open", "write", "short_write", "sync", "close", "rename"} {
+		pause := pausedSettle(stage)
+		if stage == "open" {
+			pause = nil // nothing is created
+		}
+		store := sdkauth.NewFileTokenStoreWithSaveFaultForTest(stage, syscall.ENOSPC, pause)
+		report, err := store.SaveWithReport(context.Background(), fxSaveAuth(authDir, fmt.Sprintf("sk-failed-%d", i)), cliproxyauth.SaveOptions{Sync: true})
+		if err == nil || report.Outcome != cliproxyauth.SaveOutcomeFailed {
+			t.Fatalf("%s: report=%+v err=%v, want failed", stage, report, err)
+		}
+		if got := f.settle(); len(got) != 0 {
+			t.Fatalf("%s: failed save produced watcher updates: %s", stage, fxDescribeUpdates(got))
+		}
+		fxAssertNoTempFiles(t, authDir)
+	}
+
+	// One persisted save, then one unsynced save: each is exactly one modify of the
+	// destination, carrying the complete new content; never an add or remove.
+	for _, sync := range []bool{true, false} {
+		store := sdkauth.NewFileTokenStoreWithSaveFaultForTest("", nil, pausedSettle(fmt.Sprintf("sync=%t before rename", sync)))
+		access := fmt.Sprintf("sk-ant-oat01-SYNTHETIC-NEW-sync-%t", sync)
+		report, err := store.SaveWithReport(context.Background(), fxSaveAuth(authDir, access), cliproxyauth.SaveOptions{Sync: sync})
+		wantOutcome := cliproxyauth.SaveOutcomeUnverified
+		if sync {
+			wantOutcome = cliproxyauth.SaveOutcomePersisted
+		}
+		if err != nil || report.Outcome != wantOutcome {
+			t.Fatalf("sync=%t: report=%+v err=%v, want %s", sync, report, err, wantOutcome)
+		}
+		got := f.settle()
+		if len(got) != 1 || got[0].ID != "claude-a.json" || got[0].Action != watcher.AuthUpdateActionModify {
+			t.Fatalf("sync=%t: updates = %s, want exactly modify:claude-a.json", sync, fxDescribeUpdates(got))
+		}
+		if token, _ := got[0].Auth.Metadata["access_token"].(string); token != access {
+			t.Fatalf("sync=%t: watcher loaded access_token %q, want the complete new content", sync, token)
+		}
+		fxAssertNoTempFiles(t, authDir)
+	}
+}
+
+func TestCM053StartupScanIgnoresSaveTemp(t *testing.T) {
+	authDir := filepath.Join(t.TempDir(), "auth")
+	if err := os.MkdirAll(authDir, 0o700); err != nil {
+		t.Fatal(err)
+	}
+	dest := filepath.Join(authDir, "claude-a.json")
+	fxWriteCredential(t, dest, "sk-ant-oat01-SYNTHETIC-DEST")
+	// A crash between create and rename leaves a complete credential copy behind.
+	leftover := sdkauth.SaveTempPathForTest(dest, "0123456789abcdef")
+	fxWriteCredential(t, leftover, "sk-ant-oat01-SYNTHETIC-LEFTOVER")
+
+	_, initial := fxStartWatcher(t, authDir)
+	if len(initial) != 1 || initial[0].ID != "claude-a.json" {
+		t.Fatalf("initial scan updates = %s, want only add:claude-a.json", fxDescribeUpdates(initial))
+	}
+	if token, _ := initial[0].Auth.Metadata["access_token"].(string); token != "sk-ant-oat01-SYNTHETIC-DEST" {
+		t.Fatalf("initial scan loaded access_token %q", token)
+	}
+
+	store := sdkauth.NewFileTokenStore()
+	store.SetBaseDir(authDir)
+	listed, err := store.List(context.Background())
+	if err != nil {
+		t.Fatalf("List: %v", err)
+	}
+	if len(listed) != 1 || listed[0].ID != "claude-a.json" {
+		ids := make([]string, 0, len(listed))
+		for _, a := range listed {
+			ids = append(ids, a.ID)
+		}
+		t.Fatalf("store List = %q, want only claude-a.json", ids)
+	}
+	if _, errStat := os.Stat(leftover); errStat != nil {
+		t.Fatalf("the scan must leave the leftover alone: %v", errStat)
+	}
+}
