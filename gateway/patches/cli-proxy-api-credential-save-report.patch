diff --git a/sdk/auth/filestore_cm053_fsize_test.go b/sdk/auth/filestore_cm053_fsize_test.go
new file mode 100644
index 00000000..972e9c06
--- /dev/null
+++ b/sdk/auth/filestore_cm053_fsize_test.go
@@ -0,0 +1,113 @@
+//go:build linux
+
+package auth
+
+import (
+	"bytes"
+	"context"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"os"
+	"os/exec"
+	"path/filepath"
+	"strings"
+	"syscall"
+	"testing"
+
+	cliproxyauth "github.com/router-for-me/CLIProxyAPI/v8/sdk/cliproxy/auth"
+)
+
+// A black-box control on the real file system: a re-executed test process lowers
+// RLIMIT_FSIZE below the new payload and saves over a valid credential. The Go runtime
+// only forwards SIGXFSZ to signal.Notify, so the write fails with EFBIG. The previous
+// credential must be intact. (Upstream's in-place O_TRUNC write loses it.)
+const (
+	fxFSizeChildEnv = "CM053_FSIZE_CHILD_DIR"
+	fxFSizeModeEnv  = "CM053_FSIZE_MODE"
+	fxFSizeLimit    = 4096
+)
+
+func fxFSizeChild(t *testing.T, dir, mode string) {
+	limit := syscall.Rlimit{Cur: fxFSizeLimit, Max: fxFSizeLimit}
+	if err := syscall.Setrlimit(syscall.RLIMIT_FSIZE, &limit); err != nil {
+		fmt.Printf("CM053RESULT setrlimit-failed\n")
+		os.Exit(3)
+	}
+	meta := map[string]any{
+		"type":          "claude",
+		"access_token":  "sk-ant-oat01-SYNTHETIC-NEW-ACCESS",
+		"refresh_token": "sk-ant-ort01-SYNTHETIC-NEW-REFRESH",
+		"padding":       strings.Repeat("x", 4*fxFSizeLimit),
+	}
+	auth := &cliproxyauth.Auth{
+		ID:         "claude-a.json",
+		Provider:   "claude",
+		FileName:   "claude-a.json",
+		Attributes: map[string]string{"path": filepath.Join(dir, "claude-a.json")},
+		Metadata:   meta,
+	}
+	store := NewFileTokenStore()
+	var err error
+	outcome := "none"
+	switch mode {
+	case "save":
+		_, err = store.Save(context.Background(), auth)
+	case "report":
+		var report cliproxyauth.SaveReport
+		report, err = store.SaveWithReport(context.Background(), auth, cliproxyauth.SaveOptions{Sync: true})
+		outcome = fmt.Sprintf("%s/%s/%d", report.Outcome, report.Stage, report.Errno)
+	}
+	var errno syscall.Errno
+	if !errors.As(err, &errno) {
+		errno = 0
+	}
+	fmt.Printf("CM053RESULT errno=%d outcome=%s\n", int(errno), outcome)
+	os.Exit(0)
+}
+
+func TestCM053CredentialSaveFileSizeLimitKeepsPriorCredential(t *testing.T) {
+	if dir := os.Getenv(fxFSizeChildEnv); dir != "" {
+		fxFSizeChild(t, dir, os.Getenv(fxFSizeModeEnv))
+		return
+	}
+	for _, mode := range []string{"save", "report"} {
+		t.Run(mode, func(t *testing.T) {
+			dir := t.TempDir()
+			prior, err := json.Marshal(map[string]any{
+				"type":          "claude",
+				"access_token":  "sk-ant-oat01-SYNTHETIC-OLD-ACCESS",
+				"refresh_token": "sk-ant-ort01-SYNTHETIC-OLD-REFRESH",
+			})
+			if err != nil {
+				t.Fatal(err)
+			}
+			dest := filepath.Join(dir, "claude-a.json")
+			if err = os.WriteFile(dest, prior, 0o600); err != nil {
+				t.Fatal(err)
+			}
+			cmd := exec.Command(os.Args[0], "-test.run=^TestCM053CredentialSaveFileSizeLimitKeepsPriorCredential$", "-test.count=1")
+			cmd.Env = append(os.Environ(), fxFSizeChildEnv+"="+dir, fxFSizeModeEnv+"="+mode)
+			var out bytes.Buffer
+			cmd.Stdout, cmd.Stderr = &out, &out
+			if errRun := cmd.Run(); errRun != nil {
+				t.Fatalf("child: %v\n%s", errRun, out.String())
+			}
+			wantResult := "CM053RESULT errno=27 outcome=none"
+			if mode == "report" {
+				wantResult = "CM053RESULT errno=27 outcome=failed/write/27"
+			}
+			if !strings.Contains(out.String(), wantResult+"\n") {
+				t.Fatalf("child result: want %q (EFBIG) in\n%s", wantResult, out.String())
+			}
+			got, errRead := os.ReadFile(dest)
+			if errRead != nil || !bytes.Equal(got, prior) {
+				t.Fatalf("prior credential lost after an EFBIG write: %q (err %v), want %q", got, errRead, prior)
+			}
+			entries, _ := os.ReadDir(dir)
+			if len(entries) != 1 {
+				t.Fatalf("directory holds %d entries after the failed save, want only the destination", len(entries))
+			}
+		})
+	}
+}
diff --git a/sdk/auth/filestore_cm053_manager_test.go b/sdk/auth/filestore_cm053_manager_test.go
new file mode 100644
index 00000000..e0c9a83c
--- /dev/null
+++ b/sdk/auth/filestore_cm053_manager_test.go
@@ -0,0 +1,187 @@
+package auth_test
+
+import (
+	"context"
+	"encoding/json"
+	"os"
+	"path/filepath"
+	"regexp"
+	"strings"
+	"sync"
+	"testing"
+
+	sdkauth "github.com/router-for-me/CLIProxyAPI/v8/sdk/auth"
+	cliproxyauth "github.com/router-for-me/CLIProxyAPI/v8/sdk/cliproxy/auth"
+	log "github.com/sirupsen/logrus"
+)
+
+// This gate drives the Manager with the real FileTokenStore: a refresh's verified save
+// whose destination another save replaces during its directory sync must not produce a
+// persisted receipt, and must not be logged after the newer save as if it were current.
+// The manager serializes its own saves of one credential (the mutation gate), so the
+// replacing writers here are outside it: a save through the store itself, and another
+// process replacing the file.
+
+type fxManagerLogs struct {
+	mu    sync.Mutex
+	lines []string
+}
+
+func (c *fxManagerLogs) Levels() []log.Level { return log.AllLevels }
+
+func (c *fxManagerLogs) Fire(entry *log.Entry) error {
+	if strings.HasPrefix(entry.Message, "credential_save_v1 ") {
+		c.mu.Lock()
+		c.lines = append(c.lines, entry.Message)
+		c.mu.Unlock()
+	}
+	return nil
+}
+
+var fxManagerEvent = regexp.MustCompile(`^credential_save_v1 operation=([a-z]+) result=([a-z]+) .* category=([a-z_]+) bytes=`)
+
+// take returns "operation/result/category" for every event since the last call.
+func (c *fxManagerLogs) take(t *testing.T) string {
+	t.Helper()
+	c.mu.Lock()
+	lines := c.lines
+	c.lines = nil
+	c.mu.Unlock()
+	parts := make([]string, 0, len(lines))
+	for _, line := range lines {
+		m := fxManagerEvent.FindStringSubmatch(line)
+		if m == nil {
+			t.Fatalf("credential_save_v1 line off format: %q", line)
+		}
+		parts = append(parts, m[1]+"/"+m[2]+"/"+m[3])
+	}
+	return strings.Join(parts, " ")
+}
+
+func fxCaptureManagerLogs(t *testing.T) *fxManagerLogs {
+	t.Helper()
+	capture := &fxManagerLogs{}
+	logger := log.StandardLogger()
+	saved := make(log.LevelHooks)
+	for level, hooks := range logger.Hooks {
+		saved[level] = append([]log.Hook(nil), hooks...)
+	}
+	savedLevel := logger.GetLevel()
+	logger.SetLevel(log.TraceLevel)
+	logger.AddHook(capture)
+	t.Cleanup(func() {
+		logger.ReplaceHooks(saved)
+		logger.SetLevel(savedLevel)
+	})
+	return capture
+}
+
+func TestCM053CredentialSaveSupersededReceiptWithFileStore(t *testing.T) {
+	logs := fxCaptureManagerLogs(t)
+	dir := t.TempDir()
+	path := filepath.Join(dir, "claude-a.json")
+	fxWriteCredential(t, path, "sk-ant-oat01-SYNTHETIC-SEED")
+
+	var during func()
+	store, syncCounts := sdkauth.NewFileTokenStoreWithDirSyncHookForTest(func() {
+		if f := during; f != nil {
+			during = nil
+			f()
+		}
+	})
+	store.SetBaseDir(dir)
+	m := cliproxyauth.NewManager(store, nil, nil)
+	newAuth := func(access string) *cliproxyauth.Auth {
+		return &cliproxyauth.Auth{
+			ID:         "claude-a.json",
+			Provider:   "claude",
+			FileName:   "claude-a.json",
+			Attributes: map[string]string{"path": path},
+			Metadata: map[string]any{
+				"type":          "claude",
+				"email":         "synthetic-user@example.invalid",
+				"access_token":  access,
+				"refresh_token": "sk-ant-ort01-SYNTHETIC-REFRESH",
+				"disabled":      false,
+			},
+		}
+	}
+	if _, err := m.Register(cliproxyauth.WithSkipPersist(context.Background()), newAuth("sk-ant-oat01-SYNTHETIC-SEED")); err != nil {
+		t.Fatal(err)
+	}
+	refresh := func(access string) {
+		t.Helper()
+		base, ok := m.GetByID("claude-a.json")
+		if !ok {
+			t.Fatal("auth missing")
+		}
+		updated := base.Clone()
+		updated.Metadata["access_token"] = access
+		if _, err := m.UpdateRefreshedAuth(context.Background(), base, updated); err != nil {
+			t.Fatalf("UpdateRefreshedAuth: %v", err)
+		}
+	}
+	onDisk := func() string {
+		t.Helper()
+		raw, err := os.ReadFile(path)
+		if err != nil {
+			t.Fatal(err)
+		}
+		var meta map[string]any
+		if err = json.Unmarshal(raw, &meta); err != nil {
+			t.Fatal(err)
+		}
+		access, _ := meta["access_token"].(string)
+		return access
+	}
+
+	// Control: a reader during the directory sync changes nothing: the receipt stands.
+	during = func() {
+		_ = onDisk()
+	}
+	refresh("sk-ant-oat01-SYNTHETIC-R1")
+	if got := logs.take(t); got != "refresh/persisted/none" {
+		t.Fatalf("control events = %q, want refresh/persisted/none", got)
+	}
+
+	// A save through the store writes a different credential, unsynced, between the
+	// refresh's rename and the end of its directory sync. The refresh must not report
+	// persisted.
+	filesBefore, _ := syncCounts()
+	during = func() {
+		if _, err := store.Save(context.Background(), newAuth("sk-ant-oat01-SYNTHETIC-REREGISTERED")); err != nil {
+			t.Errorf("store save: %v", err)
+		}
+	}
+	refresh("sk-ant-oat01-SYNTHETIC-R2")
+	filesAfter, _ := syncCounts()
+	got := logs.take(t)
+	if got != "refresh/unverified/superseded" {
+		t.Fatalf("events = %q (file syncs=%d), want refresh/unverified/superseded", got, filesAfter-filesBefore)
+	}
+	if access := onDisk(); access != "sk-ant-oat01-SYNTHETIC-REREGISTERED" {
+		t.Fatalf("destination access token = %q, want the re-registered credential", access)
+	}
+	if filesAfter-filesBefore != 1 {
+		t.Fatalf("file syncs during the superseded refresh = %d, want 1 (the refresh's own)", filesAfter-filesBefore)
+	}
+
+	// Another process replaces the file during the directory sync (a new inode): the
+	// refresh is superseded too.
+	during = func() {
+		fxWriteCredential(t, path+".other", "sk-ant-oat01-SYNTHETIC-OTHER-PROCESS")
+		if err := os.Rename(path+".other", path); err != nil {
+			t.Errorf("rename: %v", err)
+		}
+	}
+	refresh("sk-ant-oat01-SYNTHETIC-R2B")
+	if got = logs.take(t); got != "refresh/unverified/superseded" {
+		t.Fatalf("outside replacement events = %q, want refresh/unverified/superseded", got)
+	}
+
+	// The next refresh with no interference is a receipt again.
+	refresh("sk-ant-oat01-SYNTHETIC-R3")
+	if got := logs.take(t); got != "refresh/persisted/none" {
+		t.Fatalf("follow-up events = %q, want refresh/persisted/none", got)
+	}
+}
diff --git a/sdk/auth/filestore_cm053_test.go b/sdk/auth/filestore_cm053_test.go
new file mode 100644
index 00000000..b8ddcf77
--- /dev/null
+++ b/sdk/auth/filestore_cm053_test.go
@@ -0,0 +1,806 @@
+package auth
+
+import (
+	"bytes"
+	"context"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"io"
+	"os"
+	"path/filepath"
+	"regexp"
+	"strings"
+	"sync"
+	"syscall"
+	"testing"
+
+	cliproxyauth "github.com/router-for-me/CLIProxyAPI/v8/sdk/cliproxy/auth"
+)
+
+// fxFaults wraps the real save operations with injected failures and counters.
+type fxFaults struct {
+	mu        sync.Mutex
+	stage     string // "", "open", "write", "short_write", "sync", "close", "rename", "dirsync"
+	err       error
+	suffix    string // fixed temp suffix when set
+	fileSyncs int
+	dirSyncs  int
+	temps     []string
+	events    []string
+	// pause runs while the temporary file exists: at an injected write, sync or close
+	// failure, and before every rename.
+	pause func()
+	// beforeDirSync runs before every directory sync: after a verified save's rename,
+	// with neither the caller's ordering lock nor the store lock held.
+	beforeDirSync func()
+}
+
+func (c *fxFaults) paused() {
+	if c.pause != nil {
+		c.pause()
+	}
+}
+
+type fxFile struct {
+	f      saveFile
+	faults *fxFaults
+}
+
+func (f *fxFile) Write(p []byte) (int, error) {
+	switch f.faults.current() {
+	case "write":
+		n, _ := f.f.Write(p[:len(p)/3])
+		f.faults.paused()
+		return n, f.faults.err
+	case "short_write":
+		// A short count with a nil error: the writer must not trust err alone.
+		n, err := f.f.Write(p[:len(p)/2])
+		f.faults.paused()
+		return n, err
+	}
+	return f.f.Write(p)
+}
+
+func (f *fxFile) Sync() error {
+	f.faults.record("sync")
+	f.faults.mu.Lock()
+	f.faults.fileSyncs++
+	f.faults.mu.Unlock()
+	if f.faults.current() == "sync" {
+		_ = f.f.Sync()
+		f.faults.paused()
+		return f.faults.err
+	}
+	return f.f.Sync()
+}
+
+func (f *fxFile) Close() error {
+	errClose := f.f.Close()
+	f.faults.record("close")
+	if f.faults.current() == "close" {
+		f.faults.paused()
+		return f.faults.err
+	}
+	return errClose
+}
+
+func (c *fxFaults) current() string {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	return c.stage
+}
+
+func (c *fxFaults) record(event string) {
+	c.mu.Lock()
+	c.events = append(c.events, event)
+	c.mu.Unlock()
+}
+
+func (c *fxFaults) ops() *saveFileOps {
+	return &saveFileOps{
+		openTemp: func(name string) (saveFile, error) {
+			c.mu.Lock()
+			c.temps = append(c.temps, name)
+			c.mu.Unlock()
+			c.record("open")
+			if c.current() == "open" {
+				return nil, c.err
+			}
+			file, err := defaultSaveFileOps.openTemp(name)
+			if err != nil {
+				return nil, err
+			}
+			return &fxFile{f: file, faults: c}, nil
+		},
+		rename: func(oldPath, newPath string) error {
+			c.record("rename")
+			c.paused()
+			if c.current() == "rename" {
+				return c.err
+			}
+			return os.Rename(oldPath, newPath)
+		},
+		remove: os.Remove,
+		syncDir: func(dir string) error {
+			if c.beforeDirSync != nil {
+				c.beforeDirSync()
+			}
+			c.record("dirsync")
+			c.mu.Lock()
+			c.dirSyncs++
+			c.mu.Unlock()
+			if c.current() == "dirsync" {
+				return c.err
+			}
+			return syncDirectory(dir)
+		},
+		tempSuffix: func() (string, error) {
+			if c.suffix != "" {
+				return c.suffix, nil
+			}
+			return randomSaveSuffix()
+		},
+	}
+}
+
+func (c *fxFaults) syncCounts() (int, int) {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	return c.fileSyncs, c.dirSyncs
+}
+
+const (
+	fxOldAccess  = "sk-ant-oat01-SYNTHETIC-OLD-ACCESS"
+	fxOldRefresh = "sk-ant-ort01-SYNTHETIC-OLD-REFRESH"
+	fxNewAccess  = "sk-ant-oat01-SYNTHETIC-NEW-ACCESS"
+	fxNewRefresh = "sk-ant-ort01-SYNTHETIC-NEW-REFRESH"
+	fxEmail      = "synthetic-user@example.invalid"
+)
+
+// Fixed bytes, not json.Marshal of the object being tested (D217).
+const fxFullWriteJSONGolden = `{"access_token":"sk-ant-oat01-SYNTHETIC-NEW-ACCESS","disabled":false,"email":"synthetic-user@example.invalid","expired":"2026-09-28T12:00:00Z","refresh_token":"sk-ant-ort01-SYNTHETIC-NEW-REFRESH","type":"claude"}`
+
+func fxMetadata(access, refresh string) map[string]any {
+	return map[string]any{
+		"type":          "claude",
+		"email":         fxEmail,
+		"access_token":  access,
+		"refresh_token": refresh,
+		"expired":       "2026-09-28T12:00:00Z",
+	}
+}
+
+func fxAuth(dir, name, access, refresh string) *cliproxyauth.Auth {
+	return &cliproxyauth.Auth{
+		ID:         name,
+		Provider:   "claude",
+		FileName:   name,
+		Attributes: map[string]string{"path": filepath.Join(dir, name)},
+		Metadata:   fxMetadata(access, refresh),
+	}
+}
+
+// fxSeed writes the previous valid credential and returns its bytes.
+func fxSeed(t *testing.T, dir, name string) []byte {
+	t.Helper()
+	meta := fxMetadata(fxOldAccess, fxOldRefresh)
+	meta["disabled"] = false
+	raw, err := json.Marshal(meta)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err = os.WriteFile(filepath.Join(dir, name), raw, 0o600); err != nil {
+		t.Fatal(err)
+	}
+	return raw
+}
+
+func fxStore(dir string) (*FileTokenStore, *fxFaults) {
+	faults := &fxFaults{}
+	store := NewFileTokenStore()
+	store.SetBaseDir(dir)
+	store.fileOps = faults.ops()
+	return store, faults
+}
+
+func fxAssertNoTemp(t *testing.T, dir string) {
+	t.Helper()
+	entries, err := os.ReadDir(dir)
+	if err != nil {
+		t.Fatal(err)
+	}
+	for _, entry := range entries {
+		if strings.Contains(entry.Name(), saveTempMarker) {
+			t.Fatalf("temporary save file left behind: %s", entry.Name())
+		}
+	}
+}
+
+func fxGoldenBytesMatch(got, want []byte) bool { return bytes.Equal(got, want) }
+
+func TestCM053CredentialSaveLiteralJSONControl(t *testing.T) {
+	want := []byte(fxFullWriteJSONGolden)
+	if !fxGoldenBytesMatch(want, want) {
+		t.Fatal("literal positive control failed")
+	}
+	for _, changed := range [][]byte{append(bytes.Clone(want), byte('\n')),
+		bytes.Replace(want, []byte("NEW-ACCESS"), []byte("NEW-ACCESX"), 1)} {
+		if fxGoldenBytesMatch(changed, want) {
+			t.Fatal("changed golden byte accepted")
+		}
+	}
+}
+
+func fxAssertBytes(t *testing.T, path string, want []byte) {
+	t.Helper()
+	got, err := os.ReadFile(path)
+	if err != nil {
+		t.Fatalf("read destination: %v", err)
+	}
+	if !fxGoldenBytesMatch(got, want) {
+		t.Fatalf("destination changed:\n got %q\nwant %q", got, want)
+	}
+}
+
+func fxAssertMetadataOnly(t *testing.T, report cliproxyauth.SaveReport) {
+	t.Helper()
+	text := fmt.Sprintf("%+v", report)
+	for _, secret := range []string{fxOldAccess, fxOldRefresh, fxNewAccess, fxNewRefresh, fxEmail, "claude-a", string(os.PathSeparator)} {
+		if strings.Contains(text, secret) {
+			t.Fatalf("save report carries %q: %s", secret, text)
+		}
+	}
+}
+
+func TestCM053CredentialSaveFullWriteReceipt(t *testing.T) {
+	dir := t.TempDir()
+	fxSeed(t, dir, "claude-a.json")
+	store, faults := fxStore(dir)
+	dest := filepath.Join(dir, "claude-a.json")
+
+	auth := fxAuth(dir, "claude-a.json", fxNewAccess, fxNewRefresh)
+	report, err := store.SaveWithReport(context.Background(), auth, cliproxyauth.SaveOptions{Sync: true})
+	if err != nil {
+		t.Fatalf("SaveWithReport: %v", err)
+	}
+	want := []byte(fxFullWriteJSONGolden)
+	if report.Outcome != cliproxyauth.SaveOutcomePersisted || report.Stage != cliproxyauth.SaveStageNone ||
+		report.Category != cliproxyauth.SaveCategoryNone || report.Errno != 0 {
+		t.Fatalf("report = %+v, want persisted", report)
+	}
+	if report.Bytes != len(want) || report.Size != len(want) {
+		t.Fatalf("bytes=%d size=%d, want %d", report.Bytes, report.Size, len(want))
+	}
+	if !report.CredentialsChanged {
+		t.Fatal("a token rotation must report credentials_changed")
+	}
+	fxAssertBytes(t, dest, want)
+	info, err := os.Stat(dest)
+	if err != nil || info.Mode().Perm() != 0o600 {
+		t.Fatalf("destination mode = %v (%v), want 0600", info.Mode().Perm(), err)
+	}
+	if files, dirs := faults.syncCounts(); files != 1 || dirs != 1 {
+		t.Fatalf("file syncs=%d dir syncs=%d, want 1 and 1", files, dirs)
+	}
+	faults.mu.Lock()
+	order := strings.Join(faults.events, ",")
+	faults.mu.Unlock()
+	if order != "open,sync,close,rename,dirsync" {
+		t.Fatalf("save order = %s, want open,sync,close,rename,dirsync", order)
+	}
+	fxAssertNoTemp(t, dir)
+	fxAssertMetadataOnly(t, report)
+	if auth.Attributes[cliproxyauth.AttributePath] != dest {
+		t.Fatalf("path attribute = %q", auth.Attributes[cliproxyauth.AttributePath])
+	}
+
+	// A non-credential change is persisted but is not a credential change.
+	auth.Metadata["label"] = "renamed"
+	report, err = store.SaveWithReport(context.Background(), auth, cliproxyauth.SaveOptions{Sync: true})
+	if err != nil || report.Outcome != cliproxyauth.SaveOutcomePersisted || report.CredentialsChanged {
+		t.Fatalf("label change: report=%+v err=%v, want persisted without credential change", report, err)
+	}
+
+	// Equal content is unchanged, not a rotation and not a receipt.
+	report, err = store.SaveWithReport(context.Background(), auth, cliproxyauth.SaveOptions{Sync: true})
+	if err != nil || report.Outcome != cliproxyauth.SaveOutcomeUnchanged || report.CredentialsChanged {
+		t.Fatalf("equal content: report=%+v err=%v, want unchanged", report, err)
+	}
+	fxAssertNoTemp(t, dir)
+
+	// A new destination is persisted and carries new credentials.
+	fresh := fxAuth(dir, "claude-b.json", fxNewAccess, fxNewRefresh)
+	report, err = store.SaveWithReport(context.Background(), fresh, cliproxyauth.SaveOptions{Sync: true})
+	if err != nil || report.Outcome != cliproxyauth.SaveOutcomePersisted || !report.CredentialsChanged {
+		t.Fatalf("new file: report=%+v err=%v, want persisted with credentials_changed", report, err)
+	}
+	fxAssertNoTemp(t, dir)
+}
+
+func TestCM053CredentialSaveShortWriteIsFailure(t *testing.T) {
+	for _, sync := range []bool{true, false} {
+		t.Run(fmt.Sprintf("sync=%t", sync), func(t *testing.T) {
+			dir := t.TempDir()
+			prior := fxSeed(t, dir, "claude-a.json")
+			store, faults := fxStore(dir)
+			faults.stage = "short_write"
+
+			auth := fxAuth(dir, "claude-a.json", fxNewAccess, fxNewRefresh)
+			payload, _ := json.Marshal(func() map[string]any {
+				meta := fxMetadata(fxNewAccess, fxNewRefresh)
+				meta["disabled"] = false
+				return meta
+			}())
+			report, err := store.SaveWithReport(context.Background(), auth, cliproxyauth.SaveOptions{Sync: sync})
+			if !errors.Is(err, io.ErrShortWrite) {
+				t.Fatalf("err = %v, want io.ErrShortWrite", err)
+			}
+			if report.Outcome != cliproxyauth.SaveOutcomeFailed || report.Stage != cliproxyauth.SaveStageWrite ||
+				report.Category != cliproxyauth.SaveCategoryShortWrite || report.Errno != 0 {
+				t.Fatalf("report = %+v, want failed/write/short_write", report)
+			}
+			if report.Bytes != len(payload)/2 || report.Size != len(payload) {
+				t.Fatalf("bytes=%d size=%d, want %d of %d", report.Bytes, report.Size, len(payload)/2, len(payload))
+			}
+			if !report.CredentialsChanged {
+				t.Fatal("the failed attempt carried new credentials")
+			}
+			fxAssertBytes(t, filepath.Join(dir, "claude-a.json"), prior)
+			fxAssertNoTemp(t, dir)
+			fxAssertMetadataOnly(t, report)
+			if files, dirs := faults.syncCounts(); files != 0 || dirs != 0 {
+				t.Fatalf("a failed write must not reach sync: file=%d dir=%d", files, dirs)
+			}
+		})
+	}
+}
+
+func TestCM053CredentialSaveFailureStages(t *testing.T) {
+	cases := []struct {
+		stage     string
+		err       syscall.Errno
+		wantStage cliproxyauth.SaveStage
+		sync      bool
+		committed bool
+	}{
+		{"open", syscall.EACCES, cliproxyauth.SaveStageOpen, true, false},
+		{"open", syscall.ENOSPC, cliproxyauth.SaveStageOpen, false, false},
+		{"write", syscall.ENOSPC, cliproxyauth.SaveStageWrite, true, false},
+		{"write", syscall.EDQUOT, cliproxyauth.SaveStageWrite, false, false},
+		{"sync", syscall.EIO, cliproxyauth.SaveStageSync, true, false},
+		{"close", syscall.EIO, cliproxyauth.SaveStageClose, true, false},
+		{"close", syscall.ENOSPC, cliproxyauth.SaveStageClose, false, false},
+		{"rename", syscall.EXDEV, cliproxyauth.SaveStageRename, true, false},
+		{"rename", syscall.EACCES, cliproxyauth.SaveStageRename, false, false},
+		{"dirsync", syscall.EIO, cliproxyauth.SaveStageDirSync, true, true},
+	}
+	for _, tc := range cases {
+		t.Run(fmt.Sprintf("%s/%s/sync=%t", tc.stage, tc.err, tc.sync), func(t *testing.T) {
+			dir := t.TempDir()
+			prior := fxSeed(t, dir, "claude-a.json")
+			store, faults := fxStore(dir)
+			faults.stage, faults.err = tc.stage, tc.err
+			auth := fxAuth(dir, "claude-a.json", fxNewAccess, fxNewRefresh)
+
+			report, err := store.SaveWithReport(context.Background(), auth, cliproxyauth.SaveOptions{Sync: tc.sync})
+			if !errors.Is(err, tc.err) {
+				t.Fatalf("err = %v, want %v", err, tc.err)
+			}
+			if report.Outcome != cliproxyauth.SaveOutcomeFailed || report.Stage != tc.wantStage ||
+				report.Category != cliproxyauth.SaveCategoryErrno || report.Errno != int(tc.err) {
+				t.Fatalf("report = %+v, want failed stage=%s errno=%d", report, tc.wantStage, int(tc.err))
+			}
+			if !report.CredentialsChanged {
+				t.Fatalf("report = %+v: the attempt carried new credentials", report)
+			}
+			dest := filepath.Join(dir, "claude-a.json")
+			if tc.committed {
+				// Replacement already committed: not "nothing changed", and no restore.
+				want, _ := json.Marshal(auth.Metadata)
+				fxAssertBytes(t, dest, want)
+			} else {
+				fxAssertBytes(t, dest, prior)
+			}
+			fxAssertNoTemp(t, dir)
+			fxAssertMetadataOnly(t, report)
+			if _, ok := auth.Attributes[cliproxyauth.AttributeSourceBackend]; ok {
+				t.Fatal("a failed save must not mark the auth as file-backed")
+			}
+		})
+	}
+
+	// A real (not injected) open failure: the directory refuses new entries.
+	if os.Geteuid() == 0 {
+		t.Skip("root ignores directory permissions")
+	}
+	dir := t.TempDir()
+	prior := fxSeed(t, dir, "claude-a.json")
+	if err := os.Chmod(dir, 0o500); err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { _ = os.Chmod(dir, 0o700) })
+	store := NewFileTokenStore()
+	report, err := store.SaveWithReport(context.Background(), fxAuth(dir, "claude-a.json", fxNewAccess, fxNewRefresh), cliproxyauth.SaveOptions{Sync: true})
+	if err == nil || report.Outcome != cliproxyauth.SaveOutcomeFailed || report.Stage != cliproxyauth.SaveStageOpen || report.Errno != int(syscall.EACCES) {
+		t.Fatalf("read-only dir: report=%+v err=%v, want failed/open/EACCES", report, err)
+	}
+	fxAssertBytes(t, filepath.Join(dir, "claude-a.json"), prior)
+}
