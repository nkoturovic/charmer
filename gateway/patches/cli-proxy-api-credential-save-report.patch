+	logs.events(t)
+
+	configKey := &Auth{ID: "cfg", Provider: "claude", Attributes: map[string]string{"api_key": "sk-cfg", "source": "config:claude-api-key"}, Metadata: map[string]any{"type": "claude"}}
+	if !IsConfigAPIKeyAuth(configKey) {
