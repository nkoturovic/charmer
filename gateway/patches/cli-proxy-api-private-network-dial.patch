+func TestDiffOpenAICompatPrivateNetworkPrintsClassAndURLOnly(t *testing.T) {
+	entry := func(url, class string) config.OpenAICompatibility {
+		return config.OpenAICompatibility{
+			Name:           "pn-provider",
+			BaseURL:        url,
+			PrivateNetwork: &config.OpenAICompatPrivateNetwork{BaseURL: url, Class: class},
+			APIKeyEntries:  []config.OpenAICompatibilityAPIKey{{APIKey: "pn-sentinel-key-0123456789"}},
+		}
+	}
+	changes := DiffOpenAICompatibility(
+		[]config.OpenAICompatibility{entry("http://127.0.0.1:8010/v1", "loopback")},
+		[]config.OpenAICompatibility{entry("http://100.88.1.1:8010/v1?token=pn-query-secret", "tailnet")},
+	)
+	if len(changes) != 1 || changes[0] != "provider updated: pn-provider (private-network loopback http://127.0.0.1:8010/v1 -> tailnet http://100.88.1.1:8010/v1)" {
+		t.Fatalf("changes = %q", changes)
+	}
+	if strings.Contains(changes[0], "pn-sentinel-key") || strings.Contains(changes[0], "pn-query-secret") {
+		t.Fatal("a secret reached the change line")
+	}
+	unchanged := DiffOpenAICompatibility([]config.OpenAICompatibility{entry("http://127.0.0.1:8010/v1", "loopback")},
+		[]config.OpenAICompatibility{entry("http://127.0.0.1:8010/v1", "loopback")})
+	if len(unchanged) != 0 {
+		t.Fatalf("unchanged entry reported %q", unchanged)
+	}
+	added := DiffOpenAICompatibility(nil, []config.OpenAICompatibility{{Name: "pn-provider", PrivateNetwork: &config.OpenAICompatPrivateNetwork{BaseURL: "http://u:pn-userinfo-secret@10.0.0.5/v1", Class: "lan"}}})
+	ordinary := entry("http://127.0.0.1:8010/v1", "loopback")
+	ordinary.PrivateNetwork = nil
+	removed := DiffOpenAICompatibility([]config.OpenAICompatibility{entry("http://127.0.0.1:8010/v1", "loopback")}, []config.OpenAICompatibility{ordinary})
+	if len(added) != 1 || strings.Contains(added[0], "pn-userinfo-secret") {
+		t.Fatalf("added = %q", added)
+	}
+	if len(removed) != 1 || removed[0] != "provider updated: pn-provider (private-network loopback http://127.0.0.1:8010/v1 -> none)" {
+		t.Fatalf("removed = %q", removed)
+	}
