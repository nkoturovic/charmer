+++ b/internal/runtime/executor/openai_compat_private_network_test.go
@@ -0,0 +1,366 @@
+package executor
+
+import (
+	"bytes"
+	"context"
+	"errors"
+	"io"
+	"net"
+	"net/http"
+	"net/http/httptest"
+	"strconv"
+	"strings"
+	"sync"
+	"sync/atomic"
+	"testing"
+
+	"github.com/router-for-me/CLIProxyAPI/v8/internal/config"
+	"github.com/router-for-me/CLIProxyAPI/v8/internal/privatenet"
+	cliproxyauth "github.com/router-for-me/CLIProxyAPI/v8/sdk/cliproxy/auth"
+	cliproxyexecutor "github.com/router-for-me/CLIProxyAPI/v8/sdk/cliproxy/executor"
+	sdktranslator "github.com/router-for-me/CLIProxyAPI/v8/sdk/translator"
+	log "github.com/sirupsen/logrus"
+)
+
+const privateNetworkKey = "pn-sentinel-key-0123456789"
+
+// privateNetworkUpstream is a loopback provider that counts accepted
+// connections and requests and answers every compat site.
+type privateNetworkUpstream struct {
+	server   *httptest.Server
+	accepts  atomic.Int64
+	requests atomic.Int64
+	mu       sync.Mutex
+	auth     []string
+}
+
+func newPrivateNetworkUpstream(t *testing.T) *privateNetworkUpstream {
+	t.Helper()
+	u := &privateNetworkUpstream{}
+	u.server = httptest.NewUnstartedServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		u.requests.Add(1)
+		u.mu.Lock()
+		u.auth = append(u.auth, r.Header.Get("Authorization"))
+		u.mu.Unlock()
+		body, _ := io.ReadAll(r.Body)
+		stream := bytes.Contains(body, []byte(`"stream":true`))
+		switch {
+		case strings.HasSuffix(r.URL.Path, "/chat/completions") && stream:
+			w.Header().Set("Content-Type", "text/event-stream")
+			_, _ = io.WriteString(w, "data: {\"id\":\"c1\",\"object\":\"chat.completion.chunk\",\"model\":\"pn-model\",\"choices\":[{\"index\":0,\"delta\":{\"role\":\"assistant\",\"content\":\"ok\"},\"finish_reason\":\"stop\"}]}\n\ndata: [DONE]\n\n")
+		case strings.HasSuffix(r.URL.Path, "/chat/completions"):
+			w.Header().Set("Content-Type", "application/json")
+			_, _ = io.WriteString(w, `{"id":"c1","object":"chat.completion","model":"pn-model","choices":[{"index":0,"message":{"role":"assistant","content":"ok"},"finish_reason":"stop"}],"usage":{"prompt_tokens":1,"completion_tokens":1,"total_tokens":2}}`)
+		case strings.HasSuffix(r.URL.Path, "/images/generations") && stream:
+			w.Header().Set("Content-Type", "text/event-stream")
+			_, _ = io.WriteString(w, "data: {\"type\":\"image_generation.completed\",\"model\":\"gpt-image-2\",\"b64_json\":\"AAAA\",\"usage\":{\"input_tokens\":1,\"output_tokens\":1,\"total_tokens\":2}}\n\n")
+		case strings.HasSuffix(r.URL.Path, "/images/generations"):
+			w.Header().Set("Content-Type", "application/json")
+			_, _ = io.WriteString(w, `{"created":1,"data":[{"b64_json":"AAAA"}]}`)
+		case strings.HasSuffix(r.URL.Path, "/responses/compact"):
+			w.Header().Set("Content-Type", "application/json")
+			_, _ = io.WriteString(w, `{"id":"resp_1","object":"response.compaction","usage":{"input_tokens":1,"output_tokens":1,"total_tokens":2}}`)
+		default:
+			w.Header().Set("Content-Type", "application/json")
+			_, _ = io.WriteString(w, `{"object":"list","data":[]}`)
+		}
+	}))
+	u.server.Config.ConnState = func(_ net.Conn, state http.ConnState) {
+		if state == http.StateNew {
+			u.accepts.Add(1)
+		}
+	}
+	u.server.Start()
+	t.Cleanup(u.server.Close)
+	return u
+}
+
+func (u *privateNetworkUpstream) port() int {
+	return u.server.Listener.Addr().(*net.TCPAddr).Port
+}
+
+func privateNetworkAuth(baseURL, class, key string) *cliproxyauth.Auth {
+	attrs := map[string]string{"base_url": baseURL, "compat_name": "pn-provider", "provider_key": "pn-provider", "private_network": class}
+	if key != "" {
+		attrs["api_key"] = key
+	}
+	return &cliproxyauth.Auth{ID: "pn-auth", Provider: "openai-compatibility", Label: "pn-provider", Attributes: attrs}
+}
+
+// privateNetworkEntry is the configured entry an auth was synthesized from:
+// on a private network of class, or an ordinary entry when class is "".
+func privateNetworkEntry(baseURL, class string) config.OpenAICompatibility {
+	entry := config.OpenAICompatibility{Name: "pn-provider", BaseURL: baseURL}
+	if class != "" {
+		entry.PrivateNetwork = &config.OpenAICompatPrivateNetwork{BaseURL: baseURL, Class: class}
+		entry.PrivateNetworkNormalized = true
+	}
+	return entry
+}
+
+// privateNetworkExecutor is the executor of a configuration whose entries
+// are given; with none, the entry auth was synthesized from.
+func privateNetworkExecutor(port int, auth *cliproxyauth.Auth, entries ...config.OpenAICompatibility) *OpenAICompatExecutor {
+	if len(entries) == 0 {
+		class, _ := openAICompatPrivateNetwork(auth)
+		entries = []config.OpenAICompatibility{privateNetworkEntry(auth.Attributes["base_url"], class)}
+	}
+	return NewOpenAICompatExecutor("openai-compatibility", &config.Config{Port: port, OpenAICompatibility: entries})
+}
+
+func drainPrivateNetworkStream(result *cliproxyexecutor.StreamResult, err error) error {
+	if err != nil {
+		return err
+	}
+	for chunk := range result.Chunks {
+		if chunk.Err != nil {
+			return chunk.Err
+		}
+	}
+	return nil
+}
+
+// privateNetworkSites are the five compat client construction sites and the
+// compact path; each runs one request through the executor.
+var privateNetworkSites = []struct {
+	name string
+	run  func(ctx context.Context, e *OpenAICompatExecutor, auth *cliproxyauth.Auth) error
+}{
+	{"execute", func(ctx context.Context, e *OpenAICompatExecutor, auth *cliproxyauth.Auth) error {
+		_, err := e.Execute(ctx, auth, cliproxyexecutor.Request{Model: "pn-model", Payload: []byte(`{"model":"pn-model","messages":[{"role":"user","content":"hi"}]}`)},
+			cliproxyexecutor.Options{SourceFormat: sdktranslator.FormatOpenAI})
+		return err
+	}},
+	{"stream", func(ctx context.Context, e *OpenAICompatExecutor, auth *cliproxyauth.Auth) error {
+		return drainPrivateNetworkStream(e.ExecuteStream(ctx, auth, cliproxyexecutor.Request{Model: "pn-model", Payload: []byte(`{"model":"pn-model","messages":[{"role":"user","content":"hi"}],"stream":true}`)},
+			cliproxyexecutor.Options{SourceFormat: sdktranslator.FormatOpenAI, Stream: true}))
+	}},
+	{"images", func(ctx context.Context, e *OpenAICompatExecutor, auth *cliproxyauth.Auth) error {
+		_, err := e.Execute(ctx, auth, cliproxyexecutor.Request{Model: "gpt-image-2", Payload: []byte(`{"model":"gpt-image-2","prompt":"p"}`)},
+			cliproxyexecutor.Options{SourceFormat: sdktranslator.FromString("openai-image"), Metadata: map[string]any{cliproxyexecutor.RequestPathMetadataKey: "/v1/images/generations"}})
+		return err
+	}},
+	{"images stream", func(ctx context.Context, e *OpenAICompatExecutor, auth *cliproxyauth.Auth) error {
+		return drainPrivateNetworkStream(e.ExecuteStream(ctx, auth, cliproxyexecutor.Request{Model: "gpt-image-2", Payload: []byte(`{"model":"gpt-image-2","prompt":"p","stream":true}`)},
+			cliproxyexecutor.Options{SourceFormat: sdktranslator.FromString("openai-image"), Stream: true, Metadata: map[string]any{cliproxyexecutor.RequestPathMetadataKey: "/v1/images/generations"}}))
+	}},
+	{"generic request", func(ctx context.Context, e *OpenAICompatExecutor, auth *cliproxyauth.Auth) error {
+		req, err := http.NewRequestWithContext(ctx, http.MethodGet, auth.Attributes["base_url"]+"/models", nil)
+		if err != nil {
+			return err
+		}
+		resp, err := e.HttpRequest(ctx, auth, req)
+		if resp != nil && resp.Body != nil {
+			_ = resp.Body.Close()
+		}
+		return err
+	}},
+	{"compact", func(ctx context.Context, e *OpenAICompatExecutor, auth *cliproxyauth.Auth) error {
+		_, err := e.Execute(ctx, auth, cliproxyexecutor.Request{Model: "pn-model", Payload: []byte(`{"model":"pn-model","input":[{"role":"user","content":"hi"}]}`)},
+			cliproxyexecutor.Options{SourceFormat: sdktranslator.FromString("openai-response"), Alt: "responses/compact"})
+		return err
+	}},
+}
+
+func capturePrivateNetworkLog(t *testing.T) *bytes.Buffer {
+	t.Helper()
+	var buf bytes.Buffer
+	logger := log.StandardLogger()
+	previousOut, previousLevel := logger.Out, logger.GetLevel()
+	logger.SetOutput(&buf)
+	logger.SetLevel(log.DebugLevel)
+	t.Cleanup(func() {
+		logger.SetOutput(previousOut)
+		logger.SetLevel(previousLevel)
+	})
+	return &buf
+}
+
+func TestPrivateNetworkEverySiteServesItsClass(t *testing.T) {
+	for _, site := range privateNetworkSites {
+		t.Run(site.name, func(t *testing.T) {
+			upstream := newPrivateNetworkUpstream(t)
+			auth := privateNetworkAuth(upstream.server.URL+"/v1", privatenet.Loopback, privateNetworkKey)
+			if err := site.run(context.Background(), privateNetworkExecutor(18317, auth), auth); err != nil {
+				t.Fatalf("err = %v", err)
+			}
+			if upstream.requests.Load() != 1 {
+				t.Fatalf("upstream requests = %d", upstream.requests.Load())
+			}
+			if got := upstream.auth[0]; got != "Bearer "+privateNetworkKey {
+				t.Fatalf("authorization = %q", got)
+			}
+		})
+	}
+}
+
+func TestPrivateNetworkEverySiteRefusesOutsideItsClass(t *testing.T) {
+	const want = "upstream address refused: outside the provider's private network (tailnet)"
+	for _, site := range privateNetworkSites {
+		for _, key := range []string{privateNetworkKey, ""} {
+			t.Run(site.name+"/keyed="+strconv.FormatBool(key != ""), func(t *testing.T) {
+				logs := capturePrivateNetworkLog(t)
+				upstream := newPrivateNetworkUpstream(t)
+				auth := privateNetworkAuth(upstream.server.URL+"/v1", privatenet.Tailnet, key)
+				err := site.run(context.Background(), privateNetworkExecutor(18317, auth), auth)
+				if err == nil || err.Error() != want {
+					t.Fatalf("err = %v", err)
+				}
+				var status interface{ StatusCode() int }
+				if !errors.As(err, &status) || status.StatusCode() != http.StatusBadGateway || errors.Unwrap(err) != nil {
+					t.Fatalf("err %#v is not the fresh 502 refusal", err)
+				}
+				if upstream.accepts.Load() != 0 || upstream.requests.Load() != 0 {
+					t.Fatalf("upstream accepts=%d requests=%d", upstream.accepts.Load(), upstream.requests.Load())
+				}
+				line := "private-network: refused provider=pn-provider class=tailnet remote=127.0.0.1 reason=outside-class"
+				if text := logs.String(); !strings.Contains(text, line) || strings.Contains(text, privateNetworkKey) {
+					t.Fatalf("log = %q", text)
+				}
+			})
+		}
+	}
+}
+
+func TestPrivateNetworkRefusesTheGatewaysOwnPort(t *testing.T) {
+	upstream := newPrivateNetworkUpstream(t)
+	auth := privateNetworkAuth(upstream.server.URL+"/v1", privatenet.Loopback, privateNetworkKey)
+	err := privateNetworkSites[0].run(context.Background(), privateNetworkExecutor(upstream.port(), auth), auth)
+	refused, ok := privatenet.Canonical(err)
+	if !ok || refused.Reason != privatenet.ReasonGatewayPort || upstream.accepts.Load() != 0 {
+		t.Fatalf("err = %v accepts = %d", err, upstream.accepts.Load())
+	}
+}
+
+// Every proxy source is ignored: the global proxy-url, the credential's
+// proxy-url, a per-request proxy and a context round-tripper. The control
+// shows the same settings do reach an ordinary compat entry.
+func TestPrivateNetworkUsesNoProxy(t *testing.T) {
+	var proxied atomic.Int64
+	proxy := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, _ *http.Request) {
+		proxied.Add(1)
+		w.WriteHeader(http.StatusTeapot)
+	}))
+	defer proxy.Close()
+	var roundTripped atomic.Int64
+	contextTransport := privateNetworkRoundTripper(func(*http.Request) (*http.Response, error) {
+		roundTripped.Add(1)
+		return nil, errors.New("context round-tripper used")
+	})
+	run := func(class string) (*privateNetworkUpstream, error) {
+		upstream := newPrivateNetworkUpstream(t)
+		auth := privateNetworkAuth(upstream.server.URL+"/v1", class, privateNetworkKey)
+		if class == "" {
+			delete(auth.Attributes, "private_network")
+		}
+		auth.ProxyURL = proxy.URL
+		e := privateNetworkExecutor(18317, auth)
+		e.cfg.ProxyURL = proxy.URL
+		ctx := context.WithValue(context.Background(), "cliproxy.roundtripper", http.RoundTripper(contextTransport))
+		ctx = cliproxyexecutor.WithRequestProxyURL(ctx, proxy.URL)
+		return upstream, privateNetworkSites[0].run(ctx, e, auth)
+	}
+	upstream, err := run(privatenet.Loopback)
+	if err != nil || upstream.requests.Load() != 1 || proxied.Load() != 0 || roundTripped.Load() != 0 {
+		t.Fatalf("err=%v upstream=%d proxied=%d round-tripped=%d", err, upstream.requests.Load(), proxied.Load(), roundTripped.Load())
+	}
+	control, _ := run("")
+	if proxied.Load() == 0 || control.requests.Load() != 0 {
+		t.Fatalf("control: proxied=%d upstream=%d", proxied.Load(), control.requests.Load())
+	}
+}
+
+type privateNetworkRoundTripper func(*http.Request) (*http.Response, error)
+
+func (f privateNetworkRoundTripper) RoundTrip(r *http.Request) (*http.Response, error) { return f(r) }
+
+// A keyless private-network entry follows no redirect either (an ordinary
+// keyless entry follows Go's default policy).
+func TestPrivateNetworkKeylessFollowsNoRedirect(t *testing.T) {
+	var followed atomic.Int64
+	target := httptest.NewServer(http.HandlerFunc(func(http.ResponseWriter, *http.Request) { followed.Add(1) }))
+	defer target.Close()
+	for _, location := range []string{"/v1/elsewhere", target.URL + "/v1/chat/completions"} {
+		origin := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+			if r.URL.Path == "/v1/elsewhere" {
+				followed.Add(1)
+				return
+			}
+			http.Redirect(w, r, location, http.StatusTemporaryRedirect)
+		}))
+		auth := privateNetworkAuth(origin.URL+"/v1", privatenet.Loopback, "")
+		err := privateNetworkSites[0].run(context.Background(), privateNetworkExecutor(18317, auth), auth)
+		origin.Close()
+		if err == nil || err.Error() != "upstream redirect refused" {
+			t.Fatalf("%s: err = %v", location, err)
+		}
+	}
+	if followed.Load() != 0 {
+		t.Fatalf("%d redirects followed", followed.Load())
+	}
+}
+
+// A reload re-binds the executors to the new configuration (the snapshot the
+// published routes reflect) before the synthesized auths follow. In that
+// window the auth still carries the previous declaration; the dial policy
+// comes from the configuration, and an auth the configuration no longer
+// declares that way is refused before any connection.
+func TestPrivateNetworkDialPolicyFollowsTheCurrentConfig(t *testing.T) {
+	var proxied atomic.Int64
+	proxy := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, _ *http.Request) {
+		proxied.Add(1)
+		w.WriteHeader(http.StatusTeapot)
+	}))
+	defer proxy.Close()
+	for _, c := range []struct {
+		name string
+		// The auth's declaration (class "" = ordinary) and the current entry.
+		authClass, entryClass    string
+		entryMoved, entryRemoved bool
+		served                   bool
+		reason                   string
+	}{
+		{name: "loopback to tailnet", authClass: privatenet.Loopback, entryClass: privatenet.Tailnet, reason: privatenet.ReasonOutsideClass},
+		{name: "tailnet to loopback", authClass: privatenet.Tailnet, entryClass: privatenet.Loopback, served: true},
+		{name: "ordinary to loopback", authClass: "", entryClass: privatenet.Loopback, served: true},
+		{name: "url moved", authClass: privatenet.Loopback, entryClass: privatenet.Loopback, entryMoved: true, reason: "policy-changed"},
+		{name: "network removed", authClass: privatenet.Loopback, entryClass: "", reason: "policy-changed"},
+		{name: "entry removed", authClass: privatenet.Loopback, entryRemoved: true, reason: "policy-changed"},
+		{name: "unchanged", authClass: privatenet.Loopback, entryClass: privatenet.Loopback, served: true},
+	} {
+		t.Run(c.name, func(t *testing.T) {
+			upstream := newPrivateNetworkUpstream(t)
+			base := upstream.server.URL + "/v1"
+			auth := privateNetworkAuth(base, c.authClass, privateNetworkKey)
+			if c.authClass == "" {
+				delete(auth.Attributes, "private_network")
+			}
+			entryBase := base
+			if c.entryMoved {
+				entryBase = upstream.server.URL + "/moved/v1"
+			}
+			entries := []config.OpenAICompatibility{{Name: "pn-other", BaseURL: "http://127.0.0.1:9/v1"}}
+			if !c.entryRemoved {
+				entries = append(entries, privateNetworkEntry(entryBase, c.entryClass))
+			}
+			e := privateNetworkExecutor(18317, auth, entries...)
+			// The ordinary client would go through this proxy and fail.
+			e.cfg.ProxyURL = proxy.URL
+			before := proxied.Load()
+			err := privateNetworkSites[0].run(context.Background(), e, auth)
+			if proxied.Load() != before {
+				t.Fatalf("a private-network declaration was dialled through the proxy")
+			}
+			if c.served {
+				if err != nil || upstream.requests.Load() != 1 {
+					t.Fatalf("err=%v requests=%d", err, upstream.requests.Load())
+				}
+				return
+			}
+			refused, ok := privatenet.Canonical(err)
+			if !ok || refused.Reason != c.reason || upstream.accepts.Load() != 0 {
+				t.Fatalf("err=%v accepts=%d, want reason %s", err, upstream.accepts.Load(), c.reason)
+			}
+		})
+	}
+}
