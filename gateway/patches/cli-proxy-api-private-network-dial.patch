new file mode 100644
index 00000000..ee803c33
--- /dev/null
+++ b/internal/config/openai_compat_private_network_test.go
@@ -0,0 +1,104 @@
+package config
+
+import (
+	"bytes"
+	"strings"
+	"testing"
+
+	log "github.com/sirupsen/logrus"
+)
+
+// The renderer's block form with JSON-quoted strings.
+const privateNetworkConfig = `openai-compatibility:
+  - name: "pn-loopback"
+    private-network:
+      base-url: " http://127.0.0.1:8010/v1 "
+      class: "loopback"
+    api-key-entries:
+      - api-key: "pn-sentinel-key-0123456789"
+    models:
+      - name: "wire"
+        alias: "pn-loopback-model"
+  - name: "pn-both"
+    base-url: "http://10.0.0.5:8010/v1"
+    private-network:
+      base-url: "http://10.0.0.5:8010/v1"
+      class: "lan"
+  - name: "pn-unknown-class"
+    private-network:
+      base-url: "http://10.0.0.5:8010/v1"
+      class: "public"
+  - name: "pn-scheme"
+    private-network:
+      base-url: "ftp://10.0.0.5/v1"
+      class: "lan"
+  - name: "pn-no-host"
+    private-network:
+      base-url: "http:///v1"
+      class: "lan"
+  - name: "pn-userinfo"
+    private-network:
+      base-url: "http://user:pn-userinfo-secret@10.0.0.5/v1"
+      class: "lan"
+  - name: "pn-empty-class"
+    private-network:
+      base-url: "http://10.0.0.5:8010/v1"
+  - name: "pn-tailnet"
+    private-network: {"base-url": "https://box.tailnet.example:8443/v1", "class": "tailnet"}
+  - name: "ordinary"
+    base-url: "https://api.example.com/v1"
+`
+
+func TestOpenAICompatPrivateNetworkNormalization(t *testing.T) {
+	var logs bytes.Buffer
+	logger := log.StandardLogger()
+	previous := logger.Out
+	logger.SetOutput(&logs)
+	t.Cleanup(func() { logger.SetOutput(previous) })
+
+	cfg, err := ParseConfigBytes([]byte(privateNetworkConfig))
+	if err != nil {
+		t.Fatal(err)
+	}
+	check := func(cfg *Config) {
+		t.Helper()
+		var names []string
+		for _, e := range cfg.OpenAICompatibility {
+			names = append(names, e.Name)
+		}
+		if strings.Join(names, ",") != "pn-loopback,pn-tailnet,ordinary" {
+			t.Fatalf("kept %v", names)
+		}
+		loopback, tailnet, ordinary := cfg.OpenAICompatibility[0], cfg.OpenAICompatibility[1], cfg.OpenAICompatibility[2]
+		if loopback.BaseURL != "http://127.0.0.1:8010/v1" || loopback.PrivateNetwork == nil ||
+			*loopback.PrivateNetwork != (OpenAICompatPrivateNetwork{BaseURL: "http://127.0.0.1:8010/v1", Class: "loopback"}) {
+			t.Fatalf("loopback entry = %+v %+v", loopback, loopback.PrivateNetwork)
+		}
+		if tailnet.BaseURL != "https://box.tailnet.example:8443/v1" || tailnet.PrivateNetwork.Class != "tailnet" {
+			t.Fatalf("tailnet entry = %+v", tailnet)
+		}
+		if ordinary.PrivateNetwork != nil || ordinary.BaseURL != "https://api.example.com/v1" {
+			t.Fatalf("ordinary entry = %+v", ordinary)
+		}
+	}
+	check(cfg)
+	// Normalizing again, or a runtime copy, keeps the entries normalization
+	// itself completed.
+	cfg.SanitizeOpenAICompatibility()
+	check(cfg)
+	runtime := cfg.CloneForRuntime()
+	runtime.SanitizeOpenAICompatibility()
+	check(runtime)
+
+	text := logs.String()
+	for _, name := range []string{"pn-both", "pn-unknown-class", "pn-scheme", "pn-no-host", "pn-userinfo", "pn-empty-class"} {
+		if !strings.Contains(text, "private-network: provider "+name+" dropped: invalid private-network declaration") {
+			t.Errorf("no fixed warning for %s", name)
+		}
+	}
+	for _, leaked := range []string{"10.0.0.5", "pn-userinfo-secret", "pn-sentinel-key", "ftp://", "public"} {
+		if strings.Contains(text, leaked) {
+			t.Errorf("warning printed %q", leaked)
+		}
+	}
+}
diff --git a/internal/privatenet/privatenet.go b/internal/privatenet/privatenet.go
new file mode 100644
index 00000000..7c4ef532
--- /dev/null
+++ b/internal/privatenet/privatenet.go
@@ -0,0 +1,442 @@
+// Package privatenet is the dial guard for OpenAI-compatible providers that
+// are declared on a private network (the "private-network" block of an
+// openai-compatibility entry: a base URL and one class, loopback, lan or
+// tailnet).
+//
+// Such a provider is reached only through Transport: no proxy from any
+// source, HTTP/1.1, no redirect, and a dialer that resolves the host once,
+// drops every address outside the declared class, dials only the remaining
+// addresses by literal address, re-checks the address in the socket's dial
+// control hook and, for a tailnet, checks the connection's local address
+// before any byte is written. Loopback to the gateway's own port, 8316 and
+// 8317 is refused whatever the class.
+//
+// Classification is one ordered table (the first matching rule wins), the
+// same table the launcher uses; both are tested against one corpus of
+// addresses. A zone is dropped and an IPv4-mapped IPv6 address is read as
+// its IPv4 address before an address is classified; an IPv4-compatible
+// address (::/96, other than ::1) is never a provider address.
+//
+// The package depends on the standard library only.
+package privatenet
+
+import (
+	"context"
+	"crypto/tls"
+	"errors"
+	"net"
+	"net/http"
+	"net/netip"
+	"slices"
+	"strconv"
+	"strings"
+	"sync"
+	"syscall"
+	"time"
+)
+
+// The declarable classes, and the two classes no provider may use.
+const (
+	Loopback = "loopback"
+	LAN      = "lan"
+	Tailnet  = "tailnet"
+	Never    = "never"
+	Public   = "public"
+)
+
+// Refusal reasons, the words of the refusal log line.
+const (
+	ReasonNever           = "never"
+	ReasonGatewayPort     = "gateway-port"
+	ReasonOutsideClass    = "outside-class"
+	ReasonLocalNotTailnet = "local-not-tailnet"
+	// ReasonPolicyChanged: the credential comes from a previous declaration
+	// of its provider (a reload in progress); nothing is dialled.
+	ReasonPolicyChanged = "policy-changed"
+)
+
+// FixedGatewayPorts are refused on loopback for every class, together with
+// the gateway's own configured port.
+var FixedGatewayPorts = []int{8316, 8317}
+
+// DialTimeout bounds one connection attempt.
+const DialTimeout = 30 * time.Second
+
+type rule struct {
+	prefix netip.Prefix
+	class  string
+}
+
+// rules is the classification table; the first matching rule wins, so the
+// specific exclusions come before the ranges that contain them.
+var rules = []rule{
+	// Cloud instance metadata services.
+	{netip.MustParsePrefix("169.254.169.254/32"), Never},
+	{netip.MustParsePrefix("100.100.100.200/32"), Never},
+	{netip.MustParsePrefix("fd00:ec2::254/128"), Never},
+	// Cloud metadata services on unique local IPv6 addresses (inside
+	// fc00::/7): Google Cloud, Oracle Cloud, Linode, Scaleway, EKS Pod
+	// Identity, Alibaba Cloud.
+	{netip.MustParsePrefix("fd20:ce::254/128"), Never},
+	{netip.MustParsePrefix("fd00:c1::a9fe:a9fe/128"), Never},
+	{netip.MustParsePrefix("fd00:a9fe:a9fe::1/128"), Never},
+	{netip.MustParsePrefix("fd00:42::42/128"), Never},
+	{netip.MustParsePrefix("fd00:ec2::23/128"), Never},
+	{netip.MustParsePrefix("fd00:100::100:200/128"), Never},
+	{netip.MustParsePrefix("127.0.0.0/8"), Loopback},
+	{netip.MustParsePrefix("::1/128"), Loopback},
+	{netip.MustParsePrefix("0.0.0.0/8"), Never},
+	{netip.MustParsePrefix("169.254.0.0/16"), Never},
+	{netip.MustParsePrefix("224.0.0.0/4"), Never},
+	{netip.MustParsePrefix("255.255.255.255/32"), Never},
+	{netip.MustParsePrefix("::/128"), Never},
+	{netip.MustParsePrefix("::/96"), Never},
+	{netip.MustParsePrefix("fe80::/10"), Never},
+	{netip.MustParsePrefix("ff00::/8"), Never},
+	// The overlay's own service and reserved addresses, and its 4via6 range.
+	{netip.MustParsePrefix("100.100.0.0/24"), Never},
+	{netip.MustParsePrefix("100.100.100.0/24"), Never},
+	{netip.MustParsePrefix("100.115.92.0/23"), Never},
+	{netip.MustParsePrefix("100.101.102.103/32"), Never},
+	{netip.MustParsePrefix("fd7a:115c:a1e0::53/128"), Never},
+	{netip.MustParsePrefix("fd7a:115c:a1e0:b1a::/64"), Never},
+	{netip.MustParsePrefix("100.64.0.0/10"), Tailnet},
+	{netip.MustParsePrefix("fd7a:115c:a1e0::/48"), Tailnet},
+	{netip.MustParsePrefix("10.0.0.0/8"), LAN},
+	{netip.MustParsePrefix("172.16.0.0/12"), LAN},
+	{netip.MustParsePrefix("192.168.0.0/16"), LAN},
+	{netip.MustParsePrefix("fc00::/7"), LAN},
+}
+
+// ValidClass reports whether class is one a provider may declare.
+func ValidClass(class string) bool {
+	return class == Loopback || class == LAN || class == Tailnet
+}
+
+// Normalize drops a zone and reads an IPv4-mapped IPv6 address as IPv4.
+func Normalize(addr netip.Addr) netip.Addr {
+	return addr.WithZone("").Unmap()
+}
+
+// Classify returns loopback, lan, tailnet, never or public. An invalid
+// address is never.
+func Classify(addr netip.Addr) string {
+	if !addr.IsValid() {
+		return Never
+	}
+	addr = Normalize(addr)
+	for _, r := range rules {
+		if r.prefix.Contains(addr) {
+			return r.class
+		}
+	}
+	return Public
+}
+
+// Check returns the refusal reason for a connection to addr:port for a
+// provider declared on class, or "" when it is allowed. The precedence is
+// never, then gateway-port (a loopback address on a gateway port, whatever
+// the class), then outside-class; an undeclarable class allows nothing.
+func Check(addr netip.Addr, port int, class string, gatewayPorts []int) string {
+	found := Classify(addr)
+	switch {
+	case found == Never:
+		return ReasonNever
+	case found == Loopback && slices.Contains(gatewayPorts, port):
+		return ReasonGatewayPort
+	case !ValidClass(class) || found != class:
+		return ReasonOutsideClass
+	}
+	return ""
+}
+
+// CheckLocal is the local-address rule: a tailnet connection's own address
+// must be a tailnet address too. Other classes have no local-address rule.
+func CheckLocal(addr netip.Addr, class string) string {
+	if class == Tailnet && Classify(addr) != Tailnet {
+		return ReasonLocalNotTailnet
+	}
+	return ""
+}
+
+// rank orders refusal reasons by precedence (lower is stronger).
+func rank(reason string) int {
+	switch reason {
+	case ReasonNever:
+		return 0
+	case ReasonGatewayPort:
+		return 1
+	case ReasonOutsideClass:
+		return 2
+	}
+	return 3
+}
+
+// RefusedError is a refused upstream address. Its text names only the
+// declared class; Remote and Reason are for the refusal log line, never for
+// the client.
+type RefusedError struct {
+	Class  string
+	Remote string
+	Reason string
+}
+
+// Error returns the fixed client-visible text.
+func (e *RefusedError) Error() string {
+	return "upstream address refused: outside the provider's private network (" + displayClass(e.Class) + ")"
+}
+
+// StatusCode reports 502 Bad Gateway.
+func (e *RefusedError) StatusCode() int { return http.StatusBadGateway }
+
+func displayClass(class string) string {
+	if ValidClass(class) {
+		return class
+	}
+	return "unknown"
+}
+
+// IsRefused reports whether err is, or wraps, a refused address.
+func IsRefused(err error) bool {
+	var refused *RefusedError
+	return errors.As(err, &refused)
+}
+
+// Canonical returns a fresh copy of the refusal err wraps, built locally and
+// wrapping nothing (the HTTP client wraps a dial error with the request
+// URL), and whether err is a refusal.
+func Canonical(err error) (*RefusedError, bool) {
+	var refused *RefusedError
+	if !errors.As(err, &refused) || refused == nil {
+		return nil, false
+	}
+	return &RefusedError{Class: refused.Class, Remote: refused.Remote, Reason: refused.Reason}, true
+}
+
+// LookupFunc resolves a host name to its addresses.
+type LookupFunc func(ctx context.Context, network, host string) ([]netip.Addr, error)
+
+// ConnectFunc opens one connection to a literal address. control is the
+// dial control hook the connection must run before it connects.
+type ConnectFunc func(ctx context.Context, network, address string, control func(ctx context.Context, network, address string, c syscall.RawConn) error) (net.Conn, error)
+
+// Dialer is the guarded dialer of one class.
+type Dialer struct {
+	Class        string
+	GatewayPorts []int
+	// Lookup resolves a host name once; nil uses the default resolver.
+	Lookup LookupFunc
+	// Connect opens a connection; nil uses a net.Dialer with DialTimeout.
+	Connect ConnectFunc
+}
+
+// NewDialer returns the guarded dialer of class for a gateway listening on
+// gatewayPort (0 when unknown).
+func NewDialer(class string, gatewayPort int) *Dialer {
+	return &Dialer{Class: class, GatewayPorts: gatewayPorts(gatewayPort)}
+}
+
+func gatewayPorts(port int) []int {
+	ports := slices.Clone(FixedGatewayPorts)
+	if port > 0 && !slices.Contains(ports, port) {
+		ports = append(ports, port)
+	}
+	slices.Sort(ports)
+	return ports
+}
+
+func defaultLookup(ctx context.Context, network, host string) ([]netip.Addr, error) {
+	return net.DefaultResolver.LookupNetIP(ctx, network, host)
+}
+
+func defaultConnect(ctx context.Context, network, address string, control func(ctx context.Context, network, address string, c syscall.RawConn) error) (net.Conn, error) {
+	d := &net.Dialer{Timeout: DialTimeout, KeepAlive: 30 * time.Second, ControlContext: control}
+	return d.DialContext(ctx, network, address)
+}
+
+func (d *Dialer) refusal(addr netip.Addr, reason string) *RefusedError {
+	return &RefusedError{Class: d.Class, Remote: Normalize(addr).String(), Reason: reason}
+}
+
+// control re-checks the address a socket is about to connect to.
+func (d *Dialer) control(_ context.Context, _ string, address string, _ syscall.RawConn) error {
+	target, err := netip.ParseAddrPort(address)
+	if err != nil {
+		return &RefusedError{Class: d.Class, Remote: "", Reason: ReasonNever}
+	}
+	if reason := Check(target.Addr(), int(target.Port()), d.Class, d.GatewayPorts); reason != "" {
+		return d.refusal(target.Addr(), reason)
+	}
+	return nil
+}
+
+// DialContext resolves address's host once, keeps the addresses the class
+// allows and dials them in order by literal address. When every address is
+// refused, the strongest refusal is returned.
+func (d *Dialer) DialContext(ctx context.Context, network, address string) (net.Conn, error) {
+	host, portText, err := net.SplitHostPort(address)
+	if err != nil {
+		return nil, err
+	}
+	port, err := strconv.Atoi(portText)
+	if err != nil || port < 1 || port > 65535 {
+		return nil, &net.AddrError{Err: "invalid port", Addr: address}
+	}
+	var candidates []netip.Addr
+	if literal, errParse := netip.ParseAddr(host); errParse == nil {
+		candidates = []netip.Addr{literal}
+	} else {
+		lookup := d.Lookup
+		if lookup == nil {
+			lookup = defaultLookup
+		}
+		candidates, err = lookup(ctx, "ip", host)
+		if err != nil {
+			return nil, err
+		}
+	}
+	var refused *RefusedError
+	allowed := make([]netip.Addr, 0, len(candidates))
+	for _, candidate := range candidates {
+		candidate = Normalize(candidate)
+		if reason := Check(candidate, port, d.Class, d.GatewayPorts); reason != "" {
+			if refused == nil || rank(reason) < rank(refused.Reason) {
+				refused = d.refusal(candidate, reason)
+			}
+			continue
+		}
+		if !slices.Contains(allowed, candidate) {
+			allowed = append(allowed, candidate)
+		}
+	}
+	if len(allowed) == 0 {
+		if refused == nil {
+			refused = &RefusedError{Class: d.Class, Reason: ReasonOutsideClass}
+		}
+		return nil, refused
+	}
+	connect := d.Connect
+	if connect == nil {
+		connect = defaultConnect
+	}
+	var lastErr error
+	for _, target := range allowed {
+		conn, errDial := connect(ctx, "tcp", netip.AddrPortFrom(target, uint16(port)).String(), d.control)
+		if errDial != nil {
+			lastErr = errDial
+			if IsRefused(errDial) || ctx.Err() != nil {
+				return nil, errDial
+			}
+			continue
+		}
+		if errLocal := d.checkLocal(conn); errLocal != nil {
+			_ = conn.Close()
+			return nil, errLocal
+		}
+		return conn, nil
+	}
+	return nil, lastErr
+}
+
+// checkLocal applies the local-address rule to an open connection.
+func (d *Dialer) checkLocal(conn net.Conn) error {
+	if d.Class != Tailnet {
+		return nil
+	}
+	local, ok := addrOf(conn.LocalAddr())
+	if !ok {
+		return &RefusedError{Class: d.Class, Reason: ReasonLocalNotTailnet}
+	}
+	if reason := CheckLocal(local, d.Class); reason != "" {
+		return d.refusal(local, reason)
+	}
+	return nil
+}
+
+func addrOf(addr net.Addr) (netip.Addr, bool) {
+	switch a := addr.(type) {
+	case *net.TCPAddr:
+		ip, ok := netip.AddrFromSlice(a.IP)
+		return ip, ok
+	case nil:
+		return netip.Addr{}, false
+	}
+	parsed, err := netip.ParseAddrPort(addr.String())
+	if err != nil {
+		return netip.Addr{}, false
+	}
+	return parsed.Addr(), true
+}
+
+type transportKey struct {
+	class string
+	ports string
+}
+
+var (
+	transportsMu sync.Mutex
+	transports   = map[transportKey]*http.Transport{}
+)
+
+// Transport returns the cached transport of class for a gateway listening on
+// gatewayPort. The class and the refused port set are its cache identity.
+func Transport(class string, gatewayPort int) *http.Transport {
+	ports := gatewayPorts(gatewayPort)
+	texts := make([]string, len(ports))
+	for i, port := range ports {
+		texts[i] = strconv.Itoa(port)
+	}
+	key := transportKey{class: class, ports: strings.Join(texts, ",")}
+	transportsMu.Lock()
+	defer transportsMu.Unlock()
+	if t, ok := transports[key]; ok {
+		return t
+	}
+	t := NewTransport(&Dialer{Class: class, GatewayPorts: ports})
+	transports[key] = t
+	return t
+}
+
+// NewTransport returns a transport that dials only through d: no proxy,
+// HTTP/1.1 only, no response-header timeout.
+func NewTransport(d *Dialer) *http.Transport {
+	return &http.Transport{
+		Proxy:                 nil,
+		DialContext:           d.DialContext,
+		ForceAttemptHTTP2:     false,
+		TLSNextProto:          map[string]func(string, *tls.Conn) http.RoundTripper{},
+		MaxIdleConns:          100,
+		IdleConnTimeout:       90 * time.Second,
+		TLSHandshakeTimeout:   10 * time.Second,
+		ExpectContinueTimeout: time.Second,
+	}
+}
+
+// RefuseRedirect is the client redirect policy: no redirect is followed.
+func RefuseRedirect(*http.Request, []*http.Request) error {
+	return http.ErrUseLastResponse
+}
+
+// Client returns an HTTP client for a provider declared on class: the cached
+// transport and no redirect.
+func Client(class string, gatewayPort int) *http.Client {
+	return &http.Client{Transport: Transport(class, gatewayPort), CheckRedirect: RefuseRedirect}
+}
+
+// refusingTransport refuses every request before any connection.
+type refusingTransport struct {
+	class, reason string
+}
+
+func (t refusingTransport) RoundTrip(req *http.Request) (*http.Response, error) {
+	if req != nil && req.Body != nil {
+		_ = req.Body.Close()
+	}
+	return nil, &RefusedError{Class: t.class, Reason: t.reason}
+}
+
+// RefusingClient returns an HTTP client that refuses every request with
+// reason, before any lookup or connection.
+func RefusingClient(class, reason string) *http.Client {
+	return &http.Client{Transport: refusingTransport{class: class, reason: reason}, CheckRedirect: RefuseRedirect}
+}
