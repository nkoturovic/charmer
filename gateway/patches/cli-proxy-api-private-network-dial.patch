+		http.Redirect(w, r, location.Load().(string), http.StatusTemporaryRedirect)
+	}))
+	defer origin.Close()
+	tlsOrigin := httptest.NewTLSServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		http.Redirect(w, r, target.URL+"/followed", http.StatusTemporaryRedirect)
+	}))
+	defer tlsOrigin.Close()
+	pool := x509.NewCertPool()
+	pool.AddCert(tlsOrigin.Certificate())
+	pool.AddCert(tlsTarget.Certificate())
+	transport := NewTransport(NewDialer(Loopback, 0))
+	transport.TLSClientConfig = &tls.Config{RootCAs: pool, MinVersion: tls.VersionTLS12}
+	client := &http.Client{Transport: transport, CheckRedirect: Client(Loopback, 0).CheckRedirect}
+	for _, c := range []struct {
+		name, from, to string
+	}{
+		{"relative", origin.URL, "/followed"},
+		{"same origin", origin.URL, origin.URL + "/followed"},
+		{"another port", origin.URL, target.URL + "/followed"},
+		{"http to https", origin.URL, tlsTarget.URL + "/followed"},
+		{"https to http", tlsOrigin.URL, ""},
+	} {
+		location.Store(c.to)
+		resp, err := client.Post(c.from+"/v1/chat/completions", "application/json", strings.NewReader(`{}`))
+		if err != nil {
+			t.Fatalf("%s: %v", c.name, err)
+		}
+		_ = resp.Body.Close()
+		if resp.StatusCode != http.StatusTemporaryRedirect {
+			t.Fatalf("%s: status %d", c.name, resp.StatusCode)
+		}
+	}
+	if followed.Load() != 0 {
+		t.Fatalf("%d redirects followed", followed.Load())
+	}
+}
