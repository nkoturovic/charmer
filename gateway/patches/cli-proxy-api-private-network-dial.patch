@@ -87,7 +88,23 @@ func openAICompatRequestRedirectMode(auth *cliproxyauth.Auth, req *http.Request)
 // newHTTPClient returns the compat HTTP client for the prepared request req,
 // with the redirect policy captured from auth and req, and that mode for the
 // post-Do check. Call it after every header of req is set and before Do.
+//
+// A private-network entry, keyed or keyless, never gets the shared
+// proxy-aware client: it gets the private-network transport of its class
+// (no proxy from any source, HTTP/1.1, the guarded dialer) and follows no
+// redirect. The declaration is the executor's configuration (dialPolicy);
+// an auth of a previous declaration is refused before any connection.
 func (e *OpenAICompatExecutor) newHTTPClient(ctx context.Context, auth *cliproxyauth.Auth, req *http.Request) (*http.Client, upstreamredirect.Mode) {
+	if policy := e.dialPolicy(auth); policy.guarded {
+		if policy.refused {
+			return privatenet.RefusingClient(policy.class, privatenet.ReasonPolicyChanged), upstreamredirect.RefuseAll
+		}
+		gatewayPort := 0
+		if e.cfg != nil {
+			gatewayPort = e.cfg.Port
+		}
+		return privatenet.Client(policy.class, gatewayPort), upstreamredirect.RefuseAll
+	}
 	mode := openAICompatRequestRedirectMode(auth, req)
 	return upstreamredirect.Guard(helps.NewProxyAwareHTTPClient(ctx, e.cfg, auth, 0), mode), mode
 }
