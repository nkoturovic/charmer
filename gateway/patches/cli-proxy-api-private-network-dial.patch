+func TestClassifyCorpus(t *testing.T) {
+	raw, err := os.ReadFile("testdata/netclass-corpus.json")
+	if err != nil {
+		t.Fatal(err)
+	}
+	var corpus struct {
+		Version int `json:"version"`
+		Cases   []struct {
+			Address string `json:"address"`
+			Class   string `json:"class"`
+		} `json:"cases"`
+	}
+	if err := json.Unmarshal(raw, &corpus); err != nil {
+		t.Fatal(err)
+	}
+	if corpus.Version != 1 || len(corpus.Cases) < 100 {
+		t.Fatalf("corpus version %d with %d cases", corpus.Version, len(corpus.Cases))
+	}
+	seen := map[string]bool{}
+	for _, c := range corpus.Cases {
+		addr, err := netip.ParseAddr(c.Address)
+		if err != nil {
+			t.Errorf("%s: %v", c.Address, err)
+			continue
+		}
+		seen[c.Class] = true
+		if got := Classify(addr); got != c.Class {
+			t.Errorf("Classify(%s) = %s, want %s", c.Address, got, c.Class)
+		}
+	}
+	for _, class := range []string{Loopback, LAN, Tailnet, Never, Public} {
+		if !seen[class] {
