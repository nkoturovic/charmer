+// formatPrivateNetwork prints a declaration's class and URL only: scheme,
+// host and path, never userinfo, query or fragment.
+func formatPrivateNetwork(declared *config.OpenAICompatPrivateNetwork) string {
+	if declared == nil {
+		return "none"
+	}
+	where := "<redacted>"
+	if parsed, err := url.Parse(strings.TrimSpace(declared.BaseURL)); err == nil && parsed.Host != "" {
+		where = parsed.Scheme + "://" + parsed.Host + parsed.EscapedPath()
+	}
+	return strings.TrimSpace(declared.Class) + " " + where
+}
