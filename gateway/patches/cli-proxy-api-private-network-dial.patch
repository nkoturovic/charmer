+// The control hook re-checks the address the socket really connects to: a
+// connect that ignores the filtered address still cannot reach a listener
+// outside the class.
+func TestDialControlRechecksTheSocketAddress(t *testing.T) {
+	listener, err := net.Listen("tcp", "127.0.0.1:0")
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer func() { _ = listener.Close() }()
+	var accepts atomic.Int64
+	go func() {
+		for {
+			conn, errAccept := listener.Accept()
+			if errAccept != nil {
+				return
+			}
+			accepts.Add(1)
+			_ = conn.Close()
+		}
+	}()
+	d := &Dialer{Class: LAN, GatewayPorts: gatewayPorts(0), Lookup: (&dialRecord{}).lookup("10.0.0.5"),
+		Connect: func(ctx context.Context, network, _ string, control func(context.Context, string, string, syscall.RawConn) error) (net.Conn, error) {
+			return defaultConnect(ctx, network, listener.Addr().String(), control)
+		}}
+	conn, err := d.DialContext(context.Background(), "tcp", "llm.lan.example:8010")
+	if conn != nil {
+		_ = conn.Close()
+		t.Fatal("connected outside the class")
+	}
+	var refused *RefusedError
+	if !errors.As(err, &refused) || refused.Reason != ReasonOutsideClass || refused.Remote != "127.0.0.1" {
+		t.Fatalf("err = %#v", err)
+	}
+	time.Sleep(50 * time.Millisecond)
+	if accepts.Load() != 0 {
+		t.Fatalf("listener accepted %d connections", accepts.Load())
+	}
+	for _, c := range []struct {
+		address, reason string
+	}{
+		{"127.0.0.1:8317", ReasonGatewayPort},
+		{"[::ffff:127.0.0.1]:8316", ReasonGatewayPort},
+		{"169.254.169.254:80", ReasonNever},
+		{"10.0.0.5:8010", ""},
+	} {
+		errControl := d.control(context.Background(), "tcp", c.address, nil)
+		if c.reason == "" {
+			if errControl != nil {
+				t.Fatalf("control(%s) = %v", c.address, errControl)
+			}
+			continue
+		}
+		if !errors.As(errControl, &refused) || refused.Reason != c.reason {
+			t.Fatalf("control(%s) = %v, want %s", c.address, errControl, c.reason)
+		}
+	}
+}
