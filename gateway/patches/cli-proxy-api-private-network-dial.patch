+type fakeConn struct {
+	net.Conn
+	local, remote net.Addr
+	closed        atomic.Bool
+}
+
+func (c *fakeConn) LocalAddr() net.Addr  { return c.local }
+func (c *fakeConn) RemoteAddr() net.Addr { return c.remote }
+func (c *fakeConn) Close() error         { c.closed.Store(true); return nil }
+
+type dialRecord struct {
+	mu      sync.Mutex
+	lookups []string
+	dials   []string
+}
+
+func (r *dialRecord) lookup(answers ...string) LookupFunc {
+	return func(_ context.Context, _ string, host string) ([]netip.Addr, error) {
+		r.mu.Lock()
+		r.lookups = append(r.lookups, host)
+		r.mu.Unlock()
+		out := make([]netip.Addr, 0, len(answers))
+		for _, a := range answers {
+			out = append(out, netip.MustParseAddr(a))
+		}
+		return out, nil
+	}
+}
+
+// connect records each attempt; the first fail attempts are refused by the
+// peer, the next one connects with the given local address.
+func (r *dialRecord) connect(fail int, local string) ConnectFunc {
+	return func(_ context.Context, _ string, address string, _ func(context.Context, string, string, syscall.RawConn) error) (net.Conn, error) {
+		r.mu.Lock()
+		r.dials = append(r.dials, address)
+		n := len(r.dials)
+		r.mu.Unlock()
+		if n <= fail {
+			return nil, &net.OpError{Op: "dial", Net: "tcp", Err: syscall.ECONNREFUSED}
+		}
+		target := netip.MustParseAddrPort(address)
+		return &fakeConn{local: net.TCPAddrFromAddrPort(netip.AddrPortFrom(netip.MustParseAddr(local), 40000)), remote: net.TCPAddrFromAddrPort(target)}, nil
+	}
+}
