diff --git a/internal/runtime/executor/openai_compat_private_network.go b/internal/runtime/executor/openai_compat_private_network.go
new file mode 100644
index 00000000..3bfe9c73
--- /dev/null
+++ b/internal/runtime/executor/openai_compat_private_network.go
@@ -0,0 +1,113 @@
+package executor
+
+import (
+	"net/http"
+	"strings"
+
+	"github.com/router-for-me/CLIProxyAPI/v8/internal/config"
+	"github.com/router-for-me/CLIProxyAPI/v8/internal/privatenet"
+	cliproxyauth "github.com/router-for-me/CLIProxyAPI/v8/sdk/cliproxy/auth"
+	log "github.com/sirupsen/logrus"
+)
+
+// openAICompatPrivateNetwork returns the declared class of an auth
+// synthesized from a private-network entry.
+func openAICompatPrivateNetwork(auth *cliproxyauth.Auth) (string, bool) {
+	if auth == nil || auth.Attributes == nil {
+		return "", false
+	}
+	class, ok := auth.Attributes["private_network"]
+	return strings.TrimSpace(class), ok
+}
+
+// openAICompatDialPolicy is how one request of an auth is dialled.
+type openAICompatDialPolicy struct {
+	// guarded: through the private-network transport of class.
+	guarded bool
+	class   string
+	// refused: every dial is refused (the auth comes from a previous
+	// declaration of its provider).
+	refused bool
+}
+
+// dialPolicy decides the dial policy of auth from the executor's
+// configuration, never from the auth alone. A reload binds the executors to
+// the new configuration (the snapshot the published routes reflect) before
+// the synthesized auths follow, so an auth can still carry its provider's
+// previous declaration:
+//
+//   - the provider's single current entry is on a private network and the
+//     auth points at that entry's base URL: the guard of the entry's class;
+//   - neither the entry nor the auth is on a private network: the ordinary
+//     client;
+//   - anything else (an auth of a previous declaration: another base URL, a
+//     private network no longer declared, a removed or disabled entry, a name
+//     several entries share): every dial is refused until the auths follow.
+func (e *OpenAICompatExecutor) dialPolicy(auth *cliproxyauth.Auth) openAICompatDialPolicy {
+	authClass, authDeclared := openAICompatPrivateNetwork(auth)
+	name, base := "", ""
+	if auth != nil && auth.Attributes != nil {
+		name = strings.TrimSpace(auth.Attributes["compat_name"])
+		base = strings.TrimSpace(auth.Attributes["base_url"])
+	}
+	var entries []*config.OpenAICompatibility
+	entryDeclared := false
+	if e.cfg != nil && name != "" {
+		for i := range e.cfg.OpenAICompatibility {
+			entry := &e.cfg.OpenAICompatibility[i]
+			if strings.EqualFold(strings.TrimSpace(entry.Name), name) {
+				entries = append(entries, entry)
+				entryDeclared = entryDeclared || entry.PrivateNetwork != nil
+			}
+		}
+	}
+	if !entryDeclared && !authDeclared {
+		return openAICompatDialPolicy{}
+	}
+	if entryDeclared && len(entries) == 1 && !entries[0].Disabled && base != "" &&
+		strings.TrimSpace(entries[0].BaseURL) == base {
+		return openAICompatDialPolicy{guarded: true, class: strings.TrimSpace(entries[0].PrivateNetwork.Class)}
+	}
+	class := authClass
+	for _, entry := range entries {
+		if entry.PrivateNetwork != nil {
+			class = strings.TrimSpace(entry.PrivateNetwork.Class)
+			break
+		}
+	}
+	return openAICompatDialPolicy{guarded: true, class: class, refused: true}
+}
+
+// openAICompatRefusals canonicalizes a private-network refusal after Do: the
+// HTTP client wraps a dial error with the request URL, so the refusal is
+// replaced by a fresh, locally built error before it is logged or returned,
+// and the refusal log line is written here, once.
+type openAICompatRefusals struct {
+	auth *cliproxyauth.Auth
+}
+
+func (r openAICompatRefusals) Result(resp *http.Response, err error) (*http.Response, error) {
+	if err == nil {
+		return resp, nil
+	}
+	refused, ok := privatenet.Canonical(err)
+	if !ok {
+		return resp, err
+	}
+	if resp != nil && resp.Body != nil {
+		_ = resp.Body.Close()
+	}
+	provider := ""
+	if r.auth != nil {
+		provider = strings.TrimSpace(r.auth.Attributes["compat_name"])
+		if provider == "" {
+			provider = strings.TrimSpace(r.auth.Label)
+		}
+	}
+	remote := refused.Remote
+	if remote == "" {
+		remote = "-"
+	}
+	log.Warnf("private-network: refused provider=%s class=%s remote=%s reason=%s", provider, refused.Class, remote, refused.Reason)
+	return nil, refused
+}
