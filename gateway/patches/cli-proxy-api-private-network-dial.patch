+func TestRefusedErrorIsFixedAndCanonical(t *testing.T) {
+	refused := &RefusedError{Class: Tailnet, Remote: "127.0.0.1", Reason: ReasonOutsideClass}
+	const want = "upstream address refused: outside the provider's private network (tailnet)"
+	if refused.Error() != want || refused.StatusCode() != http.StatusBadGateway {
+		t.Fatalf("error %q status %d", refused.Error(), refused.StatusCode())
+	}
+	if text := (&RefusedError{Class: "x-secret"}).Error(); strings.Contains(text, "x-secret") {
+		t.Fatalf("an unknown class reached the text: %q", text)
+	}
+	wrapped := &url.Error{Op: "Post", URL: "http://127.0.0.1:9/v1/chat/completions?key=secret",
+		Err: &net.OpError{Op: "dial", Net: "tcp", Err: refused}}
+	fresh, ok := Canonical(wrapped)
+	if !ok || fresh == refused || *fresh != *refused || errors.Unwrap(fresh) != nil || fresh.Error() != want {
+		t.Fatalf("canonical = %#v, %t", fresh, ok)
+	}
+	if _, ok := Canonical(errors.New("other")); ok {
+		t.Fatal("an unrelated error was canonicalized")
+	}
