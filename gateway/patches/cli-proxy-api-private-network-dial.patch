+package synthesizer
+
+import (
+	"testing"
+	"time"
+
+	"github.com/router-for-me/CLIProxyAPI/v8/internal/config"
+)
+
+func TestSynthesizeOpenAICompatPrivateNetworkClass(t *testing.T) {
+	cfg, err := config.ParseConfigBytes([]byte(`openai-compatibility:
+  - name: "pn-keyed"
+    private-network:
+      base-url: "http://127.0.0.1:8010/v1"
+      class: "loopback"
+    api-key-entries:
+      - api-key: "pn-key"
+  - name: "pn-keyless"
+    private-network:
+      base-url: "http://100.88.1.1:8010/v1"
+      class: "tailnet"
+  - name: "ordinary"
+    base-url: "http://127.0.0.1:8011/v1"
+`))
+	if err != nil {
+		t.Fatal(err)
+	}
+	auths, err := NewConfigSynthesizer().Synthesize(&SynthesisContext{Config: cfg, Now: time.Now(), IDGenerator: NewStableIDGenerator()})
+	if err != nil {
+		t.Fatal(err)
+	}
+	want := map[string][2]string{
+		"pn-keyed":   {"http://127.0.0.1:8010/v1", "loopback"},
+		"pn-keyless": {"http://100.88.1.1:8010/v1", "tailnet"},
+	}
+	seen := 0
+	for _, a := range auths {
+		class, declared := a.Attributes["private_network"]
+		switch a.Label {
+		case "ordinary":
+			if declared {
+				t.Fatal("an ordinary entry carries a private-network class")
+			}
+		case "pn-keyed", "pn-keyless":
+			seen++
+			if !declared || class != want[a.Label][1] || a.Attributes["base_url"] != want[a.Label][0] {
+				t.Fatalf("%s attributes = %v", a.Label, a.Attributes)
+			}
+		}
+	}
+	if seen != 2 {
+		t.Fatalf("private-network auths = %d", seen)
+	}
+}
diff --git a/sdk/cliproxy/private_network_reload_test.go b/sdk/cliproxy/private_network_reload_test.go
new file mode 100644
index 00000000..105d0785
--- /dev/null
+++ b/sdk/cliproxy/private_network_reload_test.go
@@ -0,0 +1,204 @@
+package cliproxy
+
+import (
+	"context"
+	"encoding/json"
+	"fmt"
+	"io"
+	"net"
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"sync"
+	"sync/atomic"
+	"testing"
+
+	"github.com/router-for-me/CLIProxyAPI/v8/internal/api"
+	internalconfig "github.com/router-for-me/CLIProxyAPI/v8/internal/config"
+	internalregistry "github.com/router-for-me/CLIProxyAPI/v8/internal/registry"
+)
+
+// privateNetworkReloadUpstream counts accepted connections and the paths of
+// the requests that reach it.
+type privateNetworkReloadUpstream struct {
+	server  *httptest.Server
+	accepts atomic.Int64
+	mu      sync.Mutex
+	paths   []string
+}
+
+func (u *privateNetworkReloadUpstream) requests() []string {
+	u.mu.Lock()
+	defer u.mu.Unlock()
+	return append([]string(nil), u.paths...)
+}
+
+func newPrivateNetworkReloadUpstream(t *testing.T) *privateNetworkReloadUpstream {
+	t.Helper()
+	u := &privateNetworkReloadUpstream{}
+	u.server = httptest.NewUnstartedServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		u.mu.Lock()
+		u.paths = append(u.paths, r.URL.Path)
+		u.mu.Unlock()
+		_, _ = io.Copy(io.Discard, r.Body)
+		w.Header().Set("Content-Type", "application/json")
+		_, _ = io.WriteString(w, `{"id":"c1","object":"chat.completion","model":"pn-wire","choices":[{"index":0,"message":{"role":"assistant","content":"ok"},"finish_reason":"stop"}],"usage":{"prompt_tokens":1,"completion_tokens":1,"total_tokens":2}}`)
+	}))
+	u.server.Config.ConnState = func(_ net.Conn, state http.ConnState) {
+		if state == http.StateNew {
+			u.accepts.Add(1)
+		}
+	}
+	u.server.Start()
+	t.Cleanup(u.server.Close)
+	return u
+}
+
+// privateNetworkReloadConfig is the rendered form: the provider "pnbox"
+// (block is its private-network or base-url lines, "" for none) and the
+// reload sentinel, whose alias names the render.
+func privateNetworkReloadConfig(t *testing.T, authDir, proxy, block, sentinel string) *internalconfig.Config {
+	t.Helper()
+	text := fmt.Sprintf("auth-dir: %q\nproxy-url: %q\nrequest-retry: 0\nopenai-compatibility:\n", authDir, proxy)
+	if block != "" {
+		text += "  - name: \"pnbox\"\n" + block +
+			"    api-key-entries:\n      - api-key: \"pn-reload-key\"\n" +
+			"    models:\n      - name: \"pn-wire\"\n        alias: \"pn-reload-model\"\n"
+	}
+	text += "  - name: \"charmer-render\"\n    base-url: \"http://127.0.0.1:9/v1\"\n" +
+		"    api-key-entries:\n      - api-key: \"pn-render-key\"\n" +
+		"    models:\n      - name: \"charmer-render\"\n        alias: \"" + sentinel + "\"\n"
+	cfg, err := internalconfig.ParseConfigBytes([]byte(text))
+	if err != nil {
+		t.Fatal(err)
+	}
+	return cfg
+}
+
+func privateNetworkBlock(url, class string) string {
+	return fmt.Sprintf("    private-network:\n      base-url: %q\n      class: %q\n", url, class)
+}
+
+// A reload publishes the new routes (the sentinel) before the synthesized
+// credentials follow: applyWatcherConfigUpdate is the watcher's callback,
+// and the credential refresh that follows it is never run here, so the
+// window stays open for as long as the test needs. A request that starts
+// after the new sentinel is listed is dialled under the new declaration or
+// not at all; it never sends the key under the previous one.
+func TestPrivateNetworkReloadIsNeverDialledUnderThePreviousDeclaration(t *testing.T) {
+	var proxied atomic.Int64
+	proxy := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, _ *http.Request) {
+		proxied.Add(1)
+		w.WriteHeader(http.StatusTeapot)
+	}))
+	defer proxy.Close()
+	for _, c := range []struct {
+		name          string
+		before, after func(base string) string
+		// served: the request reaches the provider at path; otherwise
+		// nothing reaches the provider directly.
+		served string
+		// direct: no proxy, so an ordinary entry dials the provider itself.
+		direct bool
+	}{
+		{name: "loopback to tailnet",
+			before: func(b string) string { return privateNetworkBlock(b+"/v1", "loopback") },
+			after:  func(b string) string { return privateNetworkBlock(b+"/v1", "tailnet") }},
+		{name: "tailnet to loopback",
+			before: func(b string) string { return privateNetworkBlock(b+"/v1", "tailnet") },
+			after:  func(b string) string { return privateNetworkBlock(b+"/v1", "loopback") },
+			served: "/v1/chat/completions"},
+		{name: "url moved",
+			before: func(b string) string { return privateNetworkBlock(b+"/v1", "loopback") },
+			after:  func(b string) string { return privateNetworkBlock(b+"/moved/v1", "loopback") }},
+		{name: "network removed",
+			before: func(b string) string { return privateNetworkBlock(b+"/v1", "loopback") },
+			after:  func(b string) string { return fmt.Sprintf("    base-url: %q\n", b+"/v1") }},
+		{name: "network added", direct: true,
+			before: func(b string) string { return fmt.Sprintf("    base-url: %q\n", b+"/v1") },
+			after:  func(b string) string { return privateNetworkBlock(b+"/v1", "tailnet") }},
+		{name: "entry removed",
+			before: func(b string) string { return privateNetworkBlock(b+"/v1", "loopback") },
+			after:  func(string) string { return "" }},
+	} {
+		t.Run(c.name, func(t *testing.T) {
+			upstream := newPrivateNetworkReloadUpstream(t)
+			authDir := t.TempDir()
+			// Unless direct, the proxy is the only way an ordinary entry
+			// reaches anything.
+			proxyURL := proxy.URL
+			if c.direct {
+				proxyURL = ""
+			}
+			before := privateNetworkReloadConfig(t, authDir, proxyURL, c.before(upstream.server.URL), "charmer-render-before")
+			service, errBuild := NewBuilder().WithConfig(before).WithConfigPath(authDir + "/config.yaml").Build()
+			if errBuild != nil {
+				t.Fatal(errBuild)
+			}
+			server := api.NewServer(service.cfg, service.coreManager, service.accessManager, service.configPath, service.serverOptions...)
+			service.server = server
+			handler := server.Handler()
+			reg := internalregistry.GetGlobalRegistry()
+			t.Cleanup(func() {
+				for _, auth := range service.coreManager.List() {
+					if auth != nil {
+						reg.UnregisterClient(auth.ID)
+					}
+				}
+			})
+			ctx := context.Background()
+			if !service.applyConfigUpdateWithAuthSynthesis(ctx, before, true) {
+				t.Fatal("initial config not applied")
+			}
+			listed := func(alias string) bool {
+				rec := httptest.NewRecorder()
+				handler.ServeHTTP(rec, httptest.NewRequest(http.MethodGet, "/v1/models", nil))
+				var listing struct {
+					Data []struct {
+						ID string `json:"id"`
+					} `json:"data"`
+				}
+				_ = json.Unmarshal(rec.Body.Bytes(), &listing)
+				for _, row := range listing.Data {
+					if row.ID == alias {
+						return true
+					}
+				}
+				return false
+			}
+			request := func() int {
+				rec := httptest.NewRecorder()
+				req := httptest.NewRequest(http.MethodPost, "/v1/chat/completions",
+					strings.NewReader(`{"model":"pn-reload-model","messages":[{"role":"user","content":"hi"}]}`))
+				req.Header.Set("Content-Type", "application/json")
+				handler.ServeHTTP(rec, req)
+				return rec.Code
+			}
+			if !listed("charmer-render-before") || !listed("pn-reload-model") {
+				rec := httptest.NewRecorder()
+				handler.ServeHTTP(rec, httptest.NewRequest(http.MethodGet, "/v1/models", nil))
+				t.Fatalf("the initial render is not served: %d %.400s auths=%d", rec.Code, rec.Body.String(), len(service.coreManager.List()))
+			}
+
+			// The watcher's reload callback, without the credential refresh.
+			after := privateNetworkReloadConfig(t, authDir, proxyURL, c.after(upstream.server.URL), "charmer-render-after")
+			service.applyWatcherConfigUpdate(after)
+			if !listed("charmer-render-after") {
+				t.Fatal("the reloaded render is not acknowledged")
+			}
+			accepts, seen := upstream.accepts.Load(), len(upstream.requests())
+			status := request()
+			paths := upstream.requests()[seen:]
+			if c.served != "" {
+				if status != http.StatusOK || len(paths) != 1 || paths[0] != c.served {
+					t.Fatalf("status %d paths %v, want served at %s", status, paths, c.served)
+				}
+				return
+			}
+			if status == http.StatusOK || len(paths) != 0 || upstream.accepts.Load() != accepts {
+				t.Fatalf("status %d paths %v accepts +%d: dialled under the previous declaration",
+					status, paths, upstream.accepts.Load()-accepts)
+			}
+		})
+	}
+}
