@@ -0,0 +1,19 @@
+package executor
+
+import "strings"
+
+// withNativeClaudeAdvisorToolBeta keeps a confirmed native Claude Code
+// client's Anthropic-Beta list exactly as sent when it already names the
+// advisor beta. withClaudeAdvisorToolBeta removes a present advisor beta and
+// inserts it again before the first of its boundary betas, which moves it
+// behind thinking-token-count, against the native 2.1.321 order (advisor-tool
+// before thinking-token-count) and so changes the native fingerprint. A list
+// without the advisor beta still gets it placed by withClaudeAdvisorToolBeta.
+func withNativeClaudeAdvisorToolBeta(betas string) string {
+	for _, beta := range strings.Split(betas, ",") {
+		if strings.TrimSpace(beta) == claudeAdvisorToolBeta {
+			return betas
+		}
+	}
+	return withClaudeAdvisorToolBeta(betas)
+}
diff --git a/internal/runtime/executor/claude_native_advisor_beta_test.go b/internal/runtime/executor/claude_native_advisor_beta_test.go
new file mode 100644
