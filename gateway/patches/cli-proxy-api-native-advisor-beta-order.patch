--- /dev/null
+++ b/internal/runtime/executor/claude_native_advisor_beta_test.go
@@ -0,0 +1,77 @@
+package executor
+
+import (
+	"net/http"
+	"strings"
+	"testing"
+)
+
+// Native Claude Code 2.1.321 main-thread Anthropic-Beta with the advisor tool,
+// as the client sends it to the gateway (the gateway adds the OAuth beta).
+const nativeAdvisorClientBetas = "claude-code-20250219,interleaved-thinking-2025-05-14," +
+	"context-management-2025-06-27,prompt-caching-scope-2026-01-05,per-turn-control-2026-07-01," +
+	"mid-conversation-tool-changes-2026-07-01,inline-tools-2026-09-15,advisor-tool-2026-03-01," +
+	"thinking-token-count-2026-05-13,advanced-tool-use-2025-11-20,effort-2025-11-24"
+
+func nativeAdvisorBetaHeader(t *testing.T, incomingBetas string, confirmed bool) []string {
+	t.Helper()
+	incoming := http.Header{}
+	incoming.Set("Anthropic-Beta", incomingBetas)
+	body := []byte(`{"model":"claude-opus-5-5","tools":[{"type":"advisor_20260301","name":"advisor"}],"messages":[{"role":"user","content":"hi"}]}`)
+	req := newClaudeHeaderTestRequest(t, nil)
+	if err := applyClaudeHeaders(req, claudeOAuthAuthForBetaPolicy(), claudeRaceProbeOAuthKey, false, nil,
+		body, nil, incoming, confirmed); err != nil {
+		t.Fatalf("applyClaudeHeaders() error = %v", err)
+	}
+	return strings.Split(req.Header.Get("Anthropic-Beta"), ",")
+}
+
+func betaIndex(parts []string, beta string) int {
+	for index, part := range parts {
+		if strings.TrimSpace(part) == beta {
+			return index
+		}
+	}
+	return -1
+}
+
+// A confirmed native client that already sends the advisor beta keeps its own
+// order: advisor-tool stays before thinking-token-count, as in the 2.1.321
+// capture, and a trailing advisor beta stays trailing.
+func TestNativeClaudeAdvisorBetaKeepsTheClientsOrder(t *testing.T) {
+	got := nativeAdvisorBetaHeader(t, nativeAdvisorClientBetas, true)
+	advisor, thinkingCount := betaIndex(got, claudeAdvisorToolBeta), betaIndex(got, "thinking-token-count-2026-05-13")
+	if advisor == -1 || thinkingCount == -1 || advisor > thinkingCount {
+		t.Fatalf("native order changed: advisor at %d, thinking-token-count at %d in %q", advisor, thinkingCount, got)
+	}
+	client := strings.Split(nativeAdvisorClientBetas, ",")
+	var kept []string
+	for _, beta := range got {
+		if beta != "oauth-2025-04-20" && beta != "extended-cache-ttl-2025-04-11" {
+			kept = append(kept, beta)
+		}
+	}
+	if strings.Join(kept, ",") != strings.Join(client, ",") {
+		t.Fatalf("native betas reordered:\n got:  %q\n sent: %q", kept, client)
+	}
+	trailing := "claude-code-20250219,advanced-tool-use-2025-11-20,effort-2025-11-24,advisor-tool-2026-03-01"
+	got = nativeAdvisorBetaHeader(t, trailing, true)
+	if betaIndex(got, claudeAdvisorToolBeta) < betaIndex(got, "effort-2025-11-24") {
+		t.Fatalf("a native trailing advisor beta was moved: %q", got)
+	}
+}
+
+// A native client that does not send the advisor beta still gets it, placed
+// before advanced-tool-use; withNativeClaudeAdvisorToolBeta only keeps an
+// order the client chose.
+func TestNativeClaudeAdvisorBetaIsAddedWhenAbsent(t *testing.T) {
+	without := strings.Replace(nativeAdvisorClientBetas, "advisor-tool-2026-03-01,", "", 1)
+	got := nativeAdvisorBetaHeader(t, without, true)
+	advisor, tools := betaIndex(got, claudeAdvisorToolBeta), betaIndex(got, "advanced-tool-use-2025-11-20")
+	if advisor == -1 || advisor > tools {
+		t.Fatalf("advisor beta missing or misplaced: %q", got)
+	}
+	if got := withNativeClaudeAdvisorToolBeta(nativeAdvisorClientBetas); got != nativeAdvisorClientBetas {
+		t.Fatalf("withNativeClaudeAdvisorToolBeta changed a list that names the advisor beta: %q", got)
+	}
+}
