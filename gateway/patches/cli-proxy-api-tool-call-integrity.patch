+		if acc := accumulators[left]; acc != nil {
+			leftIndex = acc.SourceIndex
+		}
+		if acc := accumulators[right]; acc != nil {
+			rightIndex = acc.SourceIndex
+		}
+		if leftIndex == rightIndex {
+			return left < right
+		}
+		return leftIndex < rightIndex
+	})
 	return indexes
