+func (p *ConvertOpenAIResponseToAnthropicParams) toolCallAccumulatorIndex(arrayIndex int, toolCall gjson.Result) int {
+	id := toolCall.Get("id")
+	if explicitIndex := toolCall.Get("index"); explicitIndex.Exists() {
+		upstreamIndex := int(explicitIndex.Int())
+		if index, ok := p.ExplicitToolCallIndexes[upstreamIndex]; ok {
+			return index
+		}
+		if p.ExplicitToolCallIndexes == nil {
+			p.ExplicitToolCallIndexes = make(map[int]int)
+		}
+		// Preserve compatible continuations at the same logical effective index.
+		if index, ok := p.OmittedToolCallIndexes[upstreamIndex]; ok && toolCallIDCompatible(p.ToolCallsAccumulator[index], id) {
+			p.ExplicitToolCallIndexes[upstreamIndex] = index
+			p.ToolCallsAccumulator[index].SourceIndex = upstreamIndex
+			return index
+		}
+		index := upstreamIndex
+		if _, exists := p.ToolCallsAccumulator[index]; exists {
+			// A later explicit index must not take an omitted call's slot.
+			index = p.nextToolCallAccumulatorIndex()
+		}
+		p.ExplicitToolCallIndexes[upstreamIndex] = index
+		return index
+	}
+
+	if p.OmittedToolCallIndexes == nil {
+		p.OmittedToolCallIndexes = make(map[int]int)
+	}
+	if index, ok := p.OmittedToolCallIndexes[arrayIndex]; ok {
+		if toolCallIDCompatible(p.ToolCallsAccumulator[index], id) {
+			return index
+		}
+		// A different non-empty ID advances only this omitted position's mapping.
+	} else if index, ok := p.ExplicitToolCallIndexes[arrayIndex]; ok && toolCallIDCompatible(p.ToolCallsAccumulator[index], id) {
+		p.OmittedToolCallIndexes[arrayIndex] = index
+		return index
+	}
+	index := p.nextToolCallAccumulatorIndex()
+	p.OmittedToolCallIndexes[arrayIndex] = index
+	return index
+}
+
+func toolCallIDCompatible(accumulator *ToolCallAccumulator, id gjson.Result) bool {
+	return accumulator != nil && (id.Type != gjson.String || id.String() == "" || accumulator.ID == "" || id.String() == accumulator.ID)
+}
+
+func (p *ConvertOpenAIResponseToAnthropicParams) nextToolCallAccumulatorIndex() int {
+	index := len(p.ToolCallsAccumulator)
+	for {
+		if _, exists := p.ToolCallsAccumulator[index]; !exists {
+			return index
+		}
+		index++
+	}
+}
