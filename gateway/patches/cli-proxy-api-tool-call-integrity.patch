+
+const (
+	toolIntegrityCallA       = `{"id":"call_a","type":"function","function":{"name":"tool_a","arguments":"{\"k\":\"a\"}"}}`
+	toolIntegrityMessageA    = `{"role":"assistant","content":null,"tool_calls":[` + toolIntegrityCallA + `]}`
+	toolIntegrityContentA    = `{"role":"assistant","content":[{"type":"tool_calls","tool_calls":[` + toolIntegrityCallA + `]}]}`
+	toolIntegrityMessageText = `{"role":"assistant","content":"answer"}`
+	toolIntegrityBlockA      = `{"type":"tool_use","id":"call_a","name":"tool_a","input":{"k":"a"}}`
+	toolIntegrityBlockText   = `{"type":"text","text":"answer"}`
+	// The helper keeps the content array as text, as before.
+	toolIntegrityBlockArray = `{"type":"text","text":"[{\"type\":\"tool_calls\",\"tool_calls\":[{\"id\":\"call_a\",\"type\":\"function\",\"function\":{\"name\":\"tool_a\",\"arguments\":\"{\\\"k\\\":\\\"a\\\"}\"}}]}]"}`
+)
+
+func toolIntegrityWant(block, stopReason string) string {
+	return `{"id":"fixture","type":"message","role":"assistant","model":"fixture","content":[` + block +
+		`],"stop_reason":` + stopReason + `,"stop_sequence":null,"usage":{"input_tokens":11,"output_tokens":4}}`
+}
+
+// Converted tool calls report tool_use unless the finish reason is length or
+// content_filter, as in the streaming path; text-only replies keep their mapping.
+var toolIntegrityNonStreamGoldens = []struct{ name, message, finish, helper, registered string }{
+	{"tool-stop", toolIntegrityMessageA, `"stop"`, toolIntegrityWant(toolIntegrityBlockA, `"tool_use"`), toolIntegrityWant(toolIntegrityBlockA, `"tool_use"`)},
+	{"tool-missing", toolIntegrityMessageA, "", toolIntegrityWant(toolIntegrityBlockA, `"tool_use"`), toolIntegrityWant(toolIntegrityBlockA, `"tool_use"`)},
+	{"tool-empty", toolIntegrityMessageA, `""`, toolIntegrityWant(toolIntegrityBlockA, `"tool_use"`), toolIntegrityWant(toolIntegrityBlockA, `"tool_use"`)},
+	{"tool-null", toolIntegrityMessageA, "null", toolIntegrityWant(toolIntegrityBlockA, `"tool_use"`), toolIntegrityWant(toolIntegrityBlockA, `"tool_use"`)},
+	{"tool-tool-calls", toolIntegrityMessageA, `"tool_calls"`, toolIntegrityWant(toolIntegrityBlockA, `"tool_use"`), toolIntegrityWant(toolIntegrityBlockA, `"tool_use"`)},
+	{"tool-other", toolIntegrityMessageA, `"other"`, toolIntegrityWant(toolIntegrityBlockA, `"tool_use"`), toolIntegrityWant(toolIntegrityBlockA, `"tool_use"`)},
+	{"tool-length", toolIntegrityMessageA, `"length"`, toolIntegrityWant(toolIntegrityBlockA, `"max_tokens"`), toolIntegrityWant(toolIntegrityBlockA, `"max_tokens"`)},
+	{"tool-content-filter", toolIntegrityMessageA, `"content_filter"`, toolIntegrityWant(toolIntegrityBlockA, `"end_turn"`), toolIntegrityWant(toolIntegrityBlockA, `"end_turn"`)},
+	{"content-array-missing", toolIntegrityContentA, "", toolIntegrityWant(toolIntegrityBlockArray, "null"), toolIntegrityWant(toolIntegrityBlockA, `"tool_use"`)},
+	{"text-stop", toolIntegrityMessageText, `"stop"`, toolIntegrityWant(toolIntegrityBlockText, `"end_turn"`), toolIntegrityWant(toolIntegrityBlockText, `"end_turn"`)},
+	{"text-missing", toolIntegrityMessageText, "", toolIntegrityWant(toolIntegrityBlockText, "null"), toolIntegrityWant(toolIntegrityBlockText, `"end_turn"`)},
+	{"text-other", toolIntegrityMessageText, `"other"`, toolIntegrityWant(toolIntegrityBlockText, `"end_turn"`), toolIntegrityWant(toolIntegrityBlockText, `"end_turn"`)},
+	{"text-length", toolIntegrityMessageText, `"length"`, toolIntegrityWant(toolIntegrityBlockText, `"max_tokens"`), toolIntegrityWant(toolIntegrityBlockText, `"max_tokens"`)},
+}
+
+func toolIntegrityCall(id, name, arguments, index string) string {
+	call := `{`
+	if index != "" {
+		call += `"index":` + index + `,`
+	}
+	if id != "" {
+		call += `"id":"` + id + `","type":"function",`
+	}
+	call += `"function":{`
+	if name != "" {
+		call += `"name":"` + name + `",`
+	}
+	return call + `"arguments":"` + arguments + `"}}`
+}
+
+// The tool-call deltas of each stream case; "" is an omitted index.
+func toolIntegrityDeltas(name string) []string {
+	delta := func(calls ...string) string {
+		joined := `{"tool_calls":[`
+		for i, call := range calls {
+			if i > 0 {
+				joined += ","
+			}
+			joined += call
+		}
+		return joined + `]}`
+	}
+	a := func(index string) string { return toolIntegrityCall("call_a", "tool_a", `{\"k\":\"a\"}`, index) }
+	b := func(index string) string { return toolIntegrityCall("call_b", "tool_b", `{\"k\":\"b\"}`, index) }
+	switch name {
+	case "omitted-index":
+		return []string{delta(a("")), delta(b(""))}
+	case "mixed-forward":
+		// Array position 1 and explicit index 1 name different calls.
+		return []string{delta(a("1"), b(""))}
+	case "mixed-reverse":
+		return []string{delta(a("")), delta(b("0"))}
+	case "stable-id":
+		// The continuation may not rewrite the announced ID, and that attempt
+		// must not make the later omitted call join the first one.
+		return []string{delta(toolIntegrityCall("call_a", "tool_a", `{\"k\":`, "0")),
+			delta(toolIntegrityCall("call_b", "", `\"a\"}`, "0")), delta(b(""))}
+	case "interleaved":
+		return []string{delta(toolIntegrityCall("call_a", "tool_a", `{\"k\":`, "0")),
+			delta(toolIntegrityCall("call_b", "tool_b", `{\"k\":`, "1")),
+			delta(toolIntegrityCall("", "", `\"a\"}`, "0")), delta(toolIntegrityCall("", "", `\"b\"}`, "1"))}
+	case "omitted-interleaved":
+		// Every fragment is at array position 0; the IDs name the calls.
+		return []string{delta(toolIntegrityCall("call_a", "tool_a", `{\"k\":`, "")),
+			delta(toolIntegrityCall("call_b", "tool_b", `{\"k\":`, "")),
+			delta(toolIntegrityCall("call_a", "", `\"a\"}`, "")), delta(toolIntegrityCall("call_b", "", `\"b\"}`, ""))}
+	}
+	indexes := map[string][2]string{"explicit-continue": {"0", "0"}, "omitted-continue": {"", ""},
+		"omit-to-explicit": {"", "0"}, "explicit-to-omit": {"0", ""}}[name]
+	return []string{delta(toolIntegrityCall("call_a", "tool_a", `{\"k\":`, indexes[0])),
+		delta(toolIntegrityCall("", "", `\"a\"}`, indexes[1]))}
+}
+
+func toolIntegrityStream(deltas []string) []byte {
+	var param any
+	var out [][]byte
+	feed := func(chunk string) {
+		out = append(out, ConvertOpenAIResponseToClaude(context.Background(), "", []byte(`{"stream":true}`), nil,
+			[]byte("data: "+chunk), &param)...)
+	}
+	feed(`{"id":"fixture","model":"fixture","choices":[{"index":0,"delta":{"role":"assistant"}}]}`)
+	for _, delta := range deltas {
+		feed(`{"id":"fixture","model":"fixture","choices":[{"index":0,"delta":` + delta + `}]}`)
+	}
+	feed(`{"choices":[{"index":0,"delta":{},"finish_reason":"tool_calls"}]}`)
+	feed(`{"choices":[],"usage":{"prompt_tokens":11,"completion_tokens":4}}`)
+	feed(`[DONE]`)
+	return bytes.Join(out, nil)
+}
+
+func toolIntegrityResponse(message, finish string) []byte {
+	choice := `{"index":0,"message":` + message
+	if finish != "" {
+		choice += `,"finish_reason":` + finish
+	}
+	return []byte(`{"id":"fixture","model":"fixture","choices":[` + choice + `}],"usage":{"prompt_tokens":11,"completion_tokens":4}}`)
+}
+
+func TestToolCallIntegrityStreamGoldens(t *testing.T) {
+	for _, tc := range toolIntegrityStreamGoldens {
+		t.Run(tc.name, func(t *testing.T) {
+			if got := toolIntegrityStream(toolIntegrityDeltas(tc.name)); !bytes.Equal(got, []byte(tc.want)) {
+				t.Errorf("stream bytes changed: got %q, want %q", got, tc.want)
+			}
+		})
+	}
+}
+
+func TestToolCallIntegrityNonStreamGoldens(t *testing.T) {
+	for _, tc := range toolIntegrityNonStreamGoldens {
+		t.Run(tc.name, func(t *testing.T) {
+			raw := toolIntegrityResponse(tc.message, tc.finish)
+			for _, result := range []struct {
+				name string
+				got  []byte
+				want string
+			}{
+				{"helper", convertOpenAINonStreamingToAnthropic(raw)[0], tc.helper},
+				{"registered", ConvertOpenAIResponseToClaudeNonStream(context.Background(), "", nil, nil, raw, nil), tc.registered},
+			} {
+				if !bytes.Equal(result.got, []byte(result.want)) {
+					t.Errorf("%s bytes changed: got %q, want %q", result.name, result.got, result.want)
+				}
+			}
+		})
+	}
+}
