@@ -0,0 +1,54 @@
+package auth
+
+import (
+	"testing"
+	"time"
+)
+
+// The proactive Codex refresh lead is 96 h: a Codex OAuth credential is
+// refreshed 95 h before its expiry and not yet 97 h before it.
+func TestCodexRefreshLeadShouldRefreshAt96Hours(t *testing.T) {
+	refreshLeadMu.Lock()
+	previous, hadPrevious := refreshLeadFactories["codex"]
+	refreshLeadMu.Unlock()
+	t.Cleanup(func() {
+		refreshLeadMu.Lock()
+		defer refreshLeadMu.Unlock()
+		if hadPrevious {
+			refreshLeadFactories["codex"] = previous
+		} else {
+			delete(refreshLeadFactories, "codex")
+		}
+	})
+	RegisterRefreshLeadProvider("codex", func() *time.Duration {
+		lead := CodexOuterRefreshLead
+		return &lead
+	})
+	if CodexOuterRefreshLead != 96*time.Hour {
+		t.Fatalf("CodexOuterRefreshLead = %v, want 96h", CodexOuterRefreshLead)
+	}
+	m := NewManager(nil, nil, nil)
+	for _, tc := range []struct {
+		left time.Duration
+		want bool
+	}{
+		{95 * time.Hour, true},
+		{97 * time.Hour, false},
+	} {
+		auth := &Auth{
+			ID:       "codex-lead",
+			Provider: "codex",
+			Metadata: map[string]any{
+				"type":          "codex",
+				"refresh_token": "refresh-token",
+				"expired":       time.Now().Add(tc.left).Format(time.RFC3339),
+			},
+		}
+		if got := m.shouldRefresh(auth, time.Now()); got != tc.want {
+			t.Fatalf("shouldRefresh %v before expiry = %v, want %v", tc.left, got, tc.want)
+		}
+		if _, has, need := CodexOuterNeedsRefresh(auth, time.Now()); !has || need != tc.want {
+			t.Fatalf("CodexOuterNeedsRefresh %v before expiry = has %v need %v, want need %v", tc.left, has, need, tc.want)
+		}
+	}
+}
