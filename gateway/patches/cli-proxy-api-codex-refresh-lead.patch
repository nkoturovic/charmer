@@ -0,0 +1,39 @@
+package auth
+
+import (
+	"testing"
+	"time"
+
+	coreauth "github.com/router-for-me/CLIProxyAPI/v8/sdk/cliproxy/auth"
+)
+
+// With the production lead registry, Codex refreshes 96 h ahead and Claude
+// keeps its 4 h lead.
+func TestCodexRefreshLeadRegistry96HoursClaudeUnchanged(t *testing.T) {
+	for provider, want := range map[string]time.Duration{"codex": 96 * time.Hour, "claude": 4 * time.Hour} {
+		lead := coreauth.ProviderRefreshLead(provider, nil)
+		if lead == nil || *lead != want {
+			t.Fatalf("ProviderRefreshLead(%q) = %v, want %v", provider, lead, want)
+		}
+	}
+	for _, tc := range []struct {
+		left time.Duration
+		want bool
+	}{
+		{95 * time.Hour, true},
+		{97 * time.Hour, false},
+	} {
+		auth := &coreauth.Auth{
+			ID:       "codex-lead",
+			Provider: "codex",
+			Metadata: map[string]any{
+				"type":          "codex",
+				"refresh_token": "refresh-token",
+				"expired":       time.Now().Add(tc.left).Format(time.RFC3339),
+			},
+		}
+		if _, has, need := coreauth.CodexOuterNeedsRefresh(auth, time.Now()); !has || need != tc.want {
+			t.Fatalf("CodexOuterNeedsRefresh %v before expiry = has %v need %v, want need %v", tc.left, has, need, tc.want)
+		}
+	}
+}
